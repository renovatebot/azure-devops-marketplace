{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.project",
        "vso.extension.data_write"
    ],
    "licensing": {
        "overrides": [
            {
                "id": "executive-lenz-hub",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributions": [
        {
            "id": "executive-lenz-hub",
            "type": "ms.vss-web.hub",
            "description": "The ExecutiveLenz report library, editor and presenter.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "ExecutiveLenz",
                "order": 100,
                "uri": "index.html",
                "icon": "images/hub-lens.ico"
            }
        }
    ],
    "contributionTypes": []
}