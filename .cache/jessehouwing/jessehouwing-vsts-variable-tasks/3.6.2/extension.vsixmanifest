      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#242b32"></Property>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"></Property>

      
      
      
      
      
      
      
        </Properties>
    <Badges>
