  <Metadata>
    <Identity Language="en-US" Id="ChildTasksTemplate" Version="3.1.11" Publisher="Fiveforty"/>
    <DisplayName>Child Tasks Template</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">Create linked child tasks, bugs or any work item from reusable per-project templates in one click, with parent field values, a visual editor and validation.</Description>
    <Categories>Azure Boards</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="mailto:dbru@fiveforty.fr"/>
