      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/dbru540/ChildTasksTemplate.git"/>
    </Properties>
    <Tags>Tasks,Child tasks,Template,Work items,Azure Boards,Productivity,Automation</Tags>
    <Icon>dist/doc/fiveforty.png</Icon>
    <License>LICENSE</License>
  </Metadata>
