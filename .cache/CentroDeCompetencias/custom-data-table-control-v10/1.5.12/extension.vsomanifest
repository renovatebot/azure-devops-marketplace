{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "custom-data-table-control-dt-v3",
            "type": "ms.vss-work-web.work-item-form-control",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "description": "Agrega al formulario del elemento de trabajo una tabla editable configurable.",
            "properties": {
                "name": "Tabla de datos",
                "uri": "dist/index.html",
                "height": 380,
                "inputs": [
                    {
                        "id": "DataFieldRefName",
                        "name": "Campo de datos (nombre de referencia)",
                        "description": "Campo donde se guarda el JSON de la tabla (por ejemplo, Custom.DataTableJSON).",
                        "type": "WorkItemField",
                        "defaultValue": "Custom.DataTableJSON",
                        "properties": {
                            "workItemFieldTypes": [
                                "String",
                                "PlainText",
                                "Html"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "DataFieldRefNameText",
                        "name": "Campo de datos (ingreso manual)",
                        "description": "Si el selector no aparece, escribe el nombre de referencia del campo (por ejemplo, Custom.DataTableJSON).",
                        "type": "string",
                        "defaultValue": "Custom.DataTableJSON",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "ColumnConfiguration",
                        "name": "Configuración de columnas (JSON)",
                        "description": "Define las columnas, reglas y estados de solo lectura. Ejemplo: {\"columns\":[{\"id\":\"tarea\",\"name\":\"Tarea\",\"dataType\":\"string\"}]}",
                        "type": "string",
                        "defaultValue": "{\"columns\":[{\"id\":\"descripcion\",\"name\":\"Descripción\",\"dataType\":\"textArea\",\"required\":true,\"width\":\"55%\"},{\"id\":\"responsable\",\"name\":\"Responsable\",\"dataType\":\"string\",\"required\":true,\"width\":\"25%\"},{\"id\":\"fechaInicio\",\"name\":\"Fecha y hora inicio\",\"dataType\":\"date\",\"required\":true,\"width\":\"10%\"},{\"id\":\"fechaFin\",\"name\":\"Fecha y hora fin\",\"dataType\":\"date\",\"required\":true,\"width\":\"10%\"}]}",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "FontFamily",
                        "name": "Fuente",
                        "description": "Familia de fuente de la tabla.",
                        "type": "combo",
                        "defaultValue": "Default (System Font)",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        },
                        "properties": {
                            "EditableOptions": "False"
                        },
                        "options": {
                            "Default (System Font)": "Default (System Font)",
                            "Arial": "Arial",
                            "Verdana": "Verdana",
                            "Tahoma": "Tahoma",
                            "Trebuchet MS": "Trebuchet MS",
                            "Georgia": "Georgia",
                            "Courier New": "Courier New",
                            "Calibri": "Calibri",
                            "Segoe UI": "Segoe UI",
                            "Consolas": "Consolas"
                        }
                    },
                    {
                        "id": "FontSize",
                        "name": "Tamaño de fuente",
                        "description": "Tamaño de fuente de la tabla.",
                        "type": "combo",
                        "defaultValue": "Default (13px)",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        },
                        "properties": {
                            "EditableOptions": "False"
                        },
                        "options": {
                            "Default (13px)": "Default (13px)",
                            "Small (10px)": "10",
                            "Small (11px)": "11",
                            "Small (12px)": "12",
                            "Medium (14px)": "14",
                            "Medium (15px)": "15",
                            "Large (16px)": "16",
                            "Large (18px)": "18",
                            "Extra Large (20px)": "20",
                            "Extra Large (22px)": "22"
                        }
                    }
                ]
            }
        }
    ],
    "contributionTypes": []
}