{
    "manifestVersion": 1,
    "CustomerQnASupport": {
        "enablemarketplaceqna": true,
        "enableMarketplaceQnA": true
    },
    "scopes": [
        "vso.work",
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "create-child-task-work-item-toolbar-button",
            "type": "ms.vss-web.action",
            "description": "Adds a menu item to the work item toolbar to create child work items.",
            "targets": [
                "ms.vss-work-web.work-item-toolbar-menu"
            ],
            "properties": {
                "text": "Create child work items",
                "title": "Create child work items",
                "toolbarText": "Create child work items",
                "icon": "img/create-child-work-items-icon-16x16.png",
                "uri": "toolbar.html",
                "registeredObjectId": "create-child-task-work-item-toolbar-button"
            }
        },
        {
            "id": "create-child-task-backlog-item-button",
            "type": "ms.vss-web.action",
            "description": "Adds a menu item to the backlog item menu to create child work items.",
            "targets": [
                "ms.vss-work-web.backlog-item-menu"
            ],
            "properties": {
                "text": "Create child work items",
                "title": "Create child work items",
                "toolbarText": "Create child work items",
                "icon": "img/create-child-work-items-icon-16x16.png",
                "uri": "toolbar.html",
                "registeredObjectId": "create-child-task-backlog-item-button"
            }
        },
        {
            "id": "create-child-task-board-card-item-button",
            "type": "ms.vss-web.action",
            "description": "Adds a menu item to the board card menu to create child work items.",
            "targets": [
                "ms.vss-work-web.backlog-board-card-item-menu"
            ],
            "properties": {
                "text": "Create child work items",
                "title": "Create child work items",
                "toolbarText": "Create child work items",
                "icon": "img/create-child-work-items-icon-16x16.png",
                "uri": "toolbar.html",
                "registeredObjectId": "create-child-task-board-card-item-button"
            }
        },
        {
            "id": "create-child-tasks-progress-dialog",
            "type": "ms.vss-web.dialog-content",
            "description": "Progress dialog for Create Child Work Items.",
            "targets": [
                "ms.vss-web.dialog-content"
            ],
            "properties": {
                "uri": "progress.html"
            }
        },
        {
            "id": "create-child-tasks-admin-page",
            "type": "ms.vss-web.hub",
            "description": "Organization-level admin and settings page for Create Child Work Items.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Create Child Work Items",
                "title": "Create Child Work Items",
                "uri": "admin.html",
                "icon": "img/create-child-work-items-icon-16x16.png",
                "group": "extensions",
                "order": 100,
                "supportsMobile": false
            }
        }
    ],
    "contributionTypes": []
}