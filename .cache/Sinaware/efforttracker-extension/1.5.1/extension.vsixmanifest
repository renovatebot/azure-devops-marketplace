<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="efforttracker-extension" Publisher="Sinaware" Version="1.5.1"/>
    <DisplayName>Effort Tracker</DisplayName>
    <Description xml:space="preserve">Track time and effort on Azure Boards work items: log it on the item, from any board or by the week, approve it, and see it in reports, budgets, sprints, dashboards and Power BI.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>time tracking,time log,effort tracking,work items,timesheets,timesheet,productivity,reports,report,report time,reporting,utilization record,project management,time,time logging,time management,time recording,time tracker,tracker,tracking,api,rest api,approvals,budget,sprint,dashboard,power bi</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://efforttracker.sinaware.com"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/Sinaware/EffortTracker/wiki/Getting-Started"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://github.com/Sinaware/EffortTracker/wiki"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/Sinaware/EffortTracker/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://efforttracker.sinaware.com/privacy.html"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://efforttracker.sinaware.com/terms.html"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/Sinaware/EffortTracker"/>
    </Properties>
    <Icon>images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
