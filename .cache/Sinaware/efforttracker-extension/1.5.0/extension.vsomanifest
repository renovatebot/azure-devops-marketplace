{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/Sinaware/EffortTracker"
    },
    "scopes": [
        "vso.work",
        "vso.work_write",
        "vso.project",
        "vso.graph"
    ],
    "contributions": [
        {
            "id": "efforttracker-workitem-tab",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Effort Tracker tab for work items",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Effort Tracker",
                "uri": "dist/index.html",
                "height": 500
            }
        },
        {
            "id": "efforttracker-workitem-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "description": "Quick Timer control. Not placed on any form until an administrator adds it under Process > Layout, so it costs nothing where it is not wanted.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Effort Tracker",
                "uri": "dist/timetracker-group.html",
                "height": 120
            }
        },
        {
            "id": "efforttracker-reports-hub",
            "type": "ms.vss-web.hub",
            "description": "Effort Tracker Reports Hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Effort Reports",
                "uri": "dist/reports.html",
                "iconName": "Chart",
                "supportsMobile": false,
                "order": 99
            }
        },
        {
            "id": "efforttracker-my-effort-records-hub",
            "type": "ms.vss-web.hub",
            "description": "Effort Tracker My Effort Records",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "My Effort Records",
                "uri": "dist/my-effort-records.html",
                "iconName": "Clock",
                "supportsMobile": false,
                "order": 98
            }
        },
        {
            "id": "efforttracker-sprint-tab",
            "type": "ms.vss-web.tab",
            "description": "Effort Tracker on the Sprints page: the open sprint's capacity, effort, pace and moved-out items",
            "targets": [
                "ms.vss-work-web.iteration-backlog-tabs"
            ],
            "properties": {
                "name": "Effort",
                "title": "Effort",
                "uri": "dist/sprint.html"
            }
        },
        {
            "id": "efforttracker-approvals-hub",
            "type": "ms.vss-web.hub",
            "description": "Effort Tracker Effort Approvals: approve or send back submitted weeks and months",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Effort Approvals",
                "uri": "dist/approvals.html",
                "iconName": "Completed",
                "supportsMobile": false,
                "order": 99
            }
        },
        {
            "id": "efforttracker-admin-hub",
            "type": "ms.vss-web.hub",
            "description": "Effort Tracker Admin Settings",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Effort Tracker Settings",
                "uri": "dist/admin.html",
                "iconName": "Clock",
                "supportsMobile": false,
                "order": 99
            }
        },
        {
            "id": "efforttracker-org-admin-hub",
            "type": "ms.vss-web.hub",
            "description": "Effort Tracker Organization Admin Settings",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Effort Tracker",
                "uri": "dist/org-admin.html",
                "iconName": "Clock",
                "supportsMobile": false,
                "order": 99
            }
        },
        {
            "id": "efforttracker-widget-hours",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".efforttracker-widget-hours-config"
            ],
            "properties": {
                "name": "Hours this sprint",
                "description": "Effort recorded by a team in its current sprint, or in another period.",
                "catalogIconUrl": "images/icon.png",
                "previewImageUrl": "images/icon.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "isNameConfigurable": true
            }
        },
        {
            "id": "efforttracker-widget-hours-config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Hours this sprint settings",
                "description": "Team, period and activity types for Hours this sprint.",
                "uri": "dist/widget-config.html"
            }
        },
        {
            "id": "efforttracker-widget-people",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".efforttracker-widget-people-config"
            ],
            "properties": {
                "name": "Time by person",
                "description": "Each person's effort over a period, largest first.",
                "catalogIconUrl": "images/icon.png",
                "previewImageUrl": "images/icon.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "isNameConfigurable": true
            }
        },
        {
            "id": "efforttracker-widget-people-config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Time by person settings",
                "description": "Team, period and activity types for Time by person.",
                "uri": "dist/widget-config.html"
            }
        },
        {
            "id": "efforttracker-widget-types",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".efforttracker-widget-types-config"
            ],
            "properties": {
                "name": "Time by activity type",
                "description": "Effort over a period by activity type, as a donut.",
                "catalogIconUrl": "images/icon.png",
                "previewImageUrl": "images/icon.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "isNameConfigurable": true
            }
        },
        {
            "id": "efforttracker-widget-types-config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Time by activity type settings",
                "description": "Team, period and activity types for Time by activity type.",
                "uri": "dist/widget-config.html"
            }
        },
        {
            "id": "efforttracker-widget-budget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".efforttracker-widget-budget-config"
            ],
            "properties": {
                "name": "Budget",
                "description": "One work item's effort, its children's included, against the Original Estimate under it.",
                "catalogIconUrl": "images/icon.png",
                "previewImageUrl": "images/icon.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "isNameConfigurable": true
            }
        },
        {
            "id": "efforttracker-widget-budget-config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Budget settings",
                "description": "The work item the Budget widget follows.",
                "uri": "dist/widget-config.html"
            }
        },
        {
            "id": "efforttracker-add-effort-action",
            "type": "ms.vss-web.action",
            "description": "Add effort to a work item from its menu on backlogs, boards, taskboards and queries",
            "targets": [
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "text": "Add effort",
                "title": "Add effort",
                "iconName": "Clock",
                "uri": "dist/add-effort-action.html",
                "registeredObjectId": "efforttracker-add-effort-action"
            }
        },
        {
            "id": "efforttracker-add-effort-dialog",
            "type": "ms.vss-web.external-content",
            "description": "The Add effort dialog opened from a work item menu",
            "properties": {
                "uri": "dist/add-effort.html"
            }
        }
    ],
    "contributionTypes": []
}