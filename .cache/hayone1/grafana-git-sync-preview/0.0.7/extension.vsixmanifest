<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="grafana-git-sync-preview" Version="0.0.7" Publisher="hayone1"/>
    <DisplayName>Grafana Git Sync PR Preview</DisplayName>
    <GalleryFlags/>
    <Description xml:space="preserve">Comment Grafana Git Sync 'view current' and 'preview changes' links on Azure Repos pull requests.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>grafana,git sync,dashboards,pull request,preview,observability</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/hayone1/azdo-grafana-git-sync-preview"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/hayone1/azdo-grafana-git-sync-preview/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/hayone1/azdo-grafana-git-sync-preview/blob/main/LICENSE"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/hayone1/azdo-grafana-git-sync-preview"/>
    </Properties>
    <Icon>images/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>