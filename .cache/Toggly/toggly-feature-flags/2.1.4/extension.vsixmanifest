<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="toggly-feature-flags" Version="2.1.4" Publisher="toggly"/>
    <DisplayName>Toggly Feature Flags</DisplayName>
    <Description xml:space="preserve">Feature flags and progressive delivery for Azure Pipelines — typed tasks, service connection, and a CLI escape hatch</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>feature flags,feature toggles,deployment,release management,progressive delivery,ci/cd,cli</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://docs.toggly.io/integrations/azure-devops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://docs.toggly.io"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://toggly.io/support"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/ops-ai/toggly-azure-devops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/ops-ai/toggly-azure-devops"/>
    </Properties>
    <Badges>
      <Badge Link="https://docs.toggly.io/integrations/azure-devops" ImgUri="https://img.shields.io/badge/docs-Azure%20DevOps-556EE6" Description="Toggly Azure DevOps docs"/>
      <Badge Link="https://toggly.io" ImgUri="https://img.shields.io/badge/Toggly-Feature%20Flags-blue" Description="Toggly Feature Flags"/>
    </Badges>
    <Icon>images/extension-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="images/extension-icon.png" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="images/publisher-logo.png" d:Source="File" Path="images/publisher-logo.png" Addressable="true"/>
    <Asset Type="images/screenshots/cli-escape-hatch.png" d:Source="File" Path="images/screenshots/cli-escape-hatch.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.2" d:Source="File" Path="images/screenshots/cli-escape-hatch.png" Addressable="true"/>
    <Asset Type="images/screenshots/typed-tasks.png" d:Source="File" Path="images/screenshots/typed-tasks.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="images/screenshots/typed-tasks.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>