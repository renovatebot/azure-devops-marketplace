{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/ops-ai/Toggly.FeatureManagement"
    },
    "badges": [
        {
            "href": "https://toggly.io",
            "uri": "https://img.shields.io/badge/Toggly-Feature%20Flags-blue",
            "description": "Toggly Feature Flags"
        }
    ],
    "contributions": [
        {
            "id": "toggly-service-endpoint",
            "type": "ms.vss-endpoint.service-endpoint-type",
            "targets": [
                "ms.vss-endpoint.endpoint-types"
            ],
            "properties": {
                "name": "toggly",
                "displayName": "Toggly Feature Flags",
                "icon": "images/extension-icon.png",
                "url": {
                    "displayName": "Toggly API URL",
                    "value": "https://app.toggly.io/api",
                    "helpText": "Base URL for the Toggly API. Default: https://app.toggly.io/api",
                    "isVisible": "true"
                },
                "authenticationSchemes": [
                    {
                        "type": "ms.vss-endpoint.endpoint-auth-scheme-none",
                        "inputDescriptors": [
                            {
                                "id": "clientId",
                                "name": "Client ID",
                                "description": "OAuth2 Client ID for Toggly authentication",
                                "inputMode": "textbox",
                                "isConfidential": false,
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "clientSecret",
                                "name": "Client Secret",
                                "description": "OAuth2 Client Secret for Toggly authentication",
                                "inputMode": "passwordbox",
                                "isConfidential": true,
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "authority",
                                "name": "Authority URL",
                                "description": "OAuth2 Authority URL. Default: https://auth.toggly.io",
                                "inputMode": "textbox",
                                "isConfidential": false,
                                "validation": {
                                    "isRequired": false,
                                    "dataType": "string"
                                },
                                "values": {
                                    "defaultValue": "https://auth.toggly.io"
                                }
                            }
                        ]
                    }
                ],
                "helpMarkDown": "Configure a connection to Toggly Feature Flags service. You'll need OAuth2 credentials (Client ID and Client Secret) from your Toggly account."
            }
        },
        {
            "id": "toggly-create-release-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/CreateReleaseTask"
            }
        },
        {
            "id": "toggly-associate-build-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/AssociateBuildTask"
            }
        },
        {
            "id": "toggly-create-feature-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/CreateFeatureTask"
            }
        },
        {
            "id": "toggly-update-feature-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/UpdateFeatureTask"
            }
        },
        {
            "id": "toggly-update-feature-env-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/UpdateFeatureEnvTask"
            }
        },
        {
            "id": "toggly-activate-release-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/ActivateReleaseTask"
            }
        },
        {
            "id": "toggly-rollback-release-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/RollbackReleaseTask"
            }
        },
        {
            "id": "toggly-cli-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/TogglyCLI"
            }
        }
    ],
    "scopes": [],
    "contributionTypes": []
}