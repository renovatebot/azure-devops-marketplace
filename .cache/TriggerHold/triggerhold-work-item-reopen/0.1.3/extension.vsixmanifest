<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="triggerhold-work-item-reopen" Publisher="TriggerHold" Version="0.1.3"/>
    <DisplayName>TriggerHold — Schedule Work Item Reopen</DisplayName>
    <Description xml:space="preserve">Schedule a closed work item to reopen automatically at a future date. TriggerHold PATCHes the Azure DevOps REST API directly at the scheduled time — no relay backend involved.</Description>
    <GalleryFlags/>
    <Categories>Azure Boards</Categories>
    <Tags>triggerhold,scheduling,automation,work items</Tags>
    <Icon>images/extension-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/panel/index.css" d:Source="File" Path="dist/panel/index.css" Addressable="true"/>
    <Asset Type="dist/panel/index.html" d:Source="File" Path="dist/panel/index.html" Addressable="true"/>
    <Asset Type="dist/panel/index.js" d:Source="File" Path="dist/panel/index.js" Addressable="true"/>
    <Asset Type="dist/settings/index.css" d:Source="File" Path="dist/settings/index.css" Addressable="true"/>
    <Asset Type="dist/settings/index.html" d:Source="File" Path="dist/settings/index.html" Addressable="true"/>
    <Asset Type="dist/settings/index.js" d:Source="File" Path="dist/settings/index.js" Addressable="true"/>
    <Asset Type="images/extension-icon.png" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>