{
    "manifestVersion": 1,
    "scopes": [
        "vso.project",
        "vso.work",
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "triggerhold-work-item-panel",
            "type": "ms.vss-work-web.work-item-form-group",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "TriggerHold",
                "uri": "dist/panel/index.html",
                "height": 260
            }
        },
        {
            "id": "triggerhold-settings-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "TriggerHold",
                "order": 100,
                "uri": "dist/settings/index.html"
            }
        }
    ],
    "contributionTypes": []
}