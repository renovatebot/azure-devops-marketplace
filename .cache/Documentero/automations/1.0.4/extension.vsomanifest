{
    "manifestVersion": 1,
    "demands": [
        "api-version/3.0"
    ],
    "scopes": [
        "vso.work",
        "vso.project",
        "vso.identity",
        "vso.wiki",
        "vso.build",
        "vso.release",
        "vso.hooks",
        "vso.graph",
        "vso.features_write",
        "vso.memberentitlementmanagement"
    ],
    "contributions": [
        {
            "id": "feature-show-left-nav",
            "type": "ms.vss-web.feature",
            "description": "Show Automations in left navigation",
            "properties": {
                "name": "Show Automations in left navigation",
                "defaultState": true,
                "userConfigurable": false,
                "hostConfigurable": true,
                "hostScopes": [
                    "project"
                ]
            }
        },
        {
            "id": "workflow-automation-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Automations",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Automations",
                "icon": {
                    "light": "dist/assets/img/logo-automation-160.png",
                    "dark": "dist/assets/img/logo-automation-160.png"
                },
                "order": 1
            },
            "constraints": [
                {
                    "name": "Feature",
                    "properties": {
                        "featureId": "Documentero.automations.feature-show-left-nav"
                    }
                }
            ]
        },
        {
            "id": "workflow-automation-settings",
            "type": "ms.vss-web.hub",
            "description": "Manage automations",
            "targets": [
                ".workflow-automation-hub-group"
            ],
            "properties": {
                "name": "Settings",
                "icon": {
                    "light": "dist/assets/img/logo-automation-160.png",
                    "dark": "dist/assets/img/logo-automation-160.png"
                },
                "uri": "dist/integration/settings/settings.html"
            }
        },
        {
            "id": "workflow-automation-organization",
            "type": "ms.vss-web.hub",
            "description": "Automations",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Automations",
                "icon": {
                    "light": "dist/assets/img/logo-automation-160.png",
                    "dark": "dist/assets/img/logo-automation-160.png"
                },
                "uri": "dist/integration/organization/organization.html"
            }
        },
        {
            "id": "workflow-automation-project-settings",
            "type": "ms.vss-web.hub",
            "description": "Automations - Settings",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Automations - Settings",
                "icon": {
                    "light": "dist/assets/img/logo-automation-160.png",
                    "dark": "dist/assets/img/logo-automation-160.png"
                },
                "uri": "dist/integration/project/project.html"
            }
        },
        {
            "id": "workflow-automation-project",
            "type": "ms.vss-web.hub",
            "description": "Automations - Settings",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Automations - Settings",
                "icon": {
                    "light": "dist/assets/img/logo-automation-160.png",
                    "dark": "dist/assets/img/logo-automation-160.png"
                },
                "uri": "dist/integration/settings/settings.html"
            },
            "constraints": [
                {
                    "name": "Feature",
                    "properties": {
                        "featureId": "Documentero.automations.feature-show-left-nav"
                    },
                    "inverse": true
                }
            ]
        }
    ],
    "contributionTypes": []
}