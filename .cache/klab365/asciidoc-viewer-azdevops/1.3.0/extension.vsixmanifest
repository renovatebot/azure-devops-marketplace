<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="asciidoc-viewer-azdevops" Publisher="klab365" Version="1.3.0"/>
    <DisplayName>AsciiDoc Viewer</DisplayName>
    <Description xml:space="preserve">Preview AsciiDoc (.adoc/.asciidoc) files directly in Azure Repos.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Repos</Categories>
    <Tags>asciidoc,preview,documentation,repos</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/klab365/asciidoc-viewer-azdevops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/klab365/asciidoc-viewer-azdevops/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/klab365/asciidoc-viewer-azdevops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/klab365/asciidoc-viewer-azdevops"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#be2703"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="light"/>
    </Properties>
    <Icon>images/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
