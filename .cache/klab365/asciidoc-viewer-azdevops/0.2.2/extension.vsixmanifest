<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="asciidoc-viewer-azdevops" Publisher="klab365" Version="0.2.2"/>
    <DisplayName>AsciiDoc Viewer</DisplayName>
    <Description xml:space="preserve">Preview AsciiDoc (.adoc/.asciidoc) files directly in Azure Repos, with local include:: resolution.</Description>
    <GalleryFlags/>
    <Categories>Azure Repos</Categories>
    <Tags>asciidoc,preview,documentation,repos</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/klab365/asciidoc-viewer-azdevops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/klab365/asciidoc-viewer-azdevops/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/klab365/asciidoc-viewer-azdevops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/klab365/asciidoc-viewer-azdevops"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#be2703"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="light"/>
    </Properties>
    <Icon>images/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/action.html" d:Source="File" Path="dist/action.html" Addressable="true"/>
    <Asset Type="dist/assets/SDK.min-CiQBL3iq.js" d:Source="File" Path="dist/assets/SDK.min-CiQBL3iq.js" Addressable="true"/>
    <Asset Type="dist/assets/__vite-browser-external-XrL-nBDI.js" d:Source="File" Path="dist/assets/__vite-browser-external-XrL-nBDI.js" Addressable="true"/>
    <Asset Type="dist/assets/action-UTzIvY7j.js" d:Source="File" Path="dist/assets/action-UTzIvY7j.js" Addressable="true"/>
    <Asset Type="dist/assets/index-CL_uwIZr.js" d:Source="File" Path="dist/assets/index-CL_uwIZr.js" Addressable="true"/>
    <Asset Type="dist/assets/renderer-Bxbsk9V6.js" d:Source="File" Path="dist/assets/renderer-Bxbsk9V6.js" Addressable="true"/>
    <Asset Type="dist/assets/renderer-Co1wyb9a.css" d:Source="File" Path="dist/assets/renderer-Co1wyb9a.css" Addressable="true"/>
    <Asset Type="dist/renderer.html" d:Source="File" Path="dist/renderer.html" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>