{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/klab365/asciidoc-viewer-azdevops"
    },
    "contributions": [
        {
            "id": "asciidoc-preview-action",
            "type": "ms.vss-web.action",
            "description": "Opens a preview dialog for .adoc/.asciidoc files in Azure Repos.",
            "targets": [
                "ms.vss-code-web.source-item-menu"
            ],
            "properties": {
                "text": "AsciiDoc Preview",
                "title": "Preview this AsciiDoc file",
                "icon": "images/icon.png",
                "group": "actions",
                "uri": "dist/action.html"
            }
        },
        {
            "id": "asciidoc-preview-dialog",
            "type": "ms.vss-web.control",
            "description": "Dialog content that renders the AsciiDoc preview.",
            "targets": [],
            "properties": {
                "uri": "dist/renderer.html"
            }
        }
    ],
    "scopes": [],
    "contributionTypes": []
}