{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/klab365/asciidoc-viewer-azdevops"
    },
    "scopes": [
        "vso.code"
    ],
    "contributions": [
        {
            "id": "asciidoc-viewer-hub",
            "type": "ms.vss-web.hub",
            "description": "Browse a repository and preview an AsciiDoc file.",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "AsciiDoc Viewer",
                "order": 100,
                "uri": "dist/hub.html",
                "icon": "images/icon.png"
            }
        }
    ],
    "contributionTypes": []
}