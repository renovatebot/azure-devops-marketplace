{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "work-item-form-observer",
            "type": "ms.vss-work-web.work-item-notifications",
            "description": "Recibe eventos al guardar el formulario del elemento de trabajo actual.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "uri": "dist/work-item-form-observer.html"
            }
        },
        {
            "id": "work-item-toolbar-menu",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.work-item-toolbar-menu"
            ],
            "properties": {
                "text": "Work Item Twins",
                "uri": "dist/work-item-toolbar-menu.html",
                "icon": {
                    "light": "static/WITwin2.png",
                    "dark": "static/WITwin2.png"
                },
                "registeredObjectId": "work-item-toolbar-menu"
            }
        },
        {
            "id": "panel-content",
            "type": "ms.vss-web.external-content",
            "properties": {
                "uri": "dist/work-item-sync-panel.html"
            }
        },
        {
            "id": "bulk-query-result-menu",
            "type": "ms.vss-web.action",
            "description": "Sincronización de gemelos en lote desde el menú contextual de los resultados de consulta",
            "targets": [
                "ms.vss-work-web.query-result-work-item-menu"
            ],
            "properties": {
                "text": "Sincronizar gemelos en lote",
                "title": "Crea o sincroniza gemelos de los elementos de trabajo seleccionados",
                "uri": "dist/bulk-sync-menu.html",
                "icon": {
                    "light": "static/WITwin2.png",
                    "dark": "static/WITwin2.png"
                },
                "registeredObjectId": "bulk-query-result-menu"
            }
        },
        {
            "id": "bulk-query-toolbar-menu",
            "type": "ms.vss-web.action",
            "description": "Botón de sincronización de gemelos en lote en la barra de herramientas de los resultados de consulta",
            "targets": [
                "ms.vss-work-web.work-item-query-results-toolbar-menu"
            ],
            "properties": {
                "text": "Sincronizar gemelos en lote",
                "title": "Crea o sincroniza gemelos de los elementos de trabajo de esta consulta",
                "toolbarText": "Sincronizar gemelos en lote",
                "uri": "dist/bulk-sync-menu.html",
                "icon": {
                    "light": "static/WITwin2.png",
                    "dark": "static/WITwin2.png"
                },
                "registeredObjectId": "bulk-query-toolbar-menu"
            }
        },
        {
            "id": "bulk-backlog-item-menu",
            "type": "ms.vss-web.action",
            "description": "Sincronización de gemelos en lote desde el menú contextual del backlog",
            "targets": [
                "ms.vss-work-web.backlog-item-menu"
            ],
            "properties": {
                "text": "Sincronizar gemelos en lote",
                "title": "Crea o sincroniza gemelos de los elementos del backlog seleccionados",
                "uri": "dist/bulk-sync-menu.html",
                "icon": {
                    "light": "static/WITwin2.png",
                    "dark": "static/WITwin2.png"
                },
                "registeredObjectId": "bulk-backlog-item-menu"
            }
        },
        {
            "id": "bulk-sync-panel",
            "type": "ms.vss-web.external-content",
            "properties": {
                "uri": "dist/bulk-sync-panel.html"
            }
        }
    ],
    "scopes": [
        "vso.work_write",
        "vso.project",
        "vso.identity"
    ],
    "licensing": {
        "overrides": [
            {
                "id": "work-item-form-observer",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "work-item-toolbar-menu",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "panel-content",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "bulk-query-result-menu",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "bulk-query-toolbar-menu",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "bulk-backlog-item-menu",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "bulk-sync-panel",
                "behavior": "AlwaysInclude"
            }
        ]
    }
}