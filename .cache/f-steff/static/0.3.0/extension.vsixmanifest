<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="static" Version="0.3.0" Publisher="f-steff"/>
    <DisplayName>Static</DisplayName>
    <Description xml:space="preserve">Bookmarkable links and a curated directory for your Azure DevOps project: pages, pipelines, pull requests and repos, always one click away.</Description>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0e7490"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/f-steff/ado-static#readme"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://github.com/f-steff/ado-static/tree/main/docs"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/f-steff/ado-static/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/f-steff/ado-static"/>
    </Properties>
    <Categories>Azure Repos,Azure Pipelines</Categories>
    <Tags>pages,links,reports,publish,pipeline,bookmarks,quick-access,navigation,transparency,html,dashboard,devops</Tags>
    <GalleryFlags>Public</GalleryFlags>
    <Icon>images/icon-128.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
