{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.project",
        "vso.analytics"
    ],
    "contributions": [
        {
            "id": "sprintlynx-dashboard-ui",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "loglynx.sprintlynx-dashboard-ui.agile-intelligence-config"
            ],
            "properties": {
                "name": "SprintLynx Agile Intelligence",
                "description": "Unified Agile Intelligence & Capacity Dashboard",
                "catalogIconUrl": "img/icon.png",
                "previewImageUrl": "img/preview.png",
                "uri": "index.html",
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 5,
                        "columnSpan": 5
                    },
                    {
                        "rowSpan": 6,
                        "columnSpan": 8
                    },
                    {
                        "rowSpan": 10,
                        "columnSpan": 10
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "configurationContributionId": "loglynx.sprintlynx-dashboard-ui.agile-intelligence-config"
            }
        },
        {
            "id": "agile-intelligence-config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Agile Intelligence Configuration",
                "description": "Configures the Lyzr keys and Project",
                "uri": "configuration.html"
            }
        }
    ],
    "contributionTypes": []
}