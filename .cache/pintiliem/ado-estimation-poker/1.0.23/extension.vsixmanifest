<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="ado-estimation-poker" Publisher="pintiliem" Version="1.0.23"/>
    <DisplayName>Estimation Poker</DisplayName>
    <Description xml:space="preserve">Simple Estimation Poker extension to estimate work items directly within the form.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Icon>img/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="index.html" d:Source="File" Path="index.html" Addressable="true"/>
    <Asset Type="index.css" d:Source="File" Path="index.css" Addressable="true"/>
    <Asset Type="index.js" d:Source="File" Path="index.js" Addressable="true"/>
    <Asset Type="state.js" d:Source="File" Path="state.js" Addressable="true"/>
    <Asset Type="debug.js" d:Source="File" Path="debug.js" Addressable="true"/>
    <Asset Type="helpers.js" d:Source="File" Path="helpers.js" Addressable="true"/>
    <Asset Type="ui.js" d:Source="File" Path="ui.js" Addressable="true"/>
    <Asset Type="settings.js" d:Source="File" Path="settings.js" Addressable="true"/>
    <Asset Type="votes.js" d:Source="File" Path="votes.js" Addressable="true"/>
    <Asset Type="polling.js" d:Source="File" Path="polling.js" Addressable="true"/>
    <Asset Type="VSS.SDK.min.js" d:Source="File" Path="VSS.SDK.min.js" Addressable="true"/>
    <Asset Type="img/logo.png" d:Source="File" Path="img/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/logo.png" Addressable="true"/>
    <Asset Type="img/voting-view.png" d:Source="File" Path="img/voting-view.png" Addressable="true"/>
    <Asset Type="img/revealed-view.png" d:Source="File" Path="img/revealed-view.png" Addressable="true"/>
    <Asset Type="README.md" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
