{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "risk-matrix-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "pintiliem.risk-matrix-widget.risk-matrix-widget-configuration"
            ],
            "properties": {
                "name": "Risk Matrix",
                "description": "Visualizes open Risk work items in a Likelihood x Impact matrix.",
                "catalogIconUrl": "static/images/icon.png",
                "uri": "dist/RiskMatrixWidget/RiskMatrixWidget.html",
                "supportsVersionedMode": true,
                "previewImageUrl": "static/images/preview.png",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "risk-matrix-widget-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Risk Matrix Configuration",
                "description": "Configures the Risk Matrix widget.",
                "uri": "dist/RiskMatrixConfiguration/RiskMatrixConfiguration.html"
            }
        }
    ],
    "contributionTypes": []
}