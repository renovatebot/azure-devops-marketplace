<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="risk-matrix-widget" Publisher="pintiliem" Version="1.0.53"/>
    <DisplayName>Risk Matrix Widget</DisplayName>
    <Description xml:space="preserve">Dashboard widget that visualizes open Risk work items as a Likelihood x Impact matrix with counts per cell.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Icon>static/images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/RiskMatrixWidget/RiskMatrixWidget.css" d:Source="File" Path="dist/RiskMatrixWidget/RiskMatrixWidget.css" Addressable="true"/>
    <Asset Type="dist/RiskMatrixWidget/RiskMatrixWidget.html" d:Source="File" Path="dist/RiskMatrixWidget/RiskMatrixWidget.html" Addressable="true"/>
    <Asset Type="dist/RiskMatrixWidget/RiskMatrixWidget.js" d:Source="File" Path="dist/RiskMatrixWidget/RiskMatrixWidget.js" Addressable="true"/>
    <Asset Type="dist/RiskMatrixConfiguration/RiskMatrixConfiguration.css" d:Source="File" Path="dist/RiskMatrixConfiguration/RiskMatrixConfiguration.css" Addressable="true"/>
    <Asset Type="dist/RiskMatrixConfiguration/RiskMatrixConfiguration.html" d:Source="File" Path="dist/RiskMatrixConfiguration/RiskMatrixConfiguration.html" Addressable="true"/>
    <Asset Type="dist/RiskMatrixConfiguration/RiskMatrixConfiguration.js" d:Source="File" Path="dist/RiskMatrixConfiguration/RiskMatrixConfiguration.js" Addressable="true"/>
    <Asset Type="static/images/config-screenshot.png" d:Source="File" Path="static/images/config-screenshot.png" Addressable="true"/>
    <Asset Type="static/images/icon.png" d:Source="File" Path="static/images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="static/images/icon.png" Addressable="true"/>
    <Asset Type="static/images/widget-icon-v2.png" d:Source="File" Path="static/images/widget-icon-v2.png" Addressable="true"/>
    <Asset Type="static/images/widget-preview-v2.png" d:Source="File" Path="static/images/widget-preview-v2.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>