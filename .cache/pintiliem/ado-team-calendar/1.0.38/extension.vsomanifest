{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/pintiliem/ado-team-calendar"
    },
    "scopes": [
        "vso.work",
        "vso.project"
    ],
    "demands": [
        "api-version/3.0"
    ],
    "contributions": [
        {
            "id": "team-calendar-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Team Calendar",
                "order": 30,
                "uri": "dist/hub.html",
                "icon": "images/calendar-icon.png"
            }
        }
    ],
    "contributionTypes": []
}