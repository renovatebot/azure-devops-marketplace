{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/jeremy-morren/install-dart"
    },
    "badges": [
        {
            "href": "https://github.com/jeremy-morren/install-dart",
            "uri": "https://img.shields.io/badge/GitHub-Repository-181717?logo=github",
            "description": "GitHub repository"
        },
        {
            "href": "https://github.com/jeremy-morren/install-dart/actions/workflows/build.yml",
            "uri": "https://img.shields.io/github/actions/workflow/status/jeremy-morren/install-dart/build.yml?label=Build",
            "description": "Build"
        },
        {
            "href": "https://github.com/jeremy-morren/install-dart/actions/workflows/publish.yml",
            "uri": "https://img.shields.io/github/actions/workflow/status/jeremy-morren/install-dart/publish.yml?label=Publish",
            "description": "Publish"
        }
    ],
    "contributions": [
        {
            "id": "install-dart-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/InstallDart"
            }
        }
    ],
    "scopes": [],
    "contributionTypes": []
