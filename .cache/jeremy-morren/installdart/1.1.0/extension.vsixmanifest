<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="installdart" Publisher="jeremy-morren" Version="1.1.0"/>
    <DisplayName>Install Dart SDK</DisplayName>
    <Description xml:space="preserve">Installs the Dart SDK on Windows, macOS, and Linux agents. A port of the dart-lang/setup-dart GitHub Action.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>dart,sdk,tool installer,pub</Tags>
    <GalleryFlags>Public</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://github.com/jeremy-morren/install-dart"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/jeremy-morren/install-dart"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/jeremy-morren/install-dart/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/jeremy-morren/install-dart"/>
    </Properties>
    <Badges>
      <Badge Link="https://github.com/jeremy-morren/install-dart" ImgUri="https://img.shields.io/badge/GitHub-Repository-181717?logo=github" Description="GitHub repository"/>
      <Badge Link="https://github.com/jeremy-morren/install-dart/actions/workflows/build.yml" ImgUri="https://img.shields.io/github/actions/workflow/status/jeremy-morren/install-dart/build.yml?label=Build" Description="Build"/>
      <Badge Link="https://github.com/jeremy-morren/install-dart/actions/workflows/publish.yml" ImgUri="https://img.shields.io/github/actions/workflow/status/jeremy-morren/install-dart/publish.yml?label=Publish" Description="Publish"/>
    </Badges>
    <License>LICENSE.txt</License>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="LICENSE.txt" d:Source="File" Path="LICENSE.txt" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE.txt" Addressable="true"/>
    <Asset Type="docs/Overview.md" d:Source="File" Path="docs/Overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="docs/Overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>