<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="authenticatedscripts" Publisher="jeremy-morren" Version="2.0.2"/>
    <DisplayName>Authenticated Scripts</DisplayName>
    <Description xml:space="preserve">Allows using Generic Azure DevOps service connections in pipelines.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>service-connection,authentication,pwsh,bash,powershell,batch</Tags>
    <GalleryFlags>Public</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://github.com/jeremy-morren/authenticated-scripts"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/jeremy-morren/authenticated-scripts"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/jeremy-morren/authenticated-scripts/issues"/>
    </Properties>
    <Badges>
      <Badge Link="https://github.com/jeremy-morren/authenticated-scripts/actions/workflows/publish.yml" ImgUri="https://img.shields.io/github/actions/workflow/status/jeremy-morren/authenticated-scripts/publish.yml?label=Release" Description="Release"/>
    </Badges>
    <License>LICENSE.txt</License>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="LICENSE.txt" d:Source="File" Path="LICENSE.txt" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE.txt" Addressable="true"/>
    <Asset Type="docs/Overview.md" d:Source="File" Path="docs/Overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="docs/Overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>