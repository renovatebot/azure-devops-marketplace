{
    "manifestVersion": 1,
    "scopes": [
        "vso.project",
        "vso.work",
        "vso.work_write",
        "vso.release",
        "vso.code_status",
        "vso.code",
        "vso.extension",
        "vso.extension.data",
        "vso.extension.data_write"
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/leansoftx/azure-devops-release-report"
    },
    "license": "LICENSE",
    "homepage": "https://marketplace.visualstudio.com/publishers/leansoftx",
    "contributions": [
        {
            "id": "release-version-export.menu-action",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.work-item-toolbar-menu",
                "ms.vss-work-web.backlog-item-menu",
                "ms.vss-work-web.backlog-board-card-item-menu",
                "ms.vss-work-web.query-result-work-item-menu"
            ],
            "properties": {
                "text": "发布版本导出",
                "title": "导出选中工作项的发布版本报告",
                "uri": "dist/menu-action.html",
                "registeredObjectId": "release-version-export.menu-action",
                "icon": {
                    "dark": "images/icon.png",
                    "light": "images/icon.png"
                }
            }
        },
        {
            "id": "release-version-export-dialog",
            "type": "ms.vss-web.external-content",
            "targets": [],
            "properties": {
                "uri": "dist/index.html",
                "title": "发布版本导出"
            }
        }
    ],
    "contributionTypes": []
}