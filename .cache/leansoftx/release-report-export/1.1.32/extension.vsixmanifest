<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="release-report-export" Publisher="leansoftx" Version="1.1.32"/>
    <DisplayName>Release Version Export</DisplayName>
    <Description xml:space="preserve">【Prview】一键导出 Azure DevOps 发布版本报告，自动关联工作项与提交，适用于 DevOps Server/Services。</Description>
    <GalleryFlags>Public Preview Paid</GalleryFlags>
    <Categories>Azure Boards,Azure Repos,Azure Pipelines</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="30"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#1890ff"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="light"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://leansoftx.com"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/leansoftX/ads-workitems-batch-copy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/leansoftX/ads-workitems-batch-copy/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://github.com/leansoftX/ads-workitems-batch-copy/blob/main/privacypolicy.md"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/leansoftx/azure-devops-release-report"/>
    </Properties>
    <Tags>Version Management,Version Export,Release Version Export,__BYOLENFORCED</Tags>
    <Icon>images/icon.png</Icon>
    <License>license-terms.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
