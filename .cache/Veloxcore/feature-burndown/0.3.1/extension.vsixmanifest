<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="feature-burndown" Publisher="veloxcore" Version="0.3.1"/>
    <DisplayName>Feature burndown</DisplayName>
    <Description xml:space="preserve">The feature burndown report as a Boards hub: estimated, spent and remaining hours, burndown with forecast, team and bugs for one Feature at a time, read live through the Azure DevOps SDK.</Description>
    <GalleryFlags>Public Preview</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>burndown,feature,hours,estimation,boards,reporting</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://www.veloxcore.com"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://www.veloxcore.com"/>
    </Properties>
    <Badges/>
    <Icon>img/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/dev.html" d:Source="File" Path="dist/dev.html" Addressable="true"/>
    <Asset Type="dist/dev.js" d:Source="File" Path="dist/dev.js" Addressable="true"/>
    <Asset Type="dist/dev.js.map" d:Source="File" Path="dist/dev.js.map" Addressable="true"/>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/hub.js" d:Source="File" Path="dist/hub.js" Addressable="true"/>
    <Asset Type="dist/hub.js.map" d:Source="File" Path="dist/hub.js.map" Addressable="true"/>
    <Asset Type="dist/page.css" d:Source="File" Path="dist/page.css" Addressable="true"/>
    <Asset Type="dist/page.js" d:Source="File" Path="dist/page.js" Addressable="true"/>
    <Asset Type="img/icon.png" d:Source="File" Path="img/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>