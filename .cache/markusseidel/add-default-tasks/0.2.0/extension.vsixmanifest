<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="add-default-tasks" Publisher="markusseidel" Version="0.2.0"/>
    <DisplayName>Add Default Tasks</DisplayName>
    <Description xml:space="preserve">Add your team's standard set of tasks to a user story in two clicks, right from the sprint taskboard. Tasks inherit Area and Iteration from the story.</Description>
    <GalleryFlags>Public Preview</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>Tasks,Taskboard,Sprint planning,User Story,Default tasks,Task template,Work items,Scrum,Agile</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0078d4"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/markusseidel/adddefaulttasks#readme"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/markusseidel/adddefaulttasks/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/markusseidel/adddefaulttasks"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/markusseidel/adddefaulttasks/blob/main/LICENSE"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/markusseidel/adddefaulttasks"/>
    </Properties>
    <Icon>static/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/action/action.html" d:Source="File" Path="dist/action/action.html" Addressable="true"/>
    <Asset Type="dist/action/action.js" d:Source="File" Path="dist/action/action.js" Addressable="true"/>
    <Asset Type="dist/dialog/dialog.css" d:Source="File" Path="dist/dialog/dialog.css" Addressable="true"/>
    <Asset Type="dist/dialog/dialog.html" d:Source="File" Path="dist/dialog/dialog.html" Addressable="true"/>
    <Asset Type="dist/dialog/dialog.js" d:Source="File" Path="dist/dialog/dialog.js" Addressable="true"/>
    <Asset Type="static/icon.png" d:Source="File" Path="static/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="static/icon.png" Addressable="true"/>
    <Asset Type="static/menu-icon.png" d:Source="File" Path="static/menu-icon.png" Addressable="true"/>
    <Asset Type="marketplace/images/dialog.png" d:Source="File" Path="marketplace/images/dialog.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="marketplace/images/dialog.png" Addressable="true"/>
    <Asset Type="marketplace/images/edit-list.png" d:Source="File" Path="marketplace/images/edit-list.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.2" d:Source="File" Path="marketplace/images/edit-list.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="marketplace/overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>