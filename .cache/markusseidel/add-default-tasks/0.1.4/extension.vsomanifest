{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "add-default-tasks-action",
            "type": "ms.vss-web.action",
            "description": "Context menu entry on work item cards (sprint taskboard, boards, backlogs, queries).",
            "targets": [
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "text": "Add Defaulttasks...",
                "title": "Add the default set of tasks to this work item",
                "icon": "static/menu-icon.png",
                "groupId": "actions",
                "uri": "dist/action/action.html",
                "registeredObjectId": "add-default-tasks-action"
            }
        },
        {
            "id": "add-default-tasks-dialog",
            "type": "ms.vss-web.external-content",
            "description": "Dialog for picking the default tasks to create.",
            "properties": {
                "uri": "dist/dialog/dialog.html"
            }
        }
    ],
    "contributionTypes": []
}