    <Asset Type="dist/action.js.map" d:Source="File" Path="dist/action.js.map" Addressable="true"/>
    <Asset Type="dist/dialog.html" d:Source="File" Path="dist/dialog.html" Addressable="true"/>
    <Asset Type="dist/dialog.js" d:Source="File" Path="dist/dialog.js" Addressable="true"/>
    <Asset Type="dist/dialog.js.map" d:Source="File" Path="dist/dialog.js.map" Addressable="true"/>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/hub.js" d:Source="File" Path="dist/hub.js" Addressable="true"/>
    <Asset Type="dist/hub.js.map" d:Source="File" Path="dist/hub.js.map" Addressable="true"/>
    <Asset Type="dist/styles.css" d:Source="File" Path="dist/styles.css" Addressable="true"/>
    <Asset Type="icon.png" d:Source="File" Path="icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="icon.png" Addressable="true"/>
    <Asset Type="overview.md" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>