{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_write",
        "vso.build"
    ],
    "contributions": [
        {
            "id": "schedules-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "Scheduled-PR",
                "uri": "dist/hub.html",
                "icon": "icon.png"
            }
        },
        {
            "id": "schedule-merge-action",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-code-web.pull-request-action-menu"
            ],
            "properties": {
                "text": "Schedule merge…",
                "title": "Schedule this pull request to merge later",
                "group": "actions",
                "uri": "dist/action.html",
                "registeredObjectId": "schedule-merge-menu"
            }
        },
        {
            "id": "schedule-dialog",
            "type": "ms.vss-web.control",
            "targets": [],
            "properties": {
                "uri": "dist/dialog.html"
            }
        }
    ],
    "contributionTypes": []
}