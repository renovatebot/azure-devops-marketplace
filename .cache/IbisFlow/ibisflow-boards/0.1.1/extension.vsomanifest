{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "ibisflow-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "IbisFlow",
                "uri": "hub.html"
            }
        },
        {
            "id": "ibisflow-work-item-page",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "IbisFlow",
                "uri": "workitem.html"
            }
        }
    ],
    "scopes": [
        "vso.work"
    ],
    "contributionTypes": []
}