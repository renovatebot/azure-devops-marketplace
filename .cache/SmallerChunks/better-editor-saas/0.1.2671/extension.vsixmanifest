  <Metadata>
    <Identity Language="en-US" Id="better-editor-saas" Publisher="SmallerChunks" Version="0.1.2671"/>
    <DisplayName>Better Editor</DisplayName>
    <Description xml:space="preserve">Edit Azure DevOps work-item fields such as Description and Acceptance Criteria with rich-text formatting, tables, and Markdown preview.</Description>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#003e73"/>
