      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://www.smallerchunks.com/license-terms.txt"/>
    </Properties>
    <Categories>Azure Boards</Categories>
    <Tags>editor,markdown,rich text,tables,html,wysiwyg,text editor,rich text editor,markdown editor,html editor,work items,work item editor,work item form,work item fields,azure devops,azure boards,description,acceptance criteria,formatting,text color,highlighting,headings,lists,numbered lists,links,images,code blocks,text alignment,productivity,__BYOLENFORCED</Tags>
    <Icon>images/icon-marketplace.png</Icon>
