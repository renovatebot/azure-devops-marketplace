{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "better-editor-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Better Editor",
                "uri": "dist/index.html",
                "height": 480,
                "inputs": [
                    {
                        "id": "FieldName",
                        "name": "Rich-text field",
                        "description": "Choose the rich-text field Better Editor will edit. To use a new field, create it with New field in the process layout first.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "HTML"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    }
                ]
            }
        },
        {
            "id": "better-editor-full-page",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Better Editor",
                "order": 99,
                "uri": "dist/index.html?view=fullPage",
                "icon": "images/hub-icon.png"
            }
        },
        {
            "id": "better-editor-org-setup",
            "type": "ms.vss-web.hub",
            "description": "Setup and usage instructions for process administrators.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "How to use",
                "order": 10,
                "uri": "dist/setup.html",
                "icon": "images/hub-icon.png"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "better-editor-control",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "better-editor-full-page",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "better-editor-org-setup",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}