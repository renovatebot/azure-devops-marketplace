<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="better-editor-saas-testing" Publisher="SmallerChunks" Version="0.1.2881"/>
    <DisplayName>PLACE HOLDER</DisplayName>
    <Description xml:space="preserve">Placeholder for a future app.</Description>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Tags>__BYOLENFORCED,__DoNotDownload</Tags>
    <Categories>Azure Boards</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://www.smallerchunks.com/privacy-policy.html"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://support.smallerchunks.com/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://www.smallerchunks.com/license-terms.txt"/>
    </Properties>
    <Icon>sc-icon.png</Icon>
    <License>license-terms.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="sc-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="license-terms.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Privacypolicy" d:Source="File" Path="privacy-policy.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Pricing" d:Source="File" Path="pricing.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>