{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.extension.data_write",
        "vso.project",
        "vso.memberentitlementmanagement"
    ],
    "contributions": [
        {
            "id": "suite-map",
            "type": "SmallerChunks.whole-chunk-saas-testing.suite-tool",
            "targets": [
                "SmallerChunks.whole-chunk-saas-testing.chunk-suite-page"
            ],
            "properties": {
                "name": "Map",
                "order": 20,
                "protocol": 1
            }
        },
        {
            "id": "suite-data",
            "type": "ms.vss-web.control",
            "targets": [],
            "properties": {
                "uri": "dist/suite-data.html",
                "registeredObjectId": "suite-data"
            }
        },
        {
            "id": "dashboard-metric",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "SmallerChunks.work-item-mapping-saas-testing.dashboard-metric-configuration"
            ],
            "properties": {
                "name": "Map metrics (Testing)",
                "description": "Configurable Map counts and progress. Add multiple cards to show different metrics.",
                "uri": "dist/dashboard.html",
                "catalogIconUrl": "dist/assets/chunk-map_icon.png",
                "previewImageUrl": "images/dashboard-preview.png",
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "isNameConfigurable": true
            }
        },
        {
            "id": "dashboard-metric-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Map metric settings",
                "description": "Choose a metric and saved-item scope.",
                "uri": "dist/dashboard-configuration.html"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "suite-map",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "suite-data",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "dashboard-metric",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "dashboard-metric-configuration",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}