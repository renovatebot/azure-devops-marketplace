<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="better-editor" Publisher="SmallerChunks" Version="0.1.6"/>
    <DisplayName>Better Editor</DisplayName>
    <Description xml:space="preserve">Free Markdown and rich HTML editing for Azure DevOps work-item fields. Colors, highlights, tables, and Lucide controls from Smaller Chunks.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#003e73"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://www.smallerchunks.com"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://www.smallerchunks.com"/>
    </Properties>
    <Categories>Azure Boards</Categories>
    <Tags>free,editor,markdown,rich text,tables,html,wysiwyg,text editor,rich text editor,markdown editor,html editor,work items,work item editor,work item form,work item fields,azure devops,azure boards,description,acceptance criteria,formatting,text color,highlighting,headings,lists,numbered lists,links,images,code blocks,text alignment,productivity</Tags>
    <Icon>images/icon-marketplace.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
    <Asset Type="dist/THIRD-PARTY-NOTICES.txt" d:Source="File" Path="dist/THIRD-PARTY-NOTICES.txt" Addressable="true"/>
    <Asset Type="dist/assets/index-0mG15IWj.css" d:Source="File" Path="dist/assets/index-0mG15IWj.css" Addressable="true"/>
    <Asset Type="dist/assets/index-7pQ190uo.js" d:Source="File" Path="dist/assets/index-7pQ190uo.js" Addressable="true"/>
    <Asset Type="dist/index.html" d:Source="File" Path="dist/index.html" Addressable="true"/>
    <Asset Type="images/editor-preview.png" d:Source="File" Path="images/editor-preview.png" Addressable="true"/>
    <Asset Type="images/icon-marketplace.png" d:Source="File" Path="images/icon-marketplace.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon-marketplace.png" Addressable="true"/>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>