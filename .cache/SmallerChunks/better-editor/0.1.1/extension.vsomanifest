{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "better-editor-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Better Editor",
                "uri": "dist/index.html",
                "height": 700
            },
            "inputs": [
                {
                    "id": "FieldName",
                    "name": "Rich-text field",
                    "description": "The existing HTML field to edit, such as System.Description.",
                    "type": "WorkItemField",
                    "properties": {
                        "workItemFieldTypes": [
                            "HTML"
                        ]
                    },
                    "validation": {
                        "dataType": "String",
                        "isRequired": true
                    }
                }
            ]
        }
    ],
    "contributionTypes": []
}