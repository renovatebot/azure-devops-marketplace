{
    "manifestVersion": 1,
    "scopes": [
        "vso.build",
        "vso.build_execute",
        "vso.code",
        "vso.work",
        "vso.analytics"
    ],
    "contributions": [
        {
            "id": "pipeline-pulse",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "SmallerChunks.chunk-dashboards-saas-testing.pipeline-pulse-configuration"
            ],
            "properties": {
                "name": "Chunk Dashboards (Testing) - Pipeline health",
                "description": "Smaller Chunks pipeline duration and run health.",
                "uri": "dist/pipeline-widget.html",
                "catalogIconUrl": "images/icon-marketplace.png",
                "previewImageUrl": "images/pipeline-pulse-preview.png",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "pipeline-pulse-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Pipeline pulse configuration",
                "description": "Choose a pipeline, metric, and time range.",
                "uri": "dist/pipeline-configuration.html"
            }
        },
        {
            "id": "work-item-chart",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "SmallerChunks.chunk-dashboards-saas-testing.work-item-chart-configuration"
            ],
            "properties": {
                "name": "Chunk Dashboards - Work item chart",
                "description": "One WIQL-driven Chart.js chart per dashboard frame, with snapshot grouping or daily Analytics trends.",
                "uri": "dist/work-item-chart.html",
                "catalogIconUrl": "images/icon-marketplace.png",
                "previewImageUrl": "images/work-item-chart-preview.png",
                "isNameConfigurable": false,
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "work-item-chart-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Work item chart settings",
                "description": "Configure WIQL filters, grouping, stacking and chart type.",
                "uri": "dist/work-item-chart-configuration.html"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "pipeline-pulse",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "pipeline-pulse-configuration",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "work-item-chart",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "work-item-chart-configuration",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}