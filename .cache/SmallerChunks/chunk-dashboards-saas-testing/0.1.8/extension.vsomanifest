{
    "manifestVersion": 1,
    "scopes": [
        "vso.build"
    ],
    "contributions": [
        {
            "id": "pipeline-pulse",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "SmallerChunks.chunk-dashboards-saas-testing.pipeline-pulse-configuration"
            ],
            "properties": {
                "name": "Chunk Dashboards (Testing) - Pipeline health",
                "description": "Smaller Chunks pipeline duration and run health.",
                "uri": "dist/pipeline-widget.html",
                "catalogIconUrl": "images/icon-marketplace.png",
                "previewImageUrl": "images/pipeline-pulse-preview.png",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "pipeline-pulse-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Pipeline pulse configuration",
                "description": "Choose a pipeline, metric, and time range.",
                "uri": "dist/pipeline-configuration.html"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "pipeline-pulse",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "pipeline-pulse-configuration",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}