{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "chunk-filter-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Chunk Filter (Testing)",
                "uri": "dist/index.html",
                "iconName": "Filter",
                "order": 24
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "chunk-filter-hub",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}