<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="better-editor-free" Publisher="SmallerChunks" Version="0.1.21"/>
    <DisplayName>Better Editor (Free)</DisplayName>
    <Description xml:space="preserve">Make Azure Boards descriptions and acceptance criteria easier to read with headings, tables, lists, links, code, and rich-text formatting.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#003e73"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://www.smallerchunks.com/extensions/better-editor-free"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://www.smallerchunks.com/better-editor.html"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://www.smallerchunks.com/privacy-policy.html"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://support.smallerchunks.com/"/>
    </Properties>
    <Categories>Azure Boards</Categories>
    <Tags>free,editor,rich text,tables,headings,html,wysiwyg,work items,work item fields,azure devops,azure boards,description,acceptance criteria</Tags>
    <Icon>images/icon-marketplace.png</Icon>
    <License>license-terms.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
