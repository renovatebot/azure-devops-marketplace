{
    "manifestVersion": 1,
    "scopes": [
        "vso.extension_manage",
        "vso.work_write",
        "vso.extension.data_write",
        "vso.project",
        "vso.build"
    ],
    "contributions": [
        {
            "id": "whole-chunk-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Chunk Suite (Testing)",
                "order": 99,
                "uri": "dist/whole-chunk.html",
                "iconAsset": "SmallerChunks.whole-chunk-saas-testing/images/icon.png",
                "icon": {
                    "light": "images/icon.png",
                    "dark": "images/icon.png"
                },
                "includesData": {
                    "assets": [
                        "SmallerChunks.whole-chunk-saas-testing/images/icon.png"
                    ]
                }
            }
        },
        {
            "id": "chunk-suite-page",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Smaller Chunks",
                "uri": "dist/chunk-suite.html"
            }
        },
        {
            "id": "pipeline-pulse",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "SmallerChunks.whole-chunk-saas-testing.pipeline-pulse-configuration"
            ],
            "properties": {
                "name": "Pipeline pulse (Testing)",
                "description": "Smaller Chunks pipeline duration and run health.",
                "uri": "dist/pipeline-widget.html",
                "catalogIconUrl": "images/icon.png",
                "previewImageUrl": "images/pipeline-pulse-preview.png",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "pipeline-pulse-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Pipeline pulse configuration",
                "description": "Choose a pipeline, metric, and time range.",
                "uri": "dist/pipeline-configuration.html"
            }
        }
    ],
    "contributionTypes": [
        {
            "id": "suite-tool",
            "name": "Smaller Chunks tool",
            "description": "Registers an installed tool with the Smaller Chunks work-item workspace.",
            "properties": {
                "name": {
                    "type": "string",
                    "required": true
                },
                "order": {
                    "type": "integer",
                    "required": true
                },
                "protocol": {
                    "type": "integer",
                    "required": true
                }
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "whole-chunk-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "chunk-suite-page",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "pipeline-pulse",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "pipeline-pulse-configuration",
                "behavior": "AlwaysInclude"
            }
        ]
    }
}