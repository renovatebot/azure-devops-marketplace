{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.extension.data_write",
        "vso.identity"
    ],
    "contributions": [
        {
            "id": "suite-obeya",
            "type": "SmallerChunks.whole-chunk-saas-testing.suite-tool",
            "targets": [
                "SmallerChunks.whole-chunk-saas-testing.chunk-suite-page"
            ],
            "properties": {
                "name": "Obeya",
                "order": 40,
                "protocol": 1
            }
        },
        {
            "id": "suite-data",
            "type": "ms.vss-web.control",
            "targets": [],
            "properties": {
                "uri": "dist/suite-data.html",
                "registeredObjectId": "suite-data"
            }
        },
        {
            "id": "dashboard-metric",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "SmallerChunks.chunk-obeya-saas-testing.dashboard-metric-configuration"
            ],
            "properties": {
                "name": "Assist metrics (Testing)",
                "description": "Configurable Assist counts and progress. Add multiple cards to show different metrics.",
                "uri": "dist/dashboard.html",
                "catalogIconUrl": "dist/assets/chunk-obeya_icon.png",
                "previewImageUrl": "images/dashboard-preview.png",
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "isNameConfigurable": true
            }
        },
        {
            "id": "dashboard-metric-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Assist metric settings",
                "description": "Choose a metric and saved-item scope.",
                "uri": "dist/dashboard-configuration.html"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "suite-obeya",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "suite-data",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "dashboard-metric",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "dashboard-metric-configuration",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}