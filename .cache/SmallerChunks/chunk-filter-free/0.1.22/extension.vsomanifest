{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.work_write",
        "vso.graph"
    ],
    "contributions": [
        {
            "id": "chunk-filter-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Filter (Free)",
                "uri": "dist/index.html",
                "icon": "images/hub-icon.png",
                "order": 24
            }
        },
        {
            "id": "chunk-filter-org-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Filter (Free)",
                "uri": "dist/index.html",
                "icon": "images/hub-icon.png",
                "order": 102
            }
        },
        {
            "id": "seat-management",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Filter (Free) Seats",
                "uri": "dist/seat-management.html",
                "icon": "images/hub-icon.png",
                "order": 110,
                "supportsMobile": true
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "seat-management",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}