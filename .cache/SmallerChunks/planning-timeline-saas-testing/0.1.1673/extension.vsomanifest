{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.extension.data_write"
    ],
    "contributions": [
        {
            "id": "planning-full-page",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Chunk Plan (Testing)",
                "order": 99,
                "iconName": "Timeline",
                "uri": "dist/planning-full.html"
            }
        },
        {
            "id": "suite-plan",
            "type": "SmallerChunks.whole-chunk-saas-testing.suite-tool",
            "targets": [
                "SmallerChunks.whole-chunk-saas-testing.chunk-suite-page"
            ],
            "properties": {
                "name": "Plan",
                "order": 10,
                "protocol": 1
            }
        },
        {
            "id": "suite-data",
            "type": "ms.vss-web.control",
            "targets": [],
            "properties": {
                "uri": "dist/suite-data.html",
                "registeredObjectId": "suite-data"
            }
        },
        {
            "id": "dashboard-metric",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "SmallerChunks.planning-timeline-saas-testing.dashboard-metric-configuration"
            ],
            "properties": {
                "name": "Chunk Plan metrics (Testing)",
                "description": "Configurable Chunk Plan counts and progress. Add multiple cards to show different metrics.",
                "uri": "dist/dashboard.html",
                "catalogIconUrl": "images/icon.png",
                "previewImageUrl": "images/dashboard-preview.png",
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "isNameConfigurable": true
            }
        },
        {
            "id": "dashboard-metric-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Chunk Plan metric settings",
                "description": "Choose a metric and saved-item scope.",
                "uri": "dist/dashboard-configuration.html"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "planning-full-page",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "suite-plan",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "suite-data",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "dashboard-metric",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "dashboard-metric-configuration",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}