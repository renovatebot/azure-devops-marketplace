{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.extension.data_write",
        "vso.memberentitlementmanagement"
    ],
    "contributions": [
        {
            "id": "chunk-size-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Estimate (Testing)",
                "uri": "dist/index.html",
                "icon": "images/hub-icon.png",
                "order": 22
            }
        },
        {
            "id": "chunk-size-org-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Estimate (Testing)",
                "uri": "dist/index.html",
                "icon": "images/hub-icon.png",
                "order": 100
            }
        },
        {
            "id": "suite-size",
            "type": "SmallerChunks.whole-chunk-saas-testing.suite-tool",
            "targets": [
                "SmallerChunks.whole-chunk-saas-testing.chunk-suite-page"
            ],
            "properties": {
                "name": "Estimate",
                "order": 50,
                "protocol": 1
            }
        },
        {
            "id": "suite-data",
            "type": "ms.vss-web.control",
            "targets": [],
            "properties": {
                "uri": "dist/suite-data.html",
                "registeredObjectId": "suite-data"
            }
        },
        {
            "id": "dashboard-metric",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "SmallerChunks.chunk-size-saas-testing.dashboard-metric-configuration"
            ],
            "properties": {
                "name": "Estimate metrics (Testing)",
                "description": "Configurable Estimate counts and progress. Add multiple cards to show different metrics.",
                "uri": "dist/dashboard.html",
                "catalogIconUrl": "images/icon.png",
                "previewImageUrl": "images/dashboard-preview.png",
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "isNameConfigurable": true
            }
        },
        {
            "id": "dashboard-metric-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Estimate metric settings",
                "description": "Choose a metric and saved-item scope.",
                "uri": "dist/dashboard-configuration.html"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "chunk-size-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "chunk-size-org-settings",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "suite-size",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "suite-data",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "dashboard-metric",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "dashboard-metric-configuration",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}