{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "prodpass-service-endpoint",
            "description": "Connection to a ProdPass Deployment tools integration",
            "type": "ms.vss-endpoint.service-endpoint-type",
            "targets": [
                "ms.vss-endpoint.endpoint-types"
            ],
            "properties": {
                "name": "prodpass",
                "displayName": "ProdPass",
                "iconUrl": "images/icon.png",
                "url": {
                    "displayName": "ProdPass URL",
                    "helpText": "The URL from ProdPass > Integrations > Deployment tools, e.g. https://<your-prodpass>/hooks/integrations/<id>"
                },
                "authenticationSchemes": [
                    {
                        "type": "ms.vss-endpoint.endpoint-auth-scheme-token",
                        "inputDescriptors": [
                            {
                                "id": "apitoken",
                                "name": "Token",
                                "description": "The ProdPass token (ermi_...), without the word Bearer.",
                                "inputMode": "passwordbox",
                                "isConfidential": true,
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "string"
                                }
                            }
                        ]
                    }
                ],
                "helpMarkDown": "In ProdPass, open Integrations > Deployment tools, add a connection, and copy its URL and token."
            }
        },
        {
            "id": "prodpass-deployment-task",
            "description": "Record a deployment in ProdPass",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "ProdPassDeployment"
            }
        }
    ],
    "scopes": [],
    "contributionTypes": []
}