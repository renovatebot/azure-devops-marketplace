<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="team-productivity-intelligence" Publisher="CatchUpAI" Version="4.29.151"/>
    <DisplayName>Azure DevOps Insights</DisplayName>
    <Description xml:space="preserve">Ask questions about your sprints in plain English. Get sprint health, delivery risk, blockers and flow metrics inside Azure DevOps. No setup, no Power BI.</Description>
    <Categories>Azure Boards,Azure Repos</Categories>
    <Tags>sprint report,sprint health,delivery dashboard,PMO,engineering manager,cycle time,flow metrics,WIP,blockers,reporting,analytics,AI,ask anything,executive report</Tags>
    <GalleryFlags>Public</GalleryFlags>
    <Icon>img/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub/hub.html" d:Source="File" Path="dist/hub/hub.html" Addressable="true"/>
    <Asset Type="dist/hub/hub.js" d:Source="File" Path="dist/hub/hub.js" Addressable="true"/>
    <Asset Type="dist/hub/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="img/ask-about-this-page.gif" d:Source="File" Path="img/ask-about-this-page.gif" Addressable="true"/>
    <Asset Type="img/ask-question-library.png" d:Source="File" Path="img/ask-question-library.png" Addressable="true"/>
    <Asset Type="img/azure-devops-insights-hero.png" d:Source="File" Path="img/azure-devops-insights-hero.png" Addressable="true"/>
    <Asset Type="img/azure-devops-insights-sprint-health.png" d:Source="File" Path="img/azure-devops-insights-sprint-health.png" Addressable="true"/>
    <Asset Type="img/engineering-manager-dashboard.png" d:Source="File" Path="img/engineering-manager-dashboard.png" Addressable="true"/>
    <Asset Type="img/hero-ask-anything.gif" d:Source="File" Path="img/hero-ask-anything.gif" Addressable="true"/>
    <Asset Type="img/logo.png" d:Source="File" Path="img/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/logo.png" Addressable="true"/>
    <Asset Type="img/pmo-dashboard.png" d:Source="File" Path="img/pmo-dashboard.png" Addressable="true"/>
    <Asset Type="img/step-filters.png" d:Source="File" Path="img/step-filters.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>