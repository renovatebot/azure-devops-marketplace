{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "waypoint-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Waypoint",
                "uri": "dist/hub.html",
                "icon": "images/icons/waypoint-hub-32.png"
            }
        },
        {
            "id": "waypoint-settings-panel",
            "type": "ms.vss-web.external-content",
            "properties": {
                "uri": "dist/settings.html"
            }
        }
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/andersmoldin/Waypoint"
    },
    "contributionTypes": []
}