<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Version="2026.11.3" Publisher="andersmoldin" Id="waypoint-board"/>
    <Categories>Azure Boards</Categories>
    <DisplayName>Waypoint</DisplayName>
    <Description xml:space="preserve">A read-only lifecycle board for Azure Boards. See which phase every work item is in, which group it belongs to and whether it is waiting for something.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Tags>lifecycle,board,phases,read-only,portfolio</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#2b1d6e"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/andersmoldin/Waypoint/blob/main/LICENSE"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://github.com/andersmoldin/Waypoint/blob/main/PRIVACY.md"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/andersmoldin/Waypoint/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/andersmoldin/Waypoint"/>
    </Properties>
    <Icon>images/icons/waypoint-light-128.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/hub.js" d:Source="File" Path="dist/hub.js" Addressable="true"/>
    <Asset Type="dist/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/settings.html" d:Source="File" Path="dist/settings.html" Addressable="true"/>
    <Asset Type="dist/settings.js" d:Source="File" Path="dist/settings.js" Addressable="true"/>
    <Asset Type="dist/settings.js.LICENSE.txt" d:Source="File" Path="dist/settings.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="images/icons/waypoint-dark-128.png" d:Source="File" Path="images/icons/waypoint-dark-128.png" Addressable="true"/>
    <Asset Type="images/icons/waypoint-dark-256.png" d:Source="File" Path="images/icons/waypoint-dark-256.png" Addressable="true"/>
    <Asset Type="images/icons/waypoint-hub-32.png" d:Source="File" Path="images/icons/waypoint-hub-32.png" Addressable="true"/>
    <Asset Type="images/icons/waypoint-light-128.png" d:Source="File" Path="images/icons/waypoint-light-128.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icons/waypoint-light-128.png" Addressable="true"/>
    <Asset Type="images/icons/waypoint-light-256.png" d:Source="File" Path="images/icons/waypoint-light-256.png" Addressable="true"/>
    <Asset Type="images/screenshots/board.png" d:Source="File" Path="images/screenshots/board.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="images/screenshots/board.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>