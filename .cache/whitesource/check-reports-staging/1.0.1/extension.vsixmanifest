<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="check-reports-staging" Publisher="whitesource" Version="1.0.1"/>
    <DisplayName>Check Reports (Staging)</DisplayName>
    <Description xml:space="preserve">Internal pre-release build of an Azure Repos check-run report viewer, used for testing. Not intended for general use.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Repos</Categories>
    <Icon>images/staging-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
    <Asset Type="dist/build-info.json" d:Source="File" Path="dist/build-info.json" Addressable="true"/>
    <Asset Type="dist/check-run-hub.html" d:Source="File" Path="dist/check-run-hub.html" Addressable="true"/>
    <Asset Type="dist/check-run-hub.js" d:Source="File" Path="dist/check-run-hub.js" Addressable="true"/>
    <Asset Type="dist/check-run-hub.js.LICENSE.txt" d:Source="File" Path="dist/check-run-hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/staging-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview-staging.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>