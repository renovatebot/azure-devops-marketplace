<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="picket" Version="0.1.7" Publisher="willibrandon"/>
    <DisplayName>Picket</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">Local-first secrets scanning for Azure Pipelines.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>DevSecOps,secret scanning,security</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0c0e10"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://willibrandon.github.io/picket/generated/azure-devops/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://willibrandon.github.io/picket/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/willibrandon/picket/blob/main/LICENSE"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://github.com/willibrandon/picket/blob/main/azure-devops/PRIVACY.md"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/willibrandon/picket/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/willibrandon/picket"/>
    </Properties>
    <License>LICENSE</License>
    <Icon>images/extension-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="README.md" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="LICENSE" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="CHANGELOG.md" d:Source="File" Path="CHANGELOG.md" Addressable="true"/>
    <Asset Type="COMPATIBILITY.md" d:Source="File" Path="COMPATIBILITY.md" Addressable="true"/>
    <Asset Type="PRIVACY.md" d:Source="File" Path="PRIVACY.md" Addressable="true"/>
    <Asset Type="images/extension-icon.png" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>