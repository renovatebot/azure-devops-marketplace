{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/geeklearningio/gl-vsts-tasks-yarn"
    },
    "contributions": [
        {
            "description": "[DEPRECATED - unmaintained] Executes Yarn 1.x (Classic)",
            "id": "yarn-task",
            "properties": {
                "name": "Tasks/Yarn"
            },
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "type": "ms.vss-distributed-task.task"
        },
        {
            "description": "[DEPRECATED - unmaintained] Installs a version of Yarn 1.x (Classic)",
            "id": "yarn-installer-task",
            "properties": {
                "name": "Tasks/YarnInstaller"
            },
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "type": "ms.vss-distributed-task.task"
        }
    ],
    "scopes": [],
    "contributionTypes": []
}