<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="ai-qa-trigger" Version="1.0.4" Publisher="KMSMobilitySolutions"/>
    <GalleryFlags>Public</GalleryFlags>
    <DisplayName>AI QA Test Trigger</DisplayName>
    <Description xml:space="preserve">Adds a 'Run QA Test' button to work items that queues the AI QA pipeline for the ticket.</Description>
    <Categories>Azure Boards</Categories>
    <Icon>icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="qa-trigger.html" d:Source="File" Path="qa-trigger.html" Addressable="true"/>
    <Asset Type="sdk.min.js" d:Source="File" Path="sdk.min.js" Addressable="true"/>
    <Asset Type="static/play.png" d:Source="File" Path="static/play.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>