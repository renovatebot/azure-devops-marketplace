<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="devops-awareness" Version="2.5.0" Publisher="KMSMobilitySolutions"/>
    <GalleryFlags>Public</GalleryFlags>
    <DisplayName>DevOps Awareness</DisplayName>
    <Description xml:space="preserve">Personal awareness dashboard: what needs your attention across PRs, tickets, and pipelines.</Description>
    <Categories>Azure Boards</Categories>
    <Icon>icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="awareness.html" d:Source="File" Path="awareness.html" Addressable="true"/>
    <Asset Type="sdk.min.js" d:Source="File" Path="sdk.min.js" Addressable="true"/>
    <Asset Type="icon.png" d:Source="File" Path="icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>