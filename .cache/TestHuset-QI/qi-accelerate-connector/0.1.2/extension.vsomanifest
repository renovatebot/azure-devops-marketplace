{
    "manifestVersion": 1,
    "preview": false,
    "demands": [
        "environment/cloud"
    ],
    "scopes": [
        "vso.project",
        "vso.work_write",
        "vso.test",
        "vso.wiki",
        "vso.code",
        "vso.graph"
    ],
    "contributions": [
        {
            "id": "work-item-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "QI Accelerate sync",
                "uri": "dist/index.html",
                "order": 100
            }
        },
        {
            "id": "organization-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "QI Accelerate",
                "uri": "dist/index.html",
                "order": 100
            }
        },
        {
            "id": "knowledge-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "QI Accelerate knowledge",
                "uri": "dist/index.html",
                "order": 100
            }
        },
        {
            "id": "conflict-review-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "QI Accelerate conflicts",
                "uri": "dist/index.html",
                "order": 101
            }
        }
    ],
    "contributionTypes": []
}