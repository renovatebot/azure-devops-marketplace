    <Asset Type="dist/assets/AzureApp-w6NjP6rz.js" d:Source="File" Path="dist/assets/AzureApp-w6NjP6rz.js" Addressable="true"/>
    <Asset Type="dist/assets/icon.png" d:Source="File" Path="dist/assets/icon.png" Addressable="true"/>
    <Asset Type="dist/assets/index-B9MkdP53.js" d:Source="File" Path="dist/assets/index-B9MkdP53.js" Addressable="true"/>
    <Asset Type="dist/assets/index-BX6ZV3eh.css" d:Source="File" Path="dist/assets/index-BX6ZV3eh.css" Addressable="true"/>
    <Asset Type="dist/assets/jsx-runtime-DLNB9Qsn.js" d:Source="File" Path="dist/assets/jsx-runtime-DLNB9Qsn.js" Addressable="true"/>
    <Asset Type="dist/index.html" d:Source="File" Path="dist/index.html" Addressable="true"/>
