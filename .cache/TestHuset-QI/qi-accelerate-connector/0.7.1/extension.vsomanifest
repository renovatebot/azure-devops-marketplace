{
    "manifestVersion": 1,
    "preview": false,
    "demands": [
        "environment/cloud"
    ],
    "scopes": [
        "vso.project",
        "vso.work_write",
        "vso.test",
        "vso.wiki",
        "vso.graph"
    ],
    "contributions": [
        {
            "id": "qi-accelerate-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "QI Accelerate",
                "order": 100,
                "icon": {
                    "light": "dist/assets/accelerate.png",
                    "dark": "dist/assets/accelerate.png"
                }
            }
        },
        {
            "id": "work-item-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qi-accelerate-hub-group"
            ],
            "properties": {
                "name": "Sync",
                "iconName": "Refresh",
                "uri": "dist/index.html",
                "order": 101
            }
        },
        {
            "id": "organization-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "QI Accelerate",
                "uri": "dist/index.html",
                "order": 100
            }
        },
        {
            "id": "knowledge-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qi-accelerate-hub-group"
            ],
            "properties": {
                "name": "Knowledge",
                "iconName": "Library",
                "uri": "dist/index.html",
                "order": 102
            }
        },
        {
            "id": "conflict-review-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qi-accelerate-hub-group"
            ],
            "properties": {
                "name": "Sync conflicts",
                "iconName": "BranchCompare",
                "uri": "dist/index.html",
                "order": 103
            }
        },
        {
            "id": "native-tasks-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qi-accelerate-hub-group"
            ],
            "properties": {
                "name": "My tasks",
                "iconName": "CheckList",
                "uri": "dist/index.html",
                "order": 100
            }
        },
        {
            "id": "work-item-review-action",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "text": "Review with QI Accelerate",
                "title": "Review this saved work item with QI Accelerate",
                "toolbarText": "QI Accelerate review",
                "icon": "dist/assets/accelerate.png",
                "uri": "dist/review-action.html",
                "group": "qi-accelerate"
            }
        },
        {
            "id": "work-item-generation-action",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "text": "Generate test cases with QI Accelerate",
                "title": "Generate test case drafts from this saved work item with QI Accelerate",
                "toolbarText": "QI Accelerate test cases",
                "icon": "dist/assets/accelerate.png",
                "uri": "dist/generation-action.html",
                "group": "qi-accelerate"
            }
        },
        {
            "id": "work-item-review-tab",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "QI Accelerate",
                "uri": "dist/review-tab.html"
            }
        },
        {
            "id": "work-item-review-dialog",
            "type": "ms.vss-web.external-content",
            "targets": [],
            "properties": {
                "uri": "dist/review-dialog.html"
            }
        }
    ],
    "contributionTypes": []
}