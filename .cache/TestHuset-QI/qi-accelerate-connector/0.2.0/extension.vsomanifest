{
    "manifestVersion": 1,
    "preview": false,
    "demands": [
        "environment/cloud"
    ],
    "scopes": [
        "vso.project",
        "vso.work_write",
        "vso.test",
        "vso.wiki",
        "vso.code",
        "vso.graph"
    ],
    "contributions": [
        {
            "id": "work-item-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "QI Accelerate sync",
                "uri": "dist/index.html",
                "order": 100
            }
        },
        {
            "id": "organization-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "QI Accelerate",
                "uri": "dist/index.html",
                "order": 100
            }
        },
        {
            "id": "knowledge-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "QI Accelerate knowledge",
                "uri": "dist/index.html",
                "order": 100
            }
        },
        {
            "id": "conflict-review-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "QI Accelerate conflicts",
                "uri": "dist/index.html",
                "order": 101
            }
        },
        {
            "id": "work-item-review-action",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "text": "Review with QI Accelerate",
                "title": "Review this saved work item with QI Accelerate",
                "toolbarText": "QI Accelerate review",
                "icon": "dist/assets/accelerate.png",
                "uri": "dist/review-action.html",
                "group": "qi-accelerate"
            }
        },
        {
            "id": "work-item-review-tab",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "QI Accelerate review",
                "uri": "dist/review-tab.html"
            }
        },
        {
            "id": "work-item-review-dialog",
            "type": "ms.vss-web.control",
            "targets": [],
            "properties": {
                "uri": "dist/review-dialog.html"
            }
        }
    ],
    "contributionTypes": []
}