{
    "manifestVersion": 1,
    "licensing": {
        "overrides": [
            {
                "id": "release-work-item-form-page",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "release-form",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "add-column-dialog",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "release-version-form-extension",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "releasesOverview",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "insights",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "roadmaps",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "trajektori.Release.Backlogs.Panel",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "trajektori-project-admin-hub-group",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "trajektori-license-hub",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributions": [
        {
            "id": "release-work-item-form-page",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Workitem tab to show workitems belong to release",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Release",
                "uri": "/dist/releasepanel_tab.html"
            }
        },
        {
            "id": "release-form",
            "type": "ms.vss-web.external-content",
            "description": "Dialog to pick correct release",
            "targets": [],
            "properties": {
                "uri": "/dist/dialog.html"
            }
        },
        {
            "id": "add-column-dialog",
            "type": "ms.vss-web.external-content",
            "description": "The content to be displayed in the AddColumnDialog",
            "targets": [],
            "properties": {
                "uri": "/dist/add_column_dialog.html"
            }
        },
        {
            "id": "release-version-form-extension",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Workitem formgroup to show and set release",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Release",
                "uri": "/dist/workitem.html",
                "order": 10
            }
        },
        {
            "id": "releasesOverview",
            "type": "ms.vss-web.hub",
            "description": "Releases overview page",
            "targets": [
                "ms.vss-web.home-hub-group"
            ],
            "properties": {
                "name": "Releases",
                "uri": "/dist/index.html",
                "order": 3,
                "pageTitle": "Releases",
                "icon": "static/icon_greyscale.png"
            }
        },
        {
            "id": "insights",
            "type": "ms.vss-web.hub",
            "description": "Insights matrix page",
            "targets": [
                "ms.vss-web.home-hub-group"
            ],
            "properties": {
                "name": "Insights",
                "uri": "/dist/insights.html",
                "order": 4,
                "pageTitle": "Insights",
                "icon": "static/icon_insights_grey.png"
            }
        },
        {
            "id": "roadmaps",
            "type": "ms.vss-web.hub",
            "description": "Roadmaps timeline page",
            "targets": [
                "ms.vss-web.home-hub-group"
            ],
            "properties": {
                "name": "Roadmaps",
                "uri": "/dist/roadmaps.html",
                "order": 5,
                "pageTitle": "Roadmaps",
                "icon": "static/icon_roadmaps_grey.png"
            }
        },
        {
            "id": "trajektori.Release.Backlogs.Panel",
            "type": "ms.vss-work-web.backlog-panel",
            "description": "Adds a 'Release' panel to Product and Iteration backlog pages.",
            "targets": [
                "ms.vss-work-web.requirement-backlog-toolpane",
                "ms.vss-work-web.portfolio-backlog-toolpane",
                "ms.vss-work-web.iteration-backlog-toolpane"
            ],
            "properties": {
                "title": "Release panel",
                "name": "Release Panel",
                "uri": "/dist/releasepanel.html",
                "registeredObjectId": "backlogPanelObject"
            }
        },
        {
            "id": "trajektori-project-admin-hub-group",
            "type": "ms.vss-web.hub",
            "description": "Project settings page for Release me",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Release me",
                "uri": "/dist/project_config.html"
            }
        },
        {
            "id": "trajektori-license-hub",
            "type": "ms.vss-web.hub",
            "description": "Licence and project slots for Trajektori",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Trajektori licence",
                "uri": "/dist/license.html"
            }
        }
    ],
    "scopes": [
        "vso.work",
        "vso.work_write",
        "vso.graph"
    ],
    "contributionTypes": []
}