  <Metadata>
    <Identity Language="en-US" Id="devops-timesheet-extension" Version="1.1.9" Publisher="iamcpb"/>
    <DisplayName>Time Sheet</DisplayName>
    <Description xml:space="preserve">Track time spent on work items with comprehensive reporting and export capabilities. Log hours, generate timesheet reports, and export data to CSV/Excel.</Description>
    <Categories>Azure Boards</Categories>
    <Tags>time tracking,timesheet,work items,reporting,time management,productivity,hours logging</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/Chindara/time-sheet#getting-started"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/Chindara/time-sheet/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/Chindara/time-sheet"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/Chindara/time-sheet"/>
    </Properties>
    <Icon>images/logo.png</Icon>
    <License>LICENSE.txt</License>
  </Metadata>
