<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="devops-timesheet-extension" Version="1.2.2" Publisher="iamcpb"/>
    <DisplayName>Time Sheet</DisplayName>
    <Description xml:space="preserve">Track time spent on work items with comprehensive reporting and export capabilities. Log hours, generate timesheet reports, and export data to CSV/Excel.</Description>
    <Categories>Azure Boards</Categories>
    <Tags>time tracking,timesheet,work items,reporting,time management,productivity,hours logging</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/Chindara/time-sheet#getting-started"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/Chindara/time-sheet/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/Chindara/time-sheet"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/Chindara/time-sheet"/>
    </Properties>
    <Icon>images/logo.png</Icon>
    <License>LICENSE.txt</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/images/logo.png" d:Source="File" Path="dist/images/logo.png" Addressable="true"/>
    <Asset Type="dist/project-timesheet.html" d:Source="File" Path="dist/project-timesheet.html" Addressable="true"/>
    <Asset Type="dist/project-timesheet.js" d:Source="File" Path="dist/project-timesheet.js" Addressable="true"/>
    <Asset Type="dist/project-timesheet.js.LICENSE.txt" d:Source="File" Path="dist/project-timesheet.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/project-timesheet.js.map" d:Source="File" Path="dist/project-timesheet.js.map" Addressable="true"/>
    <Asset Type="dist/timesheet-tab.html" d:Source="File" Path="dist/timesheet-tab.html" Addressable="true"/>
    <Asset Type="dist/timesheet-tab.js" d:Source="File" Path="dist/timesheet-tab.js" Addressable="true"/>
    <Asset Type="dist/timesheet-tab.js.LICENSE.txt" d:Source="File" Path="dist/timesheet-tab.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/timesheet-tab.js.map" d:Source="File" Path="dist/timesheet-tab.js.map" Addressable="true"/>
    <Asset Type="dist/vss-extension.json" d:Source="File" Path="dist/vss-extension.json" Addressable="true"/>
    <Asset Type="images/logo.png" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE.txt" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>