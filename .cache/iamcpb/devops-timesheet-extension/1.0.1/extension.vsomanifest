{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/Chindara/time-sheet"
    },
    "contributions": [
        {
            "id": "timesheet-tab",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Log and view time entries for work items",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Sheet",
                "uri": "dist/timesheet-tab.html",
                "height": 600,
                "supportsMobile": false
            }
        }
    ],
    "scopes": [
        "vso.work_write"
    ],
    "contributionTypes": []
}