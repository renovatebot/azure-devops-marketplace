<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="oboard-azure-devops" Publisher="ObjectiveBoardLtd" Version="0.0.14"/>
    <DisplayName>Oboard OKR Software for Azure DevOps</DisplayName>
    <Description xml:space="preserve">OKR tool for Microsoft Azure DevOps. Connect your strategy execution: from goals and success metrics to Azure Boards work. Run automated check-ins through Microsoft Teams.</Description>
    <GalleryFlags>Paid</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://oboard.atlassian.net/wiki/spaces/OBPFJ/pages/2754936835/How+to+install+Oboard+for+Azure+DevOps"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://oboard.atlassian.net/wiki/spaces/OBPFJ/overview?homepageId=4030600"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://oboard.atlassian.net/servicedesk/customer/portal/2"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://oboard.io/privacy-policy"/>
    </Properties>
    <Tags>__BYOLENFORCED,okr,okrs,objectives,key results,goal management,goals,strategic goals,strategy,alignment,execution,outcomes,kpi,kpis,check-ins,azure boards</Tags>
    <Icon>oboard_icon_vs15.png</Icon>
    <License>eula.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="oboard_icon_vs15.png" d:Source="File" Path="oboard_icon_vs15.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="oboard_icon_vs15.png" Addressable="true"/>
