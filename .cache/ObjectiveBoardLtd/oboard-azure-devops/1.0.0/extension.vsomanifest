{
    "manifestVersion": 1,
    "baseUri": "https://backend.okr-api.com",
    "scopes": [
        "vso.profile",
        "vso.graph",
        "vso.identity",
        "vso.work_write",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "okrboard-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "OKR Board",
                "uri": "/azure-devops/settings",
                "icon": {
                    "dark": "oboard_icon_vs15.png",
                    "light": "oboard_icon_vs15.png"
                }
            }
        },
        {
            "id": "okrboard-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "OKR Board",
                "icon": {
                    "dark": "oboard_icon_vs15.png",
                    "light": "oboard_icon_vs15.png"
                }
            }
        },
        {
            "id": "okrboard",
            "type": "ms.vss-web.hub",
            "targets": [
                ".okrboard-hub-group"
            ],
            "properties": {
                "name": "OKR Board",
                "uri": "/azure-devops/app",
                "icon": {
                    "dark": "oboard_icon_vs15.png",
                    "light": "oboard_icon_vs15.png"
                }
            }
        }
    ],
    "contributionTypes": []
}