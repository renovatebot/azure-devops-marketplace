{
    "manifestVersion": 1,
    "scopes": [
        "vso.profile",
        "vso.work"
    ],
    "contributions": [
        {
            "id": "okrboard-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "OKR Board",
                "icon": {
                    "dark": "oboard_icon_vs15.png",
                    "light": "oboard_icon_vs15.png"
                }
            }
        },
        {
            "id": "okrboard",
            "type": "ms.vss-web.hub",
            "targets": [
                ".okrboard-hub-group"
            ],
            "properties": {
                "name": "OKR Board",
                "uri": "dist/index.html",
                "iconAsset": "ObjectiveBoardLtd.oboard-dev/oboard_icon_vs15.png",
                "includesData": {
                    "assets": [
                        "ObjectiveBoardLtd.oboard-dev/oboard_icon_vs15.png"
                    ]
                }
            }
        }
    ],
    "contributionTypes": []
}