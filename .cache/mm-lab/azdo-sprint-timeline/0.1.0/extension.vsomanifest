{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/mm-lab-dev/azdo-sprint-timeline"
    },
    "scopes": [
        "vso.work",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "azdo-sprint-timeline-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Sprint Timeline",
                "uri": "dist/azdo-sprint-timeline/browser/index.html"
            }
        }
    ],
    "contributionTypes": []
}