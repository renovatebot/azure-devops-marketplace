  <Metadata>
    <Identity Language="en-US" Id="RestDataMappingPicklist" Publisher="OscarArguedasBarboza" Version="2.0.0"/>
    <DisplayName>Rest Data Mapping Picklist</DisplayName>
    <Description xml:space="preserve">Pick work item values from any REST API, with search, on-demand loading and mapping of extra data into other fields. Fork of https://github.com/Dedac/RestDataMappingPicklist</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/OscarArguedas/RestDataMappingPicklist"/>
    </Properties>
    <Tags>Work Items,Work Item Control,Picklist,Rest,Form,ServiceNow</Tags>
    <Icon>img/Logo.png</Icon>
  </Metadata>
