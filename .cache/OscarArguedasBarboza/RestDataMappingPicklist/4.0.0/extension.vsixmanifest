    <DisplayName>Rest Data Mapping Picklist</DisplayName>
    <Description xml:space="preserve">Pick work item values from any REST API, with search, multiple values, paging and copying into other fields. Manage API configurations per process, with OAuth 2.0 sign-in.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
