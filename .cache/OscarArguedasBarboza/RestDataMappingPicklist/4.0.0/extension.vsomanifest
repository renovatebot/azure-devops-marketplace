{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/OscarArguedasB/RestDataMappingPicklist"
    },
    "scopes": [
        "vso.work",
        "vso.work_write",
        "vso.extension.data_write"
    ],
    "contributions": [
        {
            "id": "rest-data-mapping-picklist",
            "type": "ms.vss-work-web.work-item-form-control",
            "description": "Searchable picklist filled from any REST API",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Rest Data Mapping Picklist",
                "uri": "/dist/selector.html",
                "height": 36,
                "inputs": [
                    {
                        "id": "FieldName",
                        "name": "Field to fill in",
                        "description": "Text fields. A picklist works only if it accepts values people type: the extension can’t add items to it",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "String",
                                "PlainText",
                                "HTML"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "Configuration",
                        "name": "Configuration name. ⚠ API configuration has moved: you can find it under Organization settings › Extensions › REST Picklist",
                        "description": "Enter a configuration shared with this process. Leave it empty and the field shows a link to that page",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        },
        {
            "id": "rest-picklist-setup",
            "type": "ms.vss-web.hub",
            "description": "Manage REST Picklist API configurations for each process, their credentials and the organization’s security policy.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "REST Picklist",
                "uri": "/dist/configurator.html"
            }
        }
    ],
    "contributionTypes": []
}