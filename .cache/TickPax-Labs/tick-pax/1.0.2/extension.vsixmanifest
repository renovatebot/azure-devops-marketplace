  <Metadata>
    <Identity Language="en-US" Id="tick-pax" Publisher="TickPax-Labs" Version="1.0.2"/>
    <DisplayName>TickPax – AI Time Tracking &amp; Engineering Effort Recovery</DisplayName>
    <Description xml:space="preserve">Turn Azure DevOps activity into explainable time proposals. TickPax helps engineering teams recover overlooked hours, reduce manual timesheets, and improve delivery visibility.</Description>
    <Tags>__BYOLENFORCED,time tracking,timetracker,timesheet,time recovery,billable hours,AI,effort tracking,time management,reporting,audit,work items,productivity,consulting,invoicing,utilization</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://tickpax.com/install"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://tickpax.com"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://tickpax.com/support"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://tickpax.com/privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://tickpax.com/terms"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0a1628"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="30"/>
    </Properties>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Categories>Azure Boards,Azure Repos</Categories>
    <Icon>assets/icon.light.png</Icon>
    <License>legal/terms-of-service.md</License>
  </Metadata>
