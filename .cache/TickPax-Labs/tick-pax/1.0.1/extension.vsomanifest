{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.project",
        "vso.code",
        "vso.build",
        "vso.release",
        "vso.hooks_write"
    ],
    "contributions": [
        {
            "id": "tick-pax-group",
            "type": "ms.vss-web.hub-group",
            "description": "TickPax Group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "TickPax",
                "icon": {
                    "light": "assets/icon.light.png",
                    "dark": "assets/icon.dark.png"
                },
                "order": 100
            }
        },
        {
            "id": "tick-pax-ai-recovery-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".tick-pax-group"
            ],
            "properties": {
                "name": "Time Recovery",
                "order": 89,
                "icon": "assets/time-recovery.png",
                "uri": "ai-recovery.html"
            }
        },
        {
            "id": "tick-pax-calendar-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".tick-pax-group"
            ],
            "properties": {
                "name": "Calendar",
                "order": 90,
                "icon": "assets/calendar-monthly.png",
                "uri": "my-hub.html"
            }
        },
        {
            "id": "tick-pax-audit-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".tick-pax-group"
            ],
            "properties": {
                "name": "Insights",
                "order": 92,
                "icon": "assets/ai-insights.png",
                "uri": "audit.html"
            }
        },
        {
            "id": "tick-pax-work-item-tab",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Time tracking tab for work items",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "TickPax",
                "uri": "work-item-tab.html",
                "order": 1
            }
        },
        {
            "id": "tick-pax-org-settings",
            "type": "ms.vss-web.hub",
            "description": "TickPax organization settings",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "TickPax",
                "uri": "orgSettings.html",
                "order": 100,
                "supportScopes": [
                    "organization"
                ]
            }
        }
    ],
    "contributionTypes": []
}