<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="syncerd-azure-pipelines" Version="0.1.1" Publisher="clouddrove"/>
    <DisplayName>SyncerD Azure Pipelines</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">Install and run the SyncerD CLI from Azure Pipelines.</Description>
    <Categories>Azure Pipelines</Categories>
    <Icon>syncerd-clouddrove-icon-128x128.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="overview.md" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="syncerd-clouddrove-icon-128x128.png" d:Source="File" Path="syncerd-clouddrove-icon-128x128.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="syncerd-clouddrove-icon-128x128.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>