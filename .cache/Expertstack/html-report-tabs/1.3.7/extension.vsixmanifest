<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="html-report-tabs" Publisher="Expertstack" Version="1.3.7"/>
    <DisplayName>ExpertStack HTML Report Tabs</DisplayName>
    <Description xml:space="preserve">Renders interactive HTML reports (chart, filter, sort) as Azure Pipelines build-results tabs — one tab per report artifact, no third-party dependency.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Pipelines</Categories>
    <Icon>images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/images/icon.png" d:Source="File" Path="dist/images/icon.png" Addressable="true"/>
    <Asset Type="dist/report-tab.js" d:Source="File" Path="dist/report-tab.js" Addressable="true"/>
    <Asset Type="dist/report-tab.js.LICENSE.txt" d:Source="File" Path="dist/report-tab.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/tab-lint.html" d:Source="File" Path="dist/tab-lint.html" Addressable="true"/>
    <Asset Type="dist/tab-trivy.html" d:Source="File" Path="dist/tab-trivy.html" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>