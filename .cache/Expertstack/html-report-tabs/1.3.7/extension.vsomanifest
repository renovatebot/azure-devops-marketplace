{
    "manifestVersion": 1,
    "scopes": [
        "vso.build"
    ],
    "contributions": [
        {
            "id": "lint-report-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "Lint Report",
                "uri": "dist/tab-lint.html",
                "supportsTasks": []
            }
        },
        {
            "id": "trivy-report-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "Trivy Report",
                "uri": "dist/tab-trivy.html",
                "supportsTasks": []
            }
        }
    ],
    "contributionTypes": []
}