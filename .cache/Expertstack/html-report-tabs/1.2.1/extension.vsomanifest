{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "swiftlint-report-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "SwiftLint Report",
                "uri": "dist/tab-swiftlint.html",
                "supportsTasks": []
            }
        },
        {
            "id": "android-lint-report-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "Android Lint Report",
                "uri": "dist/tab-android-lint.html",
                "supportsTasks": []
            }
        },
        {
            "id": "eslint-report-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "ESLint Report",
                "uri": "dist/tab-eslint.html",
                "supportsTasks": []
            }
        },
        {
            "id": "trivy-report-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "Trivy Report",
                "uri": "dist/tab-trivy.html",
                "supportsTasks": []
            }
        }
    ],
    "scopes": [],
    "contributionTypes": []
}