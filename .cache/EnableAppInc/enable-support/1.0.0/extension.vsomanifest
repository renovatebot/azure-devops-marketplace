{
    "manifestVersion": 1,
    "scopes": [],
    "contributions": [
        {
            "id": "enable-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Enable",
                "order": 100,
                "icon": "img/icon.png"
            }
        },
        {
            "id": "enable-support-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".enable-hub-group"
            ],
            "properties": {
                "name": "Support",
                "order": 1,
                "uri": "hub/support.html"
            }
        }
    ],
    "contributionTypes": []
}