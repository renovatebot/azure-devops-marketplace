{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_write",
        "vso.threads_full",
        "vso.extension.data_write"
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/williamverdolini/advanced-pr"
    },
    "contributions": [
        {
            "id": "advanced-pr-tab",
            "type": "ms.vss-web.tab",
            "targets": [
                "ms.vss-code-web.pr-tabs"
            ],
            "properties": {
                "name": "Guided Review",
                "title": "Guided Review",
                "uri": "dist/tab/index.html"
            }
        }
    ],
    "contributionTypes": []
}