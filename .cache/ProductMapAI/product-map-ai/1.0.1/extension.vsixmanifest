<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="product-map-ai" Version="1.0.1" Publisher="ProductMapAI"/>
    <DisplayName>Product Map AI</DisplayName>
    <Description xml:space="preserve">Product Map AI brings product management context engineering to Azure Repos so agents share a version-controlled .productmap/ knowledge layer.</Description>
    <GalleryFlags/>
    <Categories>Azure Repos</Categories>
    <Tags>product management,AI,context engineering,pull requests,Azure Repos</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://app.productmap.io"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://productmap.io"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="mailto:hey@productmap.io"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://www.productmap.io/privacy-policy"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#222222"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Integration"/>
  </Installation>
  <Assets>
    <Asset Type="images/hero.png" d:Source="File" Path="images/hero.png" Addressable="true"/>
    <Asset Type="images/logo.png" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="images/screenshot.png" d:Source="File" Path="images/screenshot.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="images/screenshot.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
  </Assets>
</PackageManifest>