<?xml version="1.0" encoding="utf-8"?><PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011"><Metadata><Identity Language="en-US" Id="devwatcher" Version="0.4.4" Publisher="MadsNoerskov" /><DisplayName>ItemOps</DisplayName><Description xml:space="preserve">Turn rough work items into clear descriptions, acceptance criteria and effort estimates inside Azure DevOps. Bring your own OpenAI key.</Description><GalleryFlags /><Categories>Azure Boards</Categories><Tags>work items,acceptance criteria,estimation,AI,OpenAI,backlog</Tags><Icon>marketplace/itemops-icon.png</Icon></Metadata><Dependencies /><Installation><InstallationTarget Id="Microsoft.VisualStudio.Services" /></Installation><Assets><Asset Type="dist/bundle.js" d:Source="File" Path="dist/bundle.js" Addressable="true" /><Asset Type="dist/bundle.js.LICENSE.txt" d:Source="File" Path="dist/bundle.js.LICENSE.txt" Addressable="true" /><Asset Type="dist/index.html" d:Source="File" Path="dist/index.html" Addressable="true" /><Asset Type="assets/itemops.png" d:Source="File" Path="assets/itemops.png" Addressable="true" /><Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true" /><Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="marketplace/itemops-icon.png" Addressable="true" /><Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="overview.md" Addressable="true" /><Asset Type="marketplace/itemops-overview.png" Path="marketplace/itemops-overview.png" Addressable="true" /></Assets></PackageManifest>