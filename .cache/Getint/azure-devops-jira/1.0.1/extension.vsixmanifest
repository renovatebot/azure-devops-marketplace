<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Version="1.0.1" Publisher="getint" Id="azure-devops-jira"/>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#1c385c"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="light"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://www.getint.io/integrations/jira-azure-devops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://docs.getint.io"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://www.getint.io/support"/>
    </Properties>
    <DisplayName>Getint — Jira Integration for Azure DevOps</DisplayName>
    <Description xml:space="preserve">Keep issues and work items aligned between Jira and Azure DevOps when different teams standardize on different trackers — no manual duplication.</Description>
    <Tags>jira,integration,sync,azure devops,getint</Tags>
    <Icon>images/getint-logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Integration"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="images/screenshot1.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/getint-logo.png" Addressable="true"/>
  </Assets>
</PackageManifest>