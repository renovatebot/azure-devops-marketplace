{
    "manifestVersion": 1,
    "CustomerQnASupport": {
        "enablemarketplaceqna": true,
        "url": "https://github.com/mfclay/azure-devops-extensions/issues/new?template=bicep-whatif.yml",
        "enableMarketplaceQnA": true
    },
    "repository": {
        "type": "git",
        "uri": "https://github.com/mfclay/azure-devops-extensions/tree/main/bicep-whatif"
    },
    "scopes": [
        "vso.build"
    ],
    "contributions": [
        {
            "id": "stack-whatif-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "task"
            }
        },
        {
            "id": "stack-whatif-results-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "What-If",
                "uri": "ui/index.html",
                "supportsTasks": [
                    "b34d630d-2819-48d6-a62f-9412768de7c5"
                ]
            }
        }
    ],
    "contributionTypes": []
}