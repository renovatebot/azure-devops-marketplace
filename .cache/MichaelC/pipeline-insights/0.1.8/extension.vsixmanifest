<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="pipeline-insights" Version="0.1.8" Publisher="MichaelC"/>
    <DisplayName>Pipeline Insights (dev)</DisplayName>
    <Description xml:space="preserve">One page for a project's pipelines: what needs attention, the estate's health, and every pipeline's recent runs.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>pipelines,insights,dashboard,approvals,health</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0078d4"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <GalleryFlags>Preview</GalleryFlags>
    <Icon>images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="hub/action.html" d:Source="File" Path="hub/action.html" Addressable="true"/>
    <Asset Type="hub/assets/SDK.min-BWtcHTku.js" d:Source="File" Path="hub/assets/SDK.min-BWtcHTku.js" Addressable="true"/>
    <Asset Type="hub/assets/action-DXx2f_tk.js" d:Source="File" Path="hub/assets/action-DXx2f_tk.js" Addressable="true"/>
    <Asset Type="hub/assets/index-CVi8hDQk.js" d:Source="File" Path="hub/assets/index-CVi8hDQk.js" Addressable="true"/>
    <Asset Type="hub/index.html" d:Source="File" Path="hub/index.html" Addressable="true"/>
    <Asset Type="images/hub-dark.png" d:Source="File" Path="images/hub-dark.png" Addressable="true"/>
    <Asset Type="images/hub-light.png" d:Source="File" Path="images/hub-light.png" Addressable="true"/>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>