{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/mfclay/azure-devops-extensions/tree/main/pipeline-insights"
    },
    "scopes": [
        "vso.build",
        "vso.code"
    ],
    "contributions": [
        {
            "id": "insights-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-build-web.build-release-hub-group"
            ],
            "properties": {
                "name": "Insights",
                "uri": "hub/index.html",
                "iconName": "AnalyticsView",
                "order": 100
            }
        }
    ],
    "contributionTypes": []
}