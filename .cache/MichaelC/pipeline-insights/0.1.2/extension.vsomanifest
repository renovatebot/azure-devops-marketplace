{
    "manifestVersion": 1,
    "scopes": [
        "vso.build",
        "vso.code"
    ],
    "contributions": [
        {
            "id": "insights-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-build-web.build-release-hub-group"
            ],
            "properties": {
                "name": "Insights",
                "uri": "hub/index.html",
                "iconName": "BarChartVertical",
                "order": 100,
                "icon": {
                    "light": "images/hub-light.png",
                    "dark": "images/hub-dark.png"
                }
            }
        }
    ],
    "contributionTypes": []
}