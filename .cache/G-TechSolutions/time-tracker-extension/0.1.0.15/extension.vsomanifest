{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "work-item-time-panel",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracker",
                "uri": "dist/index.html"
            }
        },
        {
            "id": "time-tracker-org-settings",
            "type": "ms.vss-web.collection-admin-page",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Time Tracker Settings",
                "uri": "dist/config.html"
            }
        }
    ],
    "scopes": [
        "vso.work_write"
    ],
    "contributionTypes": []
}