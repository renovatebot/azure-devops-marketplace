{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "work-item-time-panel",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracker",
                "uri": "dist/index.html"
            }
        },
        {
            "id": "time-tracker-collection-level-admin-hub",
            "type": "ms.vss-web.hub",
            "description": "Settings for backend api",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "G-Tech Timetracker",
                "order": 100,
                "uri": "dist/extension.html",
                "icon": "images/icon.png"
            }
        },
        {
            "id": "time-tracker-start-stop-work-item-form-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Start / Stop button for starting/stopping time tracking",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracker",
                "uri": "dist/startStop.html",
                "height": 300
            }
        },
        {
            "id": "time-tracker-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Timetracker hub group at the project/team level",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "G-Tech Timetracker",
                "icon": "images/icon.png",
                "order": 100
            }
        },
        {
            "id": "time-tracker-monthly-calendar-hub",
            "type": "ms.vss-web.hub",
            "description": "Timetracker calendar hub under the timetracker project-level hub group.",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Calendar",
                "order": 1,
                "uri": "dist/calendar.html",
                "icon": "images/calendar-icon.png"
            }
        },
        {
            "id": "time-tracker-budgets-hub",
            "type": "ms.vss-web.hub",
            "description": "Timetracker Budgets hub under the timetracker project-level hub group.",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Budgets",
                "order": 50,
                "uri": "dist/budgets.html",
                "icon": "images/budget-icon.png"
            }
        },
        {
            "id": "time-tracker-timesheet-hub",
            "type": "ms.vss-web.hub",
            "description": "Timetracker Timesheet hub under the timetracker project-level hub group.",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Timesheet",
                "order": 25,
                "uri": "dist/timesheet.html",
                "icon": "images/timesheet-icon.png"
            }
        },
        {
            "id": "time-tracker-approval-hub",
            "type": "ms.vss-web.hub",
            "description": "Timetracker Approval hub under the timetracker project-level hub group.",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Approval",
                "order": 27,
                "uri": "dist/approvals.html",
                "icon": "images/approval-icon.png"
            }
        },
        {
            "id": "time-tracker-settings-hub",
            "type": "ms.vss-web.hub",
            "description": "Timetracker settings hub under the timetracker project-level hub group.",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Settings",
                "order": 100,
                "uri": "dist/config.html"
            }
        }
    ],
    "scopes": [
        "vso.profile",
        "vso.work"
    ],
    "contributionTypes": []
}