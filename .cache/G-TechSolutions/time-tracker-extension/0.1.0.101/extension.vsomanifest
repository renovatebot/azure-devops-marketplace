{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "work-item-time-panel",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracker",
                "uri": "dist/index.html"
            }
        },
        {
            "id": "time-tracker-collection-level-admin-hub",
            "type": "ms.vss-web.hub",
            "description": "Settings for backend api",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Time Tracker Settings",
                "order": 100,
                "uri": "dist/config.html"
            }
        },
        {
            "id": "sample-work-item-form-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Custom work item form group",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracker",
                "uri": "dist/startStop.html",
                "height": 300
            }
        },
        {
            "id": "showProperties_12",
            "type": "ms.vss-web.action",
            "description": "Shows the target properties for menu actions for the backlog grid",
            "targets": [
                "ms.vss-work-web.backlog-item-menu"
            ],
            "properties": {
                "text": "Custom backlog item action",
                "title": "ms.vss-work-web.backlog-item-menu",
                "group": "actions",
                "uri": "dist/config.html",
                "registeredObjectId": "showProperties"
            }
        },
        {
            "id": "showProperties_18",
            "type": "ms.vss-web.action",
            "description": "Shows the target properties for menu actions for the projects overview toolbar on the collection-level admin overview hub",
            "targets": [
                "ms.vss-admin-web.projects-grid-menu"
            ],
            "properties": {
                "text": "Custom admin projects grid action",
                "title": "ms.vss-admin-web.projects-grid-menu",
                "group": "actions",
                "uri": "dist/config.html",
                "registeredObjectId": "showProperties"
            }
        },
        {
            "id": "project-level-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Hub group at the project/team level",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Custom Hub Group",
                "order": 100
            }
        },
        {
            "id": "custom-hub",
            "type": "ms.vss-web.hub",
            "description": "Hub under the custom project-level hub group.",
            "targets": [
                ".project-hub-group"
            ],
            "properties": {
                "name": "Custom Hub",
                "order": 100,
                "uri": "dist/config.html"
            }
        },
        {
            "id": "home-hub",
            "type": "ms.vss-web.hub",
            "description": "Custom hub under the Dashboards/Home hub group",
            "targets": [
                "ms.vss-web.home-hub-group"
            ],
            "properties": {
                "name": "Custom Home Hub",
                "order": 100,
                "uri": "dist/config.html"
            }
        },
        {
            "id": "code-hub",
            "type": "ms.vss-web.hub",
            "description": "Custom hub under the Code hub group",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "Custom Code Hub",
                "order": 100,
                "uri": "dist/config.html"
            }
        },
        {
            "id": "work-hub",
            "type": "ms.vss-web.hub",
            "description": "Custom hub under the Work hub group",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Custom Work Hub",
                "order": 100,
                "uri": "dist/config.html"
            }
        },
        {
            "id": "build-release-hub",
            "type": "ms.vss-web.hub",
            "description": "Custom hub under the Build & Release hub group",
            "targets": [
                "ms.vss-build-web.build-release-hub-group"
            ],
            "properties": {
                "name": "Custom Build Hub",
                "order": 100,
                "uri": "dist/config.html"
            }
        },
        {
            "id": "test-hub",
            "type": "ms.vss-web.hub",
            "description": "Custom hub under the Test hub group",
            "targets": [
                "ms.vss-test-web.test-hub-group"
            ],
            "properties": {
                "name": "Custom Test Hub",
                "order": 100,
                "uri": "dist/config.html"
            }
        },
        {
            "id": "project-admin-hub",
            "type": "ms.vss-web.hub",
            "description": "Custom project-level admin hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
