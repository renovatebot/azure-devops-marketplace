{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "work-item-time-panel",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracker",
                "uri": "dist/index.html"
            }
        },
        {
            "id": "time-tracker-project-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-hub-group",
                "ms.vss-web.board-hub-group"
            ],
            "properties": {
                "name": "Time Tracker Settings",
                "uri": "dist/config.html",
                "order": 100
            }
        },
        {
            "id": "showProperties_12",
            "type": "ms.vss-web.action",
            "description": "Shows the target properties for menu actions for the backlog grid",
            "targets": [
                "ms.vss-work-web.backlog-item-menu"
            ],
            "properties": {
                "text": "Custom backlog item action",
                "title": "ms.vss-work-web.backlog-item-menu",
                "group": "actions",
                "uri": "dist/config.html",
                "registeredObjectId": "showProperties"
            }
        }
    ],
    "scopes": [
        "vso.extension"
    ],
    "contributionTypes": []
}