{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "work-item-time-panel",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracker",
                "uri": "dist/index.html"
            }
        },
        {
            "id": "time-tracker-project-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-hub-group"
            ],
            "properties": {
                "name": "Time Tracker Settings",
                "uri": "dist/config.html",
                "order": 100,
                "content": "ms.vss-web.legacy-vss-ui-content"
            }
        }
    ],
    "scopes": [
        "vso.extension"
    ],
    "contributionTypes": []
}