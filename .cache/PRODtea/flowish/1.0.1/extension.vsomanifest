{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.project",
        "vso.extension.data_write"
    ],
    "contributions": [
        {
            "id": "ivory-delivery-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Ivory Delivery",
                "order": 60,
                "icon": "images/ivory-delivery-hubicon-24.png"
            }
        },
        {
            "id": "projetos-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".ivory-delivery-hub-group"
            ],
            "properties": {
                "name": "Projetos",
                "uri": "dist/projetos.html"
            }
        }
    ],
    "contributionTypes": []
}