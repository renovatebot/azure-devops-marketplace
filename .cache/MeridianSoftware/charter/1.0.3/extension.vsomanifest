{
    "manifestVersion": 1,
    "scopes": [
        "vso.pipelineresources_manage",
        "vso.serviceendpoint",
        "vso.hooks_write",
        "vso.work_write",
        "vso.project",
        "vso.build",
        "vso.environment_manage",
        "vso.release",
        "vso.work_full",
        "vso.settings"
    ],
    "CustomerQnASupport": {
        "enablemarketplaceqna": true,
        "enableMarketplaceQnA": true
    },
    "licensing": {
        "overrides": [
            {
                "id": "charter-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "charter-apply-task",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributions": [
        {
            "id": "charter-hub",
            "type": "ms.vss-web.hub",
            "description": "Charter - Project collection management.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Charter - Project collection management",
                "uri": "dist/Settings/Settings.html"
            }
        },
        {
            "id": "charter-apply-task",
            "type": "ms.vss-distributed-task.task",
            "description": "Applies a Charter configuration from a pipeline.",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "dist/CharterApply"
            }
        }
    ],
    "contributionTypes": []
}