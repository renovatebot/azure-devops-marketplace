    <GalleryFlags>Paid Preview</GalleryFlags>
    <Tags>time tracking,timesheets,timesheet,time,__BYOLENFORCED</Tags>
    <DisplayName>VeoWork Timesheets</DisplayName>
    <Icon>content/images/logo.png</Icon>
  </Metadata>
