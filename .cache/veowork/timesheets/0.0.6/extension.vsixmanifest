<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="timesheets" Publisher="VeoWork" Version="0.0.6"/>
    <Description xml:space="preserve">VeoWork Timesheets - your fresh air time tracking extension for Azure DevOps</Description>
    <Categories>Azure Boards</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#ffe2d3"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="light"/>
