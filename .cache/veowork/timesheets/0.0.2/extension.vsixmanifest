<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="timesheets" Publisher="VeoWork" Version="0.0.2"/>
    <Description xml:space="preserve">VeoWork Timesheets - your fresh air time tracking extension for Azure DevOps</Description>
    <Categories>Azure Boards</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0065a3"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="light"/>
    </Properties>
    <DisplayName>VeoWork Timesheets</DisplayName>
    <Icon>content/images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
    <Asset Type="content/icons/dark/page-budgets.png" d:Source="File" Path="content/icons/dark/page-budgets.png" Addressable="true"/>
    <Asset Type="content/icons/dark/page-manage.png" d:Source="File" Path="content/icons/dark/page-manage.png" Addressable="true"/>
    <Asset Type="content/icons/dark/page-settings.png" d:Source="File" Path="content/icons/dark/page-settings.png" Addressable="true"/>
    <Asset Type="content/icons/dark/page-time-approval.png" d:Source="File" Path="content/icons/dark/page-time-approval.png" Addressable="true"/>
    <Asset Type="content/icons/dark/page-users.png" d:Source="File" Path="content/icons/dark/page-users.png" Addressable="true"/>
    <Asset Type="content/icons/dark/page-veowork.png" d:Source="File" Path="content/icons/dark/page-veowork.png" Addressable="true"/>
    <Asset Type="content/icons/dark/page-your-time.png" d:Source="File" Path="content/icons/dark/page-your-time.png" Addressable="true"/>
    <Asset Type="content/icons/light/page-budgets.png" d:Source="File" Path="content/icons/light/page-budgets.png" Addressable="true"/>
    <Asset Type="content/icons/light/page-manage.png" d:Source="File" Path="content/icons/light/page-manage.png" Addressable="true"/>
    <Asset Type="content/icons/light/page-settings.png" d:Source="File" Path="content/icons/light/page-settings.png" Addressable="true"/>
    <Asset Type="content/icons/light/page-time-approval.png" d:Source="File" Path="content/icons/light/page-time-approval.png" Addressable="true"/>
    <Asset Type="content/icons/light/page-users.png" d:Source="File" Path="content/icons/light/page-users.png" Addressable="true"/>
    <Asset Type="content/icons/light/page-veowork.png" d:Source="File" Path="content/icons/light/page-veowork.png" Addressable="true"/>
    <Asset Type="content/icons/light/page-your-time.png" d:Source="File" Path="content/icons/light/page-your-time.png" Addressable="true"/>
    <Asset Type="content/images/logo.png" d:Source="File" Path="content/images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Branding" d:Source="File" Path="content/images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="content/images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>