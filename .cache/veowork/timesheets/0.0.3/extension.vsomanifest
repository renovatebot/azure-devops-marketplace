{
    "manifestVersion": 1,
    "scopes": [
        "vso.graph",
        "vso.project",
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "veowork-hub.your",
            "type": "ms.vss-web.hub",
            "targets": [
                ".veowork-hub"
            ],
            "properties": {
                "name": "Your Time",
                "order": 10,
                "uri": "/",
                "icon": {
                    "light": "asset://content/icons/light/page-your-time.png",
                    "dark": "asset://content/icons/dark/page-your-time.png"
                }
            }
        },
        {
            "id": "veowork-hub.approval",
            "type": "ms.vss-web.hub",
            "targets": [
                ".veowork-hub"
            ],
            "properties": {
                "name": "Time Approval",
                "order": 20,
                "uri": "/time-approval",
                "icon": {
                    "light": "asset://content/icons/light/page-time-approval.png",
                    "dark": "asset://content/icons/dark/page-time-approval.png"
                }
            }
        },
        {
            "id": "veowork-hub.manage",
            "type": "ms.vss-web.hub",
            "targets": [
                ".veowork-hub"
            ],
            "properties": {
                "name": "Manage",
                "order": 30,
                "uri": "/manage",
                "icon": {
                    "light": "asset://content/icons/light/page-manage.png",
                    "dark": "asset://content/icons/dark/page-manage.png"
                }
            }
        },
        {
            "id": "veowork-hub.budgets",
            "type": "ms.vss-web.hub",
            "targets": [
                ".veowork-hub"
            ],
            "properties": {
                "name": "Budgets",
                "order": 40,
                "uri": "/budgets",
                "icon": {
                    "light": "asset://content/icons/light/page-budgets.png",
                    "dark": "asset://content/icons/dark/page-budgets.png"
                }
            }
        },
        {
            "id": "veowork-hub.settings",
            "type": "ms.vss-web.hub",
            "targets": [
                ".veowork-hub"
            ],
            "properties": {
                "name": "Settings",
                "order": 50,
                "uri": "/settings",
                "icon": {
                    "light": "asset://content/icons/light/page-settings.png",
                    "dark": "asset://content/icons/dark/page-settings.png"
                }
            }
        },
        {
            "id": "veowork-user-management",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "VeoWork User Management",
                "order": 40,
                "uri": "/user-management",
                "icon": {
                    "light": "asset://content/icons/light/page-users.png",
                    "dark": "asset://content/icons/dark/page-users.png"
                }
            }
        },
        {
            "id": "veowork-work-item",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "veowork work-item time overview",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "VeoWork",
                "uri": "/work-item"
            }
        },
        {
            "id": "veowork-hub",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "VeoWork Timesheets",
                "order": 30,
                "uri": "/",
                "icon": {
                    "light": "asset://content/icons/light/page-veowork.png",
                    "dark": "asset://content/icons/dark/page-veowork.png"
                }
            }
        }
    ],
    "baseUri": "https://{{account.name}}.app.veowork.io",
    "contributionTypes": []
}