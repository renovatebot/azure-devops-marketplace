{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "excel-roundtrip-hub",
            "type": "ms.vss-web.hub",
            "description": "Export work items to .xlsx, upload the edited file, review the changes and apply them.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Excel Round-Trip",
                "uri": "dist/hub.html",
                "iconName": "ExcelDocument",
                "order": 100
            }
        },
        {
            "id": "excel-roundtrip-action",
            "type": "ms.vss-web.action",
            "description": "Opens Excel Round-Trip with the query or the selected work items.",
            "targets": [
                "ms.vss-work-web.work-item-query-menu",
                "ms.vss-work-web.work-item-query-results-toolbar-menu",
                "ms.vss-work-web.query-result-work-item-menu",
                "ms.vss-work-web.backlog-item-menu"
            ],
            "properties": {
                "text": "Export to Excel (Round-Trip)",
                "title": "Export to an .xlsx you can edit and upload back",
                "icon": "static/icon-16.png",
                "groupId": "actions",
                "uri": "dist/action.html",
                "registeredObjectId": "excel-roundtrip-action"
            }
        }
    ],
    "contributionTypes": []
}