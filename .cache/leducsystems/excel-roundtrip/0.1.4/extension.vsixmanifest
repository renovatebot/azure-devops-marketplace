<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="excel-roundtrip" Publisher="leducsystems" Version="0.1.4"/>
    <DisplayName>Excel Round-Trip for Boards</DisplayName>
    <Description xml:space="preserve">Export Azure Boards work items to .xlsx in the browser, edit them in Excel on Windows, Mac or the web, upload the file, review a field-level diff and apply bulk updates. No desktop plugin.</Description>
    <GalleryFlags/>
    <Categories>Azure Boards</Categories>
    <Tags>excel,xlsx,export,import,bulk edit,bulk update,work items,spreadsheet,mac,queries,backlog</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://leducsystems.com/excel-roundtrip/azure-devops/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://leducsystems.com/excel-roundtrip/azure-devops/support/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://leducsystems.com/excel-roundtrip/azure-devops/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#185c37"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <Icon>static/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
    <Asset Type="dist/action.html" d:Source="File" Path="dist/action.html" Addressable="true"/>
    <Asset Type="dist/action.js" d:Source="File" Path="dist/action.js" Addressable="true"/>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/hub.js" d:Source="File" Path="dist/hub.js" Addressable="true"/>
    <Asset Type="dist/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="static/icon-16.png" d:Source="File" Path="static/icon-16.png" Addressable="true"/>
    <Asset Type="static/logo.png" d:Source="File" Path="static/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="static/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>