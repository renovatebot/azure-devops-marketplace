{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "sprint-goals-hub",
            "type": "ms.vss-web.hub",
            "description": "Every team's goal for its current sprint, and each team's goals and outcomes by sprint.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Sprint Goals",
                "uri": "dist/hub.html",
                "iconName": "Flag",
                "order": 98
            }
        },
        {
            "id": "sprint-goal-tab",
            "type": "ms.vss-web.tab",
            "description": "The team's goal for this sprint, on the Sprints page.",
            "targets": [
                "ms.vss-work-web.iteration-backlog-tabs"
            ],
            "properties": {
                "name": "Goal",
                "title": "Sprint goal",
                "uri": "dist/goal.html"
            }
        },
        {
            "id": "backlog-goal-tab",
            "type": "ms.vss-web.tab",
            "description": "The team's goal for the current sprint, on the Backlogs page.",
            "targets": [
                "ms.vss-work-web.product-backlog-tabs"
            ],
            "properties": {
                "name": "Sprint goal",
                "title": "Sprint goal",
                "uri": "dist/goal.html"
            }
        },
        {
            "id": "sprint-goals-widget",
            "type": "ms.vss-dashboards-web.widget",
            "description": "A team's goal for its current sprint, with the outcome and the team's hit rate.",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".sprint-goals-widget-config"
            ],
            "properties": {
                "name": "Sprint goal",
                "description": "A team's goal for its current sprint, with the outcome and the team's hit rate.",
                "catalogIconUrl": "static/logo.png",
                "previewImageUrl": "static/logo.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "sprint-goals-widget-config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "description": "Pick the team whose sprint goal the widget shows.",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Sprint goal settings",
                "description": "Pick the team whose sprint goal the widget shows.",
                "uri": "dist/widgetConfig.html"
            }
        }
    ],
    "contributionTypes": []
}