<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="sprint-goals" Publisher="leducsystems" Version="0.1.3"/>
    <DisplayName>Sprint Goals: per team, with history</DisplayName>
    <Description xml:space="preserve">A goal for each team in each sprint, on the sprint page, the backlog and a dashboard widget. Mark goals achieved, partly achieved or missed and see each team's hit rate. Saves as you type.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>sprint goal,sprint goals,goal,scrum,sprint,iteration,sprint review,dashboard widget,teams,agile</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://leducsystems.com/sprint-goals/azure-devops/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://leducsystems.com/sprint-goals/azure-devops/support/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://leducsystems.com/sprint-goals/azure-devops/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://leducsystems.com/sprint-goals/azure-devops/terms/"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0b4f8a"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <Icon>static/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
