{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "log-time-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Log time on a work item and see your entries on it.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Log time",
                "uri": "dist/workItemGroup.html",
                "height": 320
            }
        },
        {
            "id": "timesheet-hub",
            "type": "ms.vss-web.hub",
            "description": "Weekly timesheet, approvals, settings and Tempo import.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Timesheet",
                "uri": "dist/timesheet.html",
                "iconName": "Clock",
                "order": 100
            }
        },
        {
            "id": "reports-hub",
            "type": "ms.vss-web.hub",
            "description": "Time reports by person, work item, tag, area and iteration, with CSV export.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Time reports",
                "uri": "dist/reports.html",
                "iconName": "BarChartVertical",
                "order": 101
            }
        }
    ],
    "contributionTypes": []
}