<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="pr-conflict-resolver" Publisher="leducsystems" Version="0.1.2"/>
    <DisplayName>PR Conflict Resolver</DisplayName>
    <Description xml:space="preserve">Resolve pull request merge conflicts in the browser: a three-way editor with accept source, target or both per conflict, autosaved drafts, and a final review before applying.</Description>
    <GalleryFlags/>
    <Categories>Azure Repos</Categories>
    <Tags>merge conflict,merge conflicts,conflicts,pull request,three-way merge,resolve conflicts,git,code review</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://leducsystems.com/pr-conflict-resolver/azure-devops/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://leducsystems.com/pr-conflict-resolver/azure-devops/support/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://leducsystems.com/pr-conflict-resolver/azure-devops/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#1f4e79"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <Icon>static/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
    <Asset Type="dist/conflicts.html" d:Source="File" Path="dist/conflicts.html" Addressable="true"/>
    <Asset Type="dist/conflicts.js" d:Source="File" Path="dist/conflicts.js" Addressable="true"/>
    <Asset Type="dist/conflicts.js.LICENSE.txt" d:Source="File" Path="dist/conflicts.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="static/logo.png" d:Source="File" Path="static/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="static/logo.png" Addressable="true"/>
    <Asset Type="listing/screenshots/1-merge-editor.png" d:Source="File" Path="listing/screenshots/1-merge-editor.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="listing/screenshots/1-merge-editor.png" Addressable="true"/>
    <Asset Type="listing/screenshots/2-restored-after-refresh.png" d:Source="File" Path="listing/screenshots/2-restored-after-refresh.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.2" d:Source="File" Path="listing/screenshots/2-restored-after-refresh.png" Addressable="true"/>
    <Asset Type="listing/screenshots/3-binary-file.png" d:Source="File" Path="listing/screenshots/3-binary-file.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.3" d:Source="File" Path="listing/screenshots/3-binary-file.png" Addressable="true"/>
    <Asset Type="listing/screenshots/4-review-before-apply.png" d:Source="File" Path="listing/screenshots/4-review-before-apply.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.4" d:Source="File" Path="listing/screenshots/4-review-before-apply.png" Addressable="true"/>
    <Asset Type="listing/screenshots/5-applied.png" d:Source="File" Path="listing/screenshots/5-applied.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.5" d:Source="File" Path="listing/screenshots/5-applied.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>