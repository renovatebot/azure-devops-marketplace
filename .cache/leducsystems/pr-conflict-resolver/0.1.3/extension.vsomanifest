{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_write"
    ],
    "contributions": [
        {
            "id": "resolve-conflicts-tab",
            "type": "ms.vss-web.tab",
            "description": "A pull request tab that lists conflicting files and resolves them in a three-way merge editor.",
            "targets": [
                "ms.vss-code-web.pr-tabs"
            ],
            "properties": {
                "name": "Resolve conflicts",
                "uri": "dist/conflicts.html",
                "title": "Resolve conflicts",
                "order": 100
            }
        }
    ],
    "contributionTypes": []
}