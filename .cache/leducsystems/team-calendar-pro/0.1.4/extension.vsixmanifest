  <Metadata>
    <Identity Language="en-US" Id="team-calendar-pro" Publisher="leducsystems" Version="0.1.4"/>
    <DisplayName>Team Calendar Pro: Days Off, Sprints and Events</DisplayName>
    <Description xml:space="preserve">A team calendar for Azure Boards. Days off go straight into sprint capacity, Entra ID groups expand to people, and the calendar exports to .ics. Imports events from Microsoft's Team Calendar.</Description>
    <GalleryFlags/>
    <Categories>Azure Boards</Categories>
    <Tags>calendar,team calendar,days off,capacity,sprint,vacation,holidays,out of office,PTO,ics</Tags>
