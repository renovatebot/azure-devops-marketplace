      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://leducsystems.com/team-calendar/azure-devops/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://leducsystems.com/team-calendar/azure-devops/terms/"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0b4f8a"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <Icon>static/logo.png</Icon>
  </Metadata>
