{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.project",
        "vso.graph"
    ],
    "contributions": [
        {
            "id": "team-calendar-hub",
            "type": "ms.vss-web.hub",
            "description": "Team calendar: sprints, team and personal days off (saved to sprint capacity), events, export and import.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Team Calendar",
                "uri": "dist/calendar.html",
                "iconName": "Calendar",
                "order": 99
            }
        }
    ],
    "contributionTypes": []
}