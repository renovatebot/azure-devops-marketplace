<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="dotnet-test-rerun" Version="5.1.1" Publisher="joaoopereira"/>
    <DisplayName>dotnet-test-rerun</DisplayName>
    <Description xml:space="preserve">Run dotnet test and rerun the failed tests with dotnet-test-rerun.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Pipelines</Categories>
    <Tags>dotnet,test,rerun,flaky,trx</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://joaoopereira.github.io/dotnet-test-rerun/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/joaoopereira/dotnet-test-rerun"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/joaoopereira/dotnet-test-rerun/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/joaoopereira/dotnet-test-rerun"/>
    </Properties>
    <Icon>icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="icon.png" d:Source="File" Path="icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>