{
    "manifestVersion": 1,
    "scopes": [
        "vso.build",
        "vso.release"
    ],
    "contributions": [
        {
            "id": "azure-devops-goverance-organization-settings-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Governance global settings",
                "uri": "dist/organization-settings-hub/organization-settings-hub.html"
            }
        },
        {
            "id": "azure-devops-goverance-project-settings-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Azure DevOps Goverance",
                "uri": "dist/project-settings-hub/project-settings-hub.html"
            }
        }
    ],
    "contributionTypes": []
}