{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_write"
    ],
    "contributions": [
        {
            "id": "publish-release-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "packages/task/dist/PublishReleaseV0"
            }
        },
        {
            "id": "releases-hub",
            "type": "ms.vss-web.hub",
            "description": "Releases of the current Git repository: list, draft, generate notes, publish, edit and delete.",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "Releases",
                "uri": "hub/releases.html",
                "iconName": "Rocket",
                "order": 55
            }
        }
    ],
    "contributionTypes": []
}