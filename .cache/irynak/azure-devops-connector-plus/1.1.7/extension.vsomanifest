{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "connection-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Peeklogic Connection",
                "order": 1,
                "uri": "dist/connection/connection.html",
                "icon": "assets/images/icon.png"
            }
        },
        {
            "id": "settings-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Peeklogic Settings",
                "order": 2,
                "uri": "dist/settings/settings.html",
                "icon": "assets/images/icon.png"
            }
        },
        {
            "id": "sample-work-item-form-page",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Custom work item form page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Peeklogic Connector Plus",
                "uri": "dist/workitem/workitem.html"
            }
        }
    ],
    "scopes": [
        "vso.work",
        "vso.project"
    ],
    "callbacks": {
        "postInstall": "https://webhook.site/2ec7b682-ec83-4f8f-826e-e9a615ae6c0d?event=install",
        "postUninstall": "https://webhook.site/2ec7b682-ec83-4f8f-826e-e9a615ae6c0d?event=uninstall"
    },
    "contributionTypes": []
}