{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "connection-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Peeklogic Connection",
                "order": 1,
                "uri": "dist/connection/connection.html",
                "icon": "assets/images/icon.png"
            }
        },
        {
            "id": "settings-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Peeklogic Settings",
                "order": 2,
                "uri": "dist/settings/settings.html",
                "icon": "assets/images/icon.png"
            }
        },
        {
            "id": "sample-work-item-form-page",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Custom work item form page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Peeklogic Connector Plus",
                "uri": "dist/workitem/workitem.html"
            }
        }
    ],
    "scopes": [
        "vso.work",
        "vso.project"
    ],
    "eventCallbacks": {
        "postInstall": {
            "uri": "https://peeklogic--irynakuzmi.sandbox.my.site.com/services/apexrest/azure/lifecycle/postInstall"
        },
        "postUpdate": {
            "uri": "https://webhook.site/75c349dd-41b8-415b-bbcc-0b0b90bb6ab3"
        },
        "postUninstall": {
            "uri": "https://peeklogic--irynakuzmi.sandbox.my.site.com/services/apexrest/azure/lifecycle/postUninstall"
        }
    },
    "contributionTypes": []
}