<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="poof-setup" Version="1.0.5" Publisher="pirafrank"/>
    <DisplayName>Poof Setup</DisplayName>
    <Description xml:space="preserve">Install poof and pre-built binaries from GitHub Releases into your Azure DevOps pipeline.</Description>
    <Categories>Azure Pipelines</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://github.com/pirafrank/poof"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/pirafrank/poof-azure-extension/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/pirafrank/poof-azure-extension"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/pirafrank/poof-azure-extension/blob/main/LICENSE.md"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/pirafrank/poof-azure-extension"/>
    </Properties>
    <GalleryFlags>Public</GalleryFlags>
    <Badges/>
    <Icon>images/poof_tx_bg_128x128.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/poof_tx_bg_128x128.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>