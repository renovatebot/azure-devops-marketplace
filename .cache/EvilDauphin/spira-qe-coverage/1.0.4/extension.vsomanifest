{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/Inflectra/ado-extension-spira-qe-coverage"
    },
    "scopes": [
        "vso.work",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "spira-qe-coverage-form-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "SpiraPlan QE Coverage panel on work item forms",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "SpiraPlan QE Coverage",
                "uri": "dist/form-group/form-group.html",
                "height": 400
            }
        },
        {
            "id": "spira-qe-coverage-project-settings",
            "type": "ms.vss-web.hub",
            "description": "SpiraPlan QE Coverage project settings",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "SpiraPlan QE Coverage",
                "uri": "dist/project-settings/project-settings.html",
                "order": 100
            }
        }
    ],
    "contributionTypes": []
}