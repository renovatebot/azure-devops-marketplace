<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="spira-qe-coverage" Publisher="EvilDauphin" Version="1.0.2"/>
    <DisplayName>SpiraPlan QE Coverage</DisplayName>
    <Description xml:space="preserve">Displays SpiraPlan test coverage directly on Azure DevOps work items. See which test cases cover each requirement and their execution status at a glance.</Description>
    <GalleryFlags/>
    <Categories>Azure Boards</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://www.inflectra.com/SpiraPlan/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://www.inflectra.com/Support/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://www.inflectra.com/SpiraPlan/Integrations/Developer-Tools.aspx"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://www.inflectra.com/Company/Privacy-Policy.aspx"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/Inflectra/ado-extension-spira-qe-coverage"/>
    </Properties>
    <Tags>SpiraPlan,SpiraTest,SpiraTeam,Inflectra,Test Coverage,Quality Engineering,Test Management,Traceability</Tags>
    <Icon>static/img/icon-spiraplan-128.png</Icon>
    <License>LICENSE.txt</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
