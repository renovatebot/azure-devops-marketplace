{
    "manifestVersion": 1,
    "scopes": [
        "vso.extension.data_write",
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "qa-bolt-panel",
            "type": "ms.vss-work-web.work-item-form-group",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Testflow",
                "uri": "index.html",
                "height": 300
            }
        },
        {
            "id": "qa-bolt-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Testflow Settings",
                "uri": "settings.html",
                "order": 100
            }
        }
    ],
    "contributionTypes": []
}