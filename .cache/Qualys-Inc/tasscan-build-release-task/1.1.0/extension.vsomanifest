{
    "manifestVersion": 1,
    "scopes": [
        "vso.build_execute",
        "vso.build",
        "vso.serviceendpoint",
        "vso.serviceendpoint_manage",
        "vso.release_manage",
        "vso.taskgroups_manage"
    ],
    "contributions": [
        {
            "id": "service-endpoint",
            "description": "Service endpoint type for Qualys TotalAppSec Sacnning connections",
            "type": "ms.vss-endpoint.service-endpoint-type",
            "targets": [
                "ms.vss-endpoint.endpoint-types"
            ],
            "properties": {
                "name": "tasConnection",
                "displayName": "Qualys TotalAppSec Scanning server connection",
                "url": {
                    "displayName": "API Server URL:",
                    "helpText": "API Server URL link to connect - Example: https://qualysapi.qualys.com (Please do not add a forward slash (/) at the end of URL)"
                },
                "dataSources": [],
                "authenticationSchemes": [
                    {
                        "type": "ms.vss-endpoint.endpoint-auth-scheme-basic",
                        "headers": [
                            {
                                "name": "Accept",
                                "value": "application/json"
                            },
                            {
                                "name": "Content-Type",
                                "value": "application/xml"
                            }
                        ],
                        "inputDescriptors": [
                            {
                                "id": "username",
                                "name": "Username/Client ID",
                                "description": "Username for BASIC auth or Client ID for OIDC/IDP auth",
                                "isConfidential": false,
                                "inputMode": "textbox",
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "password",
                                "name": "Password/Client Secret",
                                "description": "Password for BASIC auth or Client Secret for OIDC/IDP auth",
                                "inputMode": "passwordbox",
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "authenticationType",
                                "name": "Authentication Type",
                                "isConfidential": false,
                                "description": "Enter 'BasicAuth' for Basic Authentication, 'OIDC' for OIDC Authentication, or 'IDP' for IDP Authentication.",
                                "inputMode": "textbox",
                                "defaultValue": "BasicAuth",
                                "helpMarkDown": "Enter 'BasicAuth' for Basic Authentication, 'OIDC' for OIDC Authentication, or 'IDP' for IDP Authentication.",
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "tokenUrl",
                                "name": "Token URL - Required for IDP Auth else",
                                "description": "Token URL for IDP authentication (required for Auth Type: IDP)",
                                "isConfidential": false,
                                "inputMode": "textbox",
                                "validation": {
                                    "isRequired": false,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "scope",
                                "name": "Scope",
                                "description": "Scope for IDP authentication (optional for Auth Type: IDP)",
                                "isConfidential": false,
                                "inputMode": "textbox",
                                "validation": {
                                    "isRequired": false,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "audience",
                                "name": "Audience",
                                "description": "Audience for IDP authentication (optional for Auth Type: IDP)",
                                "isConfidential": false,
                                "inputMode": "textbox",
                                "validation": {
                                    "isRequired": false,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "useProxy",
                                "name": "Use Proxy",
                                "description": "Select the checkbox to use the proxy",
                                "inputMode": "checkbox",
                                "isConfidential": false,
                                "validation": {
                                    "isRequired": false,
                                    "dataType": "boolean"
                                }
                            },
                            {
                                "id": "proxyServerName",
                                "name": "Proxy Server",
                                "description": "Enter the proxy URL - Examples: 10.15.201.155, corp.proxyserver.company.com",
                                "inputMode": "textbox",
                                "isConfidential": false,
                                "validation": {
                                    "isRequired": false,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "proxyPort",
                                "name": "Proxy Port",
                                "description": "Enter the proxy port",
                                "inputMode": "textbox",
                                "isConfidential": false,
                                "validation": {
                                    "isRequired": false,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "proxyUserName",
                                "name": "Proxy Username",
                                "description": "Enter the proxy username",
                                "inputMode": "textbox",
                                "isConfidential": false,
                                "validation": {
                                    "isRequired": false,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "proxyPassword",
                                "name": "Proxy Password",
                                "description": "Enter the proxy password",
                                "inputMode": "passwordbox",
                                "validation": {
                                    "isRequired": false,
                                    "dataType": "string"
                                }
                            }
                        ]
                    }
                ],
                "helpMarkDown": "<a href=\"https://docs.qualys.com/en/tas/latest/get_started/get_started.htm\" target=\"_blank\"><b>Learn More</b></a>"
            }
        },
        {
            "id": "build-info-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "description": "A tab contributing to build results view",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "Qualys TAS Scan Status",
                "uri": "infoTab.html"
            },
            "includes": [
                "ms.vss-releaseManagement-web.release-service-data-external"
            ]
        },
        {
            "id": "release-management-tab",
            "type": "ms.vss-releaseManagement-web.release-summary-tab",
            "description": "Adds a 'Qualys TAS Scan Status' tab to the release environment.",
            "targets": [
                "ms.vss-releaseManagement-web.release-details-view"
            ],
            "properties": {
                "name": "Qualys TAS Scan Status",
                "order": "99",
                "uri": "infoTab.html",
                "supportsTasks": [
                    "7a06fda6-b456-11ea-b3de-0242ac130003"
                ]
            },
            "includes": [
                "ms.vss-releaseManagement-web.release-service-data-external"
            ]
        },
        {
            "id": "custom-build-release-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "buildAndReleaseTask"
            }
        }
    ],
    "contributionTypes": []
}