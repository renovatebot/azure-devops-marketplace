<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="build-release-task" Version="1.3.0" Publisher="Qualys-Inc"/>
    <DisplayName>Qualys Container Scanning Connector</DisplayName>
    <Description xml:space="preserve">This extension allows you to get the security posture for the container images built in Azure Devops and visualize it.</Description>
    <Categories>Azure Pipelines</Categories>
    <GalleryFlags>Public</GalleryFlags>
    <Tags>security,cs,container security,qualys</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://www.qualys.com"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://www.qualys.com/docs/qualys-container-scanning-connector-azure-devops-plugin-guide.pdf"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://www.qualys.com/support/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://www.qualys.com/company/privacy/"/>
    </Properties>
    <Icon>images/qualys_logo_default.png</Icon>
    <License>LICENSE.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
