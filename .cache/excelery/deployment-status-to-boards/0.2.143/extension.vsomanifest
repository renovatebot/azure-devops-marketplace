{
  "manifestVersion": 1,
  "scopes": [
    "vso.work",
    "vso.build"
  ],
  "contributions": [
    {
      "id": "pipeline-settings-menu-action",
      "type": "ms.vss-web.action",
      "description": "Choose which environments show on linked work items.",
      "targets": [
        "ms.vss-build-web.build-definition-menu"
      ],
      "properties": {
        "text": "Boards Integration",
        "title": "Report deployment status to Boards",
        "uri": "dist/PipelineSettings/PipelineSettings.html",
        "registeredObjectId": "pipeline-settings-menu-action",
        "order": 35
      }
    },
    {
      "id": "pipeline-settings-panel",
      "type": "ms.vss-web.external-content",
      "description": "Boards Integration settings for a pipeline.",
      "targets": [],
      "properties": {
        "uri": "dist/PipelineSettingsPanel/PipelineSettingsPanel.html"
      }
    },
    {
      "id": "deployments-work-item-control",
      "type": "ms.vss-work-web.work-item-form-control",
      "description": "Shows where this work item has been deployed by YAML pipelines.",
      "targets": [
        "ms.vss-work-web.work-item-form"
      ],
      "properties": {
        "name": "Deployment Status for YAML",
        "uri": "dist/DeploymentsGroup/DeploymentsGroup.html",
        "height": 220
      }
    }
  ],
  "repository": {
    "type": "git",
    "uri": "https://github.com/excelery/azdo-extension-deployment-status"
  },
  "contributionTypes": []
}
