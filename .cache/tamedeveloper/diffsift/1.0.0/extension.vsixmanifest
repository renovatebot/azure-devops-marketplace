<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="diffsift" Version="1.0.0" Publisher="tamedeveloper"/>
    <DisplayName>Diffsift: local AI pull request review</DisplayName>
    <Description xml:space="preserve">Local-first AI review packs for your Azure DevOps pull requests: severity, confidence, and evidence from the diff. Your model, your hardware.</Description>
    <GalleryFlags/>
    <Categories>Azure Repos</Categories>
    <Tags>code review,pull requests,AI,LLM,local AI,Ollama,LM Studio,security,privacy</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://diffsift.dev/download"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://diffsift.dev/docs"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://diffsift.dev/terms"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://diffsift.dev/privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="mailto:hello@diffsift.dev"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0d1117"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <Icon>images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Integration"/>
  </Installation>
  <Assets>
    <Asset Type="images/1-inbox.png" d:Source="File" Path="images/1-inbox.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="images/1-inbox.png" Addressable="true"/>
    <Asset Type="images/2-review-pack.png" d:Source="File" Path="images/2-review-pack.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.2" d:Source="File" Path="images/2-review-pack.png" Addressable="true"/>
    <Asset Type="images/3-pr-detail.png" d:Source="File" Path="images/3-pr-detail.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.3" d:Source="File" Path="images/3-pr-detail.png" Addressable="true"/>
    <Asset Type="images/4-pr-list.png" d:Source="File" Path="images/4-pr-list.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.4" d:Source="File" Path="images/4-pr-list.png" Addressable="true"/>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
  </Assets>
</PackageManifest>