<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="sprint-timeline" Publisher="scott-turner" Version="1.1.0"/>
    <DisplayName>Sprint Timeline</DisplayName>
    <Description xml:space="preserve">See the whole sprint: development and every step your team runs around it, such as planning, UAT, the release and the close-out, on a Timeline tab of the Sprints page.</Description>
    <Categories>Azure Boards</Categories>
    <GalleryFlags>Public</GalleryFlags>
    <Tags>sprint,timeline,iteration,planning,UAT,release,cadence,gantt</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#1f2933"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/turnert2005/sprint-timeline/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/turnert2005/sprint-timeline"/>
    </Properties>
    <Icon>images/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="static/tab.html" d:Source="File" Path="static/tab.html" Addressable="true"/>
    <Asset Type="static/styles.css" d:Source="File" Path="static/styles.css" Addressable="true"/>
    <Asset Type="dist/tab.js" d:Source="File" Path="dist/tab.js" Addressable="true"/>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="images/screenshot-cycle-light.png" d:Source="File" Path="images/screenshot-cycle-light.png" Addressable="true"/>
    <Asset Type="images/screenshot-dark.png" d:Source="File" Path="images/screenshot-dark.png" Addressable="true"/>
    <Asset Type="images/screenshot-editor-dark.png" d:Source="File" Path="images/screenshot-editor-dark.png" Addressable="true"/>
    <Asset Type="images/screenshot-light.png" d:Source="File" Path="images/screenshot-light.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>