{
    "manifestVersion": 1,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/amanullah-ado/multi-picklist-mapping-grid"
    },
    "scopes": [
        "vso.work",
        "vso.work_write",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "mapping-grid-confighub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Picklist Mapping Grid",
                "uri": "dist/confighub/confighub.html",
                "order": 100,
                "icon": "images/extension-icon.png"
            }
        },
        {
            "id": "mapping-grid-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Multi-Picklist Mapping Grid",
                "uri": "dist/grid-control/grid-control.html",
                "height": 500,
                "inputs": [
                    {
                        "id": "DecimalColumnId",
                        "name": "Decimal Column ID",
                        "description": "The column ID in your grid config that holds decimal values for aggregation.",
                        "type": "string",
                        "defaultValue": "",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "GrandTotalFieldRefName",
                        "name": "Grand Total Field",
                        "description": "Work item field (Double) to store the grand total sum.",
                        "type": "WorkItemField",
                        "defaultValue": "",
                        "properties": {
                            "workItemFieldTypes": [
                                "Double",
                                "Integer"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "ValueFieldPrefix",
                        "name": "Value Field Prefix",
                        "description": "Prefix for per-value subtotal fields. Example: Custom. -> Custom.A_Total",
                        "type": "string",
                        "defaultValue": "Custom.",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "ConfigProjectId",
                        "name": "Config Project ID (optional)",
                        "description": "Override the project from which to load mapping configuration. Defaults to current project.",
                        "type": "string",
                        "defaultValue": "",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        }
    ],
    "overrides": {
        "manifestVersion": 1,
        "id": "multi-picklist-mapping-grid",
        "name": "Multi-Picklist Mapping Grid",
        "publisher": "amanullah-ado",
        "galleryFlags": "Public"
    },
    "contributionTypes": []
}