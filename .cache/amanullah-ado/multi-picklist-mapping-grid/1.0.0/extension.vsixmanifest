      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/amanullah-ado/multi-picklist-mapping-grid"/>
    </Properties>
    <Icon>images/extension-icon.png</Icon>
    <License>LICENSE</License>
