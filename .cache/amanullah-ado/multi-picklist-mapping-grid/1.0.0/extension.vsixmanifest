  <Metadata>
    <Identity Language="en-US" Id="multi-picklist-mapping-grid" Version="1.0.0" Publisher="amanullah-ado"/>
    <DisplayName>Multi-Picklist Mapping Grid</DisplayName>
    <Description xml:space="preserve">Fully configurable multi-picklist grid with cross-column mapping, aggregation totals (subtotals + grand total), and granular field persistence for Azure DevOps work items.</Description>
    <Categories>Azure Boards</Categories>
    <Tags>picklist,mapping,grid,aggregation,data table,cascading</Tags>
    <GalleryFlags>Public</GalleryFlags>
