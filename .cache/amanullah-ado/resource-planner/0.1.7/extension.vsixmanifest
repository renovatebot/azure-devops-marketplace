<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="resource-planner" Version="0.1.7" Publisher="amanullah-ado"/>
    <DisplayName>Resource Planner &amp; Heatmap</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">See who works on which Epic and how each person's capacity is used: a utilization heatmap, resource timeline, Epic Gantt and dashboard widgets for Azure Boards.</Description>
    <Categories>Azure Boards</Categories>
    <Tags>resource planning,capacity,heatmap,gantt,utilization,epic,timeline</Tags>
    <Icon>images/planner-icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
    <InstallationTarget Id="Microsoft.TeamFoundation.Server" Version="[16.0,)"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub/index.html" d:Source="File" Path="dist/hub/index.html" Addressable="true"/>
    <Asset Type="dist/hub/index.js" d:Source="File" Path="dist/hub/index.js" Addressable="true"/>
    <Asset Type="dist/hub/index.js.LICENSE.txt" d:Source="File" Path="dist/hub/index.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/widgets/config/index.html" d:Source="File" Path="dist/widgets/config/index.html" Addressable="true"/>
    <Asset Type="dist/widgets/config/index.js" d:Source="File" Path="dist/widgets/config/index.js" Addressable="true"/>
    <Asset Type="dist/widgets/config/index.js.LICENSE.txt" d:Source="File" Path="dist/widgets/config/index.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/widgets/over/index.html" d:Source="File" Path="dist/widgets/over/index.html" Addressable="true"/>
    <Asset Type="dist/widgets/over/index.js" d:Source="File" Path="dist/widgets/over/index.js" Addressable="true"/>
    <Asset Type="dist/widgets/over/index.js.LICENSE.txt" d:Source="File" Path="dist/widgets/over/index.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/widgets/teams/index.html" d:Source="File" Path="dist/widgets/teams/index.html" Addressable="true"/>
    <Asset Type="dist/widgets/teams/index.js" d:Source="File" Path="dist/widgets/teams/index.js" Addressable="true"/>
    <Asset Type="dist/widgets/teams/index.js.LICENSE.txt" d:Source="File" Path="dist/widgets/teams/index.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/widgets/tile/index.html" d:Source="File" Path="dist/widgets/tile/index.html" Addressable="true"/>
    <Asset Type="dist/widgets/tile/index.js" d:Source="File" Path="dist/widgets/tile/index.js" Addressable="true"/>
    <Asset Type="dist/widgets/tile/index.js.LICENSE.txt" d:Source="File" Path="dist/widgets/tile/index.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="images/planner-icon.png" d:Source="File" Path="images/planner-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/planner-icon.png" Addressable="true"/>
    <Asset Type="images/preview-over.png" d:Source="File" Path="images/preview-over.png" Addressable="true"/>
    <Asset Type="images/preview-teams.png" d:Source="File" Path="images/preview-teams.png" Addressable="true"/>
    <Asset Type="images/preview-tile.png" d:Source="File" Path="images/preview-tile.png" Addressable="true"/>
