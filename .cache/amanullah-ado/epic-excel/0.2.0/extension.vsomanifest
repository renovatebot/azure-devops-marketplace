{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "epic-excel-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "description": "Excel template for this Epic, embedded in the form.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Epic Excel Template",
                "uri": "dist/form.html",
                "height": 650,
                "inputs": [
                    {
                        "id": "FieldName",
                        "name": "Field (optional)",
                        "description": "Optional. A custom HTML or long-text field to place this control next to. The workbook itself is stored as an attachment on the Epic.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "String",
                                "PlainText",
                                "Html"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        },
        {
            "id": "epic-excel-panel",
            "type": "ms.vss-web.control",
            "description": "Large panel used by the Full screen button.",
            "targets": [],
            "properties": {
                "uri": "dist/panel.html"
            }
        },
        {
            "id": "epic-excel-settings",
            "type": "ms.vss-web.hub",
            "description": "Upload the Epic Excel template for this project.",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Epic Excel Template",
                "uri": "dist/settings.html"
            }
        }
    ],
    "contributionTypes": []
}