{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "epic-excel-form-page",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Excel template for this Epic",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Risk Questionnaire",
                "uri": "dist/form.html",
                "registeredObjectId": "epic-excel-form"
            }
        },
        {
            "id": "epic-excel-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Epic Excel Template",
                "uri": "dist/settings.html"
            }
        }
    ],
    "contributionTypes": []
}