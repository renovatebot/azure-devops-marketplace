{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "epic-excel-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "description": "Excel template inside the Epic form; the values are stored per Epic in a field.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Epic Excel Template",
                "uri": "dist/form.html",
                "height": 650,
                "inputs": [
                    {
                        "id": "FieldName",
                        "name": "Storage field (long text or HTML)",
                        "description": "A custom long-text or HTML field used only by this control. What users type is saved in it when they save the Epic.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "PlainText",
                                "Html"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "TemplateName",
                        "name": "Template file name (optional)",
                        "description": "File name of the template uploaded in Project Settings, for example Risk.xlsx. Leave empty when the project has one template.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        },
        {
            "id": "epic-excel-settings",
            "type": "ms.vss-web.hub",
            "description": "Upload the Epic Excel template for this project.",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Epic Excel Templates",
                "uri": "dist/settings.html"
            }
        }
    ],
    "contributionTypes": []
}