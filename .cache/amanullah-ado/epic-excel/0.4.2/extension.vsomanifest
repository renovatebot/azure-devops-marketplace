{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.work_write",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "epic-excel-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "description": "Excel template for this Epic, embedded in the form.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Epic Excel Template",
                "uri": "dist/form.html",
                "height": 650,
                "inputs": [
                    {
                        "id": "FieldName",
                        "name": "Custom field (names the saved file)",
                        "description": "A custom HTML or long-text field. Its label names the saved file: \"<Epic no> - <field label>.xlsx\". The workbook is stored as an attachment on the Epic.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "String",
                                "PlainText",
                                "Html"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "TemplateName",
                        "name": "Template file name (optional)",
                        "description": "File name of the template uploaded in Project Settings, for example Risk.xlsx. Leave empty when the project has one template.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        },
        {
            "id": "epic-excel-settings",
            "type": "ms.vss-web.hub",
            "description": "Upload the Epic Excel template for this project.",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Epic Excel Templates",
                "uri": "dist/settings.html"
            }
        }
    ],
    "contributionTypes": []
}