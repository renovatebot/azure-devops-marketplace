<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="CodeInsight" Version="4.0.1" Publisher="Revenera"/>
    <DisplayName>Code Insight Scan</DisplayName>
    <Description xml:space="preserve">Run a Code Insight scan as part of your build to detect OSS components, licenses, and security vulnerabilities. Includes evidence support for comprehensive scan results.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>Azure Pipelines,Code Scan,Code Insight,Vulnerabilities,Build,Continuous Integration,Detect,Open Source,Security,Utility task,Evidence</Tags>
    <GalleryFlags>Public</GalleryFlags>
    <Icon>icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
      <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
  </Assets>
</PackageManifest>