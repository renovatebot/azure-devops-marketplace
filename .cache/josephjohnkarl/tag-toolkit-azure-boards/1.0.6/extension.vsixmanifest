<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="tag-toolkit-azure-boards" Version="1.0.6" Publisher="josephjohnkarl"/>
    <DisplayName>Tag Toolkit for Azure Boards</DisplayName>
    <Description xml:space="preserve">Tag Toolkit for Azure Boards helps you clean up Azure Boards tags safely: merge duplicates, rename tags, and delete obsolete tags across work items.</Description>
    <Categories>Azure Boards,Azure Test Plans</Categories>
    <Tags>tags,work items,tag toolkit,tag cleanup,merge tags,delete tags,bulk tags,work item tags,tag administration,boards</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Source" Value="https://github.com/JJKW1984/tag-toolkit-azure-boards"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/JJKW1984/tag-toolkit-azure-boards/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Author" Value="https://www.linkedin.com/in/josephjohnkarl/"/>
    </Properties>
    <GalleryFlags>Public</GalleryFlags>
    <Icon>static/images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/hub.js" d:Source="File" Path="dist/hub.js" Addressable="true"/>
    <Asset Type="dist/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/hub.js.map" d:Source="File" Path="dist/hub.js.map" Addressable="true"/>
    <Asset Type="dist/static/images/logo.png" d:Source="File" Path="dist/static/images/logo.png" Addressable="true"/>
    <Asset Type="static/images/logo.png" d:Source="File" Path="static/images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="static/images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>