<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="stale-item-wizard" Publisher="GreyPilgrimTech" Version="0.1.2"/>
    <GalleryFlags>Public</GalleryFlags>
    <DisplayName>Stale Item Wizard</DisplayName>
    <Description xml:space="preserve">A pipeline task that helps you clean up stale work items in Azure DevOps.</Description>
    <Tags>stale,work items,stale item bot,backlog management</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#222222"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://docs.greypilgrim.tech/guides/stale-item-wizard-setup/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://greypilgrim.tech/eula"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacy" Value="https://greypilgrim.tech/privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://greypilgrim.tech/contact"/>
    </Properties>
    <Categories>Azure Pipelines</Categories>
    <Icon>extension-includes/images/extension-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="extension-includes/images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="extension-includes/overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>