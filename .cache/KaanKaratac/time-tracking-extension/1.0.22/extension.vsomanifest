{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "time-tracking-sprint-hub",
            "type": "ms.vss-web.hub",
            "description": "Sprint effort report filtered by iteration and user.",
            "targets": [
                "ms.vss-work-web.work-hub-group",
                "ms.vss-web.project-hub-group"
            ],
            "properties": {
                "name": "Sprint Efforts",
                "uri": "dist/sprintHub.html",
                "order": 36,
                "iconName": "StackedBarChart"
            }
        },
        {
            "id": "time-tracking-settings",
            "type": "ms.vss-web.hub",
            "description": "Configure logging rules per work item type.",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Time Tracking",
                "uri": "dist/settings.html",
                "order": 80,
                "icon": "images/hub-icon.png"
            }
        },
        {
            "id": "time-tracking-work-item-page",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Log time against the open work item.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracking",
                "uri": "dist/workItemForm.html",
                "icon": "images/time-tab-kk-icon.png"
            }
        },
        {
            "id": "time-tracking-work-item-notifications",
            "type": "ms.vss-work-web.work-item-notifications",
            "description": "Syncs effort fields when Original Estimate changes (no UI).",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "uri": "dist/workItemNotifications.html"
            }
        }
    ],
    "contributionTypes": []
}