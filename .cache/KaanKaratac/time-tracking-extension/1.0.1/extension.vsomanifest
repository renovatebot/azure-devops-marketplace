{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "time-tracking-hub",
            "type": "ms.vss-web.hub",
            "description": "Project hub for time entries and summaries.",
            "targets": [
                "ms.vss-web.project-hub-group"
            ],
            "properties": {
                "name": "Time tracking",
                "uri": "dist/hub.html",
                "order": 38,
                "icon": "images/hub-icon.png"
            }
        },
        {
            "id": "time-tracking-settings",
            "type": "ms.vss-web.hub",
            "description": "Configure logging rules per work item type.",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Time tracking",
                "uri": "dist/settings.html",
                "order": 80,
                "icon": "images/hub-icon.png"
            }
        },
        {
            "id": "time-tracking-work-item-page",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Log time against the open work item.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time",
                "uri": "dist/workItemForm.html",
                "icon": "images/hub-icon.png"
            }
        }
    ],
    "contributionTypes": []
}