{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/ms31376/notify-for-azure-boards"
    },
    "contributions": [
        {
            "id": "notify-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Notify",
                "uri": "dist/notification.html",
                "order": 10,
                "title": "Notify",
                "supportsMobile": true
            }
        }
    ],
    "scopes": [
        "vso.work"
    ],
    "contributionTypes": []
}