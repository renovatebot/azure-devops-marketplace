<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="notify-for-azure-boards" Version="2.2.0" Publisher="MehrdadAbdollahiyan"/>
    <DisplayName>Notify for Azure Boards</DisplayName>
    <Description xml:space="preserve">A personal notification inbox in Azure Boards: mentions, assignments, comments, state changes and due dates, with optional desktop notifications.</Description>
    <Categories>Azure Boards</Categories>
    <Tags>notifications,mentions,inbox,work items,boards</Tags>
    <GalleryFlags>Public</GalleryFlags>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/app.js" d:Source="File" Path="dist/app.js" Addressable="true"/>
    <Asset Type="dist/core.js" d:Source="File" Path="dist/core.js" Addressable="true"/>
    <Asset Type="dist/i18n.js" d:Source="File" Path="dist/i18n.js" Addressable="true"/>
    <Asset Type="dist/lib/VSS.SDK.min.js" d:Source="File" Path="dist/lib/VSS.SDK.min.js" Addressable="true"/>
    <Asset Type="dist/notification.html" d:Source="File" Path="dist/notification.html" Addressable="true"/>
    <Asset Type="dist/style.css" d:Source="File" Path="dist/style.css" Addressable="true"/>
    <Asset Type="images/logo.png" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>