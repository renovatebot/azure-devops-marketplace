{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.project_write"
    ],
    "contributions": [
        {
            "id": "capasight-hub",
            "type": "ms.vss-web.hub",
            "description": "Capasight, under Boards.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Capasight",
                "order": 100,
                "uri": "dist/index.html"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "capasight-hub",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}