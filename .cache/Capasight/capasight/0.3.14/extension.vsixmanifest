<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="capasight" Publisher="Capasight" Version="0.3.14"/>
    <DisplayName>Capasight</DisplayName>
    <Description xml:space="preserve">Visibility for what's next: estimates, emerging work and capacity for your ARTs and value streams. 30-day free trial; free for up to 10 users.</Description>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>capacity planning,SAFe,PI planning,portfolio,ART,value stream,forecast,delivery risk,__BYOLENFORCED</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#082a50"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://capasight.co.uk"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://capasight.co.uk/resources.html"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://capasight.co.uk/resources.html#support"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://capasight.co.uk/privacy.html#azure"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://capasight.co.uk/licence.html"/>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="30"/>
    </Properties>
    <Icon>images/listing/icon.png</Icon>
    <License>docs/listing/licence.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
    <Asset Type="dist/index.html" d:Source="File" Path="dist/index.html" Addressable="true"/>
    <Asset Type="dist/capasight.js" d:Source="File" Path="dist/capasight.js" Addressable="true"/>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="images/listing/actions.png" d:Source="File" Path="images/listing/actions.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.4" d:Source="File" Path="images/listing/actions.png" Addressable="true"/>
    <Asset Type="images/listing/capacity.png" d:Source="File" Path="images/listing/capacity.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.3" d:Source="File" Path="images/listing/capacity.png" Addressable="true"/>
    <Asset Type="images/listing/delivery.png" d:Source="File" Path="images/listing/delivery.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.2" d:Source="File" Path="images/listing/delivery.png" Addressable="true"/>
    <Asset Type="images/listing/icon.png" d:Source="File" Path="images/listing/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/listing/icon.png" Addressable="true"/>
    <Asset Type="images/listing/overview.png" d:Source="File" Path="images/listing/overview.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="images/listing/overview.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="docs/listing/overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Pricing" d:Source="File" Path="docs/listing/pricing.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="docs/listing/licence.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Privacypolicy" d:Source="File" Path="docs/listing/privacy.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
