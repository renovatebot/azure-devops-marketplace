<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="medissys-ftr-manager-rt" Publisher="RedsenTechnology" Version="0.2.9"/>
    <DisplayName>Medissys FTR Manager (Beta)</DisplayName>
    <Description xml:space="preserve">Enterprise Azure DevOps extension for creating, freezing, reviewing, and deploying Fast Track Releases.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards,Azure Pipelines</Categories>
    <Icon>images/ftr-manager-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/ftr-manager.css" d:Source="File" Path="dist/ftr-manager.css" Addressable="true"/>
    <Asset Type="dist/ftr-manager.js" d:Source="File" Path="dist/ftr-manager.js" Addressable="true"/>
    <Asset Type="dist/ftr-manager.js.map" d:Source="File" Path="dist/ftr-manager.js.map" Addressable="true"/>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/probe.html" d:Source="File" Path="dist/probe.html" Addressable="true"/>
    <Asset Type="dist/probe.js" d:Source="File" Path="dist/probe.js" Addressable="true"/>
    <Asset Type="images/ftr-manager-icon.png" d:Source="File" Path="images/ftr-manager-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/ftr-manager-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>