<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="safe-ado" Publisher="SAFeADO" Version="1.3.0"/>
    <GalleryFlags>Public</GalleryFlags>
    <DisplayName>SAFe Ado</DisplayName>
    <Description xml:space="preserve">Scaled agile planning for SAFe® in Azure Boards (Services and Server 2022.1): ART and team planning boards, roadmap, PI Objectives, ROAM risks, PI Planning and reports.</Description>
    <Categories>Azure Boards</Categories>
    <Tags>SAFe,PI Planning,ART,Program Board,Portfolio,Scaled Agile</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/eslam-sa3d/safe-ado"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/eslam-sa3d/safe-ado"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/eslam-sa3d/safe-ado/issues"/>
    </Properties>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
