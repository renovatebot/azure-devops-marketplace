{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/eslam-sa3d/safe-ado"
    },
    "scopes": [
        "vso.work_write",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "safe-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "SAFe",
                "uri": "dist/hub.html",
                "iconName": "Org",
                "order": 99
            }
        }
    ],
    "contributionTypes": []
}