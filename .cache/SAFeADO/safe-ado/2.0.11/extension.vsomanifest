{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/eslam-sa3d/agilo-support"
    },
    "CustomerQnASupport": {
        "enableqna": true,
        "url": "https://github.com/eslam-sa3d/agilo-support/issues"
    },
    "scopes": [
        "vso.work_full",
        "vso.project",
        "vso.analytics"
    ],
    "contributions": [
        {
            "id": "agilo-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Agilo: scaled agile delivery in Azure DevOps.",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Agilo",
                "order": 99,
                "icon": {
                    "light": "img/agilo-icon-64.png",
                    "dark": "img/agilo-icon-64.png"
                }
            }
        },
        {
            "id": "agilo-program",
            "type": "ms.vss-web.hub",
            "description": "Program dashboard, backlog, releases, dependencies, risks, objectives and traceability.",
            "targets": [
                ".agilo-hub-group"
            ],
            "properties": {
                "name": "Agilo Program",
                "order": 1,
                "uri": "dist/program/program.html",
                "icon": {
                    "light": "img/hubs/program-light.png",
                    "dark": "img/hubs/program-dark.png"
                }
            }
        },
        {
            "id": "agilo-squads",
            "type": "ms.vss-web.hub",
            "description": "Squad dashboards, teams and capacity, read from Azure DevOps.",
            "targets": [
                ".agilo-hub-group"
            ],
            "properties": {
                "name": "Agilo Squads",
                "order": 2,
                "uri": "dist/squads/squads.html",
                "icon": {
                    "light": "img/hubs/squads-light.png",
                    "dark": "img/hubs/squads-dark.png"
                }
            }
        },
        {
            "id": "agilo-pi-planning",
            "type": "ms.vss-web.hub",
            "description": "Sprints, dependency board, risks and PI objectives.",
            "targets": [
                ".agilo-hub-group"
            ],
            "properties": {
                "name": "Agilo PI Planning",
                "order": 3,
                "uri": "dist/pi-planning/pi-planning.html",
                "icon": {
                    "light": "img/hubs/pi-planning-light.png",
                    "dark": "img/hubs/pi-planning-dark.png"
                }
            }
        },
        {
            "id": "agilo-settings",
            "type": "ms.vss-web.hub",
            "description": "Field map, Definition of Ready, Planning Poker decks and environment check.",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Agilo settings",
                "order": 60,
                "uri": "dist/settings/settings.html"
            }
        },
        {
            "id": "agilo-hierarchy-rules",
            "type": "ms.vss-web.hub",
            "description": "Allowed parent and child work item types (from Canary-workitems).",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Hierarchy rules",
                "order": 61,
                "uri": "dist/hierarchy-rules/hierarchy-rules.html"
            }
        },
        {
            "id": "agilo-planning-poker",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Planning Poker on the work item form (from Azure-Planning-Poker).",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Planning Poker",
                "uri": "dist/poker-group/poker-group.html",
                "height": 420
            }
        },
        {
            "id": "agilo-link-validation",
            "type": "ms.vss-work-web.work-item-notifications",
            "description": "Blocks Parent/Child links the hierarchy rules do not allow (from Canary-workitems).",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "uri": "dist/link-validation/link-validation.html"
            }
        },
        {
            "id": "agilo-projects",
            "type": "ms.vss-web.hub",
            "description": "Choose which projects show Agilo.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Agilo projects",
                "order": 100,
                "uri": "dist/projects/projects.html"
            }
        }
    ],
    "contributionTypes": []
}