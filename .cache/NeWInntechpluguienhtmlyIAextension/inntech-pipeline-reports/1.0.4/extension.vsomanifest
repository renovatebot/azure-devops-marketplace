{
    "manifestVersion": 1,
    "scopes": [
        "vso.build"
    ],
    "contributions": [
        {
            "id": "publish-html-report-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/PublishHtmlReport"
            }
        },
        {
            "id": "publish-ai-provenance-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/PublishAiProvenance"
            }
        },
        {
            "id": "html-reports-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "description": "Lista y muestra los informes HTML publicados con PublishHtmlReport.",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "Reportes HTML",
                "uri": "web/html-reports/index.html",
                "supportsTasks": [
                    "3a82ba8f-d376-4061-8696-22ef73af5cbe"
                ]
            }
        },
        {
            "id": "ai-provenance-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "description": "Muestra la proveniencia IA publicada con PublishAiProvenance.",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "Proveniencia IA",
                "uri": "web/ai-provenance/index.html",
                "supportsTasks": [
                    "82ea66e1-30b3-401e-a899-c337bf9b6d0a"
                ]
            }
        }
    ],
    "contributionTypes": []
}