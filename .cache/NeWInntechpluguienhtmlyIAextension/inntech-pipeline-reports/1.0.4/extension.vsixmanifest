<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="inntech-pipeline-reports" Version="1.0.4" Publisher="NeWInntechpluguienhtmlyIAextension"/>
    <DisplayName>Inntech Pipeline Reports</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">Pestañas «Reportes HTML» y «Proveniencia IA» en cada ejecución, con las tareas PublishHtmlReport y PublishAiProvenance.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>html report,pipeline reports,ai provenance,build results</Tags>
    <Icon>images/extension-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="web/ai-provenance/index.html" d:Source="File" Path="web/ai-provenance/index.html" Addressable="true"/>
    <Asset Type="web/ai-provenance/main.js" d:Source="File" Path="web/ai-provenance/main.js" Addressable="true"/>
    <Asset Type="web/html-reports/index.html" d:Source="File" Path="web/html-reports/index.html" Addressable="true"/>
    <Asset Type="web/html-reports/main.js" d:Source="File" Path="web/html-reports/main.js" Addressable="true"/>
    <Asset Type="web/html-reports/report-frame.html" d:Source="File" Path="web/html-reports/report-frame.html" Addressable="true"/>
    <Asset Type="web/styles.css" d:Source="File" Path="web/styles.css" Addressable="true"/>
    <Asset Type="images/extension-icon.png" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>