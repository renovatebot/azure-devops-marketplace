<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="workitem-markdown-export" Publisher="LucasCostaBH" Version="0.4.1"/>
    <DisplayName>Work Item → Markdown (para IA)</DisplayName>
    <Description xml:space="preserve">Exporta um work item e as tarefas filhas pendentes para Markdown, com os anexos, num .zip pronto para abrir no VS Code e entregar ao Claude Code.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>work items,markdown,export,ai,claude</Tags>
    <Icon>images/logo.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/apply-menu.html" d:Source="File" Path="dist/apply-menu.html" Addressable="true"/>
    <Asset Type="dist/apply-menu.js" d:Source="File" Path="dist/apply-menu.js" Addressable="true"/>
    <Asset Type="dist/apply-menu.js.map" d:Source="File" Path="dist/apply-menu.js.map" Addressable="true"/>
    <Asset Type="dist/apply.html" d:Source="File" Path="dist/apply.html" Addressable="true"/>
    <Asset Type="dist/apply.js" d:Source="File" Path="dist/apply.js" Addressable="true"/>
    <Asset Type="dist/apply.js.map" d:Source="File" Path="dist/apply.js.map" Addressable="true"/>
    <Asset Type="dist/dialog.html" d:Source="File" Path="dist/dialog.html" Addressable="true"/>
    <Asset Type="dist/dialog.js" d:Source="File" Path="dist/dialog.js" Addressable="true"/>
    <Asset Type="dist/dialog.js.LICENSE.txt" d:Source="File" Path="dist/dialog.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/dialog.js.map" d:Source="File" Path="dist/dialog.js.map" Addressable="true"/>
    <Asset Type="dist/menu.html" d:Source="File" Path="dist/menu.html" Addressable="true"/>
    <Asset Type="dist/menu.js" d:Source="File" Path="dist/menu.js" Addressable="true"/>
    <Asset Type="dist/menu.js.map" d:Source="File" Path="dist/menu.js.map" Addressable="true"/>
    <Asset Type="dist/report.html" d:Source="File" Path="dist/report.html" Addressable="true"/>
    <Asset Type="dist/report.js" d:Source="File" Path="dist/report.js" Addressable="true"/>
    <Asset Type="dist/report.js.map" d:Source="File" Path="dist/report.js.map" Addressable="true"/>
    <Asset Type="images/logo.png" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
