{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.code"
    ],
    "contributions": [
        {
            "id": "export-md-action",
            "type": "ms.vss-web.action",
            "description": "Ação de menu que gera o Markdown do work item.",
            "targets": [
                "ms.vss-work-web.work-item-context-menu",
                "ms.vss-work-web.work-item-form-toolbar-menu",
                "ms.vss-work-web.backlog-item-menu",
                "ms.vss-work-web.query-result-work-item-menu"
            ],
            "properties": {
                "text": "Exportar para Markdown (IA)",
                "title": "Gera o .md do work item e das tarefas filhas pendentes, com os anexos, num .zip",
                "icon": "images/logo.png",
                "groupId": "actions",
                "uri": "dist/menu.html",
                "registeredObjectId": "export-md-action"
            }
        },
        {
            "id": "export-md-dialog",
            "type": "ms.vss-web.control",
            "description": "Conteúdo do diálogo de exportação (progresso e download do .zip).",
            "targets": [],
            "properties": {
                "uri": "dist/dialog.html"
            }
        },
        {
            "id": "report-hub",
            "type": "ms.vss-web.hub",
            "description": "Hub com o relatório de acompanhamento do período.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Relatório de acompanhamento",
                "order": 99,
                "uri": "dist/report.html",
                "icon": "images/logo.png"
            }
        },
        {
            "id": "apply-ai-action",
            "type": "ms.vss-web.action",
            "description": "Aplica o retorno do agente no work item: comentário, estado e tarefas filhas.",
            "targets": [
                "ms.vss-work-web.work-item-context-menu",
                "ms.vss-work-web.work-item-form-toolbar-menu",
                "ms.vss-work-web.backlog-item-menu",
                "ms.vss-work-web.query-result-work-item-menu"
            ],
            "properties": {
                "text": "Aplicar retorno da IA",
                "title": "Cola a resposta do agente e aplica comentário, estado e tarefas filhas — com confirmação",
                "icon": "images/logo.png",
                "groupId": "actions",
                "uri": "dist/menu.html",
                "registeredObjectId": "apply-ai-action"
            }
        },
        {
            "id": "apply-ai-dialog",
            "type": "ms.vss-web.control",
            "description": "Conteúdo do diálogo de aplicação do retorno da IA.",
            "targets": [],
            "properties": {
                "uri": "dist/apply.html"
            }
        }
    ],
    "contributionTypes": []
}