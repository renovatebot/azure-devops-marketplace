{
    "manifestVersion": 1,
    "scopes": [
        "vso.build"
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/radwanalmsora/runlens-azure-devops"
    },
    "contributions": [
        {
            "id": "runlens-build-results-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "description": "RunLens analysis for a single build: failure cause, slowest tasks, and comparison with recent builds.",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "RunLens",
                "uri": "dist/index.html",
                "registeredObjectId": "registerBuild",
                "dynamic": true
            }
        }
    ],
    "contributionTypes": []
}