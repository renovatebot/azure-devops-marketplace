{
  "manifestVersion": 1,
  "id": "devopslens",
  "publisher": "RadwanAlmsora",
  "version": "1.0.0",
  "name": "DevOpsLens: AI PR Summaries & Release Notes",
  "description": "Summarize pull requests, validate commit messages and generate release notes in one click, in English or Arabic.",
  "public": false,
  "categories": ["Azure Repos", "Azure Pipelines"],
  "tags": ["pull request", "release notes", "ai", "summary", "commit", "changelog", "code review", "arabic"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "icons": { "default": "images/icon-128.png" },
  "content": {
    "details": { "path": "overview.md" },
    "license": { "path": "LICENSE.txt" }
  },
  "links": {
    "getstarted": { "uri": "https://github.com/your-org/devopslens/blob/main/docs/documentation.md" },
    "learn": { "uri": "https://github.com/your-org/devopslens/blob/main/docs/documentation.md" },
    "support": { "uri": "https://github.com/your-org/devopslens/blob/main/docs/support.md" },
    "privacypolicy": { "uri": "https://github.com/your-org/devopslens/blob/main/docs/privacy.md" },
    "license": { "uri": "https://github.com/your-org/devopslens/blob/main/LICENSE.txt" }
  },
  "repository": { "type": "git", "uri": "https://github.com/your-org/devopslens" },
  "CustomerQnASupport": { "enablement": "true" },
  "scopes": ["vso.code", "vso.code_write", "vso.work", "vso.build"],
  "files": [
    { "path": "pr-tab.html", "addressable": true },
    { "path": "build-tab.html", "addressable": true },
    { "path": "css", "addressable": true },
    { "path": "js", "addressable": true },
    { "path": "lib", "addressable": true },
    { "path": "images", "addressable": true },
    { "path": "docs", "addressable": true }
  ],
  "contributions": [
    {
      "id": "pr-ai-summary-tab",
      "type": "ms.vss-web.tab",
      "description": "AI Summary tab on pull requests",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": { "name": "AI Summary", "uri": "pr-tab.html" }
    },
    {
      "id": "build-release-notes-tab",
      "type": "ms.vss-build-web.build-results-tab",
      "description": "Release Notes tab on pipeline runs",
      "targets": ["ms.vss-build-web.build-results-view"],
      "properties": { "name": "Release Notes", "uri": "build-tab.html" }
    }
  ]
}
