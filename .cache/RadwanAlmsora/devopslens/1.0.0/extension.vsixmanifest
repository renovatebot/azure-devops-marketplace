<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="devopslens" Version="1.0.0" Publisher="RadwanAlmsora" />
    <DisplayName>DevOpsLens: AI PR Summaries &amp; Release Notes</DisplayName>
    <Description xml:space="preserve">Summarize pull requests, validate commit messages and generate release notes in one click, in English or Arabic.</Description>
    <Tags>pull request,release notes,ai,summary,commit,changelog,code review,arabic</Tags>
    <Categories>Azure Repos,Azure Pipelines</Categories>
    <GalleryFlags>Public</GalleryFlags>
    <Properties><Property Id="Microsoft.VisualStudio.Services.Links.GetStarted" Value="https://github.com/your-org/devopslens/blob/main/docs/documentation.md" /><Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://github.com/your-org/devopslens/blob/main/docs/documentation.md" /><Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/your-org/devopslens/blob/main/docs/support.md" /><Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://github.com/your-org/devopslens/blob/main/docs/privacy.md" /><Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/your-org/devopslens/blob/main/LICENSE.txt" /><Property Id="Microsoft.VisualStudio.Services.Links.Source" Value="https://github.com/your-org/devopslens" /><Property Id="Microsoft.VisualStudio.Services.CustomerQnASupport.Enablement" Value="true" /></Properties>
    <License>LICENSE.txt</License>
    <Icon>images/icon-128.png</Icon>
  </Metadata>
  <Installation><InstallationTarget Id="Microsoft.VisualStudio.Services" /></Installation>
  <Dependencies/>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" Path="extension.vsomanifest" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="images/icon-128.png" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="overview.md" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" Path="LICENSE.txt" Addressable="true" />
  </Assets>
</PackageManifest>