<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="package-sentinel" Version="1.0.0" Publisher="RadwanAlmsora" />
    <DisplayName>Package Sentinel: Security &amp; Governance for Azure Artifacts</DisplayName>
    <Description xml:space="preserve">Audit feed permissions, track package lifecycle, analyze retention policies and preview safe cleanups for Azure Artifacts.</Description>
    <Tags>artifacts,feeds,security,audit,retention,governance,packages,cleanup,nuget,npm</Tags>
    <Categories>Azure Artifacts</Categories>
    <GalleryFlags>Public</GalleryFlags>
    <Properties><Property Id="Microsoft.VisualStudio.Services.Links.GetStarted" Value="https://github.com/radwanalmsora/package-sentinel/blob/main/docs/documentation.md" /><Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://github.com/radwanalmsora/package-sentinel/blob/main/docs/documentation.md" /><Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/radwanalmsora/package-sentinel/blob/main/docs/support.md" /><Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://github.com/radwanalmsora/package-sentinel/blob/main/docs/privacy.md" /><Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/radwanalmsora/package-sentinel/blob/main/LICENSE.txt" /><Property Id="Microsoft.VisualStudio.Services.Links.Source" Value="https://github.com/radwanalmsora/package-sentinel" /><Property Id="Microsoft.VisualStudio.Services.CustomerQnASupport.Enablement" Value="true" /></Properties>
    <License>LICENSE.txt</License>
    <Icon>images/icon-128.png</Icon>
  </Metadata>
  <Installation><InstallationTarget Id="Microsoft.VisualStudio.Services" /></Installation>
  <Dependencies/>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" Path="extension.vsomanifest" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="images/icon-128.png" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="overview.md" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" Path="LICENSE.txt" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" Path="images/screenshots/01-security-audit.png" Addressable="true" /><Asset Type="Microsoft.VisualStudio.Services.Screenshots.2" Path="images/screenshots/02-package-lifecycle.png" Addressable="true" /><Asset Type="Microsoft.VisualStudio.Services.Screenshots.3" Path="images/screenshots/03-retention-analyzer.png" Addressable="true" /><Asset Type="Microsoft.VisualStudio.Services.Screenshots.4" Path="images/screenshots/04-safe-cleanup.png" Addressable="true" />
  </Assets>
</PackageManifest>