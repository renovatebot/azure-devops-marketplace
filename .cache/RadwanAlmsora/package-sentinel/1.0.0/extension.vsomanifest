{
  "manifestVersion": 1,
  "id": "package-sentinel",
  "publisher": "RadwanAlmsora",
  "version": "1.0.0",
  "name": "Package Sentinel: Security & Governance for Azure Artifacts",
  "description": "Audit feed permissions, track package lifecycle, analyze retention policies and preview safe cleanups for Azure Artifacts.",
  "public": false,
  "categories": ["Azure Artifacts"],
  "tags": ["artifacts", "feeds", "security", "audit", "retention", "governance", "packages", "cleanup", "nuget", "npm"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "icons": { "default": "images/icon-128.png" },
  "branding": { "color": "#0A2634", "theme": "dark" },
  "content": {
    "details": { "path": "overview.md" },
    "license": { "path": "LICENSE.txt" }
  },
  "screenshots": [
    { "path": "images/screenshots/01-security-audit.png" },
    { "path": "images/screenshots/02-package-lifecycle.png" },
    { "path": "images/screenshots/03-retention-analyzer.png" },
    { "path": "images/screenshots/04-safe-cleanup.png" }
  ],
  "links": {
    "getstarted": { "uri": "https://github.com/radwanalmsora/package-sentinel/blob/main/docs/documentation.md" },
    "learn": { "uri": "https://github.com/radwanalmsora/package-sentinel/blob/main/docs/documentation.md" },
    "support": { "uri": "https://github.com/radwanalmsora/package-sentinel/blob/main/docs/support.md" },
    "privacypolicy": { "uri": "https://github.com/radwanalmsora/package-sentinel/blob/main/docs/privacy.md" },
    "license": { "uri": "https://github.com/radwanalmsora/package-sentinel/blob/main/LICENSE.txt" }
  },
  "repository": { "type": "git", "uri": "https://github.com/radwanalmsora/package-sentinel" },
  "CustomerQnASupport": { "enablement": "true" },
  "scopes": ["vso.packaging_manage"],
  "files": [
    { "path": "sentinel.html", "addressable": true },
    { "path": "css", "addressable": true },
    { "path": "js", "addressable": true },
    { "path": "lib", "addressable": true },
    { "path": "images", "addressable": true },
    { "path": "docs", "addressable": true }
  ],
  "contributions": [
    {
      "id": "sentinel-hub-group",
      "type": "ms.vss-web.hub-group",
      "description": "Package Sentinel navigation group",
      "targets": ["ms.vss-web.project-hub-groups-collection"],
      "properties": { "name": "Package Sentinel", "order": 100 }
    },
    {
      "id": "sentinel-hub",
      "type": "ms.vss-web.hub",
      "description": "Security and governance dashboard for Azure Artifacts",
      "targets": [".sentinel-hub-group"],
      "properties": { "name": "Security Dashboard", "order": 1, "uri": "sentinel.html" }
    }
  ]
}
