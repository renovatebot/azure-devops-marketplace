{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.project"
    ],
    "demands": [
        "api-version/7.1"
    ],
    "contributions": [
        {
            "id": "desk-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Email desk",
                "uri": "dist/ext/hub.html",
                "order": 100,
                "iconName": "Mail"
            }
        },
        {
            "id": "email-page",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Email",
                "uri": "dist/ext/email.html"
            }
        },
        {
            "id": "requester-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Requester",
                "uri": "dist/ext/group.html",
                "height": 96
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "desk-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "email-page",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "requester-group",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}