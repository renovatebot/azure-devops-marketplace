    <DisplayName>Recurring Work Items</DisplayName>
    <Description xml:space="preserve">Repeat any work item on a schedule: weekly, monthly, every sprint or after the last one closes, with its child tasks and a rotating assignee.</Description>
    <Categories>Azure Boards</Categories>
    <Tags>recurring,recurring work items,repeat,schedule,scheduled,sprint,rotation,work items,boards,__BYOLENFORCED,__TrialDays:30</Tags>
