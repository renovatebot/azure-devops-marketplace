{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.project"
    ],
    "demands": [
        "api-version/7.1"
    ],
    "contributions": [
        {
            "id": "recur-action",
            "type": "ms.vss-web.action-provider",
            "targets": [
                "ms.vss-work-web.work-item-toolbar-menu",
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "uri": "dist/ext/action.html",
                "registeredObjectId": "recur-action"
            }
        },
        {
            "id": "recur-panel",
            "type": "ms.vss-web.external-content",
            "properties": {
                "uri": "dist/ext/panel.html"
            }
        },
        {
            "id": "history-panel",
            "type": "ms.vss-web.external-content",
            "properties": {
                "uri": "dist/ext/history.html"
            }
        },
        {
            "id": "recur-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Recurring",
                "uri": "dist/ext/group.html",
                "height": 92
            }
        },
        {
            "id": "recur-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Recurring",
                "uri": "dist/ext/hub.html",
                "order": 99,
                "iconName": "Refresh"
            }
        }
    ],
    "contributionTypes": []
}