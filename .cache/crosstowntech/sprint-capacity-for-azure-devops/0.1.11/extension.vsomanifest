{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.project"
    ],
    "demands": [
        "api-version/7.1"
    ],
    "contributions": [
        {
            "id": "points-tab",
            "type": "ms.vss-web.tab",
            "targets": [
                "ms.vss-work-web.iteration-backlog-tabs"
            ],
            "properties": {
                "name": "Points capacity",
                "uri": "dist/ext/tab.html",
                "registeredObjectId": "points-tab"
            }
        },
        {
            "id": "points-pane",
            "type": "ms.vss-work-web.backlog-panel",
            "targets": [
                "ms.vss-work-web.iteration-backlog-toolpane"
            ],
            "properties": {
                "title": "Points capacity",
                "name": "Points capacity",
                "uri": "dist/ext/pane.html",
                "registeredObjectId": "points-pane"
            }
        },
        {
            "id": "points-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Points capacity",
                "uri": "dist/ext/hub.html",
                "order": 99,
                "iconName": "BarChartVertical"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "points-tab",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "points-pane",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "points-hub",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}