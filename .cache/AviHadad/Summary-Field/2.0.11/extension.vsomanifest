{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write"
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/avih75/SummaryField"
    },
    "contributions": [
        {
            "id": "Summary_Field",
            "description": "Add a Label with summary of several fields",
            "type": "ms.vss-work-web.work-item-form-control",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Summary Field Control",
                "uri": "dist/Control/Control.html",
                "inputs": [
                    {
                        "id": "summaryFieldList",
                        "name": "Field list to summarise",
                        "description": "Semicolon-separated list of work item field reference names",
                        "type": "TextArea",
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "summaryLabelList",
                        "name": "Label list",
                        "description": "Semicolon-separated list of display labels (one per field)",
                        "type": "TextArea",
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "summaryColorList",
                        "name": "Color list",
                        "description": "Semicolon-separated CSS colors for each field label (inherit/blue/red/green...)",
                        "type": "TextArea",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "summaryField",
                        "name": "Summary Field",
                        "description": "Optional: work item field to auto-save the summary text into",
                        "type": "WorkItemField",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        }
    ],
    "contributionTypes": []
}