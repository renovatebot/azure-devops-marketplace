        },
        {
            "id": "myAction",
            "description": "Upload a picker CSV from the work item context menu",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "text": "Upload Picker csv",
                "title": "Upload Picker control CSV Dependencies file",
                "icon": "img/icon.png",
                "groupId": "Picker",
                "uri": "dist/Action/Action.html"
            }
        },
        {
            "id": "configureMultiPickerCSV",
            "type": "ms.vss-web.hub",
            "description": "Adds a 'Multi picker Fields Map Configuration' hub to the collection admin hub group.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Multi Picker",
                "uri": "dist/Hub/Hub.html",
                "order": 99
            }
        }
