                    {
                        "id": "FieldName6",
                        "name": "Field Name 6 (optional)",
                        "type": "TextArea",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "Field6",
                        "name": "Field 6 (optional)",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
