{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_full",
        "vso.work",
        "vso.work_write",
        "vso.identity",
        "vso.graph",
        "vso.project",
        "vso.security_manage"
    ],
    "contributions": [
        {
            "id": "Multi_Pickers_Fields_Control",
            "description": "Cascading picker fields — unlimited levels",
            "type": "ms.vss-work-web.work-item-form-control",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Multi Pickers Fields with dependencies",
                "uri": "dist/Control/Control.html",
                "inputs": [
                    {
                        "id": "ControlName",
                        "name": "Control Name",
                        "description": "Storage key for this control's CSV data. Also used as the CSV filename.",
                        "type": "TextArea",
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "FieldCount",
                        "name": "Field Count",
                        "description": "Number of cascading levels (2–8). Default: 2.",
                        "type": "TextArea",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "FieldName1",
                        "name": "Field Name 1",
                        "type": "TextArea",
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "Field1",
                        "name": "Field 1",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
                                "Double",
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "Field1Hide",
                        "name": "Hide Field 1",
                        "inputMode": "CheckBox",
                        "validation": {
                            "dataType": "Boolean"
                        }
                    },
                    {
                        "id": "Field1Required",
                        "name": "Field 1 Required",
                        "inputMode": "CheckBox",
                        "validation": {
                            "dataType": "Boolean"
                        }
                    },
                    {
                        "id": "FieldName2",
                        "name": "Field Name 2",
                        "type": "TextArea",
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "Field2",
                        "name": "Field 2",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
                                "Double",
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "Field2Hide",
                        "name": "Hide Field 2",
                        "inputMode": "CheckBox",
                        "validation": {
                            "dataType": "Boolean"
