                        "name": "Summarize to Path field",
                        "description": "Write backslash-separated path of all level values into this field.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
                                "Double",
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "Reposetory",
                        "name": "Backup Repository",
                        "description": "ProjectName\\RepoName — push CSV backup to this Git repo.",
                        "type": "TextArea",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "ViewOption",
                        "name": "View Option",
                        "description": "Number of dropdowns per row (1–4). Default: 1.",
                        "type": "TextArea",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "PrivateBehaviure",
                        "name": "Private Behaviour",
                        "description": "Set to 'Auto' to auto-select when only one option is available.",
                        "type": "TextArea",
                        "validation": {
