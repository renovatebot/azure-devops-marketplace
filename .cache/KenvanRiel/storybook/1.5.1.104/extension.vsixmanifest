  <Metadata>
    <Identity Language="en-US" Id="storybook" Publisher="KenvanRiel" Version="1.5.1.104"/>
    <DisplayName>Storybook</DisplayName>
    <Description xml:space="preserve">Your team's Storybook, right inside Azure DevOps. Create one in a click or use the one already in your repo. It's read straight from Azure Repos.</Description>
    <Tags>Storybook,UI components,Design system,Component library,React,Documentation</Tags>
    <Categories>Azure Boards</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://marketplace.visualstudio.com/items?itemName=KenvanRiel.storybook&amp;ssr=false#qna"/>
