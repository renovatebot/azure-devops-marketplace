{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_manage"
    ],
    "contributions": [
        {
            "id": "designs-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Designs",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Designs",
                "order": 120,
                "iconAsset": "KenvanRiel.storybook/static/images/hub-icon.png",
                "_sharedData": {
                    "assets": [
                        "KenvanRiel.storybook/static/images/hub-icon.png"
                    ]
                }
            }
        },
        {
            "id": "storybook-hub-overview",
            "type": "ms.vss-web.hub",
            "description": "Storybook overview",
            "targets": [
                ".designs-hub-group"
            ],
            "properties": {
                "name": "Overview",
                "order": 10,
                "uri": "dist/hub/index.html"
            }
        },
        {
            "id": "publish-panel",
            "type": "ms.vss-web.external-content",
            "description": "Publish code as Storybook panel",
            "properties": {
                "uri": "dist/panel/index.html"
            }
        },
        {
            "id": "folder-dialog",
            "type": "ms.vss-web.external-content",
            "description": "Select a folder dialog of the publish panel",
            "properties": {
                "uri": "dist/folder-dialog/index.html"
            }
        }
    ],
    "contributionTypes": []
}