  <Metadata>
    <Identity Language="en-US" Id="umbraco-pr-preview" Version="0.1.6" Publisher="Moriyama"/>
    <DisplayName>Umbraco PR Preview</DisplayName>
    <GalleryFlags>Public Preview</GalleryFlags>
    <Description xml:space="preserve">Renders changed uSync and Umbraco Deploy data types and document types in a pull request tab, using the real Umbraco backoffice editors, side by side with the target branch.</Description>
    <Categories>Azure Repos</Categories>
    <Tags>Umbraco,uSync,Umbraco Deploy,pull request,code review</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/Moriyama-Umbraco/umbraco-pr-preview"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/Moriyama-Umbraco/umbraco-pr-preview/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/Moriyama-Umbraco/umbraco-pr-preview/blob/main/LICENSE"/>
    </Properties>
    <Icon>images/icon.png</Icon>
  </Metadata>
