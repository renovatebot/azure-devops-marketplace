<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="azure-pr-pipeline-export" Publisher="codylabs" Version="0.1.1"/>
    <DisplayName>PR &amp; Pipeline History Export for Azure DevOps</DisplayName>
    <Description xml:space="preserve">Export pull request history, pipeline runs and test runs to a typed Excel workbook with review and merge time metrics.</Description>
    <GalleryFlags/>
    <Categories>Azure Repos,Azure Pipelines</Categories>
    <Tags>pull requests,pipelines,Excel,export,reporting,DORA</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://codylabs.uk/azure-pr-pipeline-export/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://codylabs.uk/azure-pr-pipeline-export/privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://codylabs.uk/azure-pr-pipeline-export/terms"/>
    </Properties>
    <Icon>img/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub.css" d:Source="File" Path="dist/hub.css" Addressable="true"/>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/hub.js" d:Source="File" Path="dist/hub.js" Addressable="true"/>
    <Asset Type="dist/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="img/icon.png" d:Source="File" Path="img/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>