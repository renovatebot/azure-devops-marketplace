{
    "manifestVersion": 1,
    "scopes": [
        "vso.wiki",
        "vso.code"
    ],
    "contributions": [
        {
            "id": "azure-wiki-export-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "Wiki Export",
                "description": "Export wiki pages to Word.",
                "order": 120,
                "uri": "dist/hub.html",
                "iconName": "WordDocument"
            }
        }
    ],
    "contributionTypes": []
}