{
    "manifestVersion": 1,
    "scopes": [
        "vso.test",
        "vso.work"
    ],
    "contributions": [
        {
            "id": "azure-test-evidence-export-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-test-web.test-hub-group"
            ],
            "properties": {
                "name": "Test Evidence Export",
                "description": "Export test plan results to Word and Excel.",
                "order": 120,
                "uri": "dist/hub.html",
                "iconName": "WordDocument"
            }
        }
    ],
    "contributionTypes": []
}