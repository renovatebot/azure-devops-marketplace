<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="azure-test-evidence-export" Publisher="codylabs" Version="0.1.2"/>
    <DisplayName>Test Evidence Export for Azure Test Plans</DisplayName>
    <Description xml:space="preserve">Turn Azure Test Plans results into a sign-off Word document and an Excel traceability matrix. Step outcomes, linked bugs and requirements, screenshots. Runs in your browser.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Test Plans</Categories>
    <Tags>test plan,test evidence,UAT,sign-off,traceability matrix,Word,Excel,validation</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://codylabs.uk/azure-test-evidence-export/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://codylabs.uk/azure-test-evidence-export/privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://codylabs.uk/azure-test-evidence-export/terms"/>
    </Properties>
    <Icon>img/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub.css" d:Source="File" Path="dist/hub.css" Addressable="true"/>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/hub.js" d:Source="File" Path="dist/hub.js" Addressable="true"/>
    <Asset Type="dist/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="img/icon.png" d:Source="File" Path="img/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>