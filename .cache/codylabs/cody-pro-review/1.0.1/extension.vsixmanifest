<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="cody-pro-review" Version="1.0.1" Publisher="codylabs"/>
    <DisplayName>Cody Pro - AI Code Review</DisplayName>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Description xml:space="preserve">AI code review for Azure DevOps pull requests, powered by Anthropic Claude or OpenAI. Requires a Cody Pro license from codylabs.gumroad.com/l/cody-pro.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>code review,AI,pull request,Claude,Anthropic,OpenAI,GPT-5,pipelines,__BYOLENFORCED</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/codylabs/cody-code-reviewer/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://codylabs.pages.dev/privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://codylabs.gumroad.com/l/cody-pro"/>
    </Properties>
    <Icon>images/extension-icon.png</Icon>
    <License>eula.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Pricing" d:Source="File" Path="pricing.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="eula.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Privacypolicy" d:Source="File" Path="privacy.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>