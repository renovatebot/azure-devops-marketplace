{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "azure-boards-excel-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Excel Import & Export",
                "description": "Export and safely import Azure Boards work items with Excel.",
                "order": 100,
                "uri": "dist/hub.html",
                "iconName": "ExcelDocument"
            }
        }
    ],
    "contributionTypes": []
}