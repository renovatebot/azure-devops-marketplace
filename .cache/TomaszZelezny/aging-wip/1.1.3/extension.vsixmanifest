      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://github.com/tomaszzelezny/azure-devops/blob/main/PRIVACY.md"/>
      <Property Id="Microsoft.VisualStudio.Services.CustomerQnALink" Value="https://github.com/tomaszzelezny/azure-devops/issues"/>
    </Properties>
    <Icon>img/logo.png</Icon>
    <License>LICENSE</License>
  </Metadata>
