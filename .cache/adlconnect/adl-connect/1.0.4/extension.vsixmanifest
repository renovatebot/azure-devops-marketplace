<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="adl-connect" Version="1.0.4" Publisher="adlconnect"/>
    <DisplayName>Salesforce Connector - ADL Connect</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">Link Salesforce records to Azure DevOps work items — view, search, create, and edit Salesforce data without leaving ADO.</Description>
    <Categories>Azure Boards</Categories>
    <Tags>salesforce,crm,integration,work-items,azure-boards,adl</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://adlsolution.com/contact-us/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://adlsolution.com/azure-devops/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://adlsolution.com/privacy-policy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/adl-connect/ado"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#ffffff"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="light"/>
    </Properties>
    <Icon>src/assets/adl-logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/admin-hub.html" d:Source="File" Path="dist/admin-hub.html" Addressable="true"/>
    <Asset Type="dist/admin-hub.js" d:Source="File" Path="dist/admin-hub.js" Addressable="true"/>
    <Asset Type="dist/admin-hub.js.LICENSE.txt" d:Source="File" Path="dist/admin-hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/assets/adl-logo.0ff9a7afc05fdec92667.png" d:Source="File" Path="dist/assets/adl-logo.0ff9a7afc05fdec92667.png" Addressable="true"/>
    <Asset Type="dist/workitem-panel.html" d:Source="File" Path="dist/workitem-panel.html" Addressable="true"/>
    <Asset Type="dist/workitem-panel.js" d:Source="File" Path="dist/workitem-panel.js" Addressable="true"/>
    <Asset Type="dist/workitem-panel.js.LICENSE.txt" d:Source="File" Path="dist/workitem-panel.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="images/marketing/customers.png" d:Source="File" Path="images/marketing/customers.png" Addressable="true"/>
    <Asset Type="images/marketing/multi-platform.png" d:Source="File" Path="images/marketing/multi-platform.png" Addressable="true"/>
    <Asset Type="images/marketing/prefill-forms.png" d:Source="File" Path="images/marketing/prefill-forms.png" Addressable="true"/>
    <Asset Type="images/marketing/results.png" d:Source="File" Path="images/marketing/results.png" Addressable="true"/>
    <Asset Type="images/marketing/support-team.png" d:Source="File" Path="images/marketing/support-team.png" Addressable="true"/>
    <Asset Type="images/screenshots/01-hero.png" d:Source="File" Path="images/screenshots/01-hero.png" Addressable="true"/>
    <Asset Type="images/screenshots/02-work-item-panel.png" d:Source="File" Path="images/screenshots/02-work-item-panel.png" Addressable="true"/>
    <Asset Type="images/screenshots/03-record-attachments.png" d:Source="File" Path="images/screenshots/03-record-attachments.png" Addressable="true"/>
    <Asset Type="images/screenshots/05-admin-mapping.png" d:Source="File" Path="images/screenshots/05-admin-mapping.png" Addressable="true"/>
    <Asset Type="images/screenshots/06-admin-connected.png" d:Source="File" Path="images/screenshots/06-admin-connected.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="src/assets/adl-logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
