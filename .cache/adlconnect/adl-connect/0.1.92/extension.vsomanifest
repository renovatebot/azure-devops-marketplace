{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/adlsolution/adl-connect"
    },
    "scopes": [
        "vso.work",
        "vso.project",
        "vso.profile"
    ],
    "contributions": [
        {
            "id": "adl-connect-admin-hub",
            "type": "ms.vss-web.hub",
            "description": "ADL Connect — admin configuration",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "ADL Connect",
                "order": 100,
                "uri": "dist/admin-hub.html"
            }
        },
        {
            "id": "adl-connect-workitem-panel",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "ADL Connect — Salesforce records linked to this work item",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Salesforce Records",
                "uri": "dist/workitem-panel.html",
                "height": 320
            }
        }
    ],
    "contributionTypes": []
}