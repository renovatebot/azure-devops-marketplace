{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.work_write",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "time-tracker-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Top-level Time Tracker navigation group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Time Tracker",
                "order": 100,
                "icon": "static/icon.png"
            }
        },
        {
            "id": "time-tracker-hub",
            "type": "ms.vss-web.hub",
            "description": "Main time tracking hub with timer and manual entry",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Track",
                "order": 1,
                "uri": "dist/TimeTrackerHub/TimeTrackerHub.html",
                "icon": {
                    "light": "static/icon-light.png",
                    "dark": "static/icon-dark.png"
                }
            }
        },
        {
            "id": "time-reports-hub",
            "type": "ms.vss-web.hub",
            "description": "Time reports and analytics dashboard",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Reports",
                "order": 2,
                "uri": "dist/TimeReportsHub/TimeReportsHub.html",
                "icon": {
                    "light": "static/reports-light.png",
                    "dark": "static/reports-dark.png"
                }
            }
        },
        {
            "id": "all-time-hub",
            "type": "ms.vss-web.hub",
            "description": "View all team members time entries",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Team Time",
                "order": 3,
                "uri": "dist/AllTimeHub/AllTimeHub.html",
                "icon": {
                    "light": "static/team-light.png",
                    "dark": "static/team-dark.png"
                }
            }
        },
        {
            "id": "time-submit-hub",
            "type": "ms.vss-web.hub",
            "description": "Submit your time entries for approval",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Submit Timesheet",
                "order": 4,
                "uri": "dist/SubmitHub/SubmitHub.html",
                "icon": {
                    "light": "static/submit-light.png",
                    "dark": "static/submit-dark.png"
                }
            }
        },
        {
            "id": "time-approval-hub",
            "type": "ms.vss-web.hub",
            "description": "Review and approve time entries",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Approval",
                "order": 5,
                "uri": "dist/TimeApprovalHub/TimeApprovalHub.html",
                "icon": {
                    "light": "static/approval-light.png",
                    "dark": "static/approval-dark.png"
                }
            }
        },
        {
            "id": "settings-hub",
            "type": "ms.vss-web.hub",
            "description": "Manage time tracker settings and approval permissions",
            "targets": [
                ".time-tracker-hub-group"
            ],
            "properties": {
                "name": "Settings",
                "order": 6,
                "uri": "dist/SettingsHub/SettingsHub.html",
                "icon": {
                    "light": "static/settings-light.png",
                    "dark": "static/settings-dark.png"
                }
            }
        },
        {
            "id": "work-item-time-panel",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Time tracking tab on work item form",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracking",
                "uri": "dist/WorkItemTimePanel/WorkItemTimePanel.html"
            }
        },
        {
            "id": "work-item-observer",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Keeps RemainingWork in sync with OriginalEstimate",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracker",
                "uri": "dist/WorkItemObserver/WorkItemObserver.html",
                "height": 160
            }
        },
        {
            "id": "time-tracker-data-service",
            "type": "ms.vss-features.extension-data-service",
            "description": "Storage for time entries and settings",
            "targets": [
                "ms.vss-features.extension-data-service"
            ],
            "properties": {}
        },
        {
            "id": "time-tracker-context-menu",
            "type": "ms.vss-web.action-provider",
            "description": "Quick access menu for time tracking from work item menus",
            "targets": [
                "ms.vss-work-web.work-item-context-menu",
                "ms.vss-work-web.work-item-toolbar-menu"
            ],
            "properties": {
                "uri": "dist/WorkItemMenu/WorkItemMenu.html",
                "registeredObjectId": "time-tracker-menu-provider"
            }
        },
        {
            "id": "quick-add-panel",
            "type": "ms.vss-web.external-content",
            "description": "Panel for quickly adding time entries from context menu",
            "properties": {
                "uri": "dist/QuickAddPanel/QuickAddPanel.html"
            }
        }
    ],
    "contributionTypes": []
}