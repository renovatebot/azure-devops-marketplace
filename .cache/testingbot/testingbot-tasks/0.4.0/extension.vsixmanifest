<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="testingbot-tasks" Version="0.4.0" Publisher="testingbot"/>
    <DisplayName>TestingBot for Azure DevOps</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">Integrate TestingBot's automated testing with Azure DevOps</Description>
    <Categories>Azure Pipelines,Azure Test Plans</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://testingbot.com"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Gettingstarted" Value="https://testingbot.com/signup?utm_source=vsip"/>
