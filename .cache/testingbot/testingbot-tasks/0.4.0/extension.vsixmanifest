      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://testingbot.com/support"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://testingbot.com/support"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://testingbot.com/terms"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/testingbot/vso-testingbot-plugin"/>
    </Properties>
    <Icon>images/testingbot-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
