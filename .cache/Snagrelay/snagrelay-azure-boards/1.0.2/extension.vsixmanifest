<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="snagrelay-azure-boards" Publisher="snagrelay" Version="1.0.2"/>
    <DisplayName>SnagRelay</DisplayName>
    <Description xml:space="preserve">Intelligent Bug Capture — screenshots, console logs, and HTTP payloads in Azure Boards.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Icon>static/images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="overview.md" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="src/lib/api.js" d:Source="File" Path="src/lib/api.js" Addressable="true"/>
    <Asset Type="src/lib/boot.js" d:Source="File" Path="src/lib/boot.js" Addressable="true"/>
    <Asset Type="src/panel/panel.html" d:Source="File" Path="src/panel/panel.html" Addressable="true"/>
    <Asset Type="src/panel/panel.js" d:Source="File" Path="src/panel/panel.js" Addressable="true"/>
    <Asset Type="src/settings/settings.html" d:Source="File" Path="src/settings/settings.html" Addressable="true"/>
    <Asset Type="src/settings/settings.js" d:Source="File" Path="src/settings/settings.js" Addressable="true"/>
    <Asset Type="src/vendor/SDK.min.js" d:Source="File" Path="src/vendor/SDK.min.js" Addressable="true"/>
    <Asset Type="src/vendor/capture-define.js" d:Source="File" Path="src/vendor/capture-define.js" Addressable="true"/>
    <Asset Type="src/vendor/restore-define.js" d:Source="File" Path="src/vendor/restore-define.js" Addressable="true"/>
    <Asset Type="static/images/logo.png" d:Source="File" Path="static/images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="static/images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>