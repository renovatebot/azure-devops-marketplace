{
    "manifestVersion": 1,
    "contentSecurityPolicy": "default-src 'self' 'unsafe-inline'; connect-src 'self' https://app.snagrelay.com https://*.snagrelay.com https://localhost:* http://localhost:* https://127.0.0.1:* http://127.0.0.1:* https://*.ngrok-free.app https://*.ngrok.io https://*.trycloudflare.com https://*.loca.lt; img-src 'self' data: https:;",
    "contributions": [
        {
            "id": "snagrelay-work-item-panel",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "SnagRelay",
                "uri": "src/panel/panel.html"
            }
        },
        {
            "id": "snagrelay-project-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "SnagRelay",
                "uri": "src/settings/settings.html"
            }
        }
    ],
    "scopes": [
        "vso.work",
        "vso.work_write"
    ],
    "contributionTypes": []
}