<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="liquibase-linter-ci" Version="1.0.0" Publisher="tulkas-dev"/>
    <DisplayName>Liquibase Changelog Linter</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">Native Azure DevOps CI task for Liquibase Community Edition auditing path security, strict encoding without BOM, formatted SQL headers, targets.json compatibility, and database engine SQL rules.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>liquibase,linter,sql,devsecops,database,postgresql,mssql,yugabytedb</Tags>
    <Icon>images/extension-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
