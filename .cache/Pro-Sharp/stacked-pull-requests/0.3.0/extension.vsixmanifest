<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="stacked-pull-requests" Version="0.3.0" Publisher="Pro-Sharp"/>
    <DisplayName> Pull Requests (Stacked)</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">Review stacked pull requests layer by layer: a hierarchy of dependent PRs across all repositories, with a branch-only diff, and full review features.</Description>
    <Categories>Azure Repos</Categories>
    <Tags>pull request,stacked,review,code review</Tags>
    <Icon>static/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
    <InstallationTarget Id="Microsoft.TeamFoundation.Server" Version="[19.0,)"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/hub.js" d:Source="File" Path="dist/hub.js" Addressable="true"/>
    <Asset Type="dist/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/pr-action.html" d:Source="File" Path="dist/pr-action.html" Addressable="true"/>
    <Asset Type="dist/pr-action.js" d:Source="File" Path="dist/pr-action.js" Addressable="true"/>
    <Asset Type="dist/pr-tab.html" d:Source="File" Path="dist/pr-tab.html" Addressable="true"/>
    <Asset Type="dist/pr-tab.js" d:Source="File" Path="dist/pr-tab.js" Addressable="true"/>
    <Asset Type="dist/pr-tab.js.LICENSE.txt" d:Source="File" Path="dist/pr-tab.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="static/icon.png" d:Source="File" Path="static/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="static/icon.png" Addressable="true"/>
    <Asset Type="static/index.html" d:Source="File" Path="static/index.html" Addressable="true"/>
    <Asset Type="docs/images/pr-overview.jpg" d:Source="File" Path="docs/images/pr-overview.jpg" Addressable="true"/>
    <Asset Type="docs/images/review-layer-diff.jpg" d:Source="File" Path="docs/images/review-layer-diff.jpg" Addressable="true"/>
    <Asset Type="docs/images/stack-list.jpg" d:Source="File" Path="docs/images/stack-list.jpg" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>