    <DisplayName>Work Item Sheets</DisplayName>
    <Description xml:space="preserve">Excel-like work item management for Azure DevOps. Bulk edit, filter, group and manage work items across multiple projects in one fast spreadsheet view with timeline planning.</Description>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Categories>Azure Boards</Categories>
