  <Metadata>
    <Identity Language="en-US" Id="rixter-risk-manager" Publisher="rixterab" Version="1.0.28"/>
    <DisplayName>Risk Manager</DisplayName>
    <Description xml:space="preserve">Manage risk in Azure DevOps with a shared risk register, risk matrix and exposure dashboards. Assess risks, track mitigation and see whether treatment reduces exposure.</Description>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="30"/>
