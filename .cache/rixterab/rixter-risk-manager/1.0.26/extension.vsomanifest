{
    "manifestVersion": 1,
    "licensing": {
        "overrides": [
            {
                "id": "risk-manager-widget",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "risk-manager-widget-configuration",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "risk-gauge-widget",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "risk-gauge-widget-configuration",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "admin-page",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "scopes": [
        "vso.extension.data",
        "vso.extension.data_write",
        "vso.graph",
        "vso.memberentitlementmanagement",
        "vso.work",
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "risk-manager-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "rixterab.rixter-risk-manager.risk-manager-widget-configuration"
            ],
            "properties": {
                "name": "Risk Matrix",
                "description": "Risk Matrix - visualize risks by displaying Azure Devops workitems in a Risk Matrix based on their probability and impact",
                "catalogIconUrl": "nextjs/out/images/icon.png",
                "previewImageUrl": "images/icon.png",
                "uri": "nextjs/out/index.html",
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 5,
                        "columnSpan": 5
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "risk-manager-widget-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Risk Manager Widget Configuration",
                "description": "Configures the Risk Manager dashboard widget",
                "uri": "nextjs/out/index.html",
                "height": 600
            }
        },
        {
            "id": "risk-gauge-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "rixterab.rixter-risk-manager.risk-gauge-widget-configuration"
            ],
            "properties": {
                "name": "Risk Gauge",
                "description": "Risk Gauge - read a set of Azure DevOps risk work items as one severity reading against your own risk scoring and risk levels",
                "catalogIconUrl": "nextjs/out/images/gauge-icon.png",
                "previewImageUrl": "images/risk-gauge-icon.png",
                "uri": "nextjs/out/index.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "risk-gauge-widget-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Risk Gauge Widget Configuration",
                "description": "Configures the Risk Gauge dashboard widget",
                "uri": "nextjs/out/index.html",
                "height": 600
            }
        },
        {
            "id": "risk-register-hub",
            "type": "ms.vss-web.hub",
            "description": "Risk Register - a saved, configurable working view over your risk work items with Risk Manager scoring, levels, acceptance and change.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Risk Register",
                "uri": "nextjs/out/index.html",
                "order": 100
            }
        },
        {
            "id": "admin-page",
            "type": "ms.vss-web.hub",
            "description": "Risk Manager admin page",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Risk Manager",
                "uri": "nextjs/out/index.html",
                "height": 600
            }
        },
        {
            "id": "project-settings-page",
            "type": "ms.vss-web.hub",
            "description": "Risk Manager project settings",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Risk Manager",
                "uri": "nextjs/out/index.html",
                "height": 600
            }
        }
    ],
    "contributionTypes": []
}