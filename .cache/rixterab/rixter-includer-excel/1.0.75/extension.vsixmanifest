    <DisplayName>Excel Includer – Link and view Excel files on work items</DisplayName>
    <Description xml:space="preserve">Include an Excel file on a work item and view it directly on the work item page</Description>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="30"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://rixter.atlassian.net/servicedesk/customer/portal/2"/>
