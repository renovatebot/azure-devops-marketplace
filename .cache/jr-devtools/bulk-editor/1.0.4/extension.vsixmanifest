<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="bulk-editor" Publisher="jr-devtools" Version="1.0.4"/>
    <DisplayName>Bulk Editor – spreadsheet grid for work items</DisplayName>
    <Description xml:space="preserve">Edit work items in bulk in a spreadsheet-like grid, right in Azure DevOps. The browser-based alternative to Open in Excel: no Office add-in, works on Mac.</Description>
    <GalleryFlags>Paid</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>excel,open in excel,bulk edit,bulk update,mass edit,spreadsheet,grid,work items,import,export,xlsx,__BYOLENFORCED</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://jr-devtools.com/bulk-editor/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://jr-devtools.com/bulk-editor/#get-started"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://jr-devtools.com/support/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://jr-devtools.com/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://jr-devtools.com/eula/"/>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="14"/>
    </Properties>
    <Icon>images/logo.png</Icon>
    <License>license.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
