{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "bulk-editor-hub",
            "type": "ms.vss-web.hub",
            "description": "Edit work items in a grid.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Bulk Editor",
                "uri": "dist/hub.html",
                "icon": {
                    "light": "images/logo.png",
                    "dark": "images/logo.png"
                }
            }
        },
        {
            "id": "open-query-results",
            "type": "ms.vss-web.action",
            "description": "Open the query results in the Bulk Editor.",
            "targets": [
                "ms.vss-work-web.work-item-query-results-toolbar-menu"
            ],
            "properties": {
                "text": "Open in Bulk Editor",
                "icon": "images/logo.png",
                "uri": "dist/action.html",
                "registeredObjectId": "open-query-in-bulk-editor"
            }
        },
        {
            "id": "open-work-items",
            "type": "ms.vss-web.action",
            "description": "Open the selected work items in the Bulk Editor.",
            "targets": [
                "ms.vss-work-web.work-item-context-menu",
                "ms.vss-work-web.backlog-item-menu"
            ],
            "properties": {
                "text": "Open in Bulk Editor",
                "icon": "images/logo.png",
                "uri": "dist/action.html",
                "registeredObjectId": "open-selection-in-bulk-editor"
            }
        },
        {
            "id": "settings-hub",
            "type": "ms.vss-web.hub",
            "description": "License management for Bulk Editor.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Bulk Editor",
                "uri": "dist/settings.html",
                "order": 100
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "bulk-editor-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "open-query-results",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "open-work-items",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "settings-hub",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}