<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="ado-merge-conflict-resolver" Publisher="jr-devtools" Version="1.0.0"/>
    <DisplayName>Merge Conflict Resolver</DisplayName>
    <Description xml:space="preserve">Resolve pull request merge conflicts in Azure DevOps with a reliable 3-way editor that never loses your work or mangles characters. A maintained alternative to the DevLabs conflicts tab.</Description>
    <GalleryFlags>Paid</GalleryFlags>
    <Categories>Azure Repos</Categories>
    <Tags>merge,merge conflicts,conflict resolution,resolve conflicts,pull request,git,3-way merge,merge editor,conflicts tab,devlabs alternative,__BYOLENFORCED</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://jr-devtools.com/merge-conflict-resolver/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://jr-devtools.com/merge-conflict-resolver/#get-started"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://jr-devtools.com/support/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://jr-devtools.com/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://jr-devtools.com/eula/"/>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="14"/>
    </Properties>
    <Icon>images/logo.png</Icon>
    <License>license.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/app.css" d:Source="File" Path="dist/app.css" Addressable="true"/>
    <Asset Type="dist/codicon.ttf" d:Source="File" Path="dist/codicon.ttf" Addressable="true"/>
    <Asset Type="dist/conflicts-tab.css" d:Source="File" Path="dist/conflicts-tab.css" Addressable="true"/>
