{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_write"
    ],
    "contributions": [
        {
            "id": "conflicts-tab",
            "type": "ms.vss-web.tab",
            "description": "Resolve merge conflicts of the pull request.",
            "targets": [
                "ms.vss-code-web.pr-tabs"
            ],
            "properties": {
                "name": "Resolve conflicts",
                "uri": "dist/conflicts-tab.html",
                "title": "Resolve conflicts"
            }
        },
        {
            "id": "settings-hub",
            "type": "ms.vss-web.hub",
            "description": "License and settings for Merge Conflict Resolver.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Merge Conflict Resolver",
                "uri": "dist/settings.html",
                "order": 100
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "conflicts-tab",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "settings-hub",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}