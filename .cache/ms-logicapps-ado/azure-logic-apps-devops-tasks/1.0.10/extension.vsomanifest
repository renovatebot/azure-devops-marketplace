{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "hybrid-logic-app-service-endpoint",
            "description": "Service connection for Azure Logic Apps Hybrid (AAD authentication)",
            "type": "ms.vss-endpoint.service-endpoint-type",
            "targets": [
                "ms.vss-endpoint.endpoint-types"
            ],
            "properties": {
                "name": "HybridLogicApp",
                "displayName": "Hybrid Logic App",
                "description": "Service connection for authenticating to Azure Logic Apps Hybrid ZIP deploy API using AAD client credentials.",
                "url": {
                    "displayName": "Server URL",
                    "value": "https://login.microsoftonline.com",
                    "isVisible": false
                },
                "inputDescriptors": [
                    {
                        "id": "tenantId",
                        "name": "Tenant ID",
                        "description": "The Azure Active Directory Tenant ID (GUID).",
                        "inputMode": "textbox",
                        "isConfidential": false,
                        "validation": {
                            "isRequired": true,
                            "dataType": "string"
                        }
                    }
                ],
                "authenticationSchemes": [
                    {
                        "type": "ms.vss-endpoint.endpoint-auth-scheme-basic",
                        "displayName": "Client Credentials",
                        "inputDescriptors": [
                            {
                                "id": "username",
                                "name": "Client ID",
                                "description": "The Application (Client) ID of the AAD App Registration.",
                                "inputMode": "textbox",
                                "isConfidential": false,
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "string"
                                }
                            },
                            {
                                "id": "password",
                                "name": "Client Secret",
                                "description": "The Client Secret of the AAD App Registration.",
                                "inputMode": "passwordbox",
                                "isConfidential": true,
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "string"
                                }
                            }
                        ]
                    }
                ],
                "helpMarkDown": "<a href=\"https://docs.microsoft.com/azure/logic-apps/\" target=\"_blank\"><b>Learn more about Azure Logic Apps Hybrid</b></a>"
            }
        },
        {
            "id": "logic-apps-build-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.task"
            ],
            "properties": {
                "name": "AzureLogicAppsStandardBuildV0"
            }
        },
        {
            "id": "logic-apps-connections-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.task"
            ],
            "properties": {
                "name": "AzureLogicAppsStandardConnectionsDeploymentV0"
            }
        },
        {
            "id": "logic-apps-release-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.task"
            ],
            "properties": {
                "name": "AzureLogicAppsStandardReleaseV0"
            }
        },
        {
            "id": "logic-apps-business-process-artifacts-build-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.task"
            ],
            "properties": {
                "name": "AzureLogicAppsStandardBusinessProcessArtifactsBuildV0"
            }
        },
        {
            "id": "logic-apps-hybrid-build-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.task"
            ],
            "properties": {
                "name": "AzureLogicAppsHybridBuildV0"
            }
        },
        {
            "id": "logic-apps-hybrid-release-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.task"
            ],
            "properties": {
                "name": "AzureLogicAppsHybridReleaseV0"
            }
        },
        {
            "id": "logic-apps-hybrid-connections-deployment-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.task"
            ],
            "properties": {
                "name": "AzureLogicAppsHybridConnectionsDeploymentV0"
            }
        }
    ],
    "scopes": [],
    "contributionTypes": []
}