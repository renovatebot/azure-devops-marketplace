{
    "manifestVersion": 1,
    "scopes": [
        "vso.test",
        "vso.work_write",
        "vso.project",
        "vso.wiki_write"
    ],
    "contributions": [
        {
            "id": "test-dashboard-hub",
            "type": "ms.vss-web.hub",
            "description": "Full-page testing dashboard.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Sprint Dashboard",
                "order": 100,
                "uri": "dist/hub.html",
                "icon": "img/logo.png"
            }
        },
        {
            "id": "test-dashboard-widget",
            "type": "ms.vss-dashboards-web.widget",
            "description": "At-a-glance test execution summary tile.",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog"
            ],
            "properties": {
                "name": "Test Execution Summary",
                "description": "Shows pass/fail/blocked outcomes across your test plans.",
                "catalogIconUrl": "img/logo.png",
                "previewImageUrl": "img/logo.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "qa-tasks-observer",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Auto-creates the 5 QA tasks when a User Story is saved in New, and shows status.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "QA Automation",
                "uri": "dist/observer.html",
                "height": 160
            }
        },
        {
            "id": "atep-hub",
            "type": "ms.vss-web.hub",
            "description": "ATEP configuration for this project (Global configuration + Use cases tabs).",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "8-ATEP",
                "order": 100,
                "uri": "dist/atep.html"
            }
        },
        {
            "id": "atep-work-item-tab",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "ATEP use cases (Generate Test Cases, ATEP Testing Chat) for this work item.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "ATEP",
                "uri": "dist/atepWorkItemTab.html"
            }
        }
    ],
    "contributionTypes": []
}