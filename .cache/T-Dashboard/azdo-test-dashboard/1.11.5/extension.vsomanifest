{
    "manifestVersion": 1,
    "scopes": [
        "vso.test",
        "vso.work",
        "vso.project",
        "vso.hooks_write"
    ],
    "contributions": [
        {
            "id": "test-dashboard-hub",
            "type": "ms.vss-web.hub",
            "description": "Full-page testing dashboard.",
            "targets": [
                "ms.vss-test-web.test-hub-group"
            ],
            "properties": {
                "name": "Test Dashboard",
                "order": 100,
                "uri": "dist/hub/hub.html",
                "icon": "img/logo.png"
            }
        },
        {
            "id": "test-dashboard-widget",
            "type": "ms.vss-dashboards-web.widget",
            "description": "At-a-glance test execution summary tile.",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog"
            ],
            "properties": {
                "name": "Test Execution Summary",
                "description": "Shows pass/fail/blocked outcomes across your test plans.",
                "catalogIconUrl": "img/logo.png",
                "previewImageUrl": "img/logo.png",
                "uri": "dist/widget/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        }
    ],
    "contributionTypes": []
}