<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="azdo-test-dashboard" Publisher="T-Dashboard" Version="1.1.0"/>
    <DisplayName>Test Dashboard</DisplayName>
    <Description xml:space="preserve">A testing dashboard for Azure DevOps focused on Test Plans, Test Cases, and execution results.</Description>
    <GalleryFlags/>
    <Categories>Azure Test Plans</Categories>
    <Tags>test,test plans,test cases,dashboard,quality,reporting</Tags>
    <Icon>img/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub/hub.html" d:Source="File" Path="dist/hub/hub.html" Addressable="true"/>
    <Asset Type="dist/hub/hub.js" d:Source="File" Path="dist/hub/hub.js" Addressable="true"/>
    <Asset Type="dist/hub/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/hub/hub.js.map" d:Source="File" Path="dist/hub/hub.js.map" Addressable="true"/>
    <Asset Type="dist/widget/widget.html" d:Source="File" Path="dist/widget/widget.html" Addressable="true"/>
    <Asset Type="dist/widget/widget.js" d:Source="File" Path="dist/widget/widget.js" Addressable="true"/>
    <Asset Type="dist/widget/widget.js.LICENSE.txt" d:Source="File" Path="dist/widget/widget.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/widget/widget.js.map" d:Source="File" Path="dist/widget/widget.js.map" Addressable="true"/>
    <Asset Type="dist/img/logo.png" d:Source="File" Path="dist/img/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>