    <DisplayName>TestPulse — Executive quality reporting for Azure DevOps</DisplayName>
    <Description xml:space="preserve">Executive quality reporting for Azure DevOps: traceability, coverage, GO/NO-GO score, exploratory sessions, PDF/Word/Excel/PPT/HTML reports. Cloud &amp; Server 2022.1. EN/FR.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Test Plans,Azure Boards</Categories>
    <Tags>Test report,Test reporting,Test management,Test Plan,Test case,Test suite,Test results,Test coverage,Traceability,Requirements,Requirements coverage,Quality gate,Release readiness,Exploratory testing,QA,Export,Reporting,PDF,Word,Excel,PowerPoint,Work Item,Dashboard,Executive reporting,Audit</Tags>
    <Icon>images/icon.png</Icon>
  </Metadata>
