{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "tristate-switch",
            "type": "ms.vss-work-web.work-item-form-control",
            "description": "Shows a picklist (string) field as a three-position switch: True / False / Unset.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Tri-state switch",
                "uri": "web/control.html",
                "height": 36,
                "inputs": [
                    {
                        "id": "FieldName",
                        "name": "Field",
                        "description": "Field that stores the answer. Use a Picklist (string) field with the items True and False (no other items needed), or a Text (single line) field. Leave its default value empty, otherwise new work items don't start as Unset. Tick Required on the field to force a choice. Not a Boolean field: it can never be empty.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "String",
                                "PicklistString"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "TrueValue",
                        "name": "Value stored for True",
                        "description": "Text written to the field for True, also shown as the label. For a picklist it must be one of its items (upper/lower case doesn't matter). Leave empty for: True",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "FalseValue",
                        "name": "Value stored for False",
                        "description": "Text written to the field for False, also shown as the label. For a picklist it must be one of its items (upper/lower case doesn't matter). Leave empty for: False",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "NeutralText",
                        "name": "Text shown when nothing is selected",
                        "description": "Label shown while the field is empty. Nothing is written to the field. Leave empty for: Unset",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "RequiredIndicator",
                        "name": "Required indicator: dot, icon or none",
                        "description": "How a required field that is still Unset is marked. dot = the center bar turns into a small red dot (default). icon = red ! after the label. none = no own marker, leave it to Azure DevOps.",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        }
    ],
    "contributionTypes": []
}