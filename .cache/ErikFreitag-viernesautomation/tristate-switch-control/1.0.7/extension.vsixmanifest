<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="tristate-switch-control" Publisher="ErikFreitag-viernesautomation" Version="1.0.7"/>
    <DisplayName>Tri-State Switch</DisplayName>
    <Description xml:space="preserve">A True / False / Unset switch for work item fields. Lets you make a yes/no question required, which a Boolean field cannot do.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>work item,custom control,boolean,tri-state,toggle,required</Tags>
    <Icon>web/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="web/control.css" d:Source="File" Path="web/control.css" Addressable="true"/>
    <Asset Type="web/control.html" d:Source="File" Path="web/control.html" Addressable="true"/>
    <Asset Type="web/control.js" d:Source="File" Path="web/control.js" Addressable="true"/>
    <Asset Type="web/icon.png" d:Source="File" Path="web/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="web/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>