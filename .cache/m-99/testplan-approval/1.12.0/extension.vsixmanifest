<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="testplan-approval" Version="1.12.0" Publisher="m-99"/>
    <DisplayName>Test Plan Approval</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">QC Lead approval gate for Azure DevOps Test Plans. Approving a plan moves its test cases from Design to Ready to Test and records an audit trail.</Description>
    <Categories>Azure Test Plans</Categories>
    <Tags>test plans,approval,quality assurance,qa,test case,workflow,governance</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/Majed77M/book-aws-spring"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/Majed77M/book-aws-spring/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/Majed77M/book-aws-spring"/>
    </Properties>
    <Icon>images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/VSS.SDK.min.js" d:Source="File" Path="dist/VSS.SDK.min.js" Addressable="true"/>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>