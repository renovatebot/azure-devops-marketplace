{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "hello-world-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Hub group for SmartReactor instance versions",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Wersje SR",
                "order": 100,
                "icon": {
                    "dark": "static/icon.png",
                    "light": "static/icon.png"
                }
            }
        },
        {
            "id": "default-hub",
            "type": "ms.vss-web.hub",
            "description": "Instance version matrix",
            "targets": [
                ".hello-world-hub-group"
            ],
            "properties": {
                "name": "Instancje",
                "order": 10,
                "uri": "dist/hub/hub.html"
            }
        }
    ],
    "scopes": [
        "vso.release",
        "vso.build"
    ],
    "demands": [],
    "contributionTypes": []
}