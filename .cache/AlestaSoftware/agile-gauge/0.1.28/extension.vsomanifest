{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://dev.azure.com/AlestaSoftware/Agile%20Gauge"
    },
    "scopes": [
        "vso.project",
        "vso.work",
        "vso.graph"
    ],
    "contributions": [
        {
            "id": "agile-gauge-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Agile Gauge",
                "uri": "dist/hub.html",
                "order": 100
            }
        }
    ],
    "contributionTypes": []
}