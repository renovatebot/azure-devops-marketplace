                    "assets": [
                        "AlestaSoftware.agile-gauge/images/hub-icon.png"
                    ]
                },
                "_sharedData": {
                    "assets": [
                        "AlestaSoftware.agile-gauge/images/hub-icon.png"
                    ]
                }
            }
        }
    ],
    "contributionTypes": []
}