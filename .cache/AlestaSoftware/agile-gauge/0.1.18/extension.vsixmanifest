      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://dev.azure.com/AlestaSoftware/Agile%20Gauge"/>
    </Properties>
    <Icon>images/icon-128.png</Icon>
    <License>LICENSE</License>
  </Metadata>
