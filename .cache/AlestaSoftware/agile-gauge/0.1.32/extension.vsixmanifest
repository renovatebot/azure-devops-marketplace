  <Metadata>
    <Identity Language="en-US" Id="agile-gauge" Publisher="AlestaSoftware" Version="0.1.32"/>
    <DisplayName>Agile Gauge: Affordable Sprint &amp; Flow Metrics for Azure DevOps</DisplayName>
    <Description xml:space="preserve">Sprint health, cycle time and printable retros for Azure Boards. Free during early access; paid plans from $20 a month, with a 14-day trial and advance notice, come later.</Description>
    <GalleryFlags>Paid Preview</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>agile,scrum,kanban,sprint metrics,cycle time,work in progress,flow metrics,azure boards,sprint report,sprint retrospective,retro,throughput,lead time,aging work,blocked work,team health,capacity planning,kanban metrics,scrum metrics,predictability,sprint planning,wip,__BYOLENFORCED</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacy" Value="https://agilegauge.com/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://agilegauge.com/support/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://agilegauge.com/license/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://agilegauge.com/getting-started/"/>
    </Properties>
    <Icon>images/icon-128.png</Icon>
    <License>LICENSE</License>
  </Metadata>
