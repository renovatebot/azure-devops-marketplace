<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="flightroom-azure-devops-tasks" Version="1.0.4" Publisher="flightroom"/>
    <DisplayName>Flightroom Azure DevOps Tasks</DisplayName>
    <Description xml:space="preserve">Azure DevOps tasks for uploading frontend bundles and registering Docker images in Flightroom</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Pipelines</Categories>
    <Icon>images/extension-icon.jpeg</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/overview.md" d:Source="File" Path="dist/overview.md" Addressable="true"/>
    <Asset Type="dist/tasks/register-docker-image/index.js" d:Source="File" Path="dist/tasks/register-docker-image/index.js" Addressable="true"/>
    <Asset Type="dist/tasks/register-docker-image/task.json" d:Source="File" Path="dist/tasks/register-docker-image/task.json" Addressable="true"/>
    <Asset Type="dist/tasks/upload-microfrontend/index.js" d:Source="File" Path="dist/tasks/upload-microfrontend/index.js" Addressable="true"/>
    <Asset Type="dist/tasks/upload-microfrontend/task.json" d:Source="File" Path="dist/tasks/upload-microfrontend/task.json" Addressable="true"/>
    <Asset Type="images/extension-icon.jpeg" d:Source="File" Path="images/extension-icon.jpeg" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/extension-icon.jpeg" Addressable="true"/>
    <Asset Type="overview.md" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>