{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.work_write",
        "vso.identity",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "ActionButton",
            "description": "Configurable action buttons for the work item form",
            "type": "ms.vss-work-web.work-item-form-control",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Test Advisor Action Buttons",
                "uri": "index.html",
                "height": 200,
                "inputs": [
                    {
                        "id": "ButtonsNames",
                        "name": "Button names",
                        "description": "The label shown on each button (separate multiple buttons with commas).",
                        "type": "TextArea",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
                                "Double",
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "ActionsNames",
                        "name": "Actions (New Work Item, Create Tasks, Create Test Tasks, Create Bug, Duplicate TC, Link to FTR, Generate Tests)",
                        "description": "The action each button performs (separate multiple actions with commas).",
                        "type": "TextArea",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
                                "Double",
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "FieldsToCopy",
                        "name": "Fields To Copy",
                        "description": "Comma-separated list of fields to copy when creating or copying a work item.",
                        "type": "TextArea",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
                                "Double",
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "TargetType",
                        "name": "Work Item Target Type",
                        "description": "The work item type to create when copying or creating a work item.",
                        "type": "TextArea",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
                                "Double",
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "TargetProject",
                        "name": "Target Project Name",
                        "description": "The project to create the work item in (defaults to the current project).",
                        "type": "TextArea",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
                                "Double",
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "PreTitel",
                        "name": "Pre Title",
                        "description": "Text to prepend to the new work item title.",
                        "type": "TextArea",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
                                "Double",
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "LinkToWit",
                        "name": "Link types",
                        "description": "Comma-separated link types to create to the new work item (Child/Duplicate Of/Predecessor/Related/Tests).",
                        "type": "TextArea",
                        "properties": {
                            "workItemFieldTypes": [
                                "Integer",
                                "Double",
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "BuyPass",
                        "name": "Bypass work item rules",
                        "description": "Set field values that bypass work item rules (requires the bypass rules permission).",
                        "inputMode": "CheckBox",
                        "validation": {
                            "dataType": "Boolean"
                        }
                    },
                    {
                        "id": "IncludeLinks",
                        "name": "Include Links",
                        "description": "Copy linked items except parent and child links (they are added as Related).",
                        "inputMode": "CheckBox",
                        "validation": {
                            "dataType": "Boolean"
                        }
                    },
                    {
                        "id": "IncludeAttachments",
                        "name": "Include Attachments",
                        "description": "Copy the attachments.",
                        "inputMode": "CheckBox",
                        "validation": {
                            "dataType": "Boolean"
                        }
                    },
                    {
                        "id": "IncludeTestCaseCount",
                        "name": "Include Test Case Count",
                        "description": "Prefix title with [TCxxx] numbering based on existing test cases",
                        "inputMode": "CheckBox",
                        "validation": {
                            "dataType": "Boolean"
                        }
                    }
                ]
            }
        },
        {
            "id": "configureFunctions",
            "type": "ms.vss-web.hub",
            "description": "Configure the optional backend API URL and project name",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Test Advisor Action Buttons",
                "uri": "configActionButton.html",
                "order": 99
            }
        }
    ],
    "contributionTypes": []
}