{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "agile-analytics-hub",
            "type": "ms.vss-web.hub",
            "description": "Agile Analytics — DORA metrics, executive reports, investment allocation, sprint velocity, flow metrics, cycle time, WIP monitor, and Monte Carlo forecasting hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Agile Analytics",
                "icon": "marketplace/images/logo.png",
                "order": 100,
                "uri": "dist/hub.html"
            }
        },
        {
            "id": "widget-category",
            "type": "ms.vss-dashboards-web.widget-catalog-category",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog"
            ],
            "properties": {
                "name": "Agile Analytics"
            }
        },
        {
            "id": "widget-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Agile Analytics Widget Configuration",
                "description": "Configure team and project for Agile Analytics widgets",
                "uri": "dist/widget.html"
            }
        },
        {
            "id": "widget-team-health",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "Baytek.agile-analytics.widget-category",
                "Baytek.agile-analytics.widget-configuration"
            ],
            "properties": {
                "name": "Team Health",
                "description": "Shows team health score, grade, and throughput trend for a selected team.",
                "catalogIconUrl": "marketplace/images/logo.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "widget-cycle-time",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "Baytek.agile-analytics.widget-category",
                "Baytek.agile-analytics.widget-configuration"
            ],
            "properties": {
                "name": "Cycle Time",
                "description": "Shows p50 and p85 cycle time trends over the last 6 sprints for a selected team.",
                "catalogIconUrl": "marketplace/images/logo.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "widget-throughput",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "Baytek.agile-analytics.widget-category",
                "Baytek.agile-analytics.widget-configuration"
            ],
            "properties": {
                "name": "Throughput",
                "description": "Shows throughput per sprint bar chart for the last 6 sprints for a selected team.",
                "catalogIconUrl": "marketplace/images/logo.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "widget-sprint-forecast",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "Baytek.agile-analytics.widget-category",
                "Baytek.agile-analytics.widget-configuration"
            ],
            "properties": {
                "name": "Sprint Forecast",
                "description": "Monte Carlo forecast for the next sprint: how many items the team completes at 85% and 50% confidence, with the outcome distribution.",
                "catalogIconUrl": "marketplace/images/logo.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "widget-dora-snapshot",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "Baytek.agile-analytics.widget-category",
                "Baytek.agile-analytics.widget-configuration"
            ],
            "properties": {
                "name": "DORA Snapshot",
                "description": "The four DORA keys at a glance: deployment frequency, lead time p50, change failure rate, and restore p50 for a selected team (30-day window).",
                "catalogIconUrl": "marketplace/images/logo.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "widget-ai-adoption",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "Baytek.agile-analytics.widget-category",
                "Baytek.agile-analytics.widget-configuration"
            ],
            "properties": {
                "name": "AI Adoption",
                "description": "GitHub Copilot adoption at a glance: suggestion acceptance rate and active users, using the connection configured in the Agile Analytics hub.",
                "catalogIconUrl": "marketplace/images/logo.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        }
    ],
    "scopes": [
        "vso.project",
        "vso.work",
        "vso.graph",
        "vso.build"
    ],
    "contributionTypes": []
}