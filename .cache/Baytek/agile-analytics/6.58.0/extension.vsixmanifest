  <Metadata>
    <Identity Language="en-US" Id="agile-analytics" Publisher="Baytek" Version="6.58.0"/>
    <DisplayName>Agile Analytics — Sprint Forecasting, Flow Metrics &amp; Dashboards for Azure DevOps</DisplayName>
    <Description xml:space="preserve">Will your team hit the sprint? Monte Carlo forecasts, cycle time, aging WIP, burndown and velocity for Scrum and Kanban, plus DORA, dashboards and exec reports. No PAT, no setup, no data sent to us.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards,Azure Pipelines</Categories>
    <Tags>__DoNotDownload,agile,analytics,dashboard,insights,sprint,sprint planning,next sprint planning,velocity,cycle time,flow metrics,flow efficiency,service level expectations,monte carlo,wip,burndown,reporting,scrum,kanban,forecasting,team health,retrospective,dora,deployment frequency,lead time,change failure rate,investment allocation,executive report,sprint report,throughput,cumulative flow,capacity planning,engineering metrics,time to restore,predictability,sprint reporting,agile metrics,azure devops analytics,sprint analytics,team velocity,aging,work item age,aging wip</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://ado-analytics.baytekdev.com/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://ado-analytics.baytekdev.com/terms/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://ado-analytics.baytekdev.com/support/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://ado-analytics.baytekdev.com/install/"/>
    </Properties>
    <Icon>marketplace/images/logo.png</Icon>
    <License>marketplace/license.md</License>
  </Metadata>
