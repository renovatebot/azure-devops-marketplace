<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="monte-carlo-sprint-forecast" Publisher="Baytek" Version="1.0.0"/>
    <DisplayName>Monte Carlo Sprint Forecast</DisplayName>
    <Description xml:space="preserve">Free dashboard widget: a Monte Carlo forecast of how many items your team will finish next sprint, at 85% and 50% confidence, from your own throughput. Two read-only scopes, no backend.</Description>
    <GalleryFlags/>
    <Categories>Azure Boards</Categories>
    <Tags>monte carlo,monte carlo forecasting,sprint forecast,forecasting,delivery forecasting,probabilistic forecasting,throughput,dashboard widget,widget,dashboard,sprint planning,scrum,kanban,agile,azure boards,free,baytek,agile analytics</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://ado-analytics.baytekdev.com/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://ado-analytics.baytekdev.com/terms/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://ado-analytics.baytekdev.com/support/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://ado-analytics.baytekdev.com/solutions/azure-devops-monte-carlo-forecasting/#free-widget"/>
    </Properties>
    <Icon>marketplace/forecast/images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
