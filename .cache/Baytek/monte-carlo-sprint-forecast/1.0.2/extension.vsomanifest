{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "widget-category",
            "type": "ms.vss-dashboards-web.widget-catalog-category",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog"
            ],
            "properties": {
                "name": "Monte Carlo Sprint Forecast"
            }
        },
        {
            "id": "widget-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Monte Carlo Sprint Forecast Configuration",
                "description": "Choose the project and team to forecast",
                "uri": "dist-forecast/forecast.html"
            }
        },
        {
            "id": "widget-sprint-forecast",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "Baytek.monte-carlo-sprint-forecast.widget-category",
                "Baytek.monte-carlo-sprint-forecast.widget-configuration"
            ],
            "properties": {
                "name": "Monte Carlo Sprint Forecast",
                "description": "Monte Carlo forecast for the next sprint: how many items the team completes at 85% and 50% confidence, with the outcome distribution. Free.",
                "catalogIconUrl": "marketplace/forecast/images/icon.png",
                "uri": "dist-forecast/forecast.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        }
    ],
    "scopes": [
        "vso.project",
        "vso.work"
    ],
    "contributionTypes": []
}