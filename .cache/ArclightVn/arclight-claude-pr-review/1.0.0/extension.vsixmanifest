<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="arclight-claude-pr-review" Version="1.0.0" Publisher="ArclightVn"/>
    <DisplayName>ArcLight Claude PR Review</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">Automated Azure DevOps pull request code reviews powered by the Claude Code CLI. Get Claude's feedback on your PRs directly in Azure DevOps.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>code review,claude,claude code,ai,pull request,automation</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/viettdann/arclight-ado-claude-pr-review"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/viettdann/arclight-ado-claude-pr-review/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/viettdann/arclight-ado-claude-pr-review/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/viettdann/arclight-ado-claude-pr-review.git"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#e97a45"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="light"/>
    </Properties>
    <Icon>images/extension-icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>