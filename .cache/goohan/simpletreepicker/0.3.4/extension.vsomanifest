{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/goohan/simpletreepicker"
    },
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "simple-tree-picker-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "description": "Pick one node from a tree built out of the field's own values.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Simple Tree Picker",
                "uri": "dist/control.html",
                "height": 60,
                "inputs": [
                    {
                        "id": "FieldName",
                        "name": "Field",
                        "description": "The field this control edits. It holds the full path of the node you pick, so it must be a text field — ideally a picklist whose allowed values ARE the paths, which is where the tree is read from.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "String"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "PickerStyle",
                        "name": "Picker style",
                        "description": "How the picker opens. 'inline' (the default) expands under the field and pushes the form's content down; 'dialog' opens a dialog that floats over the form, which suits large trees. Anything unrecognized means inline.",
                        "type": "string",
                        "values": {
                            "possibleValues": [
                                {
                                    "value": "inline",
                                    "displayValue": "Inline — expands under the field"
                                },
                                {
                                    "value": "dialog",
                                    "displayValue": "Dialog — floats over the form"
                                }
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "Paths",
                        "name": "Paths (fallback)",
                        "description": "Only read when the field has no picklist: the paths to show, separated by semicolons or new lines. Example: A; A\\B; A\\B\\C; A2",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        },
        {
            "id": "simple-tree-picker-dialog",
            "type": "ms.vss-web.external-content",
            "description": "The tree, rendered inside a dialog the host draws over the form. Opened by the control when its PickerStyle input is 'dialog'.",
            "targets": [],
            "properties": {
                "uri": "dist/dialog.html"
            }
        }
    ],
    "contributionTypes": []
}