{
    "manifestVersion": 1,
    "scopes": [
        "vso.code",
        "vso.code_write",
        "vso.build",
        "vso.build_execute",
        "vso.packaging"
    ],
    "contributions": [
        {
            "id": "build-file-generator-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "Генерация файла сборки",
                "order": 96,
                "uri": "modules/build-file-generator/hub.html",
                "iconName": "Build"
            }
        },
        {
            "id": "build-file-generator-source-action",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-code-web.source-item-menu"
            ],
            "properties": {
                "text": "Генерация файла сборки",
                "title": "Создать файлы сборки main.yml и setup.iss",
                "uri": "modules/build-file-generator/action.html",
                "iconName": "Build",
                "registeredObjectId": "open-build-file-generator"
            }
        },
        {
            "id": "nuget-inspector-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-build-web.build-release-hub-group"
            ],
            "properties": {
                "name": "Обзор NuGet",
                "order": 98,
                "uri": "modules/nuget-inspector/hub.html",
                "iconName": "Package"
            }
        },
        {
            "id": "ads-nuget-snapshot-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "modules/nuget-inspector/task"
            }
        },
        {
            "id": "readme-generator-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "Генератор README",
                "order": 95,
                "uri": "modules/readme-helper/hub.html",
                "iconName": "EditNote"
            }
        },
        {
            "id": "readme-repository-picker-action",
            "type": "ms.vss-web.menu-item",
            "targets": [
                "ms.vss-code-web.command-bar-repository-picker-actions"
            ],
            "properties": {
                "text": "Генератор README",
                "title": "Сформировать или обновить README выбранного репозитория",
                "uri": "modules/readme-helper/action.html",
                "iconName": "EditNote",
                "registeredObjectId": "open-readme-generator"
            }
        },
        {
            "id": "readme-project-overview-action",
            "type": "ms.vss-web.menu-item",
            "targets": [
                "ms.vss-admin-web.project-overview-toolbar-menu"
            ],
            "properties": {
                "text": "Генератор README",
                "toolbarText": "Генератор README",
                "title": "Открыть генератор README",
                "uri": "modules/readme-helper/action.html",
                "iconName": "EditNote",
                "registeredObjectId": "open-readme-generator"
            }
        },
        {
            "id": "readme-repos-toolbar-action",
            "type": "ms.vss-web.menu-item",
            "targets": [
                "ms.vss-code-web.source-explorer-toolbar-menu"
            ],
            "properties": {
                "text": "Генератор README",
                "toolbarText": "Генератор README",
                "title": "Сформировать или обновить README текущего репозитория",
                "uri": "modules/readme-helper/action.html",
                "iconName": "EditNote",
                "registeredObjectId": "open-readme-generator"
            }
        },
        {
            "id": "readme-pull-request-action",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-code-web.pull-request-action-menu"
            ],
            "properties": {
                "text": "Генератор README",
                "title": "Открыть генератор README для репозитория",
                "uri": "modules/readme-helper/action.html",
                "iconName": "EditNote",
                "registeredObjectId": "open-readme-generator"
            }
        },
        {
            "id": "readme-commit-action",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-code-web.git-commit-details-menu"
            ],
            "properties": {
                "text": "Генератор README",
                "title": "Открыть генератор README для репозитория",
                "uri": "modules/readme-helper/action.html",
                "iconName": "EditNote",
                "registeredObjectId": "open-readme-generator"
            }
        }
    ],
    "contributionTypes": []
}