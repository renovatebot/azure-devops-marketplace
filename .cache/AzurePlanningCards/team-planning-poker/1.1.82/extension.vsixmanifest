    <Asset Type="dist/settings-1.1.82.css" d:Source="File" Path="dist/settings-1.1.82.css" Addressable="true"/>
    <Asset Type="dist/settings-1.1.82.css.map" d:Source="File" Path="dist/settings-1.1.82.css.map" Addressable="true"/>
    <Asset Type="dist/settings-1.1.82.js" d:Source="File" Path="dist/settings-1.1.82.js" Addressable="true"/>
