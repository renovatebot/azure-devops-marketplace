    <Asset Type="dist/settings-1.1.82.js.map" d:Source="File" Path="dist/settings-1.1.82.js.map" Addressable="true"/>
    <Asset Type="dist/settings.html" d:Source="File" Path="dist/settings.html" Addressable="true"/>
    <Asset Type="dist/workform-1.1.82.css" d:Source="File" Path="dist/workform-1.1.82.css" Addressable="true"/>
