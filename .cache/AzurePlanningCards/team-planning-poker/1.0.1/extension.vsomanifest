{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "planning-poker-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Planning Poker",
                "order": 99,
                "uri": "static/index.html"
            }
        },
        {
            "id": "planning-poker-settings-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Planning Poker Settings",
                "order": 99,
                "uri": "static/settings.html"
            }
        },
        {
            "id": "planning-poker-workform-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Planning Poker",
                "uri": "static/workform.html",
                "height": 260
            }
        },
        {
            "id": "planning-poker-menuaction-backlog",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.backlog-item-menu"
            ],
            "properties": {
                "text": "Start Planning Poker",
                "title": "Start a Planning Poker game with the selected item(s)",
                "icon": "img/logo.png",
                "groupId": "actions",
                "uri": "static/menuaction.html"
            }
        },
        {
            "id": "planning-poker-menuaction-board",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.backlog-board-card-item-menu"
            ],
            "properties": {
                "text": "Start Planning Poker",
                "title": "Start a Planning Poker game with the selected item(s)",
                "icon": "img/logo.png",
                "groupId": "actions",
                "uri": "static/menuaction.html"
            }
        },
        {
            "id": "planning-poker-menuaction-query",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.query-result-work-item-menu"
            ],
            "properties": {
                "text": "Start Planning Poker",
                "title": "Start a Planning Poker game with the selected item(s)",
                "icon": "img/logo.png",
                "groupId": "actions",
                "uri": "static/menuaction.html"
            }
        }
    ],
    "contributionTypes": []
}