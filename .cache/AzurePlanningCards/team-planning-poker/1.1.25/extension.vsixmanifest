<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="team-planning-poker" Publisher="AzurePlanningCards" Version="1.1.25"/>
    <DisplayName>Team Planning Poker</DisplayName>
    <Description xml:space="preserve">Collaborative estimation right from the work item form. Fibonacci / T-shirt / S-M-L / custom decks, per-work-item-type settings, one-click save. No backend to deploy.</Description>
    <Categories>Azure Boards</Categories>
    <Tags>planning poker,estimation,scrum,agile,story points</Tags>
    <Icon>img/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
