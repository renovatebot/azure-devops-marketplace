{
    "manifestVersion": 1,
    "scopes": [
        "vso.code"
    ],
    "contributions": [
        {
            "id": "mermaid-file-content-renderer",
            "type": "ms.vss-code-web.content-renderer",
            "description": "Renders interactive Mermaid (.mmd and .mermaid) diagram previews inside Azure Repos and Pull Requests.",
            "targets": [
                "ms.vss-code-web.content-renderer-collection",
                "ms.vss-code-web.content-renderers"
            ],
            "properties": {
                "name": "MermaidScope Interactive .mmd Preview",
                "uri": "dist/index.html",
                "fileExtensions": [
                    "mmd",
                    "mermaid"
                ],
                "supportedExtensions": [
                    "mmd",
                    "mermaid"
                ],
                "mimeTypes": [
                    "text/html",
                    "text/x-mermaid",
                    "text/vnd.mermaid"
                ],
                "defaultBehavior": "showRenderedContent",
                "registeredObjectId": "mermaid-content-renderer"
            }
        },
        {
            "id": "mermaid-lens-pr-tab",
            "type": "ms.vss-web.tab",
            "description": "Visual Mermaid (.mmd, .mermaid, and .md) diagram diff tab inside Azure Repos Pull Requests.",
            "targets": [
                "ms.vss-code-web.pr-tabs"
            ],
            "properties": {
                "name": "MermaidScope Diagram Diff",
                "order": 45,
                "uri": "dist/index.html?mode=pr-tab"
            }
        },
        {
            "id": "mermaid-lens-repos-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "MermaidScope",
                "order": 36,
                "uri": "dist/index.html"
            }
        },
        {
            "id": "governance-drift-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog"
            ],
            "properties": {
                "name": "Shipwright: MermaidScope Repo Diagram Health",
                "description": "Real-time Mermaid (.mmd / .mermaid) diagram syntax validation and Wiki compatibility health across Azure Repos.",
                "uri": "dist/index.html?widget=governance-drift",
                "catalogIconUrl": "icon.png",
                "previewImageUrl": "icon.png",
                "isNameConfigurable": false,
                "supportedScopes": [
                    "project_team"
                ],
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ]
            }
        }
    ],
    "contributionTypes": []
}