<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="mermaid-lens-repos" Publisher="Shipwright" Version="1.0.0"/>
    <DisplayName>MermaidScope by Shipwright — Free Mermaid .mmd File Preview &amp; Visual PR Diff</DisplayName>
    <Description xml:space="preserve">100% Free Mermaid (.mmd &amp; .mermaid) file preview for Azure Repos &amp; Pull Requests, visual PR diagram diff, 1-click syntax auto-fixer, and SVG/PNG export.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Repos</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0f172a"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://shipwrighthq.com"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://shipwrightops.dev"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://shipwrighthq.com/#roi-calculator"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Pricing" Value="https://shipwrighthq.com/#pricing"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://shipwrighthq.com/support#support"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://shipwrighthq.com/privacy#privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://shipwrighthq.com/license#licensing"/>
    </Properties>
    <Tags>Shipwright,MermaidScope,Mermaid,Diagram Preview,mmd,Flowchart,Azure Repos,Pull Request Diff,Free</Tags>
    <Icon>icon.png</Icon>
    <License>LICENSE.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/assets/index-DcBu5xhz.js" d:Source="File" Path="dist/assets/index-DcBu5xhz.js" Addressable="true"/>
    <Asset Type="dist/icon.png" d:Source="File" Path="dist/icon.png" Addressable="true"/>
    <Asset Type="dist/index.html" d:Source="File" Path="dist/index.html" Addressable="true"/>
    <Asset Type="icon.png" d:Source="File" Path="icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="MARKETPLACE.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
