  <Metadata>
    <Identity Language="en-US" Id="emr" Version="0.0.1.1787270111" Publisher="ShubhamDwivedi"/>
    <GalleryFlags>Public</GalleryFlags>
    <DisplayName>Easy Markdown Review</DisplayName>
    <Description xml:space="preserve">Review Markdown like a Word doc in Azure DevOps: comment on rendered prose in pull requests, render Mermaid diagrams, see what changed, and browse every doc. Git stays the source of truth.</Description>
    <Categories>Azure Repos</Categories>
    <Tags>markdown,review,pull request,design doc,documents,comments</Tags>
    <Icon>static/logo.png</Icon>
  </Metadata>
