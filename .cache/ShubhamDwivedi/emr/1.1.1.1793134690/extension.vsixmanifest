  <Metadata>
    <Identity Language="en-US" Id="emr" Version="1.1.1.1793134690" Publisher="ShubhamDwivedi"/>
    <GalleryFlags>Public</GalleryFlags>
    <DisplayName>Easy Markdown Review</DisplayName>
    <Description xml:space="preserve">Review Markdown like a Word doc in Azure DevOps: comment on rendered prose in pull requests, render Mermaid diagrams, see what changed, and browse every doc. Git stays the source of truth.</Description>
    <Categories>Azure Repos</Categories>
    <Tags>markdown,review,pull request,design doc,documents,comments</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/shudv/easy-markdown-review-ado#get-started"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/shudv/easy-markdown-review-ado/blob/main/LICENSE"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://github.com/shudv/easy-markdown-review-ado/blob/main/PRIVACY.md"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/shudv/easy-markdown-review-ado/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/shudv/easy-markdown-review-ado"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/shudv/easy-markdown-review-ado/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/shudv/easy-markdown-review-ado"/>
    </Properties>
    <Icon>static/logo.png</Icon>
    <License>LICENSE</License>
  </Metadata>
