{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write"
    ],
    "demands": [
        "api-version/5.1"
    ],
    "contributions": [
        {
            "id": "poker-tab",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Planning Poker tab on the work item form",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Planning Poker",
                "uri": "dist/tab.html"
            }
        },
        {
            "id": "poker-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Compact voting status panel on the work item form",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Planning Poker",
                "uri": "dist/group.html",
                "height": 90
            }
        },
        {
            "id": "poker-observer",
            "type": "ms.vss-work-web.work-item-notifications",
            "description": "Presence cleanup when the work item form closes",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "uri": "dist/observer.html"
            }
        },
        {
            "id": "poker-settings",
            "type": "ms.vss-web.hub",
            "description": "Planning Poker settings page under Project Settings",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Planning Poker",
                "order": 100,
                "uri": "dist/settings.html"
            }
        },
        {
            "id": "poker-boards-hub",
            "type": "ms.vss-web.hub",
            "description": "Planning Poker entry in the Boards menu, opening the configuration page",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Planning Poker",
                "order": 99,
                "uri": "dist/settings.html",
                "icon": {
                    "light": "static/img/hub-icon.png",
                    "dark": "static/img/hub-icon.png"
                }
            }
        }
    ],
    "contributionTypes": []
}