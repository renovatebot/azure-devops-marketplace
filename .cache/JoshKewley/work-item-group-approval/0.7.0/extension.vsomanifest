{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.graph",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "group-approval-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "description": "Approval button scoped to a named group.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Work Item Approval Button",
                "uri": "ApprovalControl/ApprovalControl.html",
                "height": 32,
                "supportsReadOnly": true,
                "inputs": [
                    {
                        "id": "GroupName",
                        "name": "Group name",
                        "description": "The group this control approves for, e.g. IT, QA, Business. Shown on the button as '<Group name> Approver'.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "ApproverField",
                        "name": "Approver field",
                        "description": "Identity field that stores who approved. Create one per group in your inherited process, e.g. Custom.ITApprover.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "String",
                                "Identity"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "ApprovedOnField",
                        "name": "Approved on field (optional)",
                        "description": "DateTime field that stores when the approval was given, e.g. Custom.ITApprovedOn.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "DateTime"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "ApproverTeamId",
                        "name": "Approver team ID (set via Configure button)",
                        "description": "GUID of the ADO team whose members may approve. Leave blank to allow anyone. Set using the Configure button — do not type a value here.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "ApproverTeamName",
                        "name": "Approver team name (set via Configure button)",
                        "description": "Display name of the approver team, stored alongside ApproverTeamId for the control UI.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        },
        {
            "id": "group-approval-control-config",
            "type": "ms.vss-work-web.work-item-form-control-configuration",
            "description": "Configuration page for the Work Item Approval Button control.",
            "targets": [
                "JoshKewley.work-item-group-approval.group-approval-control"
            ],
            "properties": {
                "uri": "ApprovalConfig/ApprovalConfig.html"
            }
        }
    ],
    "contributionTypes": []
}