{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.graph"
    ],
    "contributions": [
        {
            "id": "group-approval-control",
            "type": "ms.vss-work-web.work-item-form-control",
            "description": "Approval button scoped to a named group.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Group Approval",
                "uri": "ApprovalControl/ApprovalControl.html",
                "height": 32,
                "supportsReadOnly": true,
                "inputs": [
                    {
                        "id": "GroupName",
                        "name": "Group name",
                        "description": "The group this control approves for, e.g. IT, QA, Business. Shown on the button as '<Group name> Approver'.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "ApproverField",
                        "name": "Approver field",
                        "description": "Identity field that stores who approved. Create one per group in your inherited process, e.g. Custom.ITApprover.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "String",
                                "Identity"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": true
                        }
                    },
                    {
                        "id": "ApprovedOnField",
                        "name": "Approved on field (optional)",
                        "description": "DateTime field that stores when the approval was given, e.g. Custom.ITApprovedOn.",
                        "type": "WorkItemField",
                        "properties": {
                            "workItemFieldTypes": [
                                "DateTime"
                            ]
                        },
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    },
                    {
                        "id": "Label",
                        "name": "Label (optional)",
                        "description": "Heading shown above the button, e.g. \"Approvers\". Leave blank on every control after the first so stacked approvers sit close together. Leave the form layout's own Label blank to avoid showing two headings.",
                        "type": "string",
                        "validation": {
                            "dataType": "String",
                            "isRequired": false
                        }
                    }
                ]
            }
        }
    ],
    "contributionTypes": []
}