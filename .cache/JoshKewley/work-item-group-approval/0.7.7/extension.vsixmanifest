<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="work-item-group-approval" Publisher="JoshKewley" Version="0.7.7"/>
    <DisplayName>Work Item Approval Button</DisplayName>
    <Description xml:space="preserve">Adds an approval button to a work item. Captures the identity of the approver and a timestamp; only the approver or a project administrator can reset approval.</Description>
    <GalleryFlags/>
    <Categories>Azure Boards</Categories>
    <Tags>work item,release,approval,sign-off,governance</Tags>
    <Icon>images/validation-approval.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="ApprovalControl/ApprovalControl.html" d:Source="File" Path="ApprovalControl/ApprovalControl.html" Addressable="true"/>
    <Asset Type="ApprovalControl/ApprovalControl.js" d:Source="File" Path="ApprovalControl/ApprovalControl.js" Addressable="true"/>
    <Asset Type="ApprovalControl/ApprovalControl.js.LICENSE.txt" d:Source="File" Path="ApprovalControl/ApprovalControl.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="ApprovalControl/ApprovalControl.js.map" d:Source="File" Path="ApprovalControl/ApprovalControl.js.map" Addressable="true"/>
    <Asset Type="assets/fonts/fluent-regular.woff2" d:Source="File" Path="assets/fonts/fluent-regular.woff2" Addressable="true"/>
    <Asset Type="assets/fonts/fluent-filled.woff2" d:Source="File" Path="assets/fonts/fluent-filled.woff2" Addressable="true"/>
    <Asset Type="assets/fonts/AzDevMDL2.woff" d:Source="File" Path="assets/fonts/AzDevMDL2.woff" Addressable="true"/>
    <Asset Type="images/ApprovalStates.png" d:Source="File" Path="images/ApprovalStates.png" Addressable="true"/>
    <Asset Type="images/approved-stamp.png" d:Source="File" Path="images/approved-stamp.png" Addressable="true"/>
    <Asset Type="images/logo.png" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="images/validation-approval.png" d:Source="File" Path="images/validation-approval.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/validation-approval.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="marketplace-overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>