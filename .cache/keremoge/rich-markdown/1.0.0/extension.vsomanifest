{
    "manifestVersion": 1,
    "baseUri": "https://localhost:3000",
    "scopes": [
        "vso.code"
    ],
    "contributions": [
        {
            "id": "RichMarkdownWidget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog"
            ],
            "properties": {
                "name": "Rich Markdown Viewer",
                "description": "Reads HTML-supported Markdown from either a Git repository or manual input.",
                "catalogIconUrl": "img/logo.png",
                "previewImageUrl": "img/logo.png",
                "uri": "html/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "configurationContributionId": "rich-markdown.RichMarkdownWidget.Configuration",
                "configurationContributionRelativeId": "RichMarkdownWidget.Configuration"
            }
        },
        {
            "id": "RichMarkdownWidget.Configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Rich Markdown Configuration",
                "description": "Rich Markdown widget'ının ayar sayfası",
                "uri": "html/config.html"
            }
        }
    ],
    "contributionTypes": []
}