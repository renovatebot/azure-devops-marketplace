<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="pr-analytics" Publisher="CodeBeacon" Version="1.0.26"/>
    <DisplayName>PR Analytics</DisplayName>
    <Description xml:space="preserve">Pull Request Analytics for Azure DevOps - track metrics, trends, and team performance</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Repos</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/CodeBeaconHub/PRAnalytics/issues"/>
