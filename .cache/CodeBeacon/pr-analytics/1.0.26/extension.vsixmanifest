      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#222222"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <Tags>Pull Requests,Analytics,Metrics,Code Review,Reporting,DevOps</Tags>
    <Icon>assets/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
