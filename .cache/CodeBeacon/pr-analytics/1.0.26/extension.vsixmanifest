      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/CodeBeaconHub/PRAnalytics/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://CodeBeacon.gallery.vsassets.io/_apis/public/gallery/publisher/CodeBeacon/extension/pr-analytics/latest/assetbyname/Microsoft.VisualStudio.Services.Content.License"/>
