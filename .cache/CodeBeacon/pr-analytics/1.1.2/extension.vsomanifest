{
    "manifestVersion": 1,
    "demands": [
        "api-version/5.0"
    ],
    "scopes": [
        "vso.code"
    ],
    "contributions": [
        {
            "id": "pr-analytics-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "PR Analytics",
                "uri": "dist/pr-analytics/pr-analytics.html",
                "order": 40
            }
        },
        {
            "id": "lead-time-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "CodeBeacon.pr-analytics.lead-time-configuration"
            ],
            "properties": {
                "name": "PR Lead Time Trend",
                "description": "Weekly and monthly weekday lead time, completed PR counts and a configurable target line (default 1.5 days).",
                "catalogIconUrl": "assets/icon.png",
                "previewImageUrl": "assets/lead-time-widget-preview.png",
                "uri": "dist/lead-time-widget/lead-time-widget.html",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "lead-time-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "PR Lead Time Trend Configuration",
                "description": "Configure repositories, statistics, history and the target lead time.",
                "uri": "dist/lead-time-configuration/lead-time-configuration.html"
            }
        }
    ],
    "contributionTypes": []
}