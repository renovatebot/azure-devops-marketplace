  <Metadata>
    <Identity Language="en-US" Id="team-spaces-devops" Publisher="Vegha" Version="0.2.0"/>
    <DisplayName>Team Spaces</DisplayName>
    <Description xml:space="preserve">Confluence-style spaces in Azure DevOps: a page tree, a rich editor, live blocks, diagrams, templates, history and comments, with pages stored in Git.</Description>
    <GalleryFlags>Preview Public</GalleryFlags>
    <Categories>Azure Repos</Categories>
    <Tags>wiki,confluence,documentation,knowledge base</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://vegha.ai/teamspaces"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://vegha.ai/teamspaces/support"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://vegha.ai/teamspaces/privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://vegha.ai/teamspaces/terms"/>
    </Properties>
    <Icon>images/logo.png</Icon>
  </Metadata>
