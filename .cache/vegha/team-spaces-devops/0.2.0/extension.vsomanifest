{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_write",
        "vso.code_manage",
        "vso.work_write",
        "vso.wiki_write",
        "vso.build",
        "vso.project",
        "vso.notification_write"
    ],
    "contributions": [
        {
            "id": "hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Team Spaces in the project's navigation.",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Team Spaces",
                "order": 95,
                "icon": "images/logo.png"
            }
        },
        {
            "id": "spaces",
            "type": "ms.vss-web.hub",
            "description": "The project's spaces.",
            "targets": [
                ".hub-group"
            ],
            "properties": {
                "name": "Spaces",
                "order": 10,
                "uri": "dist/hub.html",
                "icon": "images/logo.png"
            }
        },
        {
            "id": "work-item-pages",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "The Team Spaces pages linked to a work item.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Team Spaces",
                "uri": "dist/workItem.html"
            }
        },
        {
            "id": "page-widget",
            "type": "ms.vss-dashboards-web.widget",
            "description": "A Team Spaces page on a dashboard.",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".page-widget-config"
            ],
            "properties": {
                "name": "Team Spaces page",
                "description": "A page from one of the project's Team Spaces, kept up to date.",
                "catalogIconUrl": "images/logo.png",
                "previewImageUrl": "images/logo.png",
                "uri": "dist/widget.html",
                "isNameConfigurable": false,
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 6
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "page-widget-config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "description": "Settings of the Team Spaces page widget.",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Team Spaces page settings",
                "description": "Choose the space and page.",
                "uri": "dist/widgetConfig.html"
            }
        }
    ],
    "contributionTypes": []
}