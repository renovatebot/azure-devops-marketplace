{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_write",
        "vso.code_manage",
        "vso.work_write",
        "vso.wiki_write",
        "vso.build",
        "vso.project",
        "vso.notification_write"
    ],
    "contributions": [
        {
            "id": "team-spaces",
            "type": "ms.vss-web.feature",
            "description": "Team Spaces on or off for the organisation or a project (set with the Feature Management REST API).",
            "targets": [
                "ms.vss-web.managed-features"
            ],
            "properties": {
                "name": "Team Spaces",
                "description": "Confluence-style spaces: a page tree, a rich editor and live blocks, with pages stored in Git.",
                "userConfigurable": false,
                "hostConfigurable": true,
                "hostScopes": [
                    "project",
                    null
                ],
                "defaultState": true
            }
        },
        {
            "id": "hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Team Spaces in the project's navigation.",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Team Spaces",
                "order": 95,
                "icon": "images/logo.png"
            },
            "constraints": [
                {
                    "name": "Feature",
                    "properties": {
                        "featureId": "Vegha.team-spaces-devops.team-spaces"
                    }
                }
            ]
        },
        {
            "id": "spaces",
            "type": "ms.vss-web.hub",
            "description": "The project's spaces.",
            "targets": [
                ".hub-group"
            ],
            "properties": {
                "name": "Spaces",
                "order": 10,
                "uri": "dist/hub.html",
                "icon": "images/logo.png"
            },
            "constraints": [
                {
                    "name": "Feature",
                    "properties": {
                        "featureId": "Vegha.team-spaces-devops.team-spaces"
                    }
                }
            ]
        },
        {
            "id": "page-widget",
            "type": "ms.vss-dashboards-web.widget",
            "description": "A Team Spaces page on a dashboard.",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".page-widget-config"
            ],
            "properties": {
                "name": "Team Spaces page",
                "description": "A page from one of the project's Team Spaces, kept up to date.",
                "catalogIconUrl": "images/logo.png",
                "previewImageUrl": "images/logo.png",
                "uri": "dist/widget.html",
                "isNameConfigurable": false,
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 6
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            },
            "constraints": [
                {
                    "name": "Feature",
                    "properties": {
                        "featureId": "Vegha.team-spaces-devops.team-spaces"
                    }
                }
            ]
        },
        {
            "id": "page-widget-config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "description": "Settings of the Team Spaces page widget.",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Team Spaces page settings",
                "description": "Choose the space and page.",
                "uri": "dist/widgetConfig.html"
            }
        }
    ],
    "contributionTypes": []
}