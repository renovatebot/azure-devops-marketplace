{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_write",
        "vso.work_write",
        "vso.wiki_write",
        "vso.build",
        "vso.notification_write"
    ],
    "contributions": [
        {
            "id": "hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Team Spaces in the project's navigation.",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Team Spaces",
                "order": 95,
                "icon": "images/logo.png"
            }
        },
        {
            "id": "spaces",
            "type": "ms.vss-web.hub",
            "description": "The project's spaces.",
            "targets": [
                ".hub-group"
            ],
            "properties": {
                "name": "Spaces",
                "order": 10,
                "uri": "dist/hub.html",
                "icon": "images/logo.png"
            }
        }
    ],
    "contributionTypes": []
}