<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="team-spaces-devops" Publisher="Vegha" Version="0.1.21"/>
    <DisplayName>Team Spaces</DisplayName>
    <Description xml:space="preserve">Confluence-style spaces in Azure DevOps: a page tree, a rich editor, live blocks, diagrams, templates, history and comments, with pages stored in Git.</Description>
    <GalleryFlags/>
    <Categories>Azure Repos</Categories>
    <Tags>wiki,confluence,documentation,knowledge base</Tags>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/folder.html" d:Source="File" Path="dist/folder.html" Addressable="true"/>
    <Asset Type="dist/folder.js" d:Source="File" Path="dist/folder.js" Addressable="true"/>
    <Asset Type="dist/hub.html" d:Source="File" Path="dist/hub.html" Addressable="true"/>
    <Asset Type="dist/hub.js" d:Source="File" Path="dist/hub.js" Addressable="true"/>
    <Asset Type="dist/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/workItem.html" d:Source="File" Path="dist/workItem.html" Addressable="true"/>
    <Asset Type="dist/workItem.js" d:Source="File" Path="dist/workItem.js" Addressable="true"/>
    <Asset Type="dist/workItem.js.LICENSE.txt" d:Source="File" Path="dist/workItem.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="images/logo.png" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>