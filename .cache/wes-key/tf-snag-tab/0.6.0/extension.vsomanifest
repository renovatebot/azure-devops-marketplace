{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/wes-key/tf-snag"
    },
    "scopes": [
        "vso.build"
    ],
    "contributions": [
        {
            "id": "tf-snag-build-results-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "tf-snag",
                "uri": "tab/drift.html"
            }
        },
        {
            "id": "tf-snag-install-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/tf-snag-install"
            }
        },
        {
            "id": "tf-snag-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/tf-snag"
            }
        }
    ],
    "contributionTypes": []
}