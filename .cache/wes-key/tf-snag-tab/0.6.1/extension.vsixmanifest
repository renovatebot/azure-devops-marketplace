<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="tf-snag-tab" Publisher="wes-key" Version="0.6.1"/>
    <DisplayName>tf-snag drift report</DisplayName>
    <Description xml:space="preserve">Pipeline tasks that install and run the tf-snag CLI, plus a "tf-snag" run tab showing its drift and deprecation findings with ignore-rule and baseline (first-seen) awareness.</Description>
    <GalleryFlags/>
    <Categories>Azure Pipelines</Categories>
    <Tags>terraform,drift,infrastructure,iac</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/wes-key/tf-snag"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/wes-key/tf-snag/blob/main/extension/tasks/README.md"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/wes-key/tf-snag/blob/main/LICENSE"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/wes-key/tf-snag/issues"/>
    </Properties>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="tab/drift.css" d:Source="File" Path="tab/drift.css" Addressable="true"/>
    <Asset Type="tab/drift.html" d:Source="File" Path="tab/drift.html" Addressable="true"/>
    <Asset Type="tab/drift.js" d:Source="File" Path="tab/drift.js" Addressable="true"/>
    <Asset Type="images/logo.png" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="lib/VSS.SDK.js" d:Source="File" Path="lib/VSS.SDK.js" Addressable="true"/>
    <Asset Type="lib/VSS.SDK.min.js" d:Source="File" Path="lib/VSS.SDK.min.js" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>