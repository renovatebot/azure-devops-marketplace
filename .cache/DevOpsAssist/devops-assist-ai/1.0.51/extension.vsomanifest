{
    "manifestVersion": 1,
    "publisherId": "TheCodeCubeDevelopment",
    "contributions": [
        {
            "id": "ai-pr-review-tab",
            "type": "ms.vss-web.tab",
            "targets": [
                "ms.vss-code-web.pr-tabs"
            ],
            "properties": {
                "name": "AI - Code Reviews",
                "uri": "static/code-review/code-review-action.html",
                "when": "pullRequest.status == 'active'"
            }
        },
        {
            "id": "release-groups-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "test hub group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "DevOps Assist AI",
                "order": 1,
                "icon": {
                    "light": "images/icons/128px/DA.png",
                    "dark": "images/icons/128px/DA.png"
                }
            }
        },
        {
            "id": "or-config-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "DevOps Assist Configuration",
                "uri": "static/admin-configuration/permissions.html"
            }
        },
        {
            "id": "release-groups-hub-group.list-evolve-assists",
            "type": "ms.vss-web.hub",
            "description": "Display a list of release groups",
            "targets": [
                ".release-groups-hub-group"
            ],
            "properties": {
                "name": "Evolve",
                "order": 100,
                "uri": "static/evolve-assist/evolve-assist-list.html",
                "icon": {
                    "light": "images/icons/128px/Evolve.png",
                    "dark": "images/icons/128px/Evolve.png"
                }
            }
        },
        {
            "id": "release-groups-hub-group.create-evolve-assist",
            "type": "ms.vss-web.hub",
            "description": "Create a new assist group",
            "targets": [
                ".release-groups-hub-group"
            ],
            "properties": {
                "name": "Evolve",
                "order": 101,
                "uri": "static/evolve-assist/evolve-assist-detail.html",
                "hidden": true
            }
        },
        {
            "id": "release-groups-hub-group.list-releases",
            "type": "ms.vss-web.hub",
            "description": "Display a list of release groups",
            "targets": [
                ".release-groups-hub-group"
            ],
            "properties": {
                "name": "Release",
                "order": 200,
                "uri": "static/release/release-list.html",
                "icon": {
                    "light": "images/icons/128px/Release.png",
                    "dark": "images/icons/128px/Release.png"
                }
            }
        },
        {
            "id": "release-groups-hub-group.create-release",
            "type": "ms.vss-web.hub",
            "description": "Create a new release group",
            "targets": [
                ".release-groups-hub-group"
            ],
            "properties": {
                "name": "Release",
                "order": 201,
                "hidden": true,
                "uri": "static/release/create-release.html",
                "icon": {
                    "light": "images/icons/128px/Release.png",
                    "dark": "images/icons/128px/Release.png"
                }
            }
        },
        {
            "id": "release-groups-hub-group.calendar-view",
            "type": "ms.vss-web.hub",
            "description": "Calendar view for perfect timesheets",
            "targets": [
                ".release-groups-hub-group"
            ],
            "properties": {
                "name": "Timesheet",
                "order": 300,
                "uri": "static/perfect-timesheet/calendar-view.html",
                "icon": {
                    "light": "images/icons/128px/Timesheets.png",
                    "dark": "images/icons/128px/Timesheets.png"
                }
            }
        },
        {
            "id": "release-groups-hub-group.reporting",
            "type": "ms.vss-web.hub",
            "description": "Reporting for perfect timesheets",
            "targets": [
                ".release-groups-hub-group"
            ],
            "properties": {
                "name": "Timesheet Reports",
                "order": 301,
                "uri": "static/perfect-timesheet/Reports.html",
                "icon": {
                    "light": "images/icons/128px/Timesheets.png",
                    "dark": "images/icons/128px/Timesheets.png"
                }
            }
        },
        {
            "id": "test-plan-testing-agent-tab",
            "type": "ms.vss-web.tab",
            "description": "AI Testing Agent tab on a Test Plans suite - context probe (temporary)",
            "targets": [
                "ms.vss-test-web.test-plan-pivot-tabs"
            ],
            "properties": {
                "name": "Testing Agent",
                "uri": "static/testing-agent/test-plan-tab.html"
            }
        },
        {
            "id": "release-groups-hub-group.chatbot",
            "type": "ms.vss-web.hub",
            "description": "AI Chatbot Assistant for DevOps",
            "targets": [
                ".release-groups-hub-group"
            ],
            "properties": {
                "name": "Cleo Agent",
                "order": 50,
                "uri": "static/chat-bot/chat-bot.html",
                "icon": {
                    "light": "images/icons/128px/CleoAgent.png",
                    "dark": "images/icons/128px/CleoAgent.png"
                }
            }
        },
        {
            "id": "release-groups-hub-group.dashboard",
            "type": "ms.vss-web.hub",
            "description": "Insights for DevOps Assist features and insights",
            "targets": [
                ".release-groups-hub-group"
            ],
            "properties": {
                "name": "Insights",
                "order": 51,
                "uri": "static/Insights/Insights.html",
                "icon": {
                    "light": "images/icons/128px/Insights.png",
                    "dark": "images/icons/128px/Insights.png"
                }
            }
        },
        {
            "id": "release-groups-hub-group.standups",
            "type": "ms.vss-web.hub",
            "description": "AI standup summary for teams, sprints, and releases",
            "targets": [
                ".release-groups-hub-group"
            ],
            "properties": {
                "name": "Standups",
                "order": 52,
                "uri": "static/standup-summary/standup-summary.html",
                "icon": {
                    "light": "images/icons/128px/DA.png",
                    "dark": "images/icons/128px/DA.png"
                }
            }
        },
        {
            "id": "track-time-menu",
            "type": "ms.vss-web.action",
            "description": "Track time against workitem",
            "targets": [
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "text": "Time Tracking",
                "title": "Track time against workitem",
                "toolbarText": "Time Tracking",
                "icon": "images/icons/128px/Timesheets.png",
                "uri": "static/perfect-timesheet/work-item-context-menu-handler.html",
                "id": "track-time-menu"
            }
        },
        {
            "id": "work-item-page-time-tracking",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Work item page time tracking",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Timesheets",
                "uri": "static/perfect-timesheet/work-item-page-time-tracking.html"
            }
        },
        {
            "id": "work-item-page-developer-agent",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Work item Developer Agent tab",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "AI - Developer",
                "uri": "static/developer-agent/developer-agent-action.html"
            }
        },
        {
            "id": "work-item-page-impact-analysis",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Work item Impact & Dependency Analysis tab",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "AI - Impact Analysis",
                "uri": "static/impact-analysis/impact-analysis-action.html"
            }
        },
        {
            "id": "work-item-form-quick-access",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "DevOps Assist AI - Quick Access",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "DevOps Assist AI",
                "uri": "static/quick-access/index.html",
                "height": 600
            }
        },
        {
            "id": "work-item-form-timesheet-quick-access",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Timesheet Quick Access - Start/Stop and Log Time",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Time Tracker",
                "uri": "static/quick-access/timesheet-quick.html",
                "height": 100
            }
        },
        {
            "id": "log-time-form",
            "type": "ms.vss-web.external-content",
            "description": "Log time dialog",
            "targets": [],
            "properties": {
                "name": "Log Time",
                "uri": "static/perfect-timesheet/log-time-dialog.html",
                "registeredObjectId": "log-time-form"
            }
        },
        {
            "id": "edit-logged-time-form",
            "type": "ms.vss-web.external-content",
            "description": "Edit Logged time dialog",
            "targets": [],
            "properties": {
                "name": "Edit Logged time dialog",
                "uri": "static/perfect-timesheet/edit-logged-time-dialog.html",
                "registeredObjectId": "edit-logged-time-form"
            }
        },
        {
            "id": "create-work-item-type-form",
            "type": "ms.vss-web.external-content",
            "description": "Create work item type dialog",
            "targets": [],
            "properties": {
                "name": "Create work item type dialog",
                "uri": "static/perfect-timesheet/create-work-item-type-dialog.html",
                "registeredObjectId": "create-work-item-type-form"
            }
        },
        {
            "id": "edit-work-item-type-form",
            "type": "ms.vss-web.external-content",
            "description": "Edit work item type dialog",
            "targets": [],
            "properties": {
                "uri": "static/perfect-timesheet/dialogs/edit-work-item-type-dialog.html"
            }
        },
        {
            "id": "filter-template-config-panel",
            "type": "ms.vss-web.external-content",
            "description": "Filter Template Panel",
            "properties": {
                "name": "Filter template panel content",
                "uri": "static/perfect-timesheet/filter-template-config-panel.html",
                "registeredObjectId": "filter-template-config-panel"
            }
        },
        {
            "id": "advanced-reporting-config-panel",
            "type": "ms.vss-web.external-content",
            "description": "Advanced Reporting Panel",
            "properties": {
                "name": "Advanced reporting panel content",
                "uri": "static/perfect-timesheet/advanced-reporting-config-panel.html",
                "registeredObjectId": "advanced-reporting-config-panel"
            }
        },
        {
            "id": "work-item-detail",
            "type": "ms.vss-web.control",
            "description": "Work item detail dialog",
            "targets": [],
            "properties": {
                "uri": "static/perfect-timesheet/workitem-detail-dialog.html?id={{workItemIdParam}}&org={{orgParam}}&project={{projectParam}}"
            }
        },
        {
            "id": "evolve-menu",
            "type": "ms.vss-web.action",
            "description": "Open Evolve Assist from work item menu",
            "targets": [
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "text": "Evolve",
                "title": "Open Evolve Assist",
                "toolbarText": "Evolve Assist",
                "icon": "images/icons/128px/Evolve.png",
                "uri": "static/EvolveMenuHandler.html"
            }
        },
        {
            "id": "add-to-release-menu",
            "type": "ms.vss-web.action",
            "description": "Add to Release",
            "targets": [
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "text": "Add to Release",
                "title": "Add to Release",
                "icon": "images/icons/128px/Release.png",
                "group": "actions",
                "uri": "static/EvolveMenuHandler.html"
            }
        },
        {
            "id": "add-to-release-form",
            "type": "ms.vss-web.external-content",
            "description": "Add to Release panel",
            "targets": [],
            "properties": {
                "name": "Add to Release",
                "uri": "static/release/add-to-release-dialog.html",
                "registeredObjectId": "add-to-release-form"
            }
        },
        {
            "id": "run-standup-action-sprint",
            "type": "ms.vss-web.action",
            "description": "Run a real-time standup for this team and sprint",
            "targets": [
                "ms.vss-work-web.sprint-board-pivot-filter-menu"
            ],
            "properties": {
                "text": "AI Standup",
                "title": "Run a real-time standup for this team and sprint",
                "toolbarText": "AI Standup",
                "icon": "images/icons/Summarize_24.png",
                "uri": "static/quick-standup/quick-standup-action-handler.html"
            }
        },
        {
            "id": "run-standup-action-board",
            "type": "ms.vss-web.action",
            "description": "Run a real-time standup for this team and iteration",
            "targets": [
                "ms.vss-work-web.backlog-board-pivot-filter-menu"
            ],
            "properties": {
                "text": "AI Standup",
                "title": "Run a real-time standup for this team and iteration",
                "toolbarText": "AI Standup",
                "group": "actions",
                "icon": "images/icons/Summarize_24.png",
                "uri": "static/quick-standup/quick-standup-action-handler.html"
            }
        },
        {
            "id": "quick-standup-panel",
            "type": "ms.vss-web.external-content",
            "description": "Quick Standup panel",
            "targets": [],
            "properties": {
                "name": "Quick Standup",
                "uri": "static/quick-standup/quick-standup.html",
                "registeredObjectId": "quick-standup-panel"
            }
        },
        {
            "id": "cleo-action-panel",
            "type": "ms.vss-web.external-content",
            "description": "Ask Cleo panel",
            "targets": [],
            "properties": {
                "name": "Ask Cleo",
                "uri": "static/cleo-action-panel.html",
                "registeredObjectId": "cleo-action-panel"
            }
        },
        {
            "id": "cleo-action",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-build-web.pipelines-header-menu",
                "ms.vss-code-web.pull-request-action-menu",
                "ms.vss-work-web.work-item-toolbar-menu"
            ],
            "properties": {
                "text": "Ask Cleo",
                "title": "Ask Cleo",
                "icon": {
                    "light": "images/icons/Cleo_24.png",
                    "dark": "images/icons/Cleo_24.png"
                },
                "uri": "static/cleo-action.html"
            }
        }
    ],
    "scopes": [
        "vso.work_write",
        "vso.graph",
        "vso.project",
        "vso.profile",
        "vso.code",
        "vso.identity",
        "vso.build",
        "vso.test_write",
        "vso.wiki_write",
        "vso.analytics"
    ],
    "contributionTypes": []
}