{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/Shko-Online/storybook-ado-pane"
    },
    "scopes": [
        "vso.build"
    ],
    "contributions": [
        {
            "id": "publish-storybook-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "build/tasks/PublishStorybook"
            }
        },
        {
            "id": "storybook-build-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "description": "Shows the Storybooks published by the Publish Storybook task.",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "Storybook",
                "uri": "web/tab.html",
                "supportsTasks": [
                    "336a2210-9ff7-42c5-90a8-49f39fbeecb0"
                ]
            }
        }
    ],
    "contributionTypes": []
}