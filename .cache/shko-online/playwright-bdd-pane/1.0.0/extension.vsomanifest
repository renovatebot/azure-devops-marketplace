{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/Shko-Online/playwright-bdd-pane"
    },
    "scopes": [
        "vso.build"
    ],
    "contributions": [
        {
            "id": "publish-playwright-bdd-report-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "build/tasks/PublishPlaywrightBddReport"
            }
        },
        {
            "id": "playwright-bdd-build-tab",
            "type": "ms.vss-build-web.build-results-view",
            "description": "Shows playwright-bdd reports published by the Publish Playwright BDD report task.",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "Playwright BDD",
                "uri": "web/tab.html",
                "supportsTasks": [
                    "3295db5e-8ae6-4b91-baf5-fd8be0d10d21"
                ]
            }
        }
    ],
    "contributionTypes": []
}