<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="playwright-bdd-pane" Publisher="shko-online" Version="1.2.0"/>
    <DisplayName>Playwright BDD Report</DisplayName>
    <Description xml:space="preserve">Publish playwright-bdd test reports from your pipelines and review them in a tab of the run, right in the browser.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Pipelines</Categories>
    <Tags>playwright,playwright-bdd,bdd,cucumber,gherkin,test report,testing</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/Shko-Online/playwright-bdd-pane"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/Shko-Online/playwright-bdd-pane/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/Shko-Online/playwright-bdd-pane"/>
    </Properties>
    <Icon>images/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
