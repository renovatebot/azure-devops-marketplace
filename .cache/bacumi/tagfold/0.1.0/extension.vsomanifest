{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "tagfold-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Tagfold",
                "icon": {
                    "light": "images/hub-icon-tagfold-light.png",
                    "dark": "images/hub-icon-tagfold-dark.png"
                },
                "uri": "dist/index.html",
                "order": 60
            }
        }
    ],
    "contributionTypes": []
}