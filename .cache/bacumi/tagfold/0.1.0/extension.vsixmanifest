  <Metadata>
    <Identity Language="en-US" Id="tagfold" Version="0.1.0" Publisher="bacumi"/>
    <DisplayName>Tagfold: Azure Boards Tag Management</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Tags>azure devops,tags,work items,boards,clean up,project settings</Tags>
    <Description xml:space="preserve">Review tag usage and duplicate suggestions, rename tags, merge work item tags, and inspect CSV receipts in Azure DevOps.</Description>
    <Categories>Azure Boards</Categories>
