{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "treefold-export-action",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.work-item-query-results-toolbar-menu"
            ],
            "properties": {
                "text": "Export to Excel (Treefold)",
                "title": "Export this query to an .xlsx workbook with hierarchy intact",
                "icon": {
                    "light": "images/hub-icon-treefold-light.png",
                    "dark": "images/hub-icon-treefold-dark.png"
                },
                "uri": "dist/action.html",
                "group": "actions"
            }
        },
        {
            "id": "treefold-export-dialog",
            "type": "ms.vss-web.external-content",
            "description": "The Treefold export dialog: column picker, hierarchy and rich-text options, progress.",
            "targets": [],
            "properties": {
                "uri": "dist/dialog.html"
            }
        }
    ],
    "contributionTypes": []
}