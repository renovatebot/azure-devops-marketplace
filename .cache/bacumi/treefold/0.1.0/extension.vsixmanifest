  <Metadata>
    <Identity Language="en-US" Id="treefold" Version="0.1.0" Publisher="bacumi"/>
    <DisplayName>Treefold: Azure Boards Query Export to Excel</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Tags>azure devops,excel,export,work items,boards,query</Tags>
    <Description xml:space="preserve">Export Azure Boards queries to Excel with hierarchy, selected columns, readable rich text, and export details.</Description>
    <Categories>Azure Boards</Categories>
