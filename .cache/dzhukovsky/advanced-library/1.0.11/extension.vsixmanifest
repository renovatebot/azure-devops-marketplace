  <Metadata>
    <Identity Language="en-US" Id="advanced-library" Version="1.0.11" Publisher="dzhukovsky"/>
    <DisplayName>Advanced Library</DisplayName>
    <GalleryFlags>Public Preview</GalleryFlags>
    <Description xml:space="preserve">Power-user Library hub for Azure Pipelines: inline editing of variable groups, matrix views to compare environments, change preview before saving, and per-project change history.</Description>
    <Categories>Azure Pipelines</Categories>
    <Tags>library,variables,variable groups,secure files,environments,configuration,release,devops</Tags>
    <Properties>
