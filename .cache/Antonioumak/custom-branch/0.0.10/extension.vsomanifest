{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_write",
        "vso.work"
    ],
    "contributions": [
        {
            "id": "create-branch-action",
            "type": "ms.vss-web.action",
            "description": "Menu item on the Branches page and on work items",
            "targets": [
                "ms.vss-code-web.git-branches-tree-menu",
                "ms.vss-work-web.work-item-context-menu",
                "ms.vss-work-web.work-item-toolbar-menu"
            ],
            "properties": {
                "text": "Create new branch (custom)",
                "title": "Create a branch with an enforced name",
                "group": "actions",
                "uri": "action.html"
            }
        },
        {
            "id": "create-branch-dialog",
            "type": "ms.vss-web.external-content",
            "description": "Dialog body rendered inside the ADO modal",
            "targets": [],
            "properties": {
                "uri": "dialog.html"
            }
        }
    ],
    "contributionTypes": []
}