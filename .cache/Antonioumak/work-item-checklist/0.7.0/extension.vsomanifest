{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write"
    ],
    "contributions": [
        {
            "id": "checklist-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Checklist",
                "uri": "static/checklist.html",
                "height": 220
            }
        },
        {
            "id": "checklist-templates",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Checklist templates",
                "uri": "static/templates.html",
                "order": 100
            }
        }
    ],
    "contributionTypes": []
}