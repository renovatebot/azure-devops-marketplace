<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="work-item-checklist" Publisher="Antonioumak" Version="0.5.0"/>
    <DisplayName>Work Item Checklist</DisplayName>
    <Description xml:space="preserve">Checklist group on the work item form. Default items per work item type, editable per item, shared across users.</Description>
    <GalleryFlags/>
    <Categories>Azure Boards</Categories>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="static/checklist.html" d:Source="File" Path="static/checklist.html" Addressable="true"/>
    <Asset Type="static/checklist.js" d:Source="File" Path="static/checklist.js" Addressable="true"/>
    <Asset Type="static/list.css" d:Source="File" Path="static/list.css" Addressable="true"/>
    <Asset Type="static/templates.html" d:Source="File" Path="static/templates.html" Addressable="true"/>
    <Asset Type="static/templates.js" d:Source="File" Path="static/templates.js" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>