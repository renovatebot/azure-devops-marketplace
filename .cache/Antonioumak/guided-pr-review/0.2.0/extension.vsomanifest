{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_manage",
        "vso.code_status",
        "vso.build",
        "vso.project_manage",
        "vso.identity",
        "vso.work"
    ],
    "contributions": [
        {
            "id": "guide-tab",
            "type": "ms.vss-web.tab",
            "targets": [
                "ms.vss-code-web.pr-tabs"
            ],
            "properties": {
                "name": "Guide",
                "uri": "dist/index.html",
                "order": 99
            }
        },
        {
            "id": "pr-guide-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-admin-hub-groups-collection"
            ],
            "properties": {
                "name": "PR Guide",
                "order": 100
            }
        },
        {
            "id": "pr-guide-rules",
            "type": "ms.vss-web.hub",
            "targets": [
                ".pr-guide-hub-group"
            ],
            "properties": {
                "name": "Attention rules",
                "uri": "dist/settings.html",
                "order": 1
            }
        },
        {
            "id": "pr-guide-policy",
            "type": "ms.vss-web.hub",
            "targets": [
                ".pr-guide-hub-group"
            ],
            "properties": {
                "name": "Review policy",
                "uri": "dist/settings.html",
                "order": 2
            }
        },
        {
            "id": "guided-pr-review-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "GuidedPrReview"
            }
        }
    ],
    "contributionTypes": []
}