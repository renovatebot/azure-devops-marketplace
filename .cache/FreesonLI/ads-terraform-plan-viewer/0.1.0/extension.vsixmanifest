<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="ads-terraform-plan-viewer" Publisher="FreesonLi" Version="0.1.0"/>
    <DisplayName>Terraform Plan Viewer</DisplayName>
    <Description xml:space="preserve">View Terraform plan JSON files from pipeline run artifacts.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Pipelines</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/freesonlee/azure-devops-utilities"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/freesonlee/azure-devops-utilities/issues"/>
    </Properties>
    <Icon>images/terraform-plan-viewer.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/terraform-plan-viewer.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="src/app/terraform-plan-viewer-extension/readme.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>