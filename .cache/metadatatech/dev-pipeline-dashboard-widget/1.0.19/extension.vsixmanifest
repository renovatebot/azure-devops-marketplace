<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="dev-pipeline-dashboard-widget" Publisher="metadatatech" Version="1.0.19"/>
    <DisplayName>Development Pipeline Dashboard Widget</DisplayName>
    <Description xml:space="preserve">Track &amp; manage Git usage: PR stats, per-stage promotion flow, unmerged branches, and a needs-attention list of aging or unreviewed PRs with author, date and comment counts.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Icon>img/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/Configuration/Configuration.css" d:Source="File" Path="dist/Configuration/Configuration.css" Addressable="true"/>
    <Asset Type="dist/Configuration/Configuration.html" d:Source="File" Path="dist/Configuration/Configuration.html" Addressable="true"/>
    <Asset Type="dist/Configuration/Configuration.js" d:Source="File" Path="dist/Configuration/Configuration.js" Addressable="true"/>
    <Asset Type="dist/Dashboard/Dashboard.css" d:Source="File" Path="dist/Dashboard/Dashboard.css" Addressable="true"/>
    <Asset Type="dist/Dashboard/Dashboard.html" d:Source="File" Path="dist/Dashboard/Dashboard.html" Addressable="true"/>
    <Asset Type="dist/Dashboard/Dashboard.js" d:Source="File" Path="dist/Dashboard/Dashboard.js" Addressable="true"/>
    <Asset Type="dist/img/logo.png" d:Source="File" Path="dist/img/logo.png" Addressable="true"/>
    <Asset Type="dist/vendor/VSS.SDK.min.js" d:Source="File" Path="dist/vendor/VSS.SDK.min.js" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>