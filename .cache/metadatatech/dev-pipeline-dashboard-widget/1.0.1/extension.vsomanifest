{
    "manifestVersion": 1,
    "scopes": [
        "vso.code"
    ],
    "contributions": [
        {
            "id": "dev-pipeline-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "dev-pipeline-widget-configuration"
            ],
            "properties": {
                "name": "Development Pipeline",
                "description": "PR and branch stats grouped by protected stage (develop / staging-qa / master).",
                "catalogIconUrl": "img/logo.png",
                "previewImageUrl": "img/logo.png",
                "uri": "Dashboard/Dashboard.html",
                "supportedScopes": [
                    "project_team"
                ],
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 6
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 8
                    }
                ]
            }
        },
        {
            "id": "dev-pipeline-widget-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Development Pipeline Configuration",
                "description": "Configure repository and protected-stage branch mapping.",
                "uri": "Configuration/Configuration.html"
            }
        }
    ],
    "contributionTypes": []
}