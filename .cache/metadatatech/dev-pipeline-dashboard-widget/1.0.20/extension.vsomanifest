{
    "manifestVersion": 1,
    "scopes": [
        "vso.code"
    ],
    "contributions": [
        {
            "id": "dev-pipeline-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "dev-pipeline-widget-configuration"
            ],
            "properties": {
                "name": "Development Pipeline",
                "description": "Track & manage Git usage across one or more repositories, with a switcher to move between them. Rows link straight into Azure DevOps.",
                "catalogIconUrl": "img/logo.png",
                "previewImageUrl": "img/logo.png",
                "uri": "dist/Dashboard/Dashboard.html",
                "supportedScopes": [
                    "project_team"
                ],
                "supportedSizes": [
                    {
                        "rowSpan": 4,
                        "columnSpan": 6
                    },
                    {
                        "rowSpan": 5,
                        "columnSpan": 8
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 6
                    }
                ]
            }
        },
        {
            "id": "dev-pipeline-widget-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Development Pipeline Configuration",
                "description": "Choose which repositories the widget shows, with a switcher to move between them.",
                "uri": "dist/Configuration/Configuration.html"
            }
        }
    ],
    "contributionTypes": []
}