<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="quality-delivery-monitor" Publisher="metadatatech" Version="1.0.2"/>
    <GalleryFlags>Public</GalleryFlags>
    <DisplayName>Quality &amp; Delivery Monitor</DisplayName>
    <Description xml:space="preserve">Work item &amp; bug tracking dashboard widget: tag-based severity, release burndown, fix-effectiveness, SLA ageing and team workload. On-prem friendly.</Description>
    <Categories>Azure Boards</Categories>
    <Tags>dashboard,widget,bugs,work items,quality,boards,property-xrm</Tags>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
    <InstallationTarget Id="Microsoft.TeamFoundation.Server" Version="[15.0,)"/>
  </Installation>
  <Assets>
    <Asset Type="src/configuration.html" d:Source="File" Path="src/configuration.html" Addressable="true"/>
    <Asset Type="src/configuration.js" d:Source="File" Path="src/configuration.js" Addressable="true"/>
    <Asset Type="src/widget.css" d:Source="File" Path="src/widget.css" Addressable="true"/>
    <Asset Type="src/widget.html" d:Source="File" Path="src/widget.html" Addressable="true"/>
    <Asset Type="src/widget.js" d:Source="File" Path="src/widget.js" Addressable="true"/>
    <Asset Type="scripts/VSS.SDK.min.js" d:Source="File" Path="scripts/VSS.SDK.min.js" Addressable="true"/>
    <Asset Type="images/catalog.png" d:Source="File" Path="images/catalog.png" Addressable="true"/>
    <Asset Type="images/logo.png" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="images/preview.png" d:Source="File" Path="images/preview.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>