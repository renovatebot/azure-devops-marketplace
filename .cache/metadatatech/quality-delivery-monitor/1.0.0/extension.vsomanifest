{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "demands": [
        "api-version/3.0"
    ],
    "contributions": [
        {
            "id": "quality-monitor-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog"
            ],
            "properties": {
                "name": "Quality & Delivery Monitor",
                "description": "Bugs & work items: severity (tag-based), release burndown, fix effectiveness, SLA ageing, team workload and a drill-down grid.",
                "previewImageUrl": "images/preview.png",
                "catalogIconUrl": "images/catalog.png",
                "uri": "src/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    }
                ],
                "supportedScopes": [
                    "project_team",
                    "project"
                ]
            }
        },
        {
            "id": "quality-monitor-widget.configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Quality & Delivery Monitor Configuration",
                "description": "Configure project scope, lookback window, SLA thresholds and release date.",
                "uri": "src/configuration.html"
            }
        }
    ],
    "contributionTypes": []
}