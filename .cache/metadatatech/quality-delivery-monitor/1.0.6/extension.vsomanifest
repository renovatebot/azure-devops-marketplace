{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "demands": [
        "api-version/3.0"
    ],
    "contributions": [
        {
            "id": "quality-monitor-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "metadatatech.quality-delivery-monitor.quality-monitor-widget.configuration"
            ],
            "properties": {
                "name": "Quality & Delivery Monitor",
                "description": "Bugs & work items for the current project: severity (tag-based), release burndown, fix effectiveness, SLA ageing, workload and drill-down grid.",
                "previewImageUrl": "images/preview.png",
                "catalogIconUrl": "images/catalog.png",
                "uri": "src/widget.html",
