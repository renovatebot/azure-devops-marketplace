{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.code"
    ],
    "contributions": [
        {
            "id": "ChangesetsPage",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Linked TFVC changesets with branch and merge relationships.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Changesets",
                "uri": "changesets.html"
            }
        },
        {
            "id": "FilesPage",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Files changed by the linked changesets, with per-branch comparison.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Files",
                "uri": "files.html"
            }
        },
        {
            "id": "StateCountsWidget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "ASOLUT365.work-item-code-trace.StateCountsWidget.Configuration"
            ],
            "properties": {
                "name": "Work Item States",
                "description": "Counts work items per state for a WIQL query.",
                "catalogIconUrl": "img/widget-icon.png",
                "previewImageUrl": "img/preview.png",
                "uri": "widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "StateCountsWidget.Configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Work Item States Configuration",
                "description": "Configures the WIQL query.",
                "uri": "configuration.html"
            }
        }
    ],
    "contributionTypes": []
}