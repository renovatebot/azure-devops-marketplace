<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="work-item-code-trace" Version="1.0.0" Publisher="ASOLUT365"/>
    <DisplayName>Work Item Code Trace</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">See which TFVC changesets and files belong to a work item, per branch (Dev, Main, Release), with merge chains, per-branch code differences and an Excel export of the code changes.</Description>
    <Categories>Azure Boards,Azure Repos</Categories>
    <Tags>TFVC,changeset,merge,branch,work item,traceability,code review,diff,Excel</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#950527"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://asolut365.com/de/datenschutzerklaerung"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://asolut365.com/de/kontakt"/>
    </Properties>
    <Icon>img/icon.png</Icon>
    <License>docs/eula-draft.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
    <Asset Type="widget.html" d:Source="File" Path="widget.html" Addressable="true"/>
    <Asset Type="changesets.html" d:Source="File" Path="changesets.html" Addressable="true"/>
    <Asset Type="files.html" d:Source="File" Path="files.html" Addressable="true"/>
    <Asset Type="configuration.html" d:Source="File" Path="configuration.html" Addressable="true"/>
    <Asset Type="js/changesets.js" d:Source="File" Path="js/changesets.js" Addressable="true"/>
