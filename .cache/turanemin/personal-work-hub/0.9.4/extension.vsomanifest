{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.code",
        "vso.build",
        "vso.release",
        "vso.project",
        "vso.identity"
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/eminturan/personal-work-hub"
    },
    "contributions": [
        {
            "id": "hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "My Work",
                "order": 1,
                "uri": "dist/hub/hub.html"
            }
        }
    ],
    "contributionTypes": []
}