<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="field-lens" Publisher="turanemin" Version="0.2.25"/>
    <DisplayName>Field Lens</DisplayName>
    <Description xml:space="preserve">Monthly reports by any date field: list, summarise and export work items of one type whose chosen Date/Time field falls in a range, plus a dashboard widget.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>report,work items,fields,csv,dashboard,widget</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#3b5ba5"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/eminturan/field-lens"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/eminturan/field-lens/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/eminturan/field-lens"/>
    </Properties>
    <Icon>static/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub/hub.html" d:Source="File" Path="dist/hub/hub.html" Addressable="true"/>
    <Asset Type="dist/hub/hub.js" d:Source="File" Path="dist/hub/hub.js" Addressable="true"/>
    <Asset Type="dist/hub/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/report-config/report-config.html" d:Source="File" Path="dist/report-config/report-config.html" Addressable="true"/>
    <Asset Type="dist/report-config/report-config.js" d:Source="File" Path="dist/report-config/report-config.js" Addressable="true"/>
    <Asset Type="dist/report-config/report-config.js.LICENSE.txt" d:Source="File" Path="dist/report-config/report-config.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/report-widget/report-widget.html" d:Source="File" Path="dist/report-widget/report-widget.html" Addressable="true"/>
    <Asset Type="dist/report-widget/report-widget.js" d:Source="File" Path="dist/report-widget/report-widget.js" Addressable="true"/>
    <Asset Type="dist/report-widget/report-widget.js.LICENSE.txt" d:Source="File" Path="dist/report-widget/report-widget.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="static/icon.png" d:Source="File" Path="static/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="static/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>