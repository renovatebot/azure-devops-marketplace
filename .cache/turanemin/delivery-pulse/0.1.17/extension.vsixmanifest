<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="delivery-pulse" Publisher="turanemin" Version="0.1.17"/>
    <DisplayName>Delivery Pulse</DisplayName>
    <Description xml:space="preserve">Lead time of work items from creation to closure, measured separately for parents and children.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>lead time,cycle time,delivery,work items,metrics</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0b6a5b"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/eminturan/delivery-pulse"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/eminturan/delivery-pulse/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/eminturan/delivery-pulse"/>
    </Properties>
    <Icon>static/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub/hub.html" d:Source="File" Path="dist/hub/hub.html" Addressable="true"/>
    <Asset Type="dist/hub/hub.js" d:Source="File" Path="dist/hub/hub.js" Addressable="true"/>
    <Asset Type="dist/hub/hub.js.LICENSE.txt" d:Source="File" Path="dist/hub/hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/summary-config/summary-config.html" d:Source="File" Path="dist/summary-config/summary-config.html" Addressable="true"/>
    <Asset Type="dist/summary-config/summary-config.js" d:Source="File" Path="dist/summary-config/summary-config.js" Addressable="true"/>
    <Asset Type="dist/summary-config/summary-config.js.LICENSE.txt" d:Source="File" Path="dist/summary-config/summary-config.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/summary-widget/summary-widget.html" d:Source="File" Path="dist/summary-widget/summary-widget.html" Addressable="true"/>
    <Asset Type="dist/summary-widget/summary-widget.js" d:Source="File" Path="dist/summary-widget/summary-widget.js" Addressable="true"/>
    <Asset Type="dist/summary-widget/summary-widget.js.LICENSE.txt" d:Source="File" Path="dist/summary-widget/summary-widget.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="static/icon.png" d:Source="File" Path="static/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="static/icon.png" Addressable="true"/>
    <Asset Type="static/widget-summary.png" d:Source="File" Path="static/widget-summary.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>