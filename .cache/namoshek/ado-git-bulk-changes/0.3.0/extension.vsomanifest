{
    "manifestVersion": 1,
    "demands": [
        "api-version/7.0"
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/Namoshek/azure-devops-git-bulk-changes"
    },
    "CustomerQnASupport": {
        "enablemarketplaceqna": "false",
        "url": "https://github.com/Namoshek/azure-devops-git-bulk-changes/issues",
        "enableMarketplaceQnA": "false"
    },
    "contributions": [
        {
            "id": "collection-settings-hub",
            "type": "ms.vss-web.hub",
            "description": "Git Bulk Changes adds a hub for managing bulk changes in Git repositories.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Git Bulk Changes",
                "order": 100,
                "uri": "dist/CollectionHub/index.html"
            }
        }
    ],
    "scopes": [
        "vso.project",
        "vso.code",
        "vso.code_write"
    ],
    "contributionTypes": []
}