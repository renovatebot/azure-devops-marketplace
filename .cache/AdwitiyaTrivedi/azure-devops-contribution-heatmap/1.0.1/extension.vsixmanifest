<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="azure-devops-contribution-heatmap" Version="1.0.1" Publisher="AdwitiyaTrivedi"/>
    <DisplayName>Contribution Heatmap</DisplayName>
    <Description xml:space="preserve">A contribution calendar for your own Azure Repos commits. Runs entirely inside Azure DevOps: no backend, no personal access tokens, no third-party services.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Repos</Categories>
    <Tags>contributions,heatmap,calendar,commits,activity,analytics</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#1f2a37"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/mainadwitiya/azure-devops-contribution-heatmap"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/mainadwitiya/azure-devops-contribution-heatmap/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/mainadwitiya/azure-devops-contribution-heatmap/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/mainadwitiya/azure-devops-contribution-heatmap/blob/main/LICENSE"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/mainadwitiya/azure-devops-contribution-heatmap"/>
    </Properties>
    <Icon>images/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/heatmap.css" d:Source="File" Path="dist/heatmap.css" Addressable="true"/>
    <Asset Type="dist/heatmap.html" d:Source="File" Path="dist/heatmap.html" Addressable="true"/>
    <Asset Type="dist/heatmap.js" d:Source="File" Path="dist/heatmap.js" Addressable="true"/>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="images/screenshot-calendar.png" d:Source="File" Path="images/screenshot-calendar.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="images/screenshot-calendar.png" Addressable="true"/>
    <Asset Type="images/screenshot-dark.png" d:Source="File" Path="images/screenshot-dark.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.2" d:Source="File" Path="images/screenshot-dark.png" Addressable="true"/>
    <Asset Type="images/screenshot-day-details.png" d:Source="File" Path="images/screenshot-day-details.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.3" d:Source="File" Path="images/screenshot-day-details.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>