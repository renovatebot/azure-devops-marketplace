{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/mainadwitiya/azure-devops-contribution-heatmap"
    },
    "scopes": [
        "vso.code"
    ],
    "contributions": [
        {
            "id": "contribution-heatmap-hub",
            "type": "ms.vss-web.hub",
            "description": "Adds a Contribution Heatmap hub to the Azure Repos hub group.",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "Contribution Heatmap",
                "order": 60,
                "uri": "dist/heatmap.html",
                "iconName": "Calendar",
                "supportsMobile": true
            }
        }
    ],
    "contributionTypes": []
}