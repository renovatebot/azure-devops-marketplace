    <DisplayName>BranchDeploy - Deploy linked branches from work items</DisplayName>
    <Description xml:space="preserve">Deploy Azure Repos branches from Azure Boards work items without copying branch names into Azure Pipelines.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards,Azure Pipelines</Categories>
    <Tags>Azure DevOps,Azure Boards,Azure Repos,Azure Pipelines,work items,deployment,branch deploy,pull requests,UAT,QA</Tags>
