{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.code",
        "vso.build_execute",
        "vso.extension.data_write"
    ],
    "contributions": [
        {
            "id": "branchdeploy-action",
            "type": "ms.vss-web.action",
            "description": "Run BranchDeploy for the branch linked to this work item.",
            "targets": [
                "ms.vss-work-web.work-item-toolbar-menu"
            ],
            "properties": {
                "text": "BranchDeploy",
                "title": "Deploy linked branch with BranchDeploy",
                "toolbarText": "BranchDeploy",
                "icon": "images/menu-icon-light.png",
                "uri": "dist/deploy-action.html",
                "registeredObjectId": "branchdeploy-action-handler"
            }
        },
        {
            "id": "branchdeploy-project-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "BranchDeploy",
                "order": 90,
                "icon": {
                    "light": "images/menu-icon-light.png",
                    "dark": "images/menu-icon-dark.png"
                },
                "uri": "dist/settings.html"
            }
        },
        {
            "id": "branchdeploy-branch-picker",
            "type": "ms.vss-web.external-content",
            "description": "BranchDeploy branch and environment picker dialog.",
            "properties": {
                "uri": "dist/branch-picker.html"
            }
        },
        {
            "id": "branchdeploy-dialog",
            "type": "ms.vss-web.external-content",
            "description": "BranchDeploy deploy confirmation and result dialog.",
            "properties": {
                "uri": "dist/dialog.html"
            }
        },
        {
            "id": "branchdeploy-environments-hub",
            "type": "ms.vss-web.hub",
            "description": "What's deployed to each BranchDeploy environment, and who's holding it.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "BranchDeploy",
                "order": 100,
                "icon": {
                    "light": "images/menu-icon-light.png",
                    "dark": "images/menu-icon-dark.png"
                },
                "uri": "dist/environments.html"
            }
        },
        {
            "id": "branchdeploy-work-item-deployments",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Where this work item is deployed, read from BranchDeploy pipeline runs.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Deployments",
                "uri": "dist/work-item-deployments.html",
                "height": 140
            }
        }
    ],
    "contributionTypes": []
}