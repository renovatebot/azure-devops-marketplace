{
    "manifestVersion": 1,
    "scopes": [
        "vso.code",
        "vso.extension.data",
        "vso.extension.data_write",
        "vso.work"
    ],
    "contributions": [
        {
            "id": "pullboard-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "Pullboard",
                "uri": "dist/hub/hub.html",
                "icon": "static/icon.png"
            }
        },
        {
            "id": "pullboard-settings",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Pullboard Settings",
                "uri": "dist/settings/settings.html",
                "icon": "static/icon.png"
            }
        },
        {
            "id": "pullboard-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog"
            ],
            "properties": {
                "name": "Pullboard Widget",
                "description": "Pullboard widget",
                "uri": "dist/widget/widget.html",
                "catalogIconUrl": "static/icon.png",
                "previewImageUrl": "static/icon.png",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    }
                ],
                "configurationContributionId": "pullboard-widget-config"
            }
        },
        {
            "id": "pullboard-widget-config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Pullboard Widget Configuration",
                "description": "Configure Pullboard widget",
                "uri": "dist/widget-config/widget-config.html"
            }
        },
        {
            "id": "pullboard-pr-tab",
            "type": "ms.vss-web.tab",
            "targets": [
                "ms.vss-code-web.pr-tabs"
            ],
            "properties": {
                "name": "Pullboard",
                "uri": "dist/pr-tab/pr-tab.html"
            }
        }
    ],
    "contributionTypes": []
}