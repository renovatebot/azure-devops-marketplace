<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="epsilon-ai-assistant" Version="1.0.0" Publisher="epsilonnet"/>
    <DisplayName>Epsilon AI Assistant</DisplayName>
    <Description xml:space="preserve">AI for Azure DevOps on Microsoft Foundry + Serena: pull request review with Claude, and planning/implementing work items on feature branches with Claude Code or OpenCode.</Description>
    <GalleryFlags/>
    <Categories>Azure Pipelines,Azure Boards</Categories>
    <Icon>images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="web/implement-dialog.html" d:Source="File" Path="web/implement-dialog.html" Addressable="true"/>
    <Asset Type="web/implement-dialog.js" d:Source="File" Path="web/implement-dialog.js" Addressable="true"/>
    <Asset Type="web/implement-menu.html" d:Source="File" Path="web/implement-menu.html" Addressable="true"/>
    <Asset Type="web/lib/VSS.SDK.min.js" d:Source="File" Path="web/lib/VSS.SDK.min.js" Addressable="true"/>
    <Asset Type="web/review-dialog.html" d:Source="File" Path="web/review-dialog.html" Addressable="true"/>
    <Asset Type="web/review-dialog.js" d:Source="File" Path="web/review-dialog.js" Addressable="true"/>
    <Asset Type="web/review-menu.html" d:Source="File" Path="web/review-menu.html" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>