<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="fairmas-dora-dashboard" Publisher="FairmasGmbH" Version="0.1.22"/>
    <DisplayName>Fairmas DORA Dashboard</DisplayName>
    <Description xml:space="preserve">DORA dashboard with precomputed historical metrics, charts, freshness, and evidence limitations.</Description>
    <Categories>Azure Boards</Categories>
    <GalleryFlags>Public</GalleryFlags>
    <Icon>assets/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
    <InstallationTarget Id="Microsoft.TeamFoundation.Server" Version="[19.0,)"/>
  </Installation>
  <Assets>
    <Asset Type="dist/index.html" d:Source="File" Path="dist/index.html" Addressable="true"/>
    <Asset Type="dist/index.js" d:Source="File" Path="dist/index.js" Addressable="true"/>
    <Asset Type="dist/index.js.LICENSE.txt" d:Source="File" Path="dist/index.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/initial-dashboard/assets/index-MV1fq2Dj.css" d:Source="File" Path="dist/initial-dashboard/assets/index-MV1fq2Dj.css" Addressable="true"/>
    <Asset Type="dist/initial-dashboard/assets/index-PMUSUMkM.js" d:Source="File" Path="dist/initial-dashboard/assets/index-PMUSUMkM.js" Addressable="true"/>
    <Asset Type="dist/initial-dashboard/index.html" d:Source="File" Path="dist/initial-dashboard/index.html" Addressable="true"/>
    <Asset Type="assets/logo.png" d:Source="File" Path="assets/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="assets/logo.png" Addressable="true"/>
    <Asset Type="assets/widget-icon.png" d:Source="File" Path="assets/widget-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>