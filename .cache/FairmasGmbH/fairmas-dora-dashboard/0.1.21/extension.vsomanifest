{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "dora-kpi-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog"
            ],
            "properties": {
                "name": "Fairmas DORA Dashboard",
                "description": "Shows precomputed DORA metrics and charts in a responsive, resizable widget.",
                "catalogIconUrl": "assets/widget-icon.png",
                "uri": "dist/index.html",
                "isNameConfigurable": false,
                "supportedSizes": [
                    {
                        "rowSpan": 8,
                        "columnSpan": 12
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 7
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 8
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 6
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        }
    ],
    "scopes": [
        "vso.extension.data"
    ],
    "contributionTypes": []
}