{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.extension.data_write",
        "vso.analytics",
        "vso.memberentitlementmanagement"
    ],
    "contributions": [
        {
            "id": "query-kanban-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "AnyKanban",
                "order": 100,
                "uri": "dist/hub/hub.html",
                "iconAsset": "AnyKanban.query-kanban/static/img/hub-icon.png",
                "_sharedData": {
                    "assets": [
                        "AnyKanban.query-kanban/static/img/hub-icon.png"
                    ]
                }
            }
        },
        {
            "id": "query-kanban-tab",
            "type": "ms.vss-web.tab",
            "targets": [
                "ms.vss-work-web.query-tabs"
            ],
            "properties": {
                "name": "Board",
                "uri": "dist/query-tab/query-tab.html"
            }
        },
        {
            "id": "query-kanban-tab-aging",
            "type": "ms.vss-web.tab",
            "targets": [
                "ms.vss-work-web.query-tabs"
            ],
            "properties": {
                "name": "Aging WIP",
                "uri": "dist/query-tab/query-tab.html"
            }
        },
        {
            "id": "query-kanban-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "AnyKanban.query-kanban.query-kanban-widget-configuration"
            ],
            "properties": {
                "name": "AnyKanban board",
                "description": "Column counts and a one-click link to an AnyKanban board.",
                "catalogIconUrl": "static/img/logo.png",
                "uri": "dist/widget/widget.html",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    },
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "query-kanban-widget-configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "AnyKanban board configuration",
                "uri": "dist/widget-config/widget-config.html"
            }
        },
        {
            "id": "query-kanban-admin",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "AnyKanban",
                "order": 100,
                "uri": "dist/admin/admin.html"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "query-kanban-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "query-kanban-tab",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "query-kanban-tab-aging",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "query-kanban-widget",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "query-kanban-widget-configuration",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "query-kanban-admin",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}