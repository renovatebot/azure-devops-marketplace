<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="query-kanban" Publisher="AnyKanban" Version="1.0.0"/>
    <DisplayName>AnyKanban: Kanban Board from Any Query</DisplayName>
    <Description xml:space="preserve">Turn saved Azure DevOps queries into Kanban boards across projects, including work outside your backlogs.</Description>
    <Categories>Azure Boards</Categories>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Tags>__BYOLENFORCED,Kanban,Board,Query,WIQL,Cross-project,Aging,Portfolio,Rollup,Capacity,Dependencies,Flow metrics</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://anykanban.com/docs/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://anykanban.com/eula/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://anykanban.com/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://anykanban.com/contact/"/>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="60"/>
    </Properties>
    <Icon>static/img/logo.png</Icon>
    <License>static/marketplace/license.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
