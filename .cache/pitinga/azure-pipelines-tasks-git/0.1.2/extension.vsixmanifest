<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="azure-pipelines-tasks-git" Publisher="pitinga" Version="0.1.2"/>
    <DisplayName>Git Tasks for Azure Pipelines</DisplayName>
    <Description xml:space="preserve">Node.js 24 tasks for Git tags, branches, comparison, changelogs, verification, commit statuses, pull requests and protected merges in Azure Repos.</Description>
    <GalleryFlags/>
    <Categories>Azure Pipelines</Categories>
    <Tags>git,Azure Repos,Node 24,tag,branch,compare,changelog,merge,pull request</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/pitinga/azure-pipelines-tasks-git"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/pitinga/azure-pipelines-tasks-git/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/pitinga/azure-pipelines-tasks-git"/>
    </Properties>
    <Icon>images/extension-icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>