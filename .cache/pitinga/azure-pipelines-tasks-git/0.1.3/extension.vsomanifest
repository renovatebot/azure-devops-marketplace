{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/pitinga/azure-pipelines-tasks-git"
    },
    "contributions": [
        {
            "id": "git-tag",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "GitTag"
            }
        },
        {
            "id": "git-branch",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "GitBranch"
            }
        },
        {
            "id": "git-compare",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "GitCompare"
            }
        },
        {
            "id": "git-changelog",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "GitChangelog"
            }
        },
        {
            "id": "git-verify",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "GitVerify"
            }
        },
        {
            "id": "git-commit-status",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "GitCommitStatus"
            }
        },
        {
            "id": "git-pull-request",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "GitPullRequest"
            }
        },
        {
            "id": "git-merge",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "GitMerge"
            }
        }
    ],
    "scopes": [],
    "contributionTypes": []
}