{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/pitinga/azure-pipelines-tasks-trivy"
    },
    "contributions": [
        {
            "id": "trivy-installer",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "TrivyInstaller"
            }
        },
        {
            "id": "trivy-scan",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "TrivyScan"
            }
        }
    ],
    "scopes": [],
    "contributionTypes": []
}