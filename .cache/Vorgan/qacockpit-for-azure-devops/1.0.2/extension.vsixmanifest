      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://qacockpit.app/contact/"/>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="60"/>
    </Properties>
    <Icon>assets/icon.png</Icon>
  </Metadata>
