  <Metadata>
    <Identity Language="en-US" Id="qacockpit-for-azure-devops" Publisher="Vorgan" Version="1.0.2"/>
    <DisplayName>QaCockpit for Azure DevOps</DisplayName>
    <Description xml:space="preserve">Quality cockpits, test intelligence, failure analysis and private campaigns for Azure Pipelines.</Description>
    <GalleryFlags>Paid Preview</GalleryFlags>
    <Categories>Azure Pipelines</Categories>
    <Tags>testing,test operations,pipelines,__BYOLENFORCED,__DoNotDownload</Tags>
    <Properties>
