{
    "manifestVersion": 1,
    "scopes": [
        "vso.project",
        "vso.build",
        "vso.build_execute",
        "vso.test",
        "vso.extension"
    ],
    "licensing": {
        "overrides": [
            {
                "id": "qacockpit-hub-group",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "qacockpit-pipelines-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "qacockpit-test-intelligence-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "qacockpit-campaigns-hub",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributions": [
        {
            "id": "qacockpit-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "QaCockpit",
                "order": 100,
                "icon": {
                    "light": "assets/qacockpit-navigation.png",
                    "dark": "assets/qacockpit-navigation.png"
                }
            }
        },
        {
            "id": "qacockpit-pipelines-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qacockpit-hub-group"
            ],
            "properties": {
                "name": "Quality Board",
                "order": 10,
                "uri": "dist/index.html?hub=quality-board",
                "icon": {
                    "light": "assets/quality-board.png",
                    "dark": "assets/quality-board.png"
                }
            }
        },
        {
            "id": "qacockpit-test-intelligence-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qacockpit-hub-group"
            ],
            "properties": {
                "name": "Test Intelligence",
                "order": 20,
                "uri": "dist/index.html?hub=test-intelligence",
                "icon": {
                    "light": "assets/test-intelligence.png",
                    "dark": "assets/test-intelligence.png"
                }
            }
        },
        {
            "id": "qacockpit-campaigns-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qacockpit-hub-group"
            ],
            "properties": {
                "name": "Campaigns",
                "order": 30,
                "uri": "dist/index.html?hub=campaigns",
                "icon": {
                    "light": "assets/campaigns.png",
                    "dark": "assets/campaigns.png"
                }
            }
        }
    ],
    "contributionTypes": []
}