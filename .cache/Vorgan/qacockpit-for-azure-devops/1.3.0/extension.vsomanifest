{
    "manifestVersion": 1,
    "scopes": [
        "vso.project",
        "vso.build",
        "vso.code",
        "vso.analytics",
        "vso.agentpools",
        "vso.build_execute",
        "vso.test",
        "vso.extension"
    ],
    "licensing": {
        "overrides": [
            {
                "id": "qacockpit-access",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "qacockpit-hub-group",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "qacockpit-pipelines-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "qacockpit-pipeline-intelligence-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "qacockpit-test-intelligence-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "qacockpit-campaigns-hub",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributions": [
        {
            "id": "qacockpit-access",
            "type": "ms.vss-web.feature",
            "description": "Show QaCockpit navigation for the current user or the organization.",
            "targets": [
                "ms.vss-web.managed-features",
                "ms.vss-web.managed-features-onprem"
            ],
            "properties": {
                "name": "QaCockpit access",
                "userConfigurable": true,
                "hostConfigurable": true,
                "hostScopes": [
                    null
                ],
                "defaultState": false
            }
        },
        {
            "id": "qacockpit-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "QaCockpit",
                "order": 100,
                "icon": {
                    "light": "assets/qacockpit-navigation.png",
                    "dark": "assets/qacockpit-navigation.png"
                }
            },
            "constraints": [
                {
                    "name": "Feature",
                    "properties": {
                        "featureId": "Vorgan.qacockpit-for-azure-devops.qacockpit-access"
                    }
                }
            ]
        },
        {
            "id": "qacockpit-pipelines-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qacockpit-hub-group"
            ],
            "properties": {
                "name": "Quality Board",
                "order": 10,
                "uri": "dist/index.html?hub=quality-board",
                "icon": {
                    "light": "assets/quality-board.png",
                    "dark": "assets/quality-board.png"
                }
            },
            "constraints": [
                {
                    "name": "Feature",
                    "properties": {
                        "featureId": "Vorgan.qacockpit-for-azure-devops.qacockpit-access"
                    }
                }
            ]
        },
        {
            "id": "qacockpit-pipeline-intelligence-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qacockpit-hub-group"
            ],
            "properties": {
                "name": "Pipeline Intelligence",
                "order": 20,
                "uri": "dist/index.html?hub=pipeline-intelligence",
                "icon": {
                    "light": "assets/quality-board.png",
                    "dark": "assets/quality-board.png"
                }
            },
            "constraints": [
                {
                    "name": "Feature",
                    "properties": {
                        "featureId": "Vorgan.qacockpit-for-azure-devops.qacockpit-access"
                    }
                }
            ]
        },
        {
            "id": "qacockpit-test-intelligence-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qacockpit-hub-group"
            ],
            "properties": {
                "name": "Test Intelligence",
                "order": 30,
                "uri": "dist/index.html?hub=test-intelligence",
                "icon": {
                    "light": "assets/test-intelligence.png",
                    "dark": "assets/test-intelligence.png"
                }
            },
            "constraints": [
                {
                    "name": "Feature",
                    "properties": {
                        "featureId": "Vorgan.qacockpit-for-azure-devops.qacockpit-access"
                    }
                }
            ]
        },
        {
            "id": "qacockpit-campaigns-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                ".qacockpit-hub-group"
            ],
            "properties": {
                "name": "Campaigns",
                "order": 40,
                "uri": "dist/index.html?hub=campaigns",
                "icon": {
                    "light": "assets/campaigns.png",
                    "dark": "assets/campaigns.png"
                }
            },
            "constraints": [
                {
                    "name": "Feature",
                    "properties": {
                        "featureId": "Vorgan.qacockpit-for-azure-devops.qacockpit-access"
                    }
                }
            ]
        }
    ],
    "contributionTypes": []
}