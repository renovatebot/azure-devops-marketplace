{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/icnocop/TfvcCodeReviewOnline"
    },
    "scopes": [
        "vso.code",
        "vso.work"
    ],
    "contributions": [
        {
            "id": "code-review-comments",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Adds a tab to the work item form that shows the TFVC code review discussion threads.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Comments",
                "uri": "web/index.html"
            }
        }
    ],
    "contributionTypes": []
}