{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.work_write",
        "vso.identity",
        "vso.graph",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "InsertTransportOrderButtonControl",
            "description": "Insert Transport Order button – valida e inserta órdenes de transporte SAP",
            "type": "ms.vss-work-web.work-item-form-control",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Insert Transport Order Button Control",
                "uri": "index.html",
                "height": 50,
                "inputs": [
                    {
                        "id": "ButtonText",
                        "name": "Button Text",
                        "type": "String",
                        "description": "Texto que se mostrará en el botón.",
                        "properties": {
                            "defaultValue": "Insert Transport Order"
                        },
                        "validation": {
                            "isRequired": false
                        }
                    },
                    {
                        "id": "TransportOrderField",
                        "name": "Transport Order Field",
                        "type": "String",
                        "description": "Campo del work Item Task que se leerá como 'Transport Order'",
                        "properties": {
                            "defaultValue": ""
                        },
                        "validation": {
                            "isRequired": true
                        }
                    },
                    {
                        "id": "NeedSystemDownField",
                        "name": "Need System Down Field",
                        "type": "String",
                        "description": "Campo del work Item Task que se leerá como flag de 'Need System Down'",
                        "properties": {
                            "defaultValue": ""
                        },
                        "validation": {
                            "isRequired": true
                        }
                    },
                    {
                        "id": "NeedTransactionBlockedField",
                        "name": "Need Transaction Blocked Field",
                        "type": "String",
                        "description": "Campo del work Item Task que se leerá como flag de 'Need Transaction BLoked'",
                        "properties": {
                            "defaultValue": ""
                        },
                        "validation": {
                            "isRequired": true
                        }
                    },
                    {
                        "id": "CommentsField",
                        "name": "Comments Field",
                        "type": "String",
                        "description": "Campo del work Item Task que se leerá como 'Comments'",
                        "properties": {
                            "defaultValue": ""
                        },
                        "validation": {
                            "isRequired": true
                        }
                    },
                    {
                        "id": "TransportOrderDataField",
                        "name": "Transport Order Data Field",
                        "type": "String",
                        "description": "Campo del work Item Task que se usará como 'TransportOrderData' destino de la concatenación",
                        "properties": {
                            "defaultValue": ""
                        },
                        "validation": {
                            "isRequired": true
                        }
                    },
                    {
                        "id": "CheckOdataSap",
                        "name": "Check Odata SAP",
                        "type": "Boolean",
                        "description": "Flag 'Check Odata SAP' que indica si se activa o no la verificación con SAP mediante el Odata ZBC_OD_TRANSPORT_ORDER_STATUS",
                        "properties": {
                            "defaultValue": "false"
                        }
                    },
                    {
                        "id": "OdataUri",
                        "name": "Odata URI",
                        "type": "String",
                        "description": "URI del Odata que es obligatorio",
                        "properties": {
                            "defaultValue": ""
                        },
                        "validation": {
                            "isRequired": true
                        }
                    },
                    {
                        "id": "SapUser",
                        "name": "SAP User",
                        "type": "String",
                        "description": "Usuario SAP para la conexión",
                        "properties": {
                            "defaultValue": ""
                        },
                        "validation": {
                            "isRequired": false
                        }
                    },
                    {
                        "id": "SapPassword",
                        "name": "SAP Password",
                        "type": "String",
                        "description": "Password SAP",
                        "properties": {
                            "defaultValue": ""
                        },
                        "validation": {
                            "isRequired": false
                        }
                    }
                ]
            }
        }
    ],
    "contributionTypes": []
}