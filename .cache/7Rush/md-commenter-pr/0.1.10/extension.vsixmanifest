<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="md-commenter-pr" Publisher="7rush" Version="0.1.10"/>
    <DisplayName>MD Commenter</DisplayName>
    <Description xml:space="preserve">Adds an 'MD Commenter' tab to Pull Requests: read Markdown files rendered, click any paragraph, list item, table row or code block and leave a PR comment anchored to the exact source lines.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Repos</Categories>
    <Tags>markdown,pull request,code review,preview,comments</Tags>
    <Icon>img/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/tab.html" d:Source="File" Path="dist/tab.html" Addressable="true"/>
    <Asset Type="dist/tab.js" d:Source="File" Path="dist/tab.js" Addressable="true"/>
    <Asset Type="dist/tab.js.LICENSE.txt" d:Source="File" Path="dist/tab.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="img/concept.png" d:Source="File" Path="img/concept.png" Addressable="true"/>
    <Asset Type="img/logo.png" d:Source="File" Path="img/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>