{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "june-security-ai-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/JuneSecurityAiV1"
            }
        },
        {
            "id": "june-ai-results-tab",
            "type": "ms.vss-build-web.build-results-tab",
            "description": "June AI tab of the pipeline run: quality gate, findings, exceptions, review scope, context and tokens of the June Security AI review.",
            "targets": [
                "ms.vss-build-web.build-results-view"
            ],
            "properties": {
                "name": "June AI",
                "title": "June AI",
                "uri": "results-tab/index.html",
                "supportsTasks": [
                    "a65fe3ce-503b-4c6c-918b-36a62b859028"
                ],
                "supportsMobile": false,
                "dynamic": true
            }
        }
    ],
    "scopes": [
        "vso.build"
    ],
    "contributionTypes": []
}