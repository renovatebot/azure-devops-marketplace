{
    "manifestVersion": 1,
    "licensing": {
        "overrides": [
            {
                "id": "ada-hub-group",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "ada-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "ada-work-items-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "ada-documentation-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "ada-code-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "ada-support-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "ada-requirements-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "ada-others-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "improve-with-ai-form-group",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "ada-admin-hub",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "scopes": [
        "vso.wiki_write",
        "vso.work_write",
        "vso.project",
        "vso.code",
        "vso.build",
        "vso.release"
    ],
    "contributions": [
        {
            "id": "ada-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Ada: AI assistant for Azure DevOps Wikis, work items and documentation.",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Ada",
                "order": 100,
                "icon": {
                    "light": "img/icon.png",
                    "dark": "img/icon.png"
                }
            }
        },
        {
            "id": "ada-hub",
            "type": "ms.vss-web.hub",
            "description": "Ada's Wiki actions: ask the Wiki and work items, create and edit Wiki pages. Every change is reviewed before it is saved.",
            "targets": [
                ".ada-hub-group"
            ],
            "properties": {
                "name": "Wiki",
                "order": 100,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/wiki-light.png",
                    "dark": "img/hubs/wiki-dark.png"
                }
            }
        },
        {
            "id": "ada-work-items-hub",
            "type": "ms.vss-web.hub",
            "description": "Ada's work item actions: ask about work items, create work items, generate a backlog hierarchy.",
            "targets": [
                ".ada-hub-group"
            ],
            "properties": {
                "name": "Work Items",
                "order": 200,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/work-items-light.png",
                    "dark": "img/hubs/work-items-dark.png"
                }
            }
        },
        {
            "id": "ada-documentation-hub",
            "type": "ms.vss-web.hub",
            "description": "Ada's documentation actions: pull-request documentation, release and sprint documentation, project documentation, architecture debates.",
            "targets": [
                ".ada-hub-group"
            ],
            "properties": {
                "name": "Documentation",
                "order": 300,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/documentation-light.png",
                    "dark": "img/hubs/documentation-dark.png"
                }
            }
        },
        {
            "id": "ada-code-hub",
            "type": "ms.vss-web.hub",
            "description": "Ada's code actions: read-only pull request reviews.",
            "targets": [
                ".ada-hub-group"
            ],
            "properties": {
                "name": "Code",
                "order": 400,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/code-light.png",
                    "dark": "img/hubs/code-dark.png"
                }
            }
        },
        {
            "id": "ada-support-hub",
            "type": "ms.vss-web.hub",
            "description": "Ada's support actions: diagnose a ticket from its details, logs and traces.",
            "targets": [
                ".ada-hub-group"
            ],
            "properties": {
                "name": "Support",
                "order": 500,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/support-light.png",
                    "dark": "img/hubs/support-dark.png"
                }
            }
        },
        {
            "id": "ada-requirements-hub",
            "type": "ms.vss-web.hub",
            "description": "Ada's requirements actions: design requirements, how the application works today, Delight Check and mockups.",
            "targets": [
                ".ada-hub-group"
            ],
            "properties": {
                "name": "Requirements",
                "order": 600,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/requirements-light.png",
                    "dark": "img/hubs/requirements-dark.png"
                }
            }
        },
        {
            "id": "ada-others-hub",
            "type": "ms.vss-web.hub",
            "description": "Ada's other actions: project templates and sprint schedules.",
            "targets": [
                ".ada-hub-group"
            ],
            "properties": {
                "name": "Others",
                "order": 700,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/others-light.png",
                    "dark": "img/hubs/others-dark.png"
                }
            }
        },
        {
            "id": "improve-with-ai-form-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Ada on the work item: Generate, Improve or Regenerate each text field, split stories, create Tasks and Test Cases. Every proposal is previewed first.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Ada",
                "uri": "dist/form.html",
                "height": 600
            }
        },
        {
            "id": "ada-admin-hub",
            "type": "ms.vss-web.hub",
            "description": "Ada organization settings: the organization's AI backend, personas and pull-request documentation checks.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Ada",
                "order": 100,
                "uri": "dist/admin.html"
            }
        }
    ],
    "contributionTypes": []
}