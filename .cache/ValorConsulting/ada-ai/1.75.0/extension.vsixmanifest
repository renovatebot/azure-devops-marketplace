  <Metadata>
    <Identity Language="en-US" Id="ada-ai" Publisher="ValorConsulting" Version="1.75.0"/>
    <DisplayName>Ada - Azure DevOps AI Assistant</DisplayName>
    <Description xml:space="preserve">AI code review, documentation generation and work item creation for Azure DevOps. Runs on your own backend, or as a managed service that Valor Consulting runs and keeps up to date.</Description>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Categories>Azure Repos,Azure Boards</Categories>
    <Tags>AI,AI assistant,GPT,LLM,copilot,chat,generative AI,Azure OpenAI,OpenAI,Claude,code review,pull request,PR review,code quality,static analysis,documentation,docs generator,README,architecture,technical writing,wiki,sprint planning,sprint,backlog,work items,user stories,agile,scrum,project management,requirements,requirements engineering,business analysis,mockup,UI mockup,prototyping,wireframe,Pull Requests,Test Cases,__BYOLENFORCED</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="30"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://adadocs.valor-co.com/demo/index.html"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://adadocs.valor-co.com/support.html"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://adadocs.valor-co.com/privacy.html"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://adadocs.valor-co.com/license.html"/>
    </Properties>
    <Icon>img/icon.png</Icon>
    <License>LICENSE.md</License>
  </Metadata>
