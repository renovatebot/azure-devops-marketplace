  <Metadata>
    <Identity Language="en-US" Id="amy" Publisher="ValorConsulting" Version="0.46.2"/>
    <DisplayName>Amy AI</DisplayName>
    <Description xml:space="preserve">AI code review, documentation generation and work item creation for Azure DevOps. Runs on your organization's own backend and AI provider; no hosted AI service is included.</Description>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Categories>Azure Repos,Azure Boards</Categories>
    <Tags>AI,AI assistant,GPT,LLM,copilot,chat,generative AI,Azure OpenAI,OpenAI,Claude,code review,pull request,PR review,code quality,static analysis,documentation,docs generator,README,architecture,technical writing,wiki,sprint planning,sprint,backlog,work items,user stories,agile,scrum,project management,requirements,requirements engineering,business analysis,mockup,UI mockup,prototyping,wireframe,Pull Requests,Test Cases,__BYOLENFORCED</Tags>
    <Properties>
