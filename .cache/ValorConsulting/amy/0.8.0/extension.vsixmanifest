  <Metadata>
    <Identity Language="en-US" Id="amy" Publisher="ValorConsulting" Version="0.8.0"/>
    <DisplayName>Amy AI</DisplayName>
    <Description xml:space="preserve">AI assistant for Azure DevOps Wikis and Boards. Bring your own backend: no hosted AI service is included; each organization connects its own.</Description>
    <GalleryFlags>Public Preview</GalleryFlags>
    <Categories>Azure Boards,Azure Repos</Categories>
    <Tags>AI,Wiki,Work Items,Backlog,Documentation,Architecture,Code Review,Pull Requests,Sprint Planning,Test Cases</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/NotSweetEnough/amy-docs/blob/main/SUPPORT.md"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://github.com/NotSweetEnough/amy-docs/blob/main/PRIVACY.md"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/NotSweetEnough/amy-docs/blob/main/LICENSE.md"/>
    </Properties>
    <Icon>img/icon.png</Icon>
    <License>LICENSE.md</License>
  </Metadata>
