{
    "manifestVersion": 1,
    "scopes": [
        "vso.wiki_write",
        "vso.work_write",
        "vso.project",
        "vso.code",
        "vso.build",
        "vso.release"
    ],
    "contributions": [
        {
            "id": "amy-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Amy: AI assistant for Azure DevOps Wikis, work items and documentation.",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Amy AI",
                "order": 100,
                "icon": {
                    "light": "img/icon.png",
                    "dark": "img/icon.png"
                }
            }
        },
        {
            "id": "amy-hub",
            "type": "ms.vss-web.hub",
            "description": "Chat and quick actions for Wiki questions, Wiki pages, work items and documentation. Every change is reviewed before it is saved.",
            "targets": [
                ".amy-hub-group"
            ],
            "properties": {
                "name": "Amy AI",
                "order": 100,
                "uri": "dist/index.html"
            }
        },
        {
            "id": "improve-with-ai-form-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Amy on the work item: Generate, Improve or Regenerate each text field, split stories, create Tasks and Test Cases. Every proposal is previewed first.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Amy AI",
                "uri": "dist/form.html",
                "height": 600
            }
        },
        {
            "id": "amy-admin-hub",
            "type": "ms.vss-web.hub",
            "description": "Amy AI organization settings: the organization's AI backend, personas and pull-request documentation checks.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Amy AI",
                "order": 100,
                "uri": "dist/admin.html"
            }
        }
    ],
    "contributionTypes": []
}