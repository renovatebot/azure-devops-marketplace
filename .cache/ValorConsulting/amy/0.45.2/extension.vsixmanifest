  <Metadata>
    <Identity Language="en-US" Id="amy" Publisher="ValorConsulting" Version="0.45.2"/>
    <DisplayName>Amy AI</DisplayName>
    <Description xml:space="preserve">AI assistant for Azure DevOps Wikis and Boards. Bring your own backend: no hosted AI service is included; each organization connects its own.</Description>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Categories>Azure Boards,Azure Repos</Categories>
    <Tags>AI,Wiki,Work Items,Backlog,Documentation,Architecture,Code Review,Pull Requests,Sprint Planning,Test Cases,__BYOLENFORCED</Tags>
    <Properties>
