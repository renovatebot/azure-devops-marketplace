      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://amydocs.valor-co.com/license.html"/>
    </Properties>
    <Icon>img/icon.png</Icon>
    <License>LICENSE.md</License>
  </Metadata>
