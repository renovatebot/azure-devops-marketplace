{
    "manifestVersion": 1,
    "scopes": [
        "vso.wiki_write",
        "vso.work_write",
        "vso.project",
        "vso.code",
        "vso.build",
        "vso.release"
    ],
    "contributions": [
        {
            "id": "amy-hub-group",
            "type": "ms.vss-web.hub-group",
            "description": "Amy: AI assistant for Azure DevOps Wikis, work items and documentation.",
            "targets": [
                "ms.vss-web.project-hub-groups-collection"
            ],
            "properties": {
                "name": "Amy AI",
                "order": 100,
                "icon": {
                    "light": "img/icon.png",
                    "dark": "img/icon.png"
                }
            }
        },
        {
            "id": "amy-hub",
            "type": "ms.vss-web.hub",
            "description": "Amy's Wiki actions: ask the Wiki and work items, create and edit Wiki pages. Every change is reviewed before it is saved.",
            "targets": [
                ".amy-hub-group"
            ],
            "properties": {
                "name": "Wiki",
                "order": 100,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/wiki-light.png",
                    "dark": "img/hubs/wiki-dark.png"
                }
            }
        },
        {
            "id": "amy-work-items-hub",
            "type": "ms.vss-web.hub",
            "description": "Amy's work item actions: ask about work items, create work items, generate a backlog hierarchy.",
            "targets": [
                ".amy-hub-group"
            ],
            "properties": {
                "name": "Work Items",
                "order": 200,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/work-items-light.png",
                    "dark": "img/hubs/work-items-dark.png"
                }
            }
        },
        {
            "id": "amy-documentation-hub",
            "type": "ms.vss-web.hub",
            "description": "Amy's documentation actions: pull-request documentation, release and sprint documentation, project documentation, architecture debates.",
            "targets": [
                ".amy-hub-group"
            ],
            "properties": {
                "name": "Documentation",
                "order": 300,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/documentation-light.png",
                    "dark": "img/hubs/documentation-dark.png"
                }
            }
        },
        {
            "id": "amy-code-hub",
            "type": "ms.vss-web.hub",
            "description": "Amy's code actions: read-only pull request reviews.",
            "targets": [
                ".amy-hub-group"
            ],
            "properties": {
                "name": "Code",
                "order": 400,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/code-light.png",
                    "dark": "img/hubs/code-dark.png"
                }
            }
        },
        {
            "id": "amy-others-hub",
            "type": "ms.vss-web.hub",
            "description": "Amy's other actions: project templates and sprint schedules.",
            "targets": [
                ".amy-hub-group"
            ],
            "properties": {
                "name": "Others",
                "order": 500,
                "uri": "dist/index.html",
                "icon": {
                    "light": "img/hubs/others-light.png",
                    "dark": "img/hubs/others-dark.png"
                }
            }
        },
        {
            "id": "improve-with-ai-form-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Amy on the work item: Generate, Improve or Regenerate each text field, split stories, create Tasks and Test Cases. Every proposal is previewed first.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Amy AI",
                "uri": "dist/form.html",
                "height": 600
            }
        },
        {
            "id": "amy-admin-hub",
            "type": "ms.vss-web.hub",
            "description": "Amy AI organization settings: the organization's AI backend, personas and pull-request documentation checks.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Amy AI",
                "order": 100,
                "uri": "dist/admin.html"
            }
        }
    ],
    "contributionTypes": []
}