{
    "manifestVersion": 1,
    "licensing": {
        "overrides": [
            {
                "id": "work-item-age",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "work-item-age",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "How long the work item has existed, how long it has been in its state and when it last changed.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Age",
                "uri": "dist/age.html",
                "height": 96
            }
        }
    ],
    "contributionTypes": []
}