      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/NotSweetEnough/amy-docs/blob/main/LICENSE.md"/>
    </Properties>
    <Icon>img/icon.png</Icon>
    <License>LICENSE.md</License>
  </Metadata>
