{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.project",
        "vso.extension.data_write"
    ],
    "contributions": [
        {
            "id": "delivery-map-hub",
            "type": "ms.vss-web.hub",
            "description": "Delivery Map and team dependency inbox",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Delivery Map",
                "uri": "dist/hub.html",
                "order": 99,
                "icon": {
                    "light": "static/hub-light.png",
                    "dark": "static/hub-dark.png"
                }
            }
        },
        {
            "id": "cross-team-dependencies",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Request work from another team, or hand an item over",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Cross-team dependencies",
                "uri": "dist/form.html",
                "height": 240
            }
        }
    ],
    "contributionTypes": []
}