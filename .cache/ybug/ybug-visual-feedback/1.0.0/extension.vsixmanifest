<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="ybug-visual-feedback" Version="1.0.0" Publisher="ybug"/>
    <DisplayName>Ybug: Visual Feedback &amp; Bug Reporting</DisplayName>
    <Description xml:space="preserve">Collect annotated screenshots and technical context from your website and send them to Azure Boards as work items.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>bug reporting,visual feedback,screenshot,QA,UAT,website feedback</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://ybug.io/docs/integrations/azure-devops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://ybug.io/integrations/azure-devops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://ybug.io/contact"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://ybug.io/privacy-policy"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#ffffff"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="light"/>
    </Properties>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Integration"/>
    <InstallationTarget Id="Microsoft.TeamFoundation.Server.Integration"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="images/screen1.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.2" d:Source="File" Path="images/screen2.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
  </Assets>
</PackageManifest>