{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_full",
        "vso.graph",
        "vso.identity",
        "vso.profile"
    ],
    "licensing": {
        "overrides": [
            {
                "id": "appgami-automation.project-settings",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "demands": [
        "api-version/3.0",
        "contributionType/ms.vss-web.hub"
    ],
    "eventCallbacks": {
        "postInstall": {
            "uri": "https://automation.appgami.com/api/azure/event-callback"
        },
        "postUninstall": {
            "uri": "https://automation.appgami.com/api/azure/event-callback"
        }
    },
    "contributions": [
        {
            "id": "appgami-automation.project-settings",
            "type": "ms.vss-web.hub",
            "description": "Appgami Automation project management",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Appgami Automation",
                "order": 30,
                "uri": "index.html"
            }
        },
        {
            "id": "appgami-automation.admin-hub",
            "type": "ms.vss-web.hub",
            "description": "Appgami Automation administration",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Appgami Automation",
                "order": 31,
                "uri": "index.html/admin-extension"
            }
        }
    ],
    "baseUri": "https://automation.appgami.com",
    "contributionTypes": []
}