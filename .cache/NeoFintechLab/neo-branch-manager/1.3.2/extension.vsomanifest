{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "branch-manager-hub",
            "type": "ms.vss-web.hub",
            "description": "Branch management view showing commit info, behind/ahead stats, pull requests, and work item linkage",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "Branch Manager",
                "order": 50,
                "uri": "dist/hub.html"
            }
        },
        {
            "id": "branch-manager-settings",
            "type": "ms.vss-web.hub",
            "description": "Configure the branch naming regex and user initials mappings",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Branch Manager",
                "order": 100,
                "uri": "dist/settings.html"
            }
        }
    ],
    "scopes": [
        "vso.code",
        "vso.code_manage",
        "vso.work",
        "vso.graph"
    ],
    "contributionTypes": []
}