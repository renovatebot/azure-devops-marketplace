{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "nfl-itemtasks-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Checklist panel for work items",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "State Checklist",
                "uri": "dist/checklist.html",
                "height": 320
            }
        },
        {
            "id": "nfl-itemtasks-settings-hub",
            "type": "ms.vss-web.hub",
            "description": "Configure checklists by work item type and state",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "State Checklist",
                "order": 101,
                "uri": "dist/settings.html"
            }
        },
        {
            "id": "nfl-itemtasks-state-summary-dialog",
            "type": "ms.vss-web.control",
            "description": "Read-only summary of checklist items across all states",
            "properties": {
                "name": "State Checklist Summary",
                "uri": "dist/state-summary-dialog.html"
            }
        }
    ],
    "scopes": [
        "vso.work",
        "vso.work_write"
    ],
    "contributionTypes": []
}