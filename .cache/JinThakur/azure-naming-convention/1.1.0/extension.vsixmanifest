<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="azure-naming-convention" Publisher="JinThakur" Version="1.1.0"/>
    <DisplayName>Azure Naming Convention</DisplayName>
    <Description xml:space="preserve">Generates, validates, and registers Azure resource names against a governed naming standard, right inside Azure DevOps.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards,Azure Pipelines</Categories>
    <Tags>naming convention,azure,governance,enterprise architecture</Tags>
    <Icon>img/extension-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/Hub.html" d:Source="File" Path="dist/Hub.html" Addressable="true"/>
    <Asset Type="dist/Hub.js" d:Source="File" Path="dist/Hub.js" Addressable="true"/>
    <Asset Type="dist/Hub.js.LICENSE.txt" d:Source="File" Path="dist/Hub.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/Hub.js.map" d:Source="File" Path="dist/Hub.js.map" Addressable="true"/>
    <Asset Type="dist/img/extension-icon.png" d:Source="File" Path="dist/img/extension-icon.png" Addressable="true"/>
    <Asset Type="dist/img/hub-icon.png" d:Source="File" Path="dist/img/hub-icon.png" Addressable="true"/>
    <Asset Type="img/extension-icon.png" d:Source="File" Path="img/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/extension-icon.png" Addressable="true"/>
    <Asset Type="img/hub-icon.png" d:Source="File" Path="img/hub-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>