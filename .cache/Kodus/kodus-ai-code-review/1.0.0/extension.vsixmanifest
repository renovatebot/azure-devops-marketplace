<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="kodus-ai-code-review" Version="1.0.0" Publisher="Kodus"/>
    <DisplayName>Kodus AI Code Review</DisplayName>
    <GalleryFlags/>
    <Description xml:space="preserve">Open source AI code review without vendor lock-in. Kody reviews your Azure Repos pull requests with the model you choose, in Kodus Cloud or self-hosted.</Description>
    <Categories>Azure Repos</Categories>
    <Tags>code review,pull request,AI,code quality,security,open source,self-hosted,BYOK</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://app.kodus.io/sign-up?utm_source=azure-devops-marketplace&amp;utm_medium=marketplace"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://docs.kodus.io/en/knowledge_base/how-to-set-up-ai-code-review-on-azure-devops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://discord.gg/kodus"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://kodus.io/en/privacy-policy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://kodus.io/en/terms-of-use"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/kodustech/kodus-ai"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#141217"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Integration"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
  </Assets>
</PackageManifest>