<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="pundit-specops" Publisher="Waiin" Version="2.0.4"/>
    <DisplayName>Raaghu Spec Kit</DisplayName>
    <Description xml:space="preserve">Raaghu Spec Kit, is an Azure DevOps extension for PMs, BAs and QAs to leverage Specification Driven Development using spec-kit, Microsoft GitHub Repository, acting as a Project Management tool.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Tags>ai,spec-kit,specification driven development,project management,azure boards,work items,requirements,backlog,agile,wiki,pm,ba,qa,acceptance criteria</Tags>
    <Categories>Azure Boards,Azure Repos</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="mailto:support@raaghu.ai"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://www.waiin.com/privacy-policy"/>
    </Properties>
    <Icon>utils/assets/RaaghuLogo.png</Icon>
    <License>eula.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
    <InstallationTarget Id="Microsoft.TeamFoundation.Server" Version="[17.0,)"/>
  </Installation>
