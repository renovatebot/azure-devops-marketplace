      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://iklab.dev/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://iklab.dev/terms/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://api.iklab.dev/api/privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://iklab.dev/support/"/>
      <Property Id="Microsoft.VisualStudio.Services.EnableMarketplaceQnA" Value="true"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#c41e5a"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <Icon>images/icon.png</Icon>
  </Metadata>
