<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="ai-testcase-generator" Publisher="ikcasepilot" Version="4.3.9"/>
    <DisplayName>Borsch - AI Test Case Generator &amp; Backlog Quality</DisplayName>
    <Description xml:space="preserve">One AI plugin that refines your whole backlog: generate test cases, sharpen bug reports, and enrich user stories - with a multi-stage AI review that scores higher than single-pass tools. Free tier.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards,Azure Test Plans</Categories>
    <Tags>test cases,bug reports,user stories,AI,QA,backlog,test generation,automation,test case generator,test plan,test management,GPT,OpenAI,ChatGPT,Copilot,acceptance criteria</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://iklab.dev/docs/borsch/"/>
