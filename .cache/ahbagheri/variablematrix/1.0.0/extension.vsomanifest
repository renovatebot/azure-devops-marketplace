{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/ahbagheri/variable-matrix"
    },
    "scopes": [
        "vso.variablegroups_manage"
    ],
    "contributions": [
        {
            "id": "variable-matrix-hub",
            "type": "ms.vss-web.hub",
            "description": "Environment matrix for Azure Pipelines Library variable groups.",
            "targets": [
                "ms.vss-build-web.build-release-hub-group"
            ],
            "properties": {
                "name": "Variable Matrix",
                "order": 90,
                "uri": "dist/index.html"
            }
        }
    ],
    "contributionTypes": []
}