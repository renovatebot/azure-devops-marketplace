{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "reqs-work-item-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "The reqs a work item delivers, with what changed since they were reviewed.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Reqs",
                "uri": "dist/panel.html",
                "height": 360
            }
        },
        {
            "id": "reqs-settings",
            "type": "ms.vss-web.hub",
            "description": "Connect this organization to a Reqs workspace.",
            "targets": [
                "ms.vss-web.collection-admin-hub-group"
            ],
            "properties": {
                "name": "Reqs",
                "uri": "dist/settings.html",
                "order": 100
            }
        }
    ],
    "contributionTypes": []
}