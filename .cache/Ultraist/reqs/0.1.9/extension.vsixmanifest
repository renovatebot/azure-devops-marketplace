<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="reqs" Publisher="ultraist" Version="0.1.9"/>
    <DisplayName>Reqs</DisplayName>
    <Description xml:space="preserve">See, link and review the Reqs requirements behind each work item.</Description>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://ultraist.dev/docs/reqs-azure-devops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://ultraist.dev/reqs"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://ultraist.dev/contact"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://ultraist.dev/privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://ultraist.dev/terms"/>
    </Properties>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>Requirements,Traceability,Work Items,Azure Boards,Product Management</Tags>
    <Icon>images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/panel.html" d:Source="File" Path="dist/panel.html" Addressable="true"/>
    <Asset Type="dist/panel.js" d:Source="File" Path="dist/panel.js" Addressable="true"/>
    <Asset Type="dist/panel.js.map" d:Source="File" Path="dist/panel.js.map" Addressable="true"/>
    <Asset Type="dist/settings.html" d:Source="File" Path="dist/settings.html" Addressable="true"/>
    <Asset Type="dist/settings.js" d:Source="File" Path="dist/settings.js" Addressable="true"/>
    <Asset Type="dist/settings.js.map" d:Source="File" Path="dist/settings.js.map" Addressable="true"/>
    <Asset Type="dist/styles.css" d:Source="File" Path="dist/styles.css" Addressable="true"/>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="images/screenshots/highlight-1.png" d:Source="File" Path="images/screenshots/highlight-1.png" Addressable="true"/>
    <Asset Type="images/screenshots/highlight-2.png" d:Source="File" Path="images/screenshots/highlight-2.png" Addressable="true"/>
    <Asset Type="images/screenshots/highlight-3.png" d:Source="File" Path="images/screenshots/highlight-3.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>