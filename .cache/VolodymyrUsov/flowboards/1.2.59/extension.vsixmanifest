<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="flowboards" Publisher="volodymyrusov" Version="1.2.59"/>
    <DisplayName>Flowboards: story map, roadmap, flow</DisplayName>
    <Description xml:space="preserve">A story map board, backlog tree, roadmap, dependencies, calendar, a story scheduler, sprint planning, flow metrics, pull requests, health checks and tag tidying for your team. Free and open source.</Description>
    <GalleryFlags>Preview</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>story map,kanban,roadmap,dependencies,sprint planning,flow metrics,cycle time,forecast,pull requests,health check,tags</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/Volodymyr-Usov/flowboards"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/Volodymyr-Usov/flowboards/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/Volodymyr-Usov/flowboards/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/Volodymyr-Usov/flowboards/blob/main/LICENSE"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/Volodymyr-Usov/flowboards"/>
    </Properties>
    <Icon>images/icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Cloud"/>
  </Installation>
  <Assets>
    <Asset Type="dist/index.html" d:Source="File" Path="dist/index.html" Addressable="true"/>
    <Asset Type="images/author.png" d:Source="File" Path="images/author.png" Addressable="true"/>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="images/screens/board-dark.png" d:Source="File" Path="images/screens/board-dark.png" Addressable="true"/>
    <Asset Type="images/screens/flow-light.png" d:Source="File" Path="images/screens/flow-light.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>