{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/Volodymyr-Usov/flowboards"
    },
    "scopes": [
        "vso.work_write",
        "vso.code",
        "vso.project",
        "vso.graph"
    ],
    "contributions": [
        {
            "id": "flowboards-hub",
            "type": "ms.vss-web.hub",
            "description": "Flowboards: story map, roadmap, flow and checks for a team.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Flowboards",
                "uri": "dist/index.html",
                "iconName": "ViewDashboard",
                "order": 25
            }
        }
    ],
    "contributionTypes": []
}