{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.project",
        "vso.graph"
    ],
    "demands": [
        "api-version/7.1"
    ],
    "contributions": [
        {
            "id": "workitem-link-validate-listener",
            "type": "ms.vss-work-web.work-item-notification-listener",
            "description": "Validates parent/child hierarchy links as they are added or removed on the work item form.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "uri": "dist/workItemForm/workItemForm.html"
            }
        },
        {
            "id": "workitem-link-validate-admin-hub",
            "type": "ms.vss-web.hub",
            "description": "Configure the parent/child hierarchy rules enforced for this project.",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "Link Validate",
                "uri": "dist/adminHub/adminHub.html"
            }
        },
        {
            "id": "workitem-link-validate-admin-hub-group",
            "type": "ms.vss-web.hub-group",
            "targets": [
                "ms.vss-web.project-admin-hub-groups-collection"
            ],
            "properties": {
                "name": "Link Validate"
            }
        },
        {
            "id": "workitem-link-validate-traceability-hub",
            "type": "ms.vss-web.hub",
            "description": "Shows parent/child traceability coverage for each work item type in this project, with drill-down queries.",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Work items Traceability",
                "order": 99,
                "icon": "img/traceability-hub-icon.png",
                "uri": "dist/traceabilityDashboard/traceabilityDashboard.html"
            }
        }
    ],
    "contributionTypes": []
}