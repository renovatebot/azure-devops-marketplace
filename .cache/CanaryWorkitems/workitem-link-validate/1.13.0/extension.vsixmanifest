<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="workitem-link-validate" Publisher="CanaryWorkitems" Version="1.13.0"/>
    <DisplayName>Workitem Link Validate</DisplayName>
    <Description xml:space="preserve">Enforces a configurable, per-project work item parent/child hierarchy at link time so rollups and portfolio views stay trustworthy.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>work items,hierarchy,governance,validation,on-premises</Tags>
    <Icon>img/extension-icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/adminHub/adminHub.css" d:Source="File" Path="dist/adminHub/adminHub.css" Addressable="true"/>
    <Asset Type="dist/adminHub/adminHub.html" d:Source="File" Path="dist/adminHub/adminHub.html" Addressable="true"/>
    <Asset Type="dist/adminHub/adminHub.js" d:Source="File" Path="dist/adminHub/adminHub.js" Addressable="true"/>
    <Asset Type="dist/adminHub/adminHub.js.map" d:Source="File" Path="dist/adminHub/adminHub.js.map" Addressable="true"/>
    <Asset Type="dist/traceabilityDashboard/traceabilityDashboard.css" d:Source="File" Path="dist/traceabilityDashboard/traceabilityDashboard.css" Addressable="true"/>
    <Asset Type="dist/traceabilityDashboard/traceabilityDashboard.html" d:Source="File" Path="dist/traceabilityDashboard/traceabilityDashboard.html" Addressable="true"/>
    <Asset Type="dist/traceabilityDashboard/traceabilityDashboard.js" d:Source="File" Path="dist/traceabilityDashboard/traceabilityDashboard.js" Addressable="true"/>
    <Asset Type="dist/traceabilityDashboard/traceabilityDashboard.js.map" d:Source="File" Path="dist/traceabilityDashboard/traceabilityDashboard.js.map" Addressable="true"/>
    <Asset Type="dist/workItemForm/listener.js" d:Source="File" Path="dist/workItemForm/listener.js" Addressable="true"/>
    <Asset Type="dist/workItemForm/listener.js.map" d:Source="File" Path="dist/workItemForm/listener.js.map" Addressable="true"/>
    <Asset Type="dist/workItemForm/workItemForm.html" d:Source="File" Path="dist/workItemForm/workItemForm.html" Addressable="true"/>
    <Asset Type="img/agile-hierarchy-example.png" d:Source="File" Path="img/agile-hierarchy-example.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="img/agile-hierarchy-example.png" Addressable="true"/>
    <Asset Type="img/extension-icon.png" d:Source="File" Path="img/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/extension-icon.png" Addressable="true"/>
    <Asset Type="img/traceability-hub-icon.png" d:Source="File" Path="img/traceability-hub-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
