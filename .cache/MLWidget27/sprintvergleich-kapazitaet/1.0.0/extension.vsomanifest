{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "Sprintvergleich",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "MLWidget27.sprintvergleich-kapazitaet.Sprintvergleich.Configuration"
            ],
            "properties": {
                "name": "Sprintvergleich: Punkte und Kapazität",
                "description": "Abgeschlossene Punkte, Netto-Teamstunden und Punkte je 100 Stunden für dieselben Sprints.",
                "catalogIconUrl": "img/logo.png",
                "previewImageUrl": "img/vorschau.png",
                "uri": "widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 4,
                        "columnSpan": 6
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 5,
                        "columnSpan": 8
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "isNameConfigurable": true
            }
        },
        {
            "id": "Sprintvergleich.Configuration",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Sprintvergleich konfigurieren",
                "description": "Team, Sprintanzahl und Schätzfeld festlegen.",
                "uri": "configuration.html"
            }
        }
    ],
    "contributionTypes": []
}