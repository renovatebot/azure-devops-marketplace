<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="semantic-programminglanguage" Publisher="semanticprogramminglanguage" Version="1.2.0"/>
    <DisplayName>Semantic Programming Language</DisplayName>
    <Description xml:space="preserve">Hybrid syntax highlighting and source preview for Semantic Programming Language .se and .sp files in Azure DevOps Repos.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Repos</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://www.semantic-programming-language.com/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/SemanticProgrammingLanguage"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/SemanticProgrammingLanguage"/>
    </Properties>
    <Icon>Resources/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/CodeEditorContribution/CodeEditorContribution.html" d:Source="File" Path="dist/CodeEditorContribution/CodeEditorContribution.html" Addressable="true"/>
    <Asset Type="dist/CodeEditorContribution/CodeEditorContribution.js" d:Source="File" Path="dist/CodeEditorContribution/CodeEditorContribution.js" Addressable="true"/>
    <Asset Type="dist/CodeEditorContribution/CodeEditorContribution.js.LICENSE.txt" d:Source="File" Path="dist/CodeEditorContribution/CodeEditorContribution.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="dist/SemanticRenderer/index.html" d:Source="File" Path="dist/SemanticRenderer/index.html" Addressable="true"/>
    <Asset Type="dist/SemanticRenderer/index.js" d:Source="File" Path="dist/SemanticRenderer/index.js" Addressable="true"/>
    <Asset Type="dist/SemanticRenderer/index.js.LICENSE.txt" d:Source="File" Path="dist/SemanticRenderer/index.js.LICENSE.txt" Addressable="true"/>
    <Asset Type="grammar/semantic.tmLanguage.json" d:Source="File" Path="grammar/semantic.tmLanguage.json" Addressable="true"/>
    <Asset Type="Resources/icon.png" d:Source="File" Path="Resources/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="Resources/icon.png" Addressable="true"/>
    <Asset Type="overview.md" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>