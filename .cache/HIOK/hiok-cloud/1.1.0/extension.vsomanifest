{
    "manifestVersion": 1,
    "repository": {
        "type": "git",
        "uri": "https://github.com/HIOK-Official/hiok-azure-devops"
    },
    "contributions": [
        {
            "id": "hiok-service-endpoint",
            "description": "HIOK Cloud service principal",
            "type": "ms.vss-endpoint.service-endpoint-type",
            "targets": [
                "ms.vss-endpoint.endpoint-types"
            ],
            "properties": {
                "name": "hiok",
                "displayName": "HIOK Cloud",
                "icon": "images/icon.png",
                "url": {
                    "displayName": "API endpoint",
                    "value": "https://hiokcloud.com",
                    "helpText": "Leave as is unless you run a private HIOK deployment."
                },
                "authenticationSchemes": [
                    {
                        "type": "ms.vss-endpoint.endpoint-auth-scheme-basic",
                        "inputDescriptors": [
                            {
                                "id": "username",
                                "name": "Client ID",
                                "description": "Service principal client ID (console → Identity).",
                                "inputMode": "textbox",
                                "isConfidential": false,
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "guid"
                                }
                            },
                            {
                                "id": "password",
                                "name": "Client secret",
                                "description": "The secret shown when the service principal was created.",
                                "inputMode": "passwordbox",
                                "isConfidential": true,
                                "validation": {
                                    "isRequired": true,
                                    "dataType": "string"
                                }
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "hiok-cli-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokCli"
            }
        },
        {
            "id": "hiok-api-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokApi"
            }
        },
        {
            "id": "hiok-registry-push-task",
            "description": "HIOK Cloud: Build & push image",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokRegistryPush"
            }
        },
        {
            "id": "hiok-container-app-deploy-task",
            "description": "HIOK Cloud: Deploy container app",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokContainerAppDeploy"
            }
        },
        {
            "id": "hiok-container-deploy-task",
            "description": "HIOK Cloud: Deploy container",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokContainerDeploy"
            }
        },
        {
            "id": "hiok-job-run-task",
            "description": "HIOK Cloud: Run container job",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokJobRun"
            }
        },
        {
            "id": "hiok-vm-run-task",
            "description": "HIOK Cloud: Run script on VM",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokVmRun"
            }
        },
        {
            "id": "hiok-vm-power-task",
            "description": "HIOK Cloud: Start / stop / restart VM",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokVmPower"
            }
        },
        {
            "id": "hiok-storage-upload-task",
            "description": "HIOK Cloud: Upload to storage",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokStorageUpload"
            }
        },
        {
            "id": "hiok-storage-download-task",
            "description": "HIOK Cloud: Download from storage",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokStorageDownload"
            }
        },
        {
            "id": "hiok-keyvault-secrets-task",
            "description": "HIOK Cloud: Key Vault secrets",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokKeyVaultSecrets"
            }
        },
        {
            "id": "hiok-kubernetes-task",
            "description": "HIOK Cloud: Kubernetes",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/HiokKubernetes"
            }
        }
    ],
    "scopes": [],
    "contributionTypes": []
}