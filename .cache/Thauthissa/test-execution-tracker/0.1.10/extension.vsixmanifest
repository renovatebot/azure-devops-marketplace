<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="test-execution-tracker" Version="0.1.10" Publisher="Thauthissa"/>
    <DisplayName>Test Execution Tracker</DisplayName>
    <Description xml:space="preserve">Configurable Azure DevOps widget for tracking test execution, with Test Plan and Test Suite selectors, editable reporting dates, daily target, outcome signals and completion forecast.</Description>
    <GalleryFlags/>
    <Categories>Azure Boards</Categories>
    <Icon>img/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="widget.html" d:Source="File" Path="widget.html" Addressable="true"/>
    <Asset Type="configuration.html" d:Source="File" Path="configuration.html" Addressable="true"/>
    <Asset Type="scripts/build.js" d:Source="File" Path="scripts/build.js" Addressable="true"/>
    <Asset Type="scripts/clean.js" d:Source="File" Path="scripts/clean.js" Addressable="true"/>
    <Asset Type="scripts/configuration.js" d:Source="File" Path="scripts/configuration.js" Addressable="true"/>
    <Asset Type="scripts/widget.js" d:Source="File" Path="scripts/widget.js" Addressable="true"/>
    <Asset Type="styles/configuration.css" d:Source="File" Path="styles/configuration.css" Addressable="true"/>
    <Asset Type="styles/widget.css" d:Source="File" Path="styles/widget.css" Addressable="true"/>
    <Asset Type="img/CatalogIcon.png" d:Source="File" Path="img/CatalogIcon.png" Addressable="true"/>
    <Asset Type="img/logo.png" d:Source="File" Path="img/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="img/logo.png" Addressable="true"/>
    <Asset Type="img/preview.png" d:Source="File" Path="img/preview.png" Addressable="true"/>
    <Asset Type="sdk/scripts/VSS.SDK.min.js" d:Source="File" Path="sdk/scripts/VSS.SDK.min.js" Addressable="true"/>
    <Asset Type="README.md" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Test-Execution-Tracker-Implementation.md" d:Source="File" Path="Test-Execution-Tracker-Implementation.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>