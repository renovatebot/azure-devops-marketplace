{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.project"
    ],
    "contributions": [
        {
            "id": "sprint-capacity-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "Thauthissa.advanced-sprint-capacity-1.sprint-capacity-config"
            ],
            "properties": {
                "name": "Advanced Sprint Capacity",
                "description": "Advanced Sprint Capacity bars grouped by Activity or Assigned To.",
                "catalogIconUrl": "dist/icon.png",
                "previewImageUrl": "dist/preview.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ],
                "configurationContributionId": "sprint-capacity-config",
                "isNameConfigurable": true
            }
        },
        {
            "id": "sprint-capacity-config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Advanced Sprint Capacity Configuration",
                "uri": "dist/config.html"
            }
        }
    ],
    "contributionTypes": []
}