{
    "manifestVersion": 1,
    "scopes": [
        "vso.work"
    ],
    "contributions": [
        {
            "id": "work-item-group",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Shows whether the work item is a BoardwalkDesk customer ticket, and opens it in BoardwalkDesk or shares it with a customer.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "BoardwalkDesk",
                "uri": "out/group.html",
                "height": 96
            }
        },
        {
            "id": "work-item-open-action",
            "type": "ms.vss-web.action",
            "description": "Opens the work item in BoardwalkDesk.",
            "targets": [
                "ms.vss-work-web.work-item-context-menu"
            ],
            "properties": {
                "text": "Open in BoardwalkDesk",
                "title": "Open this work item in BoardwalkDesk",
                "icon": "images/menu-icon.png",
                "uri": "out/action.html",
                "registeredObjectId": "boardwalkdesk-open-action"
            }
        }
    ],
    "contributionTypes": []
}