<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="boardwalkdesk" Version="1.0.0" Publisher="SolutionsGroupUnlimited"/>
    <DisplayName>BoardwalkDesk: customer tickets for Azure Boards</DisplayName>
    <Description xml:space="preserve">See on the work item form whether a work item is a BoardwalkDesk customer ticket, open it in BoardwalkDesk, or share the work item with a customer.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>customer support,help desk,service desk,customer portal,tickets,work items,boardwalkdesk</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#1b2a41"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://boardwalkdesk.com/?utm_source=vs-marketplace&amp;utm_medium=listing&amp;utm_campaign=boardwalkdesk"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://boardwalkdesk.com/help/devops?utm_source=vs-marketplace&amp;utm_medium=listing&amp;utm_campaign=boardwalkdesk"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://boardwalkdesk.com/d/sgu?utm_source=vs-marketplace&amp;utm_medium=listing&amp;utm_campaign=boardwalkdesk"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://boardwalkdesk.com/privacy?utm_source=vs-marketplace&amp;utm_medium=listing&amp;utm_campaign=boardwalkdesk"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://boardwalkdesk.com/terms?utm_source=vs-marketplace&amp;utm_medium=listing&amp;utm_campaign=boardwalkdesk"/>
    </Properties>
    <Icon>images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="out/action.html" d:Source="File" Path="out/action.html" Addressable="true"/>
    <Asset Type="out/action.js" d:Source="File" Path="out/action.js" Addressable="true"/>
    <Asset Type="out/group.css" d:Source="File" Path="out/group.css" Addressable="true"/>
    <Asset Type="out/group.html" d:Source="File" Path="out/group.html" Addressable="true"/>
    <Asset Type="out/group.js" d:Source="File" Path="out/group.js" Addressable="true"/>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="images/menu-icon.png" d:Source="File" Path="images/menu-icon.png" Addressable="true"/>
    <Asset Type="images/screenshot-group.png" d:Source="File" Path="images/screenshot-group.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="images/screenshot-group.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>