<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="mailpier-inbox" Version="2.2.7" Publisher="SolutionsGroupUnlimited"/>
    <DisplayName>MailPier Inbox</DisplayName>
    <Description xml:space="preserve">Wait for an email in your pipeline and use its one-time code or link: test sign-up, password reset and notification mails with MailPier Inbox.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Pipelines</Categories>
    <Tags>email,testing,otp,inbox,qa,mailpier</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://mailpier.io"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://mailpier.io/docs#ado"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://support.solutionsgroupunlimited.com"/>
    </Properties>
    <Icon>images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="images/icon.png" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>