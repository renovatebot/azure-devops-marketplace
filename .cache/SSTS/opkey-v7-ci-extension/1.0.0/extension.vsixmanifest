<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="opkey-v7-ci-extension" Version="1.0.0" Publisher="SSTS"/>
    <DisplayName>OpKey V7 CI</DisplayName>
    <Description xml:space="preserve">Execute an OpKey V7 Test Suite or Test Case from an Azure DevOps Pipeline</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://www.opkey.com/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://www.opkey.com/Help/docs/opkey-help/external-tool-integration-with-opkey-web/working-with-vsts-build/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://www.opkey.com/Help/docs/opkey-help/external-tool-integration-with-opkey-web/working-with-vsts-build/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="http://support.opkey.com/support/home"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="http://support.opkey.com/support/home"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#222222"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
    <Categories>Azure Pipelines</Categories>
    <Tags>OpKey,OpKey V7,OpKey Azure DevOps Integration</Tags>
    <Icon>images/OpkeyCI.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="images/Opkeylogo.png" d:Source="File" Path="images/Opkeylogo.png" Addressable="true"/>
    <Asset Type="images/logo.png" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="images/OpkeyRun.png" d:Source="File" Path="images/OpkeyRun.png" Addressable="true"/>
    <Asset Type="images/OpkeyCI.png" d:Source="File" Path="images/OpkeyCI.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/OpkeyCI.png" Addressable="true"/>
    <Asset Type="images/OpkeyExecutionStats.png" d:Source="File" Path="images/OpkeyExecutionStats.png" Addressable="true"/>
    <Asset Type="images/OpkeyTest.png" d:Source="File" Path="images/OpkeyTest.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>