{
    "manifestVersion": 1,
    "contributions": [
        {
            "id": "sqr-language",
            "type": "ms.vss-features.code-editor-language",
            "targets": [
                "ms.vss-features.editor"
            ],
            "properties": {
                "extensions": [
                    ".sqr",
                    ".sqc",
                    ".SQR",
                    ".SQC"
                ],
                "mimetypes": [
                    "text/x-sqr"
                ],
                "language": {
                    "displayName": "SQR",
                    "defaultToken": "",
                    "tokenPostfix": ".sqr",
                    "ignoreCase": true,
                    "brackets": [
                        {
                            "open": "{",
                            "close": "}",
                            "token": "delimiter.curly"
                        },
                        {
                            "open": "[",
                            "close": "]",
                            "token": "delimiter.square"
                        },
                        {
                            "open": "(",
                            "close": ")",
                            "token": "delimiter.parenthesis"
                        }
                    ],
                    "keywords": [
                        "add",
                        "alter-color-map",
                        "alter-locale",
                        "alter-printer",
                        "alter-report",
                        "and",
                        "array-add",
                        "array-divide",
                        "array-multiply",
                        "array-subtract",
                        "ask",
                        "begin-declare",
                        "begin-document",
                        "begin-execute",
                        "begin-footing",
                        "begin-heading",
                        "begin-procedure",
                        "begin-program",
                        "begin-select",
                        "begin-setup",
                        "begin-sql",
                        "break",
                        "call",
                        "clear-array",
                        "close",
                        "columns",
                        "commit",
                        "concat",
                        "connect",
                        "create-array",
                        "create-color-palette",
                        "date-time",
                        "declare-chart",
                        "declare-color-map",
                        "declare-connection",
                        "declare-image",
                        "declare-layout",
                        "declare-printer",
                        "declare-procedure",
                        "declare-report",
                        "declare-toc",
                        "declare-variable",
                        "display",
                        "divide",
                        "do",
                        "edit",
                        "else",
                        "encode",
                        "end-declare",
                        "end-document",
                        "end-evaluate",
                        "end-execute",
                        "end-footing",
                        "end-heading",
                        "end-if",
                        "end-procedure",
                        "end-program",
                        "end-select",
                        "end-setup",
                        "end-sql",
                        "end-while",
                        "evaluate",
                        "execute",
                        "exit-select",
                        "extract",
                        "find",
                        "from",
                        "get",
                        "get-color",
                        "goto",
                        "graphic",
                        "if",
                        "input",
                        "into",
                        "last-page",
                        "let",
                        "local",
                        "lookup",
                        "move",
                        "multiply",
                        "new-page",
                        "new-report",
                        "new-window",
                        "next-column",
                        "not",
                        "on-break",
                        "on-error",
                        "open",
                        "or",
                        "page-number",
                        "position",
                        "print",
                        "put",
                        "read",
                        "rollback",
                        "round",
                        "show",
                        "stop",
                        "string",
                        "subtract",
                        "to",
                        "unstring",
                        "use",
                        "use-column",
                        "use-printer",
                        "use-procedure",
                        "use-report",
                        "when",
                        "when-other",
                        "while",
                        "write",
                        "xor"
                    ],
                    "sqlKeywords": [
                        "select",
                        "distinct",
                        "all",
                        "as",
                        "asc",
                        "desc",
                        "union",
                        "intersect",
                        "minus",
                        "join",
                        "inner",
                        "outer",
                        "left",
                        "right",
                        "full",
                        "cross",
                        "on",
                        "where",
                        "group",
                        "by",
                        "having",
                        "order",
                        "insert",
                        "update",
                        "delete",
                        "set",
                        "values",
                        "create",
                        "table",
                        "drop",
                        "alter",
                        "truncate",
                        "exists",
                        "in",
                        "is",
                        "null",
                        "between",
                        "like",
                        "case",
                        "then",
                        "end",
                        "else",
                        "with",
                        "over",
                        "partition",
                        "fetch",
                        "rows",
                        "only",
                        "offset",
                        "top"
                    ],
                    "builtinFunctions": [
                        "abs",
                        "acos",
                        "asin",
                        "atan",
                        "ceil",
                        "cos",
                        "cosh",
                        "dateadd",
                        "datediff",
                        "datenow",
                        "datetostr",
                        "decode",
                        "edit",
                        "exp",
                        "floor",
                        "getenv",
                        "instr",
                        "isblank",
                        "isnull",
                        "length",
                        "ln",
                        "log",
                        "lower",
                        "lpad",
                        "ltrim",
                        "mod",
                        "nvl",
                        "power",
                        "replace",
                        "rpad",
                        "rtrim",
                        "sign",
                        "sin",
                        "sinh",
                        "sqrt",
                        "strtodate",
                        "substr",
                        "tan",
                        "tanh",
                        "to_char",
                        "to_date",
                        "to_number",
                        "translate",
                        "trunc",
                        "upper",
                        "sum",
                        "count",
                        "avg",
                        "min",
                        "max"
                    ],
                    "tokenizer": {
                        "root": [
                            [
                                "\\s+",
                                "white"
                            ],
                            [
                                "!=",
                                "operator"
                            ],
                            [
                                "!.*$",
                                "comment"
                            ],
                            [
                                "#(?:include|define|if|ifdef|ifndef|else|end-if|endif|debug)\\b",
                                "keyword.directive"
                            ],
                            [
                                "'$",
                                "string"
                            ],
                            [
                                "'",
                                {
                                    "token": "string",
                                    "next": "@singleString"
                                }
                            ],
                            [
                                "\"$",
                                "string"
                            ],
                            [
                                "\"",
                                {
                                    "token": "string",
                                    "next": "@doubleString"
                                }
                            ],
                            [
                                "\\{[A-Za-z_][\\w-]*\\}",
                                "constant"
                            ],
                            [
                                "[$#&%@][A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)*",
                                "variable"
                            ],
                            [
                                "(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?",
                                "number"
                            ],
                            [
                                "[A-Za-z_][\\w-]*",
                                {
                                    "cases": {
                                        "@keywords": "keyword",
                                        "@sqlKeywords": "keyword",
                                        "@builtinFunctions": "predefined",
                                        "@default": "identifier"
                                    }
                                }
                            ],
                            [
                                "[{}()[\\]]",
                                "@brackets"
                            ],
                            [
                                "[=<>:+*/|^%~-]+",
                                "operator"
                            ],
                            [
                                "[.,;]",
                                "delimiter"
                            ]
                        ],
                        "singleString": [
                            [
                                "''",
                                {
                                    "cases": {
                                        "@eos": {
                                            "token": "string.escape",
                                            "next": "@pop"
                                        },
                                        "@default": "string.escape"
                                    }
                                }
                            ],
                            [
                                "'",
                                {
                                    "token": "string",
                                    "next": "@pop"
                                }
                            ],
                            [
                                "[^']+",
                                {
                                    "cases": {
                                        "@eos": {
                                            "token": "string",
                                            "next": "@pop"
                                        },
                                        "@default": "string"
                                    }
                                }
                            ]
                        ],
                        "doubleString": [
                            [
                                "\"\"",
                                {
                                    "cases": {
                                        "@eos": {
                                            "token": "string.escape",
                                            "next": "@pop"
                                        },
                                        "@default": "string.escape"
                                    }
                                }
                            ],
                            [
                                "\"",
                                {
                                    "token": "string",
                                    "next": "@pop"
                                }
                            ],
                            [
                                "[^\\\"]+",
                                {
                                    "cases": {
                                        "@eos": {
                                            "token": "string",
                                            "next": "@pop"
                                        },
                                        "@default": "string"
                                    }
                                }
                            ]
                        ]
                    }
                }
            }
        },
        {
            "id": "peoplecode-language",
            "type": "ms.vss-features.code-editor-language",
            "targets": [
                "ms.vss-features.editor"
            ],
            "properties": {
                "extensions": [
                    ".ppl",
                    ".pcode",
                    ".peoplecode",
                    ".PPL",
                    ".PCODE",
                    ".PEOPLECODE"
                ],
                "mimetypes": [
                    "text/x-peoplecode"
                ],
                "language": {
                    "displayName": "PeopleCode",
                    "defaultToken": "",
                    "tokenPostfix": ".peoplecode",
                    "ignoreCase": true,
                    "brackets": [
                        {
                            "open": "{",
                            "close": "}",
                            "token": "delimiter.curly"
                        },
                        {
                            "open": "[",
                            "close": "]",
                            "token": "delimiter.square"
                        },
                        {
                            "open": "(",
                            "close": ")",
                            "token": "delimiter.parenthesis"
                        }
                    ],
                    "keywords": [
                        "abstract",
                        "and",
                        "as",
                        "break",
                        "catch",
                        "class",
                        "component",
                        "constant",
                        "constructor",
                        "continue",
                        "create",
                        "declare",
                        "else",
                        "end-class",
                        "end-evaluate",
                        "end-for",
                        "end-function",
                        "end-get",
                        "end-if",
                        "end-method",
                        "end-set",
                        "end-try",
                        "end-while",
                        "error",
                        "evaluate",
                        "exit",
                        "extends",
                        "for",
                        "function",
                        "get",
                        "global",
                        "if",
                        "implements",
                        "import",
                        "in",
                        "instance",
                        "interface",
                        "local",
                        "method",
                        "not",
                        "of",
                        "or",
                        "out",
                        "private",
                        "property",
                        "protected",
                        "public",
                        "readonly",
                        "repeat",
                        "return",
                        "returns",
                        "set",
                        "step",
                        "super",
                        "then",
                        "throw",
                        "to",
                        "try",
                        "until",
                        "value",
                        "warning",
                        "when",
                        "when-other",
                        "while"
                    ],
                    "typeKeywords": [
                        "any",
                        "array",
                        "boolean",
                        "date",
                        "datetime",
                        "exception",
                        "field",
                        "file",
                        "float",
                        "integer",
                        "javaobject",
                        "message",
                        "number",
                        "object",
                        "record",
                        "row",
                        "rowset",
                        "sql",
                        "string",
                        "time",
                        "xmldoc",
                        "xmlnode"
                    ],
                    "constants": [
                        "true",
                        "false",
                        "null"
                    ],
                    "builtinFunctions": [
                        "abs",
                        "all",
                        "any",
                        "char",
                        "clearkeylist",
                        "copyfields",
                        "createarray",
                        "createarrayrept",
                        "createdatetime",
                        "createexception",
                        "createjavaobject",
                        "createmessage",
                        "createrecord",
                        "createrowset",
                        "createsql",
                        "date",
                        "date3",
                        "datetimevalue",
                        "datevalue",
                        "discardrow",
                        "dosavenow",
                        "dosave",
                        "dowinmessage",
                        "fetchvalue",
                        "find",
                        "getfile",
                        "gethtmltext",
                        "getlevel0",
                        "getrecord",
                        "getrow",
                        "getrowset",
                        "getsession",
                        "getsql",
                        "getxmlstring",
                        "gray",
                        "hex",
                        "insertrow",
                        "int",
                        "isdate",
                        "isnumber",
                        "len",
                        "lower",
                        "ltrim",
                        "messagebox",
                        "msggettext",
                        "msggettextexpand",
                        "none",
                        "number",
                        "recordchanged",
                        "setcursor",
                        "setdefault",
                        "settitle",
                        "sqlexec",
                        "sqlfetch",
                        "sqlclose",
                        "sqlerror",
                        "string",
                        "rtrim",
                        "split",
                        "substitute",
                        "substring",
                        "transfer",
                        "upper",
                        "value",
                        "winmessage"
                    ],
                    "tokenizer": {
                        "root": [
                            [
                                "\\s+",
                                "white"
                            ],
                            [
                                "\\/\\*",
                                {
                                    "token": "comment",
                                    "next": "@blockComment"
                                }
                            ],
                            [
                                "<\\*",
                                {
                                    "token": "comment",
                                    "next": "@angleComment"
                                }
                            ],
                            [
                                "\\/\\+",
                                {
                                    "token": "comment.doc",
                                    "next": "@signatureComment"
                                }
                            ],
                            [
                                "\\brem\\b",
                                {
                                    "token": "comment",
                                    "next": "@remComment"
                                }
                            ],
                            [
                                "'$",
                                "string"
                            ],
                            [
                                "'",
                                {
                                    "token": "string",
                                    "next": "@singleString"
                                }
                            ],
                            [
                                "\"$",
                                "string"
                            ],
                            [
                                "\"",
                                {
                                    "token": "string",
                                    "next": "@doubleString"
                                }
                            ],
                            [
                                "&[A-Za-z_][\\w]*",
                                "variable"
                            ],
                            [
                                "%[A-Za-z_][\\w]*",
                                "predefined"
                            ],
                            [
                                "(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?",
                                "number"
                            ],
                            [
                                "[A-Za-z_][\\w]*(?:-[A-Za-z_][\\w]*)*",
                                {
                                    "cases": {
                                        "@keywords": "keyword",
                                        "@typeKeywords": "type",
                                        "@constants": "constant",
                                        "@builtinFunctions": "predefined",
                                        "@default": "identifier"
                                    }
                                }
                            ],
                            [
                                "[{}()[\\]]",
                                "@brackets"
                            ],
                            [
                                "[=<>:+*/|&~-]+",
                                "operator"
                            ],
                            [
                                "[.,;]",
                                "delimiter"
                            ]
                        ],
                        "blockComment": [
                            [
                                "\\*\\/",
                                {
                                    "token": "comment",
                                    "next": "@pop"
                                }
                            ],
                            [
                                "[^*]+",
                                "comment"
                            ],
                            [
                                ".",
                                "comment"
                            ]
                        ],
                        "angleComment": [
                            [
                                "\\*>",
                                {
                                    "token": "comment",
                                    "next": "@pop"
                                }
                            ],
                            [
                                "[^*]+",
                                "comment"
                            ],
                            [
                                ".",
                                "comment"
                            ]
                        ],
                        "signatureComment": [
                            [
                                "\\+\\/",
                                {
                                    "token": "comment.doc",
                                    "next": "@pop"
                                }
                            ],
                            [
                                "[^+]+",
                                "comment.doc"
                            ],
                            [
                                ".",
                                "comment.doc"
                            ]
                        ],
                        "remComment": [
                            [
                                ";",
                                {
                                    "token": "comment",
                                    "next": "@pop"
                                }
                            ],
                            [
                                "[^;]+",
                                "comment"
                            ]
                        ],
                        "singleString": [
                            [
                                "''",
                                {
                                    "cases": {
                                        "@eos": {
                                            "token": "string.escape",
                                            "next": "@pop"
                                        },
                                        "@default": "string.escape"
                                    }
                                }
                            ],
                            [
                                "'",
                                {
                                    "token": "string",
                                    "next": "@pop"
                                }
                            ],
                            [
                                "[^']+",
                                {
                                    "cases": {
                                        "@eos": {
                                            "token": "string",
                                            "next": "@pop"
                                        },
                                        "@default": "string"
                                    }
                                }
                            ]
                        ],
                        "doubleString": [
                            [
                                "\"\"",
                                {
                                    "cases": {
                                        "@eos": {
                                            "token": "string.escape",
                                            "next": "@pop"
                                        },
                                        "@default": "string.escape"
                                    }
                                }
                            ],
                            [
                                "\"",
                                {
                                    "token": "string",
                                    "next": "@pop"
                                }
                            ],
                            [
                                "[^\\\"]+",
                                {
                                    "cases": {
                                        "@eos": {
                                            "token": "string",
                                            "next": "@pop"
                                        },
                                        "@default": "string"
                                    }
                                }
                            ]
                        ]
                    }
                }
            }
        }
    ],
    "scopes": [],
    "contributionTypes": []
}