{
    "manifestVersion": 1,
    "scopes": [
        "vso.work_write",
        "vso.project"
    ],
    "demands": [
        "api-version/3.0"
    ],
    "contributions": [
        {
            "id": "pp-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Planning Poker",
                "order": 90,
                "uri": "dist/hub.html",
                "iconName": "Group"
            }
        },
        {
            "id": "pp-backlog-menu",
            "type": "ms.vss-web.action",
            "targets": [
                "ms.vss-work-web.backlog-item-menu"
            ],
            "properties": {
                "text": "Estimate with Planning Poker",
                "title": "Start a Planning Poker session for the selected items",
                "icon": "images/icon.png",
                "group": "actions",
                "uri": "dist/menu.html",
                "registeredObjectId": "pp-backlog-menu-action"
            }
        },
        {
            "id": "pp-work-item-tab",
            "type": "ms.vss-work-web.work-item-form-page",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "Estimation",
                "uri": "dist/workItemForm.html"
            }
        },
        {
            "id": "pp-sprint-tab",
            "type": "ms.vss-web.tab",
            "targets": [
                "ms.vss-work-web.iteration-backlog-tabs"
            ],
            "properties": {
                "name": "Planning Poker",
                "uri": "dist/sprintTab.html"
            }
        },
        {
            "id": "pp-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Estimation Summary",
                "description": "Recent Planning Poker sessions and unestimated backlog items.",
                "catalogIconUrl": "images/icon.png",
                "uri": "dist/widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        }
    ],
    "contributionTypes": []
}