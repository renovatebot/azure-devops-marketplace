    <DisplayName>Planning Poker</DisplayName>
    <Description xml:space="preserve">Run Planning Poker estimation sessions natively inside Azure DevOps. Hidden voting, simultaneous reveal, automatic write-back to work items.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>planning poker,estimation,agile,scrum,story points,backlog refinement</Tags>
    <Icon>images/icon.png</Icon>
  </Metadata>
