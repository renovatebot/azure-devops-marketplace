                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/SetupLocallyV1"
            }
        },
        {
            "id": "install-locally-plugins-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/InstallLocallyPluginsV1"
            }
        },
        {
            "id": "teardown-locally-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/TeardownLocallyV1"
            }
        },
        {
            "id": "save-locally-snapshot-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "tasks/SaveLocallySnapshotV1"
            }
        },
        {
            "id": "load-locally-snapshot-task",
