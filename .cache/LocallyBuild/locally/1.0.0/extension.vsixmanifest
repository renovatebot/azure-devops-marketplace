<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="locally" Version="1.0.0" Publisher="LocallyBuild"/>
    <DisplayName>Locally</DisplayName>
    <GalleryFlags>Public</GalleryFlags>
    <Description xml:space="preserve">Run Locally in Azure Pipelines: install the CLI and plugins, start `locally ci`, save and load snapshots, and tear it down at the end of the job.</Description>
    <Categories>Azure Pipelines</Categories>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://locally.build"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://github.com/locallybuild/azure-devops-extension"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Issues" Value="https://github.com/locallybuild/azure-devops-extension/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/locallybuild/azure-devops-extension/blob/main/LICENSE"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/locallybuild/azure-devops-extension"/>
    </Properties>
    <Icon>images/icon.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="README.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>