{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.project",
        "vso.profile"
    ],
    "contributions": [
        {
            "id": "aivana-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "AIVANA",
                "uri": "dist/index.html"
            }
        },
        {
            "id": "aivana-sprint-compass",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".aivana-sprint-compass.config"
            ],
            "properties": {
                "name": "AIVANA Sprint Compass / Sprint-Kompass",
                "description": "Sprint progress and marked blockers / Sprintfortschritt und markierte Blockaden.",
                "uri": "dist/widgets.html?widget=sprint",
                "catalogIconUrl": "dist/widget-icon.png",
                "previewImageUrl": "dist/widget-sprint.png",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "aivana-blocker-radar",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".aivana-blocker-radar.config"
            ],
            "properties": {
                "name": "AIVANA Blocker Radar / Blocker-Radar",
                "description": "Marked blockers and successors / Markierte Blockaden und Nachfolger.",
                "uri": "dist/widgets.html?widget=blockers",
                "catalogIconUrl": "dist/widget-icon.png",
                "previewImageUrl": "dist/widget-blockers.png",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 3
                    },
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "aivana-decision-card",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".aivana-decision-card.config"
            ],
            "properties": {
                "name": "AIVANA Decision Card",
                "description": "Evidence-linked decision draft / Quellenbelegte Entscheidungsvorlage.",
                "uri": "dist/widgets.html?widget=decision",
                "catalogIconUrl": "dist/widget-icon.png",
                "previewImageUrl": "dist/widget-decision.png",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 8
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "aivana-domino-map",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".aivana-domino-map.config"
            ],
            "properties": {
                "name": "AIVANA Domino Map / Domino-Map",
                "description": "Business dependencies with sources / Fachliche Abhängigkeiten mit Quellen.",
                "uri": "dist/widgets.html?widget=domino",
                "catalogIconUrl": "dist/widget-icon.png",
                "previewImageUrl": "dist/widget-domino.png",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 3,
                        "columnSpan": 6
                    },
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "aivana-sprint-lab",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".aivana-sprint-lab.config"
            ],
            "properties": {
                "name": "AIVANA Sprint Lab / Sprint-Labor",
                "description": "Local scope scenarios / Lokale Umfangsszenarien.",
                "uri": "dist/widgets.html?widget=lab",
                "catalogIconUrl": "dist/widget-icon.png",
                "previewImageUrl": "dist/widget-lab.png",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "aivana-focus-window",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog",
                ".aivana-focus-window.config"
            ],
            "properties": {
                "name": "AIVANA Focus Window / Fokus-Fenster",
                "description": "Focused work and source evidence / Fokussierte Arbeit und Quellenbelege.",
                "uri": "dist/widgets.html?widget=focus",
                "catalogIconUrl": "dist/widget-icon.png",
                "previewImageUrl": "dist/widget-focus.png",
                "isNameConfigurable": true,
                "supportedSizes": [
                    {
                        "rowSpan": 3,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 4,
                        "columnSpan": 4
                    },
                    {
                        "rowSpan": 1,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        },
        {
            "id": "aivana-domino-map.config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Domino-Map konfigurieren",
                "uri": "dist/widgets.html?mode=config"
            }
        },
        {
            "id": "aivana-sprint-lab.config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Sprint-Labor konfigurieren",
                "uri": "dist/widgets.html?mode=config"
            }
        },
        {
            "id": "aivana-focus-window.config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Fokus-Fenster konfigurieren",
                "uri": "dist/widgets.html?mode=config"
            }
        },
        {
            "id": "aivana-sprint-compass.config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Sprint-Kompass konfigurieren",
                "uri": "dist/widgets.html?mode=config"
            }
        },
        {
            "id": "aivana-blocker-radar.config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Blocker-Radar konfigurieren",
                "uri": "dist/widgets.html?mode=config"
            }
        },
        {
            "id": "aivana-decision-card.config",
            "type": "ms.vss-dashboards-web.widget-configuration",
            "targets": [
                "ms.vss-dashboards-web.widget-configuration"
            ],
            "properties": {
                "name": "Decision Card konfigurieren",
                "uri": "dist/widgets.html?mode=config"
            }
        }
    ],
    "licensing": {
        "overrides": [
            {
                "id": "aivana-hub",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-sprint-compass",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-blocker-radar",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-decision-card",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-domino-map",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-sprint-lab",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-focus-window",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-domino-map.config",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-sprint-lab.config",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-focus-window.config",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-sprint-compass.config",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-blocker-radar.config",
                "behavior": "AlwaysInclude"
            },
            {
                "id": "aivana-decision-card.config",
                "behavior": "AlwaysInclude"
            }
        ]
    },
    "contributionTypes": []
}