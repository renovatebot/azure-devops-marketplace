  <Metadata>
    <Identity Language="en-US" Id="TimeTracker01" Publisher="TimeTracker" Version="1.0.99"/>
    <DisplayName>Time Tracker</DisplayName>
    <Description xml:space="preserve">One-click timers on Azure Boards work items, time logs, approvals, reminders and reports. 7-day free trial, then $1 per user/month (taxes excluded).</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Icon>images/icon.png</Icon>
    <Tags>time,time tracker,time tracking,timer,timesheet,time logging,hours,work item,azure boards,reporting,approvals,team</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Home" Value="https://www.qservicesit.com/azure-devops-time-tracker"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://www.qservicesit.com/azure-devops-time-tracker"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://www.qservicesit.com/azure-devops-time-tracker"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="mailto:support@qservicesit.com"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://www.qservicesit.com/privacy-policy"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://www.qservicesit.com/terms-and-conditions"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#312e81"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
    </Properties>
  </Metadata>
  <Dependencies/>
