{
    "manifestVersion": 1,
    "scopes": [
        "vso.work",
        "vso.code",
        "vso.build"
    ],
    "contributions": [
        {
            "id": "work-item-pr-health-summary-v2",
            "type": "ms.vss-work-web.work-item-form-group",
            "description": "Shows a compact pull request readiness summary on the work item details page.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "PR Health Summary",
                "uri": "dist/work-item-summary/index-0.1.41.html",
                "height": 236
            }
        },
        {
            "id": "work-item-pr-health-v2",
            "type": "ms.vss-work-web.work-item-form-page",
            "description": "Shows linked pull request health for the current work item.",
            "targets": [
                "ms.vss-work-web.work-item-form"
            ],
            "properties": {
                "name": "PR Health",
                "uri": "dist/work-item/index-0.1.41.html"
            }
        },
        {
            "id": "repos-pr-health-hub-v2",
            "type": "ms.vss-web.hub",
            "description": "Shows active pull request health in Azure Repos.",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "PR Health",
                "order": 90,
                "uri": "dist/pr-hub/index-0.1.41.html",
                "icon": "images/hub-icon.png"
            }
        },
        {
            "id": "project-settings-pr-health-v2",
            "type": "ms.vss-web.hub",
            "description": "Configures PR Health for the current project.",
            "targets": [
                "ms.vss-web.project-admin-hub-group"
            ],
            "properties": {
                "name": "PR Health",
                "order": 90,
                "uri": "dist/settings/index-0.1.41.html",
                "iconName": "Settings"
            }
        }
    ],
    "contributionTypes": []
}