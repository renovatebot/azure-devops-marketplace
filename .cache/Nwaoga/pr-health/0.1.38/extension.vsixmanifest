  <Metadata>
    <Identity Language="en-US" Id="pr-health" Version="0.1.38" Publisher="nwaoga"/>
    <DisplayName>PR Health</DisplayName>
    <Description xml:space="preserve">See if a user story is ready to complete — live PR status on the work item, without editable board fields.</Description>
