<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="ivory-delivery" Publisher="ivoryitAgentic" Version="1.1.1"/>
    <DisplayName>Ivory Delivery</DisplayName>
    <Description xml:space="preserve">Acompanha projetos de prazo fechado contra a execução real no Azure Boards: sinaliza risco de atraso, registra mudanças de prazo com rastro e reúne squads, riscos e status numa visão de portfólio.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>prazo,portfólio,risco,planejamento,gestão de projetos,azure boards</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Repository" Value="https://dev.azure.com/ivory-projetos/Ivory%20Chapter/_git/extension-agilidade-ivory"/>
    </Properties>
    <Icon>images/ivory-delivery-icon-128.png</Icon>
    <License>docs/produto/licenca.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
