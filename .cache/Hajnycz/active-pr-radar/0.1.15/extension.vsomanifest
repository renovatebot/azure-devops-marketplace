{
    "manifestVersion": 1,
    "scopes": [
        "vso.code",
        "vso.code_status",
        "vso.build",
        "vso.profile"
    ],
    "demands": [
        "api-version/5.0"
    ],
    "contributions": [
        {
            "id": "active-pr-radar-hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "type": "ms.vss-web.hub",
            "description": "View all active pull requests across all repositories in a team.",
            "properties": {
                "name": "Active PR Radar",
                "order": 100,
                "uri": "dist/index.html",
                "icon": {
                    "light": "images/hub-icon-light.png",
                    "dark": "images/hub-icon-dark.png"
                }
            }
        }
    ],
    "contributionTypes": []
}