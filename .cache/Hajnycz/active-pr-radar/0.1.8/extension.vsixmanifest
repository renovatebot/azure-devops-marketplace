<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="active-pr-radar" Version="0.1.8" Publisher="Hajnycz"/>
    <DisplayName>Active PR Radar</DisplayName>
    <Description xml:space="preserve">Active PR Radar scans every repository in your project and surfaces all active pull requests in one sortable, filterable table.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Tags>pullrequest,pullrequests,pull-request,pull-requests,code,code-review</Tags>
    <Categories>Azure Repos</Categories>
    <Icon>images/extension-icon.png</Icon>
    <License>license.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/assets/fonts/AzDevMDL2.woff" d:Source="File" Path="dist/assets/fonts/AzDevMDL2.woff" Addressable="true"/>
    <Asset Type="dist/assets/fonts/fluent-filled-v1.1.293.woff2" d:Source="File" Path="dist/assets/fonts/fluent-filled-v1.1.293.woff2" Addressable="true"/>
    <Asset Type="dist/assets/fonts/fluent-regular-v1.1.293.woff2" d:Source="File" Path="dist/assets/fonts/fluent-regular-v1.1.293.woff2" Addressable="true"/>
    <Asset Type="dist/assets/index-CEWMS_pj.js" d:Source="File" Path="dist/assets/index-CEWMS_pj.js" Addressable="true"/>
    <Asset Type="dist/assets/index-CVYP_y-W.css" d:Source="File" Path="dist/assets/index-CVYP_y-W.css" Addressable="true"/>
    <Asset Type="dist/index.html" d:Source="File" Path="dist/index.html" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="license.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>