<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="savah-pi-planning" Version="1.0.4" Publisher="savah-pi-planning-tool"/>
    <DisplayName>Savah - SAFe PI Planning</DisplayName>
    <Description xml:space="preserve">Run SAFe PI Planning on a live program board with two-way Azure Boards sync: features, dependencies, ROAM risks and PI objectives.</Description>
    <GalleryFlags>Public</GalleryFlags>
    <Categories>Azure Boards</Categories>
    <Tags>SAFe,PI Planning,program board,agile,dependencies,ROAM,Agile governance,Agile portfolio management,ART portfolio visibility,Enterprise agile,Enterprise agile planning,Enterprise OKRs,Epic management,Lean portfolio management,OKR management,OKR tracking,PI planning portfolio,Portfolio governance,Portfolio management,Portfolio OKRs,Portfolio planning,Portfolio roadmap,Roadmap visualization,SAFe portfolio management,Strategic planning,Strategy execution,Strategy execution alignment</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://savah.gitbook.io/savah/integrating-savah-with-azure-devops"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://www.savahapp.com/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://www.savahapp.com/contact"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://www.savahapp.com/privacy"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#ffffff"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="light"/>
    </Properties>
    <Icon>images/logo.png</Icon>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services.Integration"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/logo.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.1" d:Source="File" Path="images/program-board.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.2" d:Source="File" Path="images/confidence-vote.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.3" d:Source="File" Path="images/azure-devops-import-query.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.4" d:Source="File" Path="images/dependencies.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.5" d:Source="File" Path="images/executive-summary.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.6" d:Source="File" Path="images/rte-view.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.7" d:Source="File" Path="images/objectives.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.8" d:Source="File" Path="images/team-board.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Screenshots.9" d:Source="File" Path="images/team-capacity.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
  </Assets>
</PackageManifest>