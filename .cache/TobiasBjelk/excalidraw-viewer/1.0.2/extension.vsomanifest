{
    "manifestVersion": 1,
    "scopes": [
        "vso.code"
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/tobiasbjelk/ado-excalidraw-view"
    },
    "contributions": [
        {
            "id": "excalidraw-viewer",
            "type": "ms.vss-code-web.content-renderer",
            "targets": [
                "ms.vss-code-web.content-renderer-collection"
            ],
            "properties": {
                "name": "Excalidraw Viewer",
                "fileExtensions": [
                    "excalidraw"
                ],
                "mimeTypes": [
                    "text/html"
                ],
                "registeredObjectId": "excalidraw_viewer",
                "defaultBehavior": "showRenderedContent",
                "uri": "index.html"
            }
        }
    ],
    "contributionTypes": []
}