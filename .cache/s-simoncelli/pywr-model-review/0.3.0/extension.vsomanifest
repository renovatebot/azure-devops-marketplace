{
    "manifestVersion": 1,
    "scopes": [
        "vso.code_write",
        "vso.work"
    ],
    "contributions": [
        {
            "id": "model-reviews-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-code-web.code-hub-group"
            ],
            "properties": {
                "name": "Model reviews",
                "uri": "hub.html",
                "icon": {
                    "light": "dist/icon.png",
                    "dark": "dist/icon.png"
                }
            }
        },
        {
            "id": "model-changes-tab",
            "type": "ms.vss-web.tab",
            "targets": [
                "ms.vss-code-web.pr-tabs"
            ],
            "properties": {
                "name": "Model changes",
                "title": "Model changes",
                "uri": "pr-tab.html"
            }
        },
        {
            "id": "model-reviews-widget",
            "type": "ms.vss-dashboards-web.widget",
            "targets": [
                "ms.vss-dashboards-web.widget-catalog"
            ],
            "properties": {
                "name": "Model reviews waiting for me",
                "description": "The pull requests that change a Pywr model and wait for your review.",
                "catalogIconUrl": "dist/icon.png",
                "uri": "widget.html",
                "supportedSizes": [
                    {
                        "rowSpan": 2,
                        "columnSpan": 2
                    }
                ],
                "supportedScopes": [
                    "project_team"
                ]
            }
        }
    ],
    "contributionTypes": []
}