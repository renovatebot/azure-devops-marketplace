<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="pywr-model-review" Publisher="s-simoncelli" Version="1.0.0"/>
    <DisplayName>Pywr for Azure DevOps</DisplayName>
    <Description xml:space="preserve">Review the pull requests that change Pywr water resource models. See each changed component and the changes on the schematic, comment and vote, without cloning the repositories.</Description>
    <GalleryFlags>Public Paid</GalleryFlags>
    <Tags>__BYOLENFORCED</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.GalleryProperties.TrialDays" Value="30"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://pywrtools.dev/eula/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://pywrtools.dev/privacy/"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://pywrtools.dev/support/"/>
    </Properties>
    <Categories>Azure Repos</Categories>
    <Icon>dist/icon.png</Icon>
    <License>license.md</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="dist/hub.css" d:Source="File" Path="dist/hub.css" Addressable="true"/>
    <Asset Type="dist/hub.js" d:Source="File" Path="dist/hub.js" Addressable="true"/>
    <Asset Type="dist/icon.png" d:Source="File" Path="dist/icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="dist/icon.png" Addressable="true"/>
    <Asset Type="dist/pr-tab.css" d:Source="File" Path="dist/pr-tab.css" Addressable="true"/>
    <Asset Type="dist/pr-tab.js" d:Source="File" Path="dist/pr-tab.js" Addressable="true"/>
    <Asset Type="dist/pywr-schema.json" d:Source="File" Path="dist/pywr-schema.json" Addressable="true"/>
    <Asset Type="dist/pywr-v1-schema.json" d:Source="File" Path="dist/pywr-v1-schema.json" Addressable="true"/>
    <Asset Type="dist/viewer.css" d:Source="File" Path="dist/viewer.css" Addressable="true"/>
    <Asset Type="dist/viewer.js" d:Source="File" Path="dist/viewer.js" Addressable="true"/>
    <Asset Type="dist/vscode-theme.css" d:Source="File" Path="dist/vscode-theme.css" Addressable="true"/>
    <Asset Type="dist/webview-schematic.css" d:Source="File" Path="dist/webview-schematic.css" Addressable="true"/>
    <Asset Type="dist/webview-schematic.js" d:Source="File" Path="dist/webview-schematic.js" Addressable="true"/>
    <Asset Type="dist/widget.css" d:Source="File" Path="dist/widget.css" Addressable="true"/>
    <Asset Type="dist/widget.js" d:Source="File" Path="dist/widget.js" Addressable="true"/>
    <Asset Type="hub.html" d:Source="File" Path="hub.html" Addressable="true"/>
    <Asset Type="pr-tab.html" d:Source="File" Path="pr-tab.html" Addressable="true"/>
    <Asset Type="widget.html" d:Source="File" Path="widget.html" Addressable="true"/>
    <Asset Type="viewer.html" d:Source="File" Path="viewer.html" Addressable="true"/>
    <Asset Type="schematic.html" d:Source="File" Path="schematic.html" Addressable="true"/>
    <Asset Type="schematic-bridge.js" d:Source="File" Path="schematic-bridge.js" Addressable="true"/>
    <Asset Type="images/review.png" d:Source="File" Path="images/review.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="overview.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Pricing" d:Source="File" Path="pricing.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="license.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Privacypolicy" d:Source="File" Path="privacy.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>