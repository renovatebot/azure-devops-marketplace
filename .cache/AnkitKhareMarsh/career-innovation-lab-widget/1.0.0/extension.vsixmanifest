<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="career-innovation-lab-widget" Version="1.0.0" Publisher="AnkitKhareMarsh" />
    <DisplayName>Marsh Career Innovation Lab</DisplayName>
    <Description xml:space="preserve">Marsh Career Innovation Lab applications dashboard widget for Azure DevOps.</Description>
    <Categories>Azure Boards</Categories>
    <Tags></Tags>
    <GalleryFlags>Public</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="" />
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#0078d4" />
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark" />
    </Properties>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services" />
  </Installation>
  <Dependencies />
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" Path="vss-extension.json" Addressable="true" />    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="static/icon.png" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Small" Path="static/icon.png" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="overview.md" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Files/dist/configuration.html" Path="dist/configuration.html" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Files/dist/widget.html" Path="dist/widget.html" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Files/static/icon.png" Path="static/icon.png" Addressable="true" />
  </Assets>
</PackageManifest>