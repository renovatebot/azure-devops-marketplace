<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="parent-field-sync" Version="1.0.1" Publisher="promicro"/>
    <DisplayName>Parent Field Sync</DisplayName>
    <Description xml:space="preserve">Keep Azure Boards child work items aligned by copying selected field values from their parents in a scheduled pipeline.</Description>
    <Categories>Azure Boards,Azure Pipelines</Categories>
    <Tags>Azure Boards,work items,parent child,field synchronization,pipeline task</Tags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Color" Value="#061842"/>
      <Property Id="Microsoft.VisualStudio.Services.Branding.Theme" Value="dark"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/promicroNL/azdo-parent-field-sync#quick-start"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://github.com/promicroNL/azdo-parent-field-sync/blob/main/docs/configuration.md"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/promicroNL/azdo-parent-field-sync/issues"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.Privacypolicy" Value="https://github.com/promicroNL/azdo-parent-field-sync/blob/main/PRIVACY.md"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.License" Value="https://github.com/promicroNL/azdo-parent-field-sync/blob/main/LICENSE"/>
      <Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/promicroNL/azdo-parent-field-sync.git"/>
    </Properties>
    <GalleryFlags>Preview</GalleryFlags>
    <Icon>images/extension-icon.png</Icon>
    <License>LICENSE</License>
  </Metadata>
  <Dependencies/>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Services"/>
  </Installation>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" d:Source="File" Path="images/extension-icon.png" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" d:Source="File" Path="docs/marketplace.md" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Content.License" d:Source="File" Path="LICENSE" Addressable="true"/>
    <Asset Type="Microsoft.VisualStudio.Services.Manifest" d:Source="File" Path="extension.vsomanifest" Addressable="true"/>
  </Assets>
</PackageManifest>